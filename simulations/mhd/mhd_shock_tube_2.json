{
    "comment": "MHD Shock Tube 2 (Strong shock) from Iwasaki & Inutsuka (2011) Fig. 6. Uses GSPH-like settings.",
    "outputDirectory": "simulations/mhd/results/mhd_shock_tube_2",
    "sample": "mhd_shock_tube_2",
    "N": 4000,
    "startTime": 0.0,
    "endTime": 0.06,
    "outputTime": 0.006,
    "SPHType": "gspmhd",
    "kernel": "cubic_spline",
    "neighborNumber": 4,
    "gamma": 1.6666666666666667,
    "cflSound": 0.3,
    "cflForce": 0.1,
    "use2ndOrderMHD": true,
    "usePowellCorrection": true,
    "useGravity": false,
    "useBalsaraSwitch": false,
    "iterativeSmoothingLength": true,
    "rangeMin": [-1.0, -0.01, -0.01],
    "rangeMax": [1.0, 0.01, 0.01],
    "periodic": false,
    "useGhostParticles": true,
    "ghostLayers": 200,
    "output": {
        "enableCSV": true,
        "enableHDF5": false,
        "enableVTK": false,
        "csvPrecision": 16
    }
}
