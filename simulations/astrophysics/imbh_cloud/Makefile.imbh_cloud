# IMBH Cloud Simulation Makefile
# Usage: make -f Makefile.imbh_cloud <target>

# Paths (relative to this Makefile)
ROOT := ../../..
BUILD_REL := $(ROOT)/build
RESULTS_LOCAL := results/lane_emden
RESULTS_HIRES := results/hires_phase1_compact

# Paths after cd to ROOT (for running commands)
BIN := ./build/sph
IMBH_DIR := simulations/astrophysics/imbh_cloud
CONFIG := $(IMBH_DIR)/config/presets/lane_emden
CONFIG_HIRES := $(IMBH_DIR)/config/presets/hires

# Python (use system python with required packages)
PYTHON := /Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3

.PHONY: help build phase1 phase2 gif-phase1 gif-phase2 clean-phase1 clean-phase2 clean-all hires-phase1-restart gif-hires-phase1

help:
	@echo "IMBH Cloud Simulation Targets:"
	@echo "  make -f Makefile.imbh_cloud build       - Build the SPH code"
	@echo "  make -f Makefile.imbh_cloud phase1      - Run Lane-Emden phase1 relaxation"
	@echo "  make -f Makefile.imbh_cloud phase2      - Run Lane-Emden phase2 hydrostatic"
	@echo "  make -f Makefile.imbh_cloud gif-phase1  - Generate phase1 GIF"
	@echo "  make -f Makefile.imbh_cloud gif-phase2  - Generate phase2 GIF"
	@echo "  make -f Makefile.imbh_cloud phase1-viz  - Run phase1 + generate GIF"
	@echo "  make -f Makefile.imbh_cloud hires-phase1-restart - Run hi-res BE sphere restart"
	@echo "  make -f Makefile.imbh_cloud gif-hires-phase1    - Generate hi-res phase1 GIF"
	@echo "  make -f Makefile.imbh_cloud clean-phase1- Clean phase1 results"
	@echo "  make -f Makefile.imbh_cloud clean-all   - Clean all results"

# Build
build:
	cd $(BUILD_REL) && make -j4

# Lane-Emden Phase 1: Relaxation
phase1: build
	@mkdir -p $(RESULTS_LOCAL)/phase1_relaxation
	cd $(ROOT) && $(BIN) $(CONFIG)/phase1_relaxation.json

# Lane-Emden Phase 2: Hydrostatic evolution
phase2: build
	@mkdir -p $(RESULTS_LOCAL)/phase2_hydrostatic
	cd $(ROOT) && $(BIN) $(CONFIG)/phase2_hydrostatic.json

# Generate GIFs
gif-phase1:
	cd $(ROOT) && $(PYTHON) scripts/viz_lane_emden_phase1.py

gif-phase2:
	cd $(ROOT) && $(PYTHON) scripts/viz_lane_emden_phase2.py

# Run phase1 and generate GIF
phase1-viz: phase1 gif-phase1

# Run phase2 and generate GIF
phase2-viz: phase2 gif-phase2

# Hi-res Phase 1: Restart from snapshot (BE sphere relaxation)
hires-phase1-restart: build
	@mkdir -p $(RESULTS_HIRES)
	cd $(ROOT) && $(BIN) $(CONFIG_HIRES)/phase1_compact_restart.json

# Generate GIF for hi-res phase1
gif-hires-phase1:
	cd $(ROOT) && $(PYTHON) $(IMBH_DIR)/scripts/visualize_be_sphere.py $(IMBH_DIR)/results/hires_phase1_compact

# Clean results
clean-phase1:
	rm -rf $(RESULTS_LOCAL)/phase1_relaxation/*.h5
	rm -rf $(RESULTS_LOCAL)/phase1_relaxation/*.csv
	rm -rf $(RESULTS_LOCAL)/phase1_relaxation/*.gif

clean-phase2:
	rm -rf $(RESULTS_LOCAL)/phase2_hydrostatic/*.h5
	rm -rf $(RESULTS_LOCAL)/phase2_hydrostatic/*.csv
	rm -rf $(RESULTS_LOCAL)/phase2_hydrostatic/*.gif

clean-all: clean-phase1 clean-phase2
