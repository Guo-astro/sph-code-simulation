{
    "_comment": "Binary I/O Resume Test: Resume from biniotest checkpoint",
    "_purpose": "Test that resuming from HDF5 checkpoint works correctly",
    "_input": "Resumes from biniotest/snapshot_0002.h5",

    "name": "Binary I/O Resume Test: Continue from checkpoint",
    "dimension": 3,

    "sample": "isothermal_bonnor_ebert",
    "resumeFromSnapshot": "simulations/astrophysics/imbh_cloud/results/biniotest/snapshot_0002.h5",
    "resetTimeOnResume": false,
    "N": 10,

    "T_cloud": 35.0,
    "n_center": 500.0,
    "xi_s": 3.0,
    "mu": 1.27,

    "M_BH": 0.0,
    "b_impact": 0.0,
    "v_rel": 0.0,
    "useEnvelope": true,
    "envelopeLayers": 3,

    "gamma": 1.6666666667,
    "neighborNumber": 50,

    "G": 0.00430091,
    "useGravity": true,

    "treeMaxLevel": 15,
    "treeLeafParticleNum": 16,
    "useMortonCode": true,
    "gravityTheta": 0.5,

    "SPHType": "gsph",
    "kernel": "cubic_spline",
    "useGradH": true,
    "use2ndOrderGSPH": false,

    "endTime": 1.0,
    "outputTime": 0.1,
    "cfl": 0.3,

    "useRelaxation": false,

    "outputDirectory": "simulations/astrophysics/imbh_cloud/results/biniotest_resume",

    "output": {
        "formats": [
            {"type": "hdf5", "compression": 6}
        ],
        "enableCSV": false,
        "enableHDF5": true,
        "enableVTK": false,
        "enableEnergyFile": true,
        "hdf5Compression": 6
    }
}
