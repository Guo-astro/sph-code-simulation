{
    "_comment": "Phase 3: IMBH flyby - Tidal interaction with 10^5 Msun IMBH",
    "_phase": "Final: Main science simulation - IMBH tidal encounter",
    "_units": "CODE units where 1 code_L=1pc, 1 code_M=1Msun, 1 code_V=1km/s",
    "_physics": "M_BH=10^5 Msun, hyperbolic flyby, v_los~80km/s, safe pericenter",

    "_calculation": {
        "cloud_R": "1.55 pc",
        "cloud_M": "127.5 M_sun",
        "M_BH": "10^5 M_sun (=100000 code_mass)",
        "v_infinity": "80 km/s (=80 code_velocity)",
        "r_pericenter": "4.0 pc (2.6× R_cloud - NO penetration)",
        "b_impact": "4.07 pc (=4.07 code_length)",
        "v_pericenter": "81.3 km/s"
    },

    "name": "Phase 3: IMBH-Cloud Tidal Flyby (v_los~80 km/s)",
    "dimension": 3,

    "sample": "isothermal_bonnor_ebert",
    "resumeFromSnapshot": "simulations/astrophysics/imbh_cloud/results/phase2.5_compact_cooling/snapshot_0002.csv",
    "resetTimeOnResume": true,
    "useSnapshotSSOT": false,
    "N": 25,

    "M_cloud": 127.5,
    "T_cloud": 20.0,
    "n_center": 500.0,
    "xi_s": 3.0,
    "R_cloud": 1.55,
    "mu": 1.27,

    "gamma": 1.6667,
    "neighborNumber": 50,

    "G": 0.00430091,
    "useGravity": true,

    "imbh_parameters": {
        "enabled": true,
        "use_code_units": true,
        "_note_units": "All IMBH params in code units (L=pc, M=Msun, V=km/s) to match particle data",
        "M_BH": 100000.0,
        "BH_initial_position": {
            "0": 15.0,
            "1": 4.07,
            "2": 0.0
        },
        "BH_initial_velocity": {
            "0": -80.0,
            "1": 0.0,
            "2": 0.0
        },
        "softening_epsilon": 0.01,
        "sink_radius": 0.1,
        "enable_sink": false,
        "_note": "BH approaches from +x, passes at y=4.07pc, r_peri=4pc"
    },

    "sphAlgorithm": "gsph",
    "kernel": "wendland",
    "riemannSolver": "hll",
    "useGradH": false,

    "useBalsaraSwitch": true,
    "alpha": 1.0,

    "endTime": 0.6,
    "outputTime": 0.01,
    "energyOutputTime": 0.01,
    "cfl": 0.3,

    "useRelaxation": false,
    "useCooling": false,

    "outputDirectory": "simulations/astrophysics/imbh_cloud/results/phase3_flyby",
    "outputFormat": "csv",
    "saveEnergyFile": true,

    "notes": [
        "Flyby geometry: BH orbit in x-y plane",
        "Cloud at origin, BH starts at (15, 4.07, 0) pc",
        "BH velocity: (-80, 0, 0) km/s - approaches from +x",
        "Pericenter r_p=4pc > 2×R_cloud ensures NO penetration",
        "v_pericenter~81 km/s matches target v_los"
    ]
}
