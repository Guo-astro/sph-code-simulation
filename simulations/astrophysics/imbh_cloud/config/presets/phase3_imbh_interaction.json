{
    "_comment": "Phase 3: IMBH flyby - Tidal disruption of cloud by 10^5 Msun IMBH",
    "_phase": "4 of 4: Main science simulation - IMBH tidal encounter",
    "_units": "L=1pc, M=1Msun, V=1km/s => T=0.978Myr, rho=6.77e-23 g/cm³, u=1e10 erg/g",
    "_physics": "M_BH=10^5 Msun, hyperbolic flyby, tidal compression & heating",
    "_input": "Should resume from Phase 2.5 cooled equilibrium state",
    "_target": "Reproduce Oka+2017 HVCC: T~60K, σ_v~22 km/s after encounter",

    "name": "Phase 3: IMBH-Cloud Tidal Interaction (M_BH=10^5 Msun)",
    "dimension": 3,

    "sample": "isothermal_bonnor_ebert",
    "resumeFromSnapshot": "simulations/astrophysics/imbh_cloud/results/phase2.5_cooling_gamma53/snapshot_FINAL.csv",
    "resetTimeOnResume": true,
    "N": 25,

    "M_cloud": 40.0,
    "T_cloud": 7.0,
    "n_center": 1800.0,
    "n_edge": 162.0,
    "P_ext": 1134.0,
    "xi_s": 6.0,
    "R_cloud": 0.75,
    "mu": 1.27,

    "M_BH": 100000.0,
    "d_BH": 10.0,
    "b_impact": 0.0,
    "v_rel": 100.0,
    "useEnvelope": false,

    "imbh_config": {
        "M_BH_Msun": 100000,
        "initial_distance_pc": 10.0,
        "position_initial": [10.0, 0.0, 0.0],
        "velocity_relative_kms": 100.0,
        "trajectory": "hyperbolic"
    },

    "gamma": 1.6667,
    "neighborNumber": 50,

    "G": 0.00430091,
    "useGravity": true,
    "useExternalGravity": true,

    "sphAlgorithm": "gsph",
    "kernel": "wendland",
    "useGradH": true,

    "endTime": 5.0,
    "outputTime": 0.05,
    "cfl": 0.3,

    "useRelaxation": false,

    "outputDirectory": "results/phase3_imbh_interaction",
    "outputFormat": "csv",

    "expected_evolution": {
        "phase1_tidal_shaping": {
            "time_Myr": "0-1",
            "R_pc": "1.0-1.5",
            "n_center_cm3": 1000,
            "sigma_v_kms": "0.5-1"
        },
        "phase2_pre_pericenter": {
            "time_Myr": "1-3",
            "R_pc": "0.3-0.5",
            "n_center_cm3": 10000,
            "sigma_v_kms": "1-2"
        },
        "phase3_pericenter": {
            "time_Myr": "3-3.1",
            "description": "Tidal stretching, shock heating",
            "n_center_cm3": "1e5-1e6",
            "T_shock_K": 10000,
            "sigma_v_kms": "50-100"
        },
        "phase4_post_encounter": {
            "time_Myr": "3.2+",
            "R_pc": 0.3,
            "n_center_cm3": "1e6.5",
            "T_K": 60,
            "sigma_v_kms": 22
        }
    },

    "notes": [
        "Based on Oka et al. (2017) HVCC CO-0.40-0.22 observations",
        "Cloud starts atomic (mu=1.27), becomes molecular during compression",
        "Target final state: T~60K, sigma_v~22 km/s (observed values)",
        "See Ballone et al. (2018) for tidal disruption physics"
    ]
}
