{
    "_comment": "Phase 3: IMBH Interaction - Tidal disruption of cloud by IMBH",
    "_phase": "3 of 3: Main science simulation with IMBH tidal forces",

    "name": "Phase 3: IMBH-Cloud Tidal Interaction (Option A)",
    "dimension": 3,

    "resumeFrom": "results/phase1_relaxation/relaxed_final.csv",

    "M_cloud": 40.0,
    "T_cloud": 9.0,
    "n_center": 980.0,
    "P_ext": 630.0,
    "xi_s": 6.45,
    "mu": 1.27,

    "M_BH": 100000.0,
    "d_BH": 10.0,
    "b_impact": 0.0,
    "v_rel": 100.0,
    "useEnvelope": false,

    "imbh_config": {
        "M_BH_Msun": 100000,
        "initial_distance_pc": 10.0,
        "position_initial": [10.0, 0.0, 0.0],
        "velocity_relative_kms": 100.0,
        "trajectory": "hyperbolic"
    },

    "gamma": 1.6667,
    "neighborNumber": 50,

    "G": 0.00430091,
    "useGravity": true,
    "useExternalGravity": true,

    "sphAlgorithm": "gsph",
    "kernel": "wendland",
    "useGradH": true,

    "endTime": 5.0,
    "outputTime": 0.05,
    "cfl": 0.3,

    "useRelaxation": false,

    "outputDirectory": "results/phase3_imbh_interaction",
    "outputFormat": "csv",

    "expected_evolution": {
        "phase1_tidal_shaping": {
            "time_Myr": "0-1",
            "R_pc": "1.0-1.5",
            "n_center_cm3": 1000,
            "sigma_v_kms": "0.5-1"
        },
        "phase2_pre_pericenter": {
            "time_Myr": "1-3",
            "R_pc": "0.3-0.5",
            "n_center_cm3": 10000,
            "sigma_v_kms": "1-2"
        },
        "phase3_pericenter": {
            "time_Myr": "3-3.1",
            "description": "Tidal stretching, shock heating",
            "n_center_cm3": "1e5-1e6",
            "T_shock_K": 10000,
            "sigma_v_kms": "50-100"
        },
        "phase4_post_encounter": {
            "time_Myr": "3.2+",
            "R_pc": 0.3,
            "n_center_cm3": "1e6.5",
            "T_K": 60,
            "sigma_v_kms": 22
        }
    },

    "notes": [
        "Based on Oka et al. (2017) HVCC CO-0.40-0.22 observations",
        "Cloud starts atomic (mu=1.27), becomes molecular during compression",
        "Target final state: T~60K, sigma_v~22 km/s (observed values)",
        "See Ballone et al. (2018) for tidal disruption physics"
