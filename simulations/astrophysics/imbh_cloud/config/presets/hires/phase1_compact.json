{
    "_comment": "Phase 1 HIGH-RES: Isothermal BE sphere with >220,000 particles",
    "_phase": "1 of 2: Damped relaxation to hydrostatic equilibrium",
    "_units": "L=1pc, M=1Msun, V=1km/s => T=0.978Myr",
    "_physics": "Truncated isothermal BE sphere at T=35K, xi_s=3.0, n_center=500 cm^-3",

    "_design_rationale": [
        "GOAL: High-resolution cloud that can resolve Jeans mass at T~6K",
        "N=61 gives ~227,000 particles (61^3 = 226,981)",
        "Required for: r_p=0.8pc cooling simulations where T can drop to ~6K",
        "",
        "Resolution analysis (from Jeans_Instability_Analysis.tex):",
        "  - At T=6K, n=2e8 cm^-3: M_J ~ 0.06 Msun",
        "  - M_cloud = 127.5 Msun",
        "  - For N_J=100 particles per Jeans mass: N_required = 220,000",
        "  - N=61 gives 227,000 particles -> m_p ~ 0.00056 Msun",
        "  - M_J/m_p ~ 107 > 100 -> RESOLVED"
    ],

    "_resolution_analysis": {
        "N_grid": 61,
        "N_particles_expected": "~227,000 (including envelope)",
        "M_cloud": "127.5 Msun",
        "m_particle": "~0.00056 Msun",
        "at_T6K_n2e8": {
            "M_J": "0.059 Msun",
            "M_J_over_m_p": "~105 particles per Jeans mass"
        }
    },

    "name": "Phase 1 HIGH-RES: Isothermal BE Sphere (N=61, >220k particles)",
    "dimension": 3,

    "sample": "isothermal_bonnor_ebert",
    "N": 61,

    "_param_mode": "n_center=500 cm^-3, xi_s=3.0, T=35K",
    "T_cloud": 35.0,

    "n_center": 500.0,
    "xi_s": 3.0,
    "mu": 1.27,

    "_derived_parameters": {
        "c_s": "0.41 km/s (at T=35K)",
        "r_0_scale": "0.52 pc",
        "R_cloud": "1.55 pc (= xi_s * r_0)",
        "M_cloud": "127.5 Msun",
        "n_edge": "~50 cm^-3",
        "P_ext_over_kB": "1750 K cm^-3"
    },

    "_timescales": {
        "free_fall": "~10.9 Myr (at n=500 cm^-3)",
        "sound_crossing": "~3.8 Myr (for R=1.55pc, cs~0.41 km/s)"
    },

    "M_BH": 0.0,
    "b_impact": 0.0,
    "v_rel": 0.0,
    "useEnvelope": true,
    "envelopeLayers": 6,

    "gamma": 1.6666666667,
    "neighborNumber": 50,

    "G": 0.00430091,
    "useGravity": false,

    "SPHType": "gsph",
    "kernel": "cubic_spline",
    "useGradH": true,
    "use2ndOrderGSPH": false,

    "endTime": 2.0,
    "outputTime": 0.2,
    "cfl": 0.3,

    "useRelaxation": true,
    "relaxationSteps": 2000,
    "relaxationOutputFreq": 10,
    "relaxationOnly": true,
    "useGlassRelaxation": false,

    "outputDirectory": "simulations/astrophysics/imbh_cloud/results/hires_phase1_compact",

    "output": {
        "formats": [
            {"type": "hdf5", "compression": 6}
        ],
        "enableCSV": false,
        "enableHDF5": true,
        "enableVTK": false,
        "enableEnergyFile": true,
        "hdf5Compression": 6
    }
}
