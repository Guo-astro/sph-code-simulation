{
    "_comment": "Binary I/O Test: Small simulation to verify HDF5 dump and resume",
    "_purpose": "Test that binary (HDF5) output and checkpoint/resume works correctly",
    "_resolution": "N=10 gives 10^3 = 1,000 particles (fast test)",

    "name": "Binary I/O Test: Small BE Sphere for checkpoint testing",
    "dimension": 3,

    "sample": "isothermal_bonnor_ebert",
    "N": 10,

    "T_cloud": 35.0,
    "n_center": 500.0,
    "xi_s": 3.0,
    "mu": 1.27,

    "M_BH": 0.0,
    "b_impact": 0.0,
    "v_rel": 0.0,
    "useEnvelope": true,
    "envelopeLayers": 3,

    "gamma": 1.6666666667,
    "neighborNumber": 50,

    "G": 0.00430091,
    "useGravity": true,

    "treeMaxLevel": 15,
    "treeLeafParticleNum": 16,
    "useMortonCode": true,
    "gravityTheta": 0.5,

    "SPHType": "gsph",
    "kernel": "cubic_spline",
    "useGradH": true,
    "use2ndOrderGSPH": false,

    "endTime": 0.5,
    "outputTime": 0.1,
    "cfl": 0.3,

    "useRelaxation": true,
    "relaxationSteps": 10,
    "relaxationOutputFreq": 5,
    "relaxationOnly": true,
    "useGlassRelaxation": false,

    "outputDirectory": "simulations/astrophysics/imbh_cloud/results/biniotest",

    "output": {
        "formats": [
            {"type": "hdf5", "compression": 6}
        ],
        "enableCSV": false,
        "enableHDF5": true,
        "enableVTK": false,
        "enableEnergyFile": true,
        "hdf5Compression": 6
    }
}
