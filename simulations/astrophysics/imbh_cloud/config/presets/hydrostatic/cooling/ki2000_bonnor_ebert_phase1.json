{
  "name": "ki2000_bonnor_ebert_phase1",
  "description": "Phase 1: K&I 2000 Bonnor-Ebert analytical relaxation (gravity OFF)",
  "comment": "Analytical relaxation using K&I 2000 barotropic EOS to achieve hydrostatic equilibrium",

  "sample": "bonnor_ebert_ki2000",
  "N": 40,

  "R_cloud_pc": 3.0,
  "M_cloud_Msun": 1000.0,
  "rho_center_nH": 1.0,
  "N_H_cm2": 1.0e19,
  "P_ext_K_cm3": 100.0,

  "useRelaxation": true,
  "relaxationSteps": 100000,
  "relaxationOutputFreq": 1000,
  "relaxationOnly": true,
  "relaxationTimestepFactor": 0.1,

  "outputDirectory": "simulations/astrophysics/imbh_cloud/results/ki2000_be/phase1_relax",
  "outputFormat": "csv",
  "enableEnergyFile": true,

  "SPHType": "gdisph",
  "kernel": "wendland",
  "neighborNumber": 50,
  "use2ndOrderGSPH": false,
  "riemannSolver": "hll",

  "useGravity": false,
  "G": 1.0,
  "theta": 0.5,

  "periodic": false,

  "cflSound": 0.3,
  "cflForce": 0.125,

  "startTime": 0.0,
  "endTime": 0.0,
  "outputTime": 0.01,

  "gamma": 1.666666667,

  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true
}
