{
  "name": "cloud_cooling_61k",
  "description": "Lane-Emden Cloud with Koyama & Inutsuka (2000) ISM Cooling - Thermal Equilibrium Test",

  "physics_summary": {
    "test_type": "3D_cloud_thermal_equilibrium",
    "cloud_structure": "Lane-Emden n=1.5 polytrope",
    "cooling_physics": "Koyama & Inutsuka (2000) - Full ISM cooling with tabulated data",
    "expected_behavior": {
      "core": "Dense core evolves toward CNM (T~100K)",
      "envelope": "Diffuse envelope stays in WNM (T~6000K)",
      "interface": "Thermally unstable layer may develop"
    },
    "particles": 61000
  },

  "resumeFromSnapshot": "simulations/astrophysics/imbh_cloud/results/IC/61k/snapshot_0000.csv",
  "resetTimeOnResume": true,

  "outputDirectory": "simulations/astrophysics/imbh_cloud/results/hydrostatic/cooling/cloud_61k",
  "outputFormat": "csv",
  "enableEnergyFile": true,

  "SPHType": "gsph",
  "use2ndOrderGSPH": false,
  "kernel": "wendland",
  "neighborNumber": 50,
  "riemannSolver": "hll",

  "useGravity": true,
  "G": 1.0,
  "theta": 0.3,
  "gravitySofteningType": "wendland_c4",

  "periodic": false,

  "cflSound": 0.3,
  "cflForce": 0.125,

  "startTime": 0.0,
  "endTime": 10.0,
  "outputTime": 0.1,

  "gamma": 1.6666666666666667,

  "enableCooling": true,
  "columnDensity": 1.0e19,
  "densityToNumberDensity": 31.9,
  "energyToCGS": 1.0e10,
  "timeToCGS": 3.086e13,

  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true,

  "units": {
    "type": "IMBH_ENCOUNTER",
    "length_pc": 1.0,
    "mass_1e3Msun": 1.0,
    "velocity_kms": 1.0,
    "time_Myr": 0.978,
    "density_cgs": 6.77e-20,
    "n_H_per_code_density": 31.9,
    "energy_cgs_per_code": 1.0e10,
    "time_s_per_code": 3.086e13,
    "comment": "Galactic units: L=1pc, M=1000Msun, V=1km/s, T=0.978Myr"
  },

  "cooling_physics": {
    "model": "Koyama & Inutsuka (2000)",
    "column_density_cm2": 1.0e19,
    "WNM_equilibrium": {"n_cm3": 0.57, "T_K": 6000, "P_k_K_cm3": 3500},
    "CNM_equilibrium": {"n_cm3": 30, "T_K": 100, "P_k_K_cm3": 3000},
    "unit_conversions": {
      "density_to_n_H": "rho_code * 31.9 = n_H [cm^-3]",
      "energy_to_cgs": "u_code * 1e10 = u [erg/g]",
      "time_to_cgs": "t_code * 3.086e13 = t [s]"
    }
  },

  "test_criteria": {
    "thermal_equilibrium": "Core and envelope reach phase-appropriate T_eq",
    "hydrostatic_balance": "Cloud maintains structural integrity with cooling",
    "energy_conservation": "Total energy drift < 5% (cooling removes thermal energy)"
  }
}
