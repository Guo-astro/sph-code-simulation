        "cloud_initial_position": {
            "0": -20.0,
            "1": 1.5,
            "2": 0.0
        },
        "cloud_initial_velocity": {
            "0": 70.0,
            "1": 0.0,
            "2": 0.0
        },
        "_cloud_note": "Cloud starts 20pc away, moves at 70km/s toward BH"
    },

    "sphAlgorithm": "gsph",
    "kernel": "wendland",
    "riemannSolver": "hll",
    "useGradH": false,

    "useBalsaraSwitch": true,
    "alpha": 1.0,

    "endTime": 1.0,
    "outputTime": 0.01,
    "energyOutputTime": 0.01,
    "cfl": 0.3,

    "useRelaxation": false,
    "useCooling": false,

    "outputDirectory": "simulations/astrophysics/imbh_cloud/results/phase3b_cloud_flyby",
