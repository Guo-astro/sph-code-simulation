# ============================================================================
# 3D ANIMATION ONLY (ONE-SHOT COMMANDS)
# ============================================================================
# Generate 3D animation with correct analytic orbit from config file.
# The analytic orbit uses proper GM = 4.498 × M_BH [pc·(km/s)²] for correct
# orbital mechanics with positions in pc and velocities in km/s.
#
# Usage:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_3d
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d CAT=CAT_OKA RES=A SCENARIO=oka
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_oka
# ============================================================================

# ----- Generic 3D animation target -----
# Usage: make anim3d CAT=CAT_OKA RES=A SCENARIO=oka
CAT ?= CAT_OKA
RES ?= A
SCENARIO ?= oka

# Map resolution letter to particle count
RES_MAP_A = 61k
RES_MAP_B = 200k
RES_MAP_C = 1M

ifeq ($(RES),A)
  RES_PARTICLES = 61k
else ifeq ($(RES),B)
  RES_PARTICLES = 200k
else ifeq ($(RES),C)
  RES_PARTICLES = 1M
else
  RES_PARTICLES = $(RES)
endif

anim3d:
	$(call animate_3d_only,$(CAT),$(RES),$(RES_PARTICLES),$(SCENARIO))

# ----- CAT_OKA 3D animations -----
CAT_OKA_A_oka_3d:
	$(call animate_3d_only,CAT_OKA,A,61k,oka)

CAT_OKA_B_oka_3d:
	$(call animate_3d_only,CAT_OKA,B,200k,oka)

CAT_OKA_C_oka_3d:
	$(call animate_3d_only,CAT_OKA,C,1M,oka)

anim3d_all_oka: CAT_OKA_A_oka_3d CAT_OKA_B_oka_3d CAT_OKA_C_oka_3d
	@echo "✓ All CAT_OKA 3D animations generated!"

# ----- CAT_OKA Corrected 3D animations -----
CAT_OKA_A_oka_corrected_3d:
	$(call animate_3d_only,CAT_OKA,A,61k,oka_corrected)

CAT_OKA_B_oka_corrected_3d:
	$(call animate_3d_only,CAT_OKA,B,200k,oka_corrected)

CAT_OKA_C_oka_corrected_3d:
	$(call animate_3d_only,CAT_OKA,C,1M,oka_corrected)

anim3d_all_oka_corrected: CAT_OKA_A_oka_corrected_3d CAT_OKA_B_oka_corrected_3d CAT_OKA_C_oka_corrected_3d
	@echo "✓ All CAT_OKA corrected 3D animations generated!"

# ----- CAT1 3D animations -----
CAT1_A_b1p5_3d:
	$(call animate_3d_only,CAT1,A,61k,b1p5)

CAT1_A_b3_3d:
	$(call animate_3d_only,CAT1,A,61k,b3)

CAT1_A_b6_3d:
	$(call animate_3d_only,CAT1,A,61k,b6)

CAT1_B_b1p5_3d:
	$(call animate_3d_only,CAT1,B,200k,b1p5)

CAT1_B_b3_3d:
	$(call animate_3d_only,CAT1,B,200k,b3)

CAT1_B_b6_3d:
	$(call animate_3d_only,CAT1,B,200k,b6)

CAT1_C_b1p5_3d:
	$(call animate_3d_only,CAT1,C,1M,b1p5)

CAT1_C_b3_3d:
	$(call animate_3d_only,CAT1,C,1M,b3)

CAT1_C_b6_3d:
	$(call animate_3d_only,CAT1,C,1M,b6)

anim3d_all_CAT1: CAT1_A_b1p5_3d CAT1_A_b3_3d CAT1_A_b6_3d \
                 CAT1_B_b1p5_3d CAT1_B_b3_3d CAT1_B_b6_3d \
                 CAT1_C_b1p5_3d CAT1_C_b3_3d CAT1_C_b6_3d
	@echo "✓ All CAT1 3D animations generated!"

# ----- CAT2 3D animations -----
CAT2_A_b1p5_3d:
	$(call animate_3d_only,CAT2,A,61k,b1p5)

CAT2_A_b3_3d:
	$(call animate_3d_only,CAT2,A,61k,b3)

CAT2_A_b6_3d:
	$(call animate_3d_only,CAT2,A,61k,b6)

CAT2_B_b1p5_3d:
	$(call animate_3d_only,CAT2,B,200k,b1p5)

CAT2_B_b3_3d:
	$(call animate_3d_only,CAT2,B,200k,b3)

CAT2_B_b6_3d:
	$(call animate_3d_only,CAT2,B,200k,b6)

CAT2_C_b1p5_3d:
	$(call animate_3d_only,CAT2,C,1M,b1p5)

CAT2_C_b3_3d:
	$(call animate_3d_only,CAT2,C,1M,b3)

CAT2_C_b6_3d:
	$(call animate_3d_only,CAT2,C,1M,b6)

anim3d_all_CAT2: CAT2_A_b1p5_3d CAT2_A_b3_3d CAT2_A_b6_3d \
                 CAT2_B_b1p5_3d CAT2_B_b3_3d CAT2_B_b6_3d \
                 CAT2_C_b1p5_3d CAT2_C_b3_3d CAT2_C_b6_3d
	@echo "✓ All CAT2 3D animations generated!"

# ----- CAT3 3D animations -----
CAT3_A_b1p5_3d:
	$(call animate_3d_only,CAT3,A,61k,b1p5)

CAT3_A_b3_3d:
	$(call animate_3d_only,CAT3,A,61k,b3)

CAT3_A_b6_3d:
	$(call animate_3d_only,CAT3,A,61k,b6)

CAT3_B_b1p5_3d:
	$(call animate_3d_only,CAT3,B,200k,b1p5)

CAT3_B_b3_3d:
	$(call animate_3d_only,CAT3,B,200k,b3)

CAT3_B_b6_3d:
	$(call animate_3d_only,CAT3,B,200k,b6)

CAT3_C_b1p5_3d:
	$(call animate_3d_only,CAT3,C,1M,b1p5)

CAT3_C_b3_3d:
	$(call animate_3d_only,CAT3,C,1M,b3)

CAT3_C_b6_3d:
	$(call animate_3d_only,CAT3,C,1M,b6)

anim3d_all_CAT3: CAT3_A_b1p5_3d CAT3_A_b3_3d CAT3_A_b6_3d \
                 CAT3_B_b1p5_3d CAT3_B_b3_3d CAT3_B_b6_3d \
                 CAT3_C_b1p5_3d CAT3_C_b3_3d CAT3_C_b6_3d
	@echo "✓ All CAT3 3D animations generated!"

# ----- Generate all 3D animations -----
anim3d_all: anim3d_all_oka anim3d_all_oka_corrected anim3d_all_CAT1 anim3d_all_CAT2 anim3d_all_CAT3
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All 3D animations generated!"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Output: $(ANIM_DIR)/<CAT>/<RES>/<SCENARIO>/3d.gif"
	@echo ""

# ============================================================================
# CLEANUP
# ============================================================================

clean_CAT1:
	@echo "Cleaning CAT1 results..."
	rm -rf $(RESULTS_DIR)/CAT1
	rm -rf $(ANIM_DIR)/CAT1
	@echo "✓ CAT1 cleaned"

clean_CAT2:
	@echo "Cleaning CAT2 results..."
	rm -rf $(RESULTS_DIR)/CAT2
	rm -rf $(ANIM_DIR)/CAT2
	@echo "✓ CAT2 cleaned"

clean_CAT3:
	@echo "Cleaning CAT3 results..."
	rm -rf $(RESULTS_DIR)/CAT3
	rm -rf $(ANIM_DIR)/CAT3
	@echo "✓ CAT3 cleaned"

clean_CAT_OKA:
	@echo "Cleaning CAT_OKA results..."
	rm -rf $(RESULTS_DIR)/CAT_OKA
	rm -rf $(ANIM_DIR)/CAT_OKA
	@echo "✓ CAT_OKA cleaned"

clean_all: clean_CAT1 clean_CAT2 clean_CAT3 clean_CAT_OKA
	@echo "✓ All category results cleaned"
