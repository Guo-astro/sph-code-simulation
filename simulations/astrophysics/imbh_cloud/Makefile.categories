# ============================================================================
# CAT_OKA: OKA Y=-0.65 VARIANT (ORIGINAL PAPER VALUE)
# ============================================================================
# Original Oka et al. (2017) parameters with Y=-0.65 (exact paper value)
# This is the closest approach trajectory - nearly radial plunge
# Should trigger BH sink accretion for particles passing close to origin
# ============================================================================

# Resolution A (61k)
CAT_OKA_A_oka_y0p65: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_y0p65)
	$(call animate_category,CAT_OKA,A,61k,oka_y0p65)

CAT_OKA_A_oka_y0p65_run: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_y0p65)

CAT_OKA_A_oka_y0p65_anim:
	$(call animate_category,CAT_OKA,A,61k,oka_y0p65)

# Resolution B (200k)
CAT_OKA_B_oka_y0p65: check_dim
	$(call run_category,CAT_OKA,B,200k,oka_y0p65)
	$(call animate_category,CAT_OKA,B,200k,oka_y0p65)

CAT_OKA_B_oka_y0p65_run: check_dim
	$(call run_category,CAT_OKA,B,200k,oka_y0p65)

CAT_OKA_B_oka_y0p65_anim:
	$(call animate_category,CAT_OKA,B,200k,oka_y0p65)

# Resolution C (1M)
