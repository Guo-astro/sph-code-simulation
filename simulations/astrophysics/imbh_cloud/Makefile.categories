	@echo "│  # Generate 3D animation only (with analytic orbit from config):             │"
	@echo "│  make -f ... CAT_OKA_A_oka_3d                                                │"
	@echo "│                                                                              │"
	@echo "│  NOTE: Animations now show accreted particles as red X markers               │"
	@echo "│        (particles removed by BH sink accretion)                              │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  CONSERVATION DIAGNOSTICS                                                    │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│                                                                              │"
	@echo "│  Verify physics conservation accounting for sink accretion:                  │"
	@echo "│  ──────────────────────────────────────────────────────────────────────────  │"
	@echo "│  - Energy:           E_tot = E_kin + E_therm + E_pot + E_BH + E_accreted     │"
	@echo "│  - Linear Momentum:  P_tot = P_gas + P_accreted                              │"
	@echo "│  - Angular Momentum: L_tot = L_gas + L_accreted (about BH)                   │"
	@echo "│  - Mass:             M_tot = M_gas + M_accreted (should be constant)         │"
	@echo "│                                                                              │"
