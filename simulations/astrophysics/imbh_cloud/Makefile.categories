# CAT_OKA: OKA Y=-3.0 VARIANT
# ============================================================================
# Same as oka_corrected but with cloud_initial_position Y=-3.0 instead of -3.5
# Testing sensitivity to initial Y position
# ============================================================================

# Resolution A (61k)
CAT_OKA_A_oka_y3: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_y3)
	$(call animate_category,CAT_OKA,A,61k,oka_y3)

