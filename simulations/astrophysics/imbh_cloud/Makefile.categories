	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  3D ANIMATION COMMANDS                                                       │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # Generate 3D animation only (with analytic orbit from config):             │"
	@echo "│  make -f ... CAT_OKA_A_oka_3d                                                │"
	@echo "│  make -f ... CAT1_A_b3_3d                                                    │"
	@echo "│                                                                              │"
	@echo "│  # Generic 3D animation with parameters:                                     │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d CAT=CAT1 RES=A SCENARIO=b3│"
	@echo "│                                                                              │"
	@echo "│  # Batch 3D animations:                                                      │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_oka   # All CAT_OKA│"
