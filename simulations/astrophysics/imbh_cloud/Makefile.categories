# ============================================================================
# CAT_OKA: OKA ET AL. (2017) EXACT ORBIT
# ============================================================================
# Hyperbolic orbit with parameters from Nature Astronomy paper:
#   - Initial position: (20.0, -5.17, 0) pc
#   - Initial velocity: (-10.18, 5.05, 0) km/s
#   - Impact parameter: 5.17 pc
#   - Approach velocity: 9.35 km/s
#   - Pericentre: 2.22 pc
#   - Eccentricity: 1.45 (hyperbolic orbit)
#
# Fixed BH parameters:
#   - BH mass: 10^5 M_sun (fixed, does not change on accretion)
#   - BH position: (0, 0, 0) pc (fixed at origin)
#   - Softening epsilon: 0.001 pc (~200 AU)
#   - Sink radius: 0.005 pc (~1000 AU)
#   - Sink accretion: enabled (removes bound, inward-moving particles)
# ============================================================================

# Resolution A (61k)
CAT_OKA_A_oka: check_dim
	$(call run_category,CAT_OKA,A,61k,oka)
	$(call animate_category,CAT_OKA,A,61k,oka)

CAT_OKA_A_oka_run: check_dim
	$(call run_category,CAT_OKA,A,61k,oka)

CAT_OKA_A_oka_anim:
	$(call animate_category,CAT_OKA,A,61k,oka)

# Resolution B (200k)
CAT_OKA_B_oka: check_dim
	$(call run_category,CAT_OKA,B,200k,oka)
	$(call animate_category,CAT_OKA,B,200k,oka)

CAT_OKA_B_oka_run: check_dim
	$(call run_category,CAT_OKA,B,200k,oka)

CAT_OKA_B_oka_anim:
	$(call animate_category,CAT_OKA,B,200k,oka)

# Resolution C (1M)
CAT_OKA_C_oka: check_dim
	$(call run_category,CAT_OKA,C,1M,oka)
	$(call animate_category,CAT_OKA,C,1M,oka)

CAT_OKA_C_oka_run: check_dim
	$(call run_category,CAT_OKA,C,1M,oka)

CAT_OKA_C_oka_anim:
	$(call animate_category,CAT_OKA,C,1M,oka)

# ============================================================================
# CAT_OKA: OKA ET AL. (2017) CORRECTED INITIAL CONDITIONS
# ============================================================================
# Corrected orbit using EXACT parameters from Nature Astronomy Methods section:
#   - Initial position: (9.8, -0.65, 0) pc (from paper Table)
#   - Initial velocity: (-8.19, 0.4, 0) km/s (from paper Table)
#   - Nearly radial orbit with velocity dispersion giving range of pericentres
#   - Mean pericentre: ~0.002 pc (depends on particle initial h)
# ============================================================================

# Resolution A (61k)
CAT_OKA_A_oka_corrected: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_corrected)
	$(call animate_category,CAT_OKA,A,61k,oka_corrected)

CAT_OKA_A_oka_corrected_run: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_corrected)

CAT_OKA_A_oka_corrected_anim:
	$(call animate_category,CAT_OKA,A,61k,oka_corrected)

# Resolution B (200k)
CAT_OKA_B_oka_corrected: check_dim
	$(call run_category,CAT_OKA,B,200k,oka_corrected)
	$(call animate_category,CAT_OKA,B,200k,oka_corrected)

CAT_OKA_B_oka_corrected_run: check_dim
	$(call run_category,CAT_OKA,B,200k,oka_corrected)

CAT_OKA_B_oka_corrected_anim:
	$(call animate_category,CAT_OKA,B,200k,oka_corrected)

# Resolution C (1M)
CAT_OKA_C_oka_corrected: check_dim
	$(call run_category,CAT_OKA,C,1M,oka_corrected)
	$(call animate_category,CAT_OKA,C,1M,oka_corrected)

CAT_OKA_C_oka_corrected_run: check_dim
	$(call run_category,CAT_OKA,C,1M,oka_corrected)

CAT_OKA_C_oka_corrected_anim:
	$(call animate_category,CAT_OKA,C,1M,oka_corrected)

