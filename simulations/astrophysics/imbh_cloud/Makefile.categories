        anim3d_all_oka_y0p65 \
        CAT_OKA_A_oka_corrected_restart CAT_OKA_A_oka_corrected_restart_run \
        CAT_OKA_A_oka_compact CAT_OKA_A_oka_compact_run CAT_OKA_A_oka_compact_anim CAT_OKA_A_oka_compact_3d \
        CAT1_A_b1p5_3d CAT1_A_b3_3d CAT1_A_b6_3d \
        CAT1_B_b1p5_3d CAT1_B_b3_3d CAT1_B_b6_3d \
        CAT1_C_b1p5_3d CAT1_C_b3_3d CAT1_C_b6_3d \
        CAT2_A_b1p5_3d CAT2_A_b3_3d CAT2_A_b6_3d \
        CAT2_B_b1p5_3d CAT2_B_b3_3d CAT2_B_b6_3d \
        CAT2_C_b1p5_3d CAT2_C_b3_3d CAT2_C_b6_3d \
        CAT3_A_b1p5_3d CAT3_A_b3_3d CAT3_A_b6_3d \
        CAT3_B_b1p5_3d CAT3_B_b3_3d CAT3_B_b6_3d \
        CAT3_C_b1p5_3d CAT3_C_b3_3d CAT3_C_b6_3d

# ============================================================================
# HELP
# ============================================================================

help: cat_help

cat_help:
	@echo "══════════════════════════════════════════════════════════════════════════════"
	@echo "  IMBH-Cloud Simulation Category System"
	@echo "══════════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  CATEGORIES                                                                  │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  CAT1     Adiabatic         Pure gas dynamics, no cooling (baseline)         │"
	@echo "│  CAT2     Radiative         Inoue-Inutsuka ISM cooling/heating               │"
	@echo "│  CAT3     Full Physics      Radiative + enhanced self-gravity (fragmentation)│"
	@echo "│  CAT_OKA  Oka et al.(2017)  Exact orbit from Nature Astronomy paper          │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  RESOLUTIONS                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  A     61k particles     Quick tests, parameter exploration (~10 min)        │"
	@echo "│  B     200k particles    Production runs, convergence (~1-3 hours)           │"
	@echo "│  C     1M particles      High resolution, publication (~12-36 hours)         │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SCENARIOS (Impact Parameter)                                                │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  b1p5  b=1.5 pc          Deep disruption (b/r_tidal = 0.41)                  │"
	@echo "│  b3    b=3.0 pc          Partial disruption (b/r_tidal = 0.83)               │"
	@echo "│  b6    b=6.0 pc          Weak interaction (b/r_tidal = 1.65)                 │"
	@echo "│  oka   Oka et al. orbit  Hyperbolic, b=5.17pc, r_peri=2.22pc, e=1.45         │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # Run simulation + generate all animations:                                 │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3                     │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT2_B_b3                     │"
	@echo "│                                                                              │"
	@echo "│  # Run simulation only (no animation):                                       │"
