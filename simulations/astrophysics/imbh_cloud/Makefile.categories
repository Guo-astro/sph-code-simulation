	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories clean_CAT1                    │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories clean_CAT2                    │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories clean_all                     │"
