	@echo "│                                                                              │"
	@echo "│  Animation-Only Commands:                                                    │"
	@echo "│  ──────────────────────────────────────────────────────────────────────────  │"
	@echo "│  # Generate all 4 animations for existing results:                           │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3_anim                │"
	@echo "│                                                                              │"
	@echo "│  # Generate 3D animation only (with analytic orbit from config):             │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_3d              │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3_3d                  │"
	@echo "│                                                                              │"
	@echo "│  # Generic 3D animation with parameters:                                     │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d CAT=CAT1 RES=A SCENARIO=b3│"
	@echo "│                                                                              │"
	@echo "│  # Batch 3D animations:                                                      │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_oka   # All CAT_OKA│"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_CAT1  # All CAT1   │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_CAT2  # All CAT2   │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_CAT3  # All CAT3   │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all       # Everything │"
	@echo "│                                                                              │"
	@echo "│  FPS Control:                                                                │"
	@echo "│  ──────────────────────────────────────────────────────────────────────────  │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3_anim FPS=30         │"
	@echo "│  (Default: FPS=15)                                                           │"
	@echo "│                                                                              │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  CLEANUP                                                                     │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories clean_CAT1                    │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories clean_CAT2                    │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories clean_all                     │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  OUTPUT LOCATIONS                                                            │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  Config files:  $(CONFIG_DIR)/<CAT>/<RES>/<SCENARIO>.json       │"
	@echo "│  Results:       $(RESULTS_DIR)/<CAT>/<RES>/<SCENARIO>/                       │"
	@echo "│  Animations:    $(ANIM_DIR)/<CAT>/<RES>/<SCENARIO>/                          │"
	@echo "│                                                                              │"
	@echo "│  Animation files:                                                            │"
	@echo "│    tidal.gif   - Tidal disruption overview                                   │"
	@echo "│    shock.gif   - Shock diagnostic panels                                     │"
	@echo "│    density.gif - Density field evolution                                     │"
	@echo "│    3d.gif      - 3D view with analytic orbit                                 │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""

# ============================================================================
# UTILITIES
# ============================================================================

check_dim: build/sph
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
		echo "❌ Error: IMBH-cloud simulation requires DIM=3"; \
		echo ""; \
		echo "To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
		exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

generate_configs:
	@echo "Generating all category configurations..."
	python $(SCRIPTS_DIR)/generate_category_configs.py

# ============================================================================
# GENERIC RUN TEMPLATE
# ============================================================================
#
# This template is used by all CAT*_*_* targets.
# Usage: $(call run_category,CAT1,A,61k,b3)
#

define run_category
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: $(1)_$(2)_$(4)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Category:    $(1)"
	@echo "  Resolution:  $(2) ($(3) particles)"
	@echo "  Scenario:    $(4)"
	@echo "  Config:      $(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@if [ ! -f "$(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json" ]; then \
		echo "❌ Config not found. Run 'make generate_configs' first."; \
		exit 1; \
	fi
	@mkdir -p $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)/checkpoints
	./build/sph $(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json
	@echo ""
	@echo "✓ Simulation complete: $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)/"
endef

define animate_category
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Animating: $(1)_$(2)_$(4)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Output directory: $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/"
	@echo ""
	@mkdir -p $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)
	@echo "[1/4] 📊 Tidal disruption (tidal.gif)"
	@echo "      X-Y projection showing cloud position relative to IMBH"
	@echo "      Color: log(density), shows tidal stream formation"
	@python $(SCRIPTS_DIR)/animate_single_run.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/tidal.gif --mode tidal --fps $(FPS) 2>/dev/null || \
		echo "  ⚠ Skipped (no snapshots?)"
	@echo ""
	@echo "[2/4] 💥 Shock diagnostics (shock.gif)"
	@echo "      Multi-panel: velocity divergence, Mach number, entropy"
	@echo "      Shows compression/expansion and shock-heated regions"
	@python $(SCRIPTS_DIR)/animate_shock_diagnostics.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/shock.gif --fps $(FPS) 2>/dev/null || \
		echo "  ⚠ Skipped"
	@echo ""
	@echo "[3/4] 🌫️  Density field (density.gif)"
	@echo "      X-Y plane density evolution showing disruption morphology"
	@echo "      Color: log(rho), reveals filaments and clumps"
	@python $(SCRIPTS_DIR)/animate_single_run.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/density.gif --mode density --fps $(FPS) 2>/dev/null || \
		echo "  ⚠ Skipped"
	@echo ""
	@echo "[4/4] 🎬 3D view with analytic orbit (3d.gif)"
	@echo "      3D perspective with hyperbolic IMBH orbit overlay"
	@echo "      Color: density, rotating camera view"
	@python $(SCRIPTS_DIR)/animate_3d_view.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/3d.gif --mode density --fps $(FPS) \
		--config $(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json 2>/dev/null || \
		echo "  ⚠ Skipped"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "✓ Animations complete: $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@ls -lh $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/*.gif 2>/dev/null || true
endef

# 3D animation only (with correct analytic orbit from config)
define animate_3d_only
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  🎬 3D Animation: $(1)_$(2)_$(4)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Description:"
	@echo "    3D perspective view of cloud particles with IMBH hyperbolic orbit overlay."
	@echo "    The analytic orbit is computed from the config file using:"
	@echo "      GM = 4.498 × M_BH [pc·(km/s)²]"
	@echo "    Positions in parsecs, velocities in km/s."
	@echo ""
	@echo "  Color: log(density) - reveals internal structure and tidal streams"
	@echo "  Camera: rotating view for full 3D perspective"
	@echo ""
	@echo "  Input:   $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)"
	@echo "  Config:  $(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json"
	@echo "  Output:  $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/3d.gif"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@mkdir -p $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)
	python $(SCRIPTS_DIR)/animate_3d_view.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/3d.gif --mode density --fps $(FPS) \
		--config $(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "✓ 3D Animation complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@ls -lh $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/3d.gif 2>/dev/null || true
endef

# ============================================================================
# CAT1: ADIABATIC SIMULATIONS
# ============================================================================

# Resolution A (61k)
CAT1_A_b1p5: check_dim
	$(call run_category,CAT1,A,61k,b1p5)
	$(call animate_category,CAT1,A,61k,b1p5)

CAT1_A_b3: check_dim
	$(call run_category,CAT1,A,61k,b3)
	$(call animate_category,CAT1,A,61k,b3)

CAT1_A_b6: check_dim
	$(call run_category,CAT1,A,61k,b6)
	$(call animate_category,CAT1,A,61k,b6)

CAT1_A_b1p5_run: check_dim
	$(call run_category,CAT1,A,61k,b1p5)

CAT1_A_b3_run: check_dim
	$(call run_category,CAT1,A,61k,b3)

CAT1_A_b6_run: check_dim
	$(call run_category,CAT1,A,61k,b6)

CAT1_A_b1p5_anim:
	$(call animate_category,CAT1,A,61k,b1p5)

CAT1_A_b3_anim:
	$(call animate_category,CAT1,A,61k,b3)

CAT1_A_b6_anim:
	$(call animate_category,CAT1,A,61k,b6)

# Resolution B (200k)
CAT1_B_b1p5: check_dim
	$(call run_category,CAT1,B,200k,b1p5)
	$(call animate_category,CAT1,B,200k,b1p5)

