# ============================================================================
# IMBH-Cloud Simulation Category System Makefile
# ============================================================================
#
# Systematic simulation categories for IMBH-molecular cloud tidal disruption.
#
# Categories:
#   CAT1    - Adiabatic (no cooling)      : Pure gas dynamics baseline
#   CAT2    - Radiative (Inoue-Inutsuka)  : ISM thermal physics
#   CAT3    - Full Physics (Rad + SG)     : Radiative + enhanced self-gravity
#   CAT_OKA - Oka et al. (2017) orbit     : Exact orbital parameters from paper
#
# Resolutions:
#   A - 61k particles  (quick tests, parameter exploration)
#   B - 200k particles (production runs, convergence studies)
#   C - 1M particles   (high resolution, publication quality)
#
# Scenarios (impact parameter):
#   b1p5 - b=1.5 pc (deep disruption,   b/r_t=0.41)
#   b3   - b=3.0 pc (partial disruption, b/r_t=0.83)
#   b6   - b=6.0 pc (weak interaction,   b/r_t=1.65)
#   oka  - Oka et al. orbit (b=5.17 pc, pericentre=2.22 pc, e=1.45)
#
# ============================================================================
# USAGE
# ============================================================================
#
# Single simulation:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT2_B_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT3_C_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka
#
# All resolutions for a category/scenario:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_all_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_all_oka
#
# All categories for a resolution/scenario:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories all_A_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories all_B_b3
#
# Comparison workflows:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories compare_physics_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories compare_resolution_CAT2_b3
#
# List available targets:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories help
#
# ============================================================================

# Path definitions
IMBH_DIR := simulations/astrophysics/imbh_cloud
CONFIG_DIR := $(IMBH_DIR)/config/presets/categories
RESULTS_DIR := $(IMBH_DIR)/results
SCRIPTS_DIR := $(IMBH_DIR)/scripts
ANIM_DIR := $(IMBH_DIR)/animations

# Animation FPS
FPS ?= 15

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: help cat_help check_dim generate_configs \
        CAT1_A_b1p5 CAT1_A_b3 CAT1_A_b6 \
        CAT1_B_b1p5 CAT1_B_b3 CAT1_B_b6 \
        CAT1_C_b1p5 CAT1_C_b3 CAT1_C_b6 \
        CAT2_A_b1p5 CAT2_A_b3 CAT2_A_b6 \
        CAT2_B_b1p5 CAT2_B_b3 CAT2_B_b6 \
        CAT2_C_b1p5 CAT2_C_b3 CAT2_C_b6 \
        CAT3_A_b1p5 CAT3_A_b3 CAT3_A_b6 \
        CAT3_B_b1p5 CAT3_B_b3 CAT3_B_b6 \
        CAT3_C_b1p5 CAT3_C_b3 CAT3_C_b6 \
        CAT_OKA_A_oka CAT_OKA_B_oka CAT_OKA_C_oka \
        CAT_OKA_A_oka_corrected CAT_OKA_B_oka_corrected CAT_OKA_C_oka_corrected \
        CAT1_all_b1p5 CAT1_all_b3 CAT1_all_b6 \
        CAT2_all_b1p5 CAT2_all_b3 CAT2_all_b6 \
        CAT3_all_b1p5 CAT3_all_b3 CAT3_all_b6 \
        CAT_OKA_all_oka CAT_OKA_all_oka_corrected \
        all_A_b1p5 all_A_b3 all_A_b6 \
        all_B_b1p5 all_B_b3 all_B_b6 \
        all_C_b1p5 all_C_b3 all_C_b6 \
        compare_physics_b1p5 compare_physics_b3 compare_physics_b6 \
        compare_resolution_CAT1_b3 compare_resolution_CAT2_b3 compare_resolution_CAT3_b3 \
        clean_CAT1 clean_CAT2 clean_CAT3 clean_CAT_OKA clean_all \
        anim3d anim3d_all anim3d_all_oka anim3d_all_CAT1 anim3d_all_CAT2 anim3d_all_CAT3 \
        CAT_OKA_A_oka_3d CAT_OKA_B_oka_3d CAT_OKA_C_oka_3d \
        CAT_OKA_A_oka_corrected_3d CAT_OKA_B_oka_corrected_3d CAT_OKA_C_oka_corrected_3d \
        anim3d_all_oka_corrected \
        CAT1_A_b1p5_3d CAT1_A_b3_3d CAT1_A_b6_3d \
        CAT1_B_b1p5_3d CAT1_B_b3_3d CAT1_B_b6_3d \
        CAT1_C_b1p5_3d CAT1_C_b3_3d CAT1_C_b6_3d \
        CAT2_A_b1p5_3d CAT2_A_b3_3d CAT2_A_b6_3d \
        CAT2_B_b1p5_3d CAT2_B_b3_3d CAT2_B_b6_3d \
        CAT2_C_b1p5_3d CAT2_C_b3_3d CAT2_C_b6_3d \
        CAT3_A_b1p5_3d CAT3_A_b3_3d CAT3_A_b6_3d \
        CAT3_B_b1p5_3d CAT3_B_b3_3d CAT3_B_b6_3d \
        CAT3_C_b1p5_3d CAT3_C_b3_3d CAT3_C_b6_3d

# ============================================================================
# HELP
# ============================================================================

help: cat_help

cat_help:
	@echo "══════════════════════════════════════════════════════════════════════════════"
	@echo "  IMBH-Cloud Simulation Category System"
	@echo "══════════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  CATEGORIES                                                                  │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  CAT1     Adiabatic         Pure gas dynamics, no cooling (baseline)         │"
	@echo "│  CAT2     Radiative         Inoue-Inutsuka ISM cooling/heating               │"
	@echo "│  CAT3     Full Physics      Radiative + enhanced self-gravity (fragmentation)│"
	@echo "│  CAT_OKA  Oka et al.(2017)  Exact orbit from Nature Astronomy paper          │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  RESOLUTIONS                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  A     61k particles     Quick tests, parameter exploration (~10 min)        │"
	@echo "│  B     200k particles    Production runs, convergence (~1-3 hours)           │"
	@echo "│  C     1M particles      High resolution, publication (~12-36 hours)         │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SCENARIOS (Impact Parameter)                                                │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  b1p5  b=1.5 pc          Deep disruption (b/r_tidal = 0.41)                  │"
	@echo "│  b3    b=3.0 pc          Partial disruption (b/r_tidal = 0.83)               │"
	@echo "│  b6    b=6.0 pc          Weak interaction (b/r_tidal = 1.65)                 │"
	@echo "│  oka   Oka et al. orbit  Hyperbolic, b=5.17pc, r_peri=2.22pc, e=1.45         │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # Run simulation + generate all animations:                                 │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3                     │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT2_B_b3                     │"
	@echo "│                                                                              │"
	@echo "│  # Run simulation only (no animation):                                       │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3_run                 │"
	@echo "│                                                                              │"
	@echo "│  # Generate all animations only (requires existing results):                 │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3_anim                │"
	@echo "│    → Generates: tidal.gif, shock.gif, density.gif, 3d.gif                    │"
	@echo "│                                                                              │"
	@echo "│  # Generate 3D animation only (with analytic orbit overlay):                 │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_3d              │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d CAT=CAT1 RES=A SCENARIO=b3│"
	@echo "│                                                                              │"
	@echo "│  # Batch 3D animations for all resolutions:                                  │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_oka                │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all                    │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  BATCH RUNS                                                                  │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # All resolutions for one category/scenario:                                │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_all_b3                   │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT2_all_b3                   │"
	@echo "│                                                                              │"
	@echo "│  # All categories for one resolution/scenario:                               │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories all_A_b3                      │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories all_B_b3                      │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  COMPARISONS                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # Physics comparison (CAT1 vs CAT2 vs CAT3) at b=3pc, Res B:                │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories compare_physics_b3            │"
	@echo "│                                                                              │"
	@echo "│  # Resolution convergence for CAT2 at b=3pc:                                 │"
	@echo "│  make -f simulations/astrophysics/imbh_cloud/Makefile.categories compare_resolution_CAT2_b3    │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  VISUALIZATION COMMANDS                                                      │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│                                                                              │"
	@echo "│  Animation Modes (generated by *_anim targets):                              │"
	@echo "│  ──────────────────────────────────────────────────────────────────────────  │"
	@echo "│  tidal.gif    X-Y projection showing cloud position relative to IMBH         │"
	@echo "│               Color: log density, shows tidal stream formation               │"
	@echo "│                                                                              │"
	@echo "│  shock.gif    Multi-panel shock diagnostics:                                 │"
	@echo "│               - Velocity divergence (compression/expansion)                  │"
