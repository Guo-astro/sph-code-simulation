# ============================================================================
# UTILITIES
# ============================================================================

check_dim: build/sph
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
		echo "❌ Error: IMBH-cloud simulation requires DIM=3"; \
		echo ""; \
		echo "To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
		exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

generate_configs:
	@echo "Generating all category configurations..."
	python $(SCRIPTS_DIR)/generate_category_configs.py

# ============================================================================
# CONSERVATION DIAGNOSTICS
# ============================================================================
# Verify energy, momentum, and angular momentum conservation accounting for
# sink accretion (particles removed by the BH).
#
# Usage:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories diag CAT=CAT_OKA RES=A SCENARIO=oka_corrected
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_corrected_diag
# ============================================================================

.PHONY: diag \
        CAT_OKA_A_oka_corrected_diag CAT_OKA_B_oka_corrected_diag CAT_OKA_C_oka_corrected_diag \
        CAT_OKA_A_oka_y0p65_diag CAT_OKA_B_oka_y0p65_diag CAT_OKA_C_oka_y0p65_diag \
        CAT_OKA_A_oka_y2_diag CAT_OKA_B_oka_y2_diag CAT_OKA_C_oka_y2_diag \
        CAT_OKA_A_oka_y2p5_diag CAT_OKA_B_oka_y2p5_diag CAT_OKA_C_oka_y2p5_diag \
        CAT_OKA_A_oka_y3_diag CAT_OKA_B_oka_y3_diag CAT_OKA_C_oka_y3_diag \
        diag_all_oka_y0p65 diag_all_oka_corrected diag_all_oka_y2 diag_all_oka_y3

# Generic diagnostics target
diag:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Conservation Diagnostics: $(CAT)_$(RES)_$(SCENARIO)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Checking: Energy, Momentum, Angular Momentum (with sink accretion)"
	@echo ""
	python $(SCRIPTS_DIR)/diag_conservation.py $(RESULTS_DIR)/$(CAT)/$(RES)_$(RES_PARTICLES)/$(SCENARIO) \
		--output-dir $(RESULTS_DIR)/$(CAT)/$(RES)_$(RES_PARTICLES)/$(SCENARIO) \
		--bh-mass 100.0
	@echo ""
	@echo "  Results:"
	@echo "    CSV:   $(RESULTS_DIR)/$(CAT)/$(RES)_$(RES_PARTICLES)/$(SCENARIO)/conservation_diagnostics.csv"
	@echo "    Plot:  $(RESULTS_DIR)/$(CAT)/$(RES)_$(RES_PARTICLES)/$(SCENARIO)/conservation_plots.png"
	@echo ""

# ============================================================================
# DIAGNOSTIC TEMPLATE
# ============================================================================
# Template for running conservation diagnostics on simulation results
# Usage: $(call run_diag,CAT_OKA,A,61k,oka_y0p65)

define run_diag
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Conservation Diagnostics: $(1)_$(2)_$(4)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Checking: Energy, Momentum, Angular Momentum (with sink accretion)"
	@echo "  Results:  $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)/"
	@echo ""
	python $(SCRIPTS_DIR)/diag_conservation.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		--output-dir $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		--bh-mass 100.0
	@echo ""
	@echo "  Output:"
	@echo "    CSV:   $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)/conservation_diagnostics.csv"
	@echo "    Plot:  $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)/conservation_plots.png"
	@echo ""
endef

