	@echo "│                                                                              │"
	@echo "│  # Generic target (specify CAT, RES, SCENARIO):                              │"
	@echo "│  make -f ... diag CAT=CAT_OKA RES=A SCENARIO=oka_y0p65                       │"
	@echo "│                                                                              │"
	@echo "│  Output Files:                                                               │"
	@echo "│  ──────────────────────────────────────────────────────────────────────────  │"
	@echo "│  conservation_diagnostics.csv  - Time series of all conserved quantities    │"
	@echo "│  conservation_plots.png        - Multi-panel diagnostic plots               │"
