# ============================================================================
# IMBH-Cloud Simulation Category System Makefile
# ============================================================================
#
# Systematic simulation categories for IMBH-molecular cloud tidal disruption.
#
# Physics Model: Fixed Black Hole with Sink Accretion
# ──────────────────────────────────────────────────────────────────────────────
# The IMBH is implemented as a fixed point mass at the origin with:
#   - Plummer softening: a = -G M_BH r / (r² + eps²)^(3/2)
#   - Sink accretion: particles inside r_sink that are bound and moving
#     inward are removed from the simulation
#   - BH mass remains fixed (fixed-potential approximation)
#
# Default parameters (can be overridden in JSON config):
#   M_BH = 10^5 M_sun           BH mass
#   eps  = 0.001 pc (~200 AU)   Softening length
#   r_sink = 0.005 pc (~1000 AU) Sink/accretion radius
#
# Time stepping includes both CFL and gravity constraints:
#   dt = min(C_CFL * h/v_sig, eta * sqrt(h/|a|))
# ──────────────────────────────────────────────────────────────────────────────
#
# Categories:
#   CAT1    - Adiabatic (no cooling)      : Pure gas dynamics baseline
#   CAT2    - Radiative (Inoue-Inutsuka)  : ISM thermal physics
#   CAT3    - Full Physics (Rad + SG)     : Radiative + enhanced self-gravity
#   CAT_OKA - Oka et al. (2017) orbit     : Exact orbital parameters from paper
#
# Resolutions:
#   A - 61k particles  (quick tests, parameter exploration)
#   B - 200k particles (production runs, convergence studies)
#   C - 1M particles   (high resolution, publication quality)
#
# Scenarios (impact parameter):
#   b1p5 - b=1.5 pc (deep disruption,   b/r_t=0.41)
#   b3   - b=3.0 pc (partial disruption, b/r_t=0.83)
#   b6   - b=6.0 pc (weak interaction,   b/r_t=1.65)
#   oka  - Oka et al. orbit (b=5.17 pc, pericentre=2.22 pc, e=1.45)
#
# Scripts (in scripts/ directory):
#   diag_conservation.py      - Conservation diagnostics (E, P, L with sink accretion)
#   viz_gradh_comparison.py   - Grad-h method comparison plots/animation
#   animate_single_run.py     - Main IMBH tidal disruption animation
#   animate_3d_view.py        - 3D perspective animation with orbit overlay
#   animate_shock_diagnostics.py - Shock diagnostic panels animation
#   visualize_relaxation.py   - Relaxation IC visualization
#   visualize_hydrostatic.py  - Hydrostatic equilibrium test visualization
#   generate_category_configs.py - Generate simulation config files
#   generate_oka_compact_ic.py   - Generate compact Gaussian IC for Oka scenario
#
# ============================================================================
# USAGE
# ============================================================================
#
# Single simulation (run + animation):
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT2_B_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT3_C_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka
#
# Simulation only (no animation):
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3_run
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_corrected_run
#
# Restart from checkpoint (continue interrupted simulation):
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_corrected_restart_run
#
# Visualization only (after simulation completed):
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_A_b3_anim
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_corrected_anim
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_A_oka_3d
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories anim3d_all_oka
#
# All resolutions for a category/scenario:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT1_all_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories CAT_OKA_all_oka
#
# All categories for a resolution/scenario:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories all_A_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories all_B_b3
#
# Comparison workflows:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories compare_physics_b3
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories compare_resolution_CAT2_b3
#
# List available targets:
#   make -f simulations/astrophysics/imbh_cloud/Makefile.categories help
#
# ============================================================================

# Path definitions
IMBH_DIR := simulations/astrophysics/imbh_cloud
CONFIG_DIR := $(IMBH_DIR)/config/presets/categories
RESULTS_DIR := $(IMBH_DIR)/results
SCRIPTS_DIR := $(IMBH_DIR)/scripts
ANIM_DIR := $(IMBH_DIR)/animations

# Animation FPS
FPS ?= 15

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: help cat_help check_dim generate_configs \
        CAT1_A_b1p5 CAT1_A_b3 CAT1_A_b6 \
        CAT1_B_b1p5 CAT1_B_b3 CAT1_B_b6 \
        CAT1_C_b1p5 CAT1_C_b3 CAT1_C_b6 \
        CAT2_A_b1p5 CAT2_A_b3 CAT2_A_b6 \
        CAT2_B_b1p5 CAT2_B_b3 CAT2_B_b6 \
        CAT2_C_b1p5 CAT2_C_b3 CAT2_C_b6 \
        CAT3_A_b1p5 CAT3_A_b3 CAT3_A_b6 \
        CAT3_B_b1p5 CAT3_B_b3 CAT3_B_b6 \
        CAT3_C_b1p5 CAT3_C_b3 CAT3_C_b6 \
        CAT_OKA_A_oka CAT_OKA_B_oka CAT_OKA_C_oka \
        CAT_OKA_A_oka_corrected CAT_OKA_B_oka_corrected CAT_OKA_C_oka_corrected \
        CAT_OKA_A_oka_y3 CAT_OKA_B_oka_y3 CAT_OKA_C_oka_y3 \
        CAT_OKA_A_oka_y2p5 CAT_OKA_B_oka_y2p5 CAT_OKA_C_oka_y2p5 \
        CAT_OKA_A_oka_y2 CAT_OKA_B_oka_y2 CAT_OKA_C_oka_y2 \
        CAT_OKA_A_oka_y0p65 CAT_OKA_B_oka_y0p65 CAT_OKA_C_oka_y0p65 \
        CAT1_all_b1p5 CAT1_all_b3 CAT1_all_b6 \
        CAT2_all_b1p5 CAT2_all_b3 CAT2_all_b6 \
        CAT3_all_b1p5 CAT3_all_b3 CAT3_all_b6 \
        CAT_OKA_all_oka CAT_OKA_all_oka_corrected CAT_OKA_all_oka_y3 CAT_OKA_all_oka_y2p5 CAT_OKA_all_oka_y2 CAT_OKA_all_oka_y0p65 \
        CAT_OKA_A_all_variants CAT_OKA_A_all_variants_run CAT_OKA_A_all_variants_anim \
        CAT_OKA_A_all_variants_3d CAT_OKA_A_all_variants_diag \
        all_A_b1p5 all_A_b3 all_A_b6 \
        all_B_b1p5 all_B_b3 all_B_b6 \
        all_C_b1p5 all_C_b3 all_C_b6 \
        compare_physics_b1p5 compare_physics_b3 compare_physics_b6 \
        compare_resolution_CAT1_b3 compare_resolution_CAT2_b3 compare_resolution_CAT3_b3 \
        clean_CAT1 clean_CAT2 clean_CAT3 clean_CAT_OKA clean_all \
        anim3d anim3d_all anim3d_all_oka anim3d_all_CAT1 anim3d_all_CAT2 anim3d_all_CAT3 \
        CAT_OKA_A_oka_3d CAT_OKA_B_oka_3d CAT_OKA_C_oka_3d \
        CAT_OKA_A_oka_corrected_3d CAT_OKA_B_oka_corrected_3d CAT_OKA_C_oka_corrected_3d \
        anim3d_all_oka_corrected \
        CAT_OKA_A_oka_y3_3d CAT_OKA_B_oka_y3_3d CAT_OKA_C_oka_y3_3d \
        anim3d_all_oka_y3 \
        CAT_OKA_A_oka_y2p5_3d CAT_OKA_B_oka_y2p5_3d CAT_OKA_C_oka_y2p5_3d \
        anim3d_all_oka_y2p5 \
        CAT_OKA_A_oka_y2_3d CAT_OKA_B_oka_y2_3d CAT_OKA_C_oka_y2_3d \
        anim3d_all_oka_y2 \
