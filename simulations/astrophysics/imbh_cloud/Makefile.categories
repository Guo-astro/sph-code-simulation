	$(call run_category,CAT_OKA,C,1M,oka_y0p65)
	$(call animate_category,CAT_OKA,C,1M,oka_y0p65)

CAT_OKA_C_oka_y0p65_run: check_dim
	$(call run_category,CAT_OKA,C,1M,oka_y0p65)

CAT_OKA_C_oka_y0p65_anim:
	$(call animate_category,CAT_OKA,C,1M,oka_y0p65)

# ============================================================================
# CAT_OKA: RESTART FROM CHECKPOINT
# ============================================================================
# Restart simulation from snapshot_0086.csv (t=0.86 code units)
# Use this to continue an interrupted simulation without losing progress.
# Output continues to the same directory, new snapshots numbered from where it left off.
# ============================================================================

# Resolution A (61k) - Restart
CAT_OKA_A_oka_corrected_restart: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_corrected_restart)
	$(call animate_category,CAT_OKA,A,61k,oka_corrected)

CAT_OKA_A_oka_corrected_restart_run: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_corrected_restart)

# ============================================================================
# CAT_OKA: COMPACT GAUSSIAN CLOUD (sigma=0.2pc - Exact Oka reproduction)
# ============================================================================
#
# Uses Gaussian IC generated by: scripts/generate_oka_compact_ic.py
# This cloud exactly matches Oka et al. (2017) parameters:
#   - Gaussian radial dispersion: σ = 0.2 pc
#   - Isotropic velocity dispersion: 1.43 km/s
#   - Total mass: 1000 M☉
#   - 10k particles for SPH resolution
#
# Generate IC first:
#   python simulations/astrophysics/imbh_cloud/scripts/generate_oka_compact_ic.py
# ============================================================================

# Resolution A (10k - matched to compact cloud)
CAT_OKA_A_oka_compact: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_compact)
	$(call animate_category,CAT_OKA,A,61k,oka_compact)

CAT_OKA_A_oka_compact_run: check_dim
	$(call run_category,CAT_OKA,A,61k,oka_compact)

CAT_OKA_A_oka_compact_anim:
	$(call animate_category,CAT_OKA,A,61k,oka_compact)

CAT_OKA_A_oka_compact_3d:
	$(call animate_3d_only,CAT_OKA,A,61k,oka_compact)

