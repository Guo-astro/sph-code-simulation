{
  "_comment": "BNS cocoon-like test: relativistic blast wave into cold ejecta (sr_sod derived)",
  "_description": "Similar to Kitajima+2025 blast wave test but with ejecta-like outer medium",
  "_reference": "Adapted from sr_blast_wave.json for cocoon physics",
  "_sr_sod": "This key triggers SRGSPH sample recognition",
  
  "outputDirectory": "simulations/astrophysics/bns_cocoon/results/cocoon_test",
  
  "startTime": 0.0,
  "endTime": 0.4,
  "outputTime": 0.01,
  "energyTime": 0.01,
  
  "checkpoint": {
    "enabled": false,
    "resumeFile": ""
  },
  
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  },
  
  "SPHType": "srgsph",
  "use2ndOrderSRGSPH": true,
  
  "cSpeed": 1.0,
  "cShock": 3.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  
  "gamma": 1.666666667,
  
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  
  "N": 5500,
  "testType": "blast_wave",
  
  "periodic": false,
  "rangeMax": [0.5],
  "rangeMin": [-0.5],
  
  "avAlpha": 0.0,
  "useBalsaraSwitch": false,
  
  "cflSound": 0.3,
  "cflForce": 0.25
}
