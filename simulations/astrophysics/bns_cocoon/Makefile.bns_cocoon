# ============================================================================
# BNS COCOON SIMULATION MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Simulate binary neutron star merger cocoon dynamics.
#
# USAGE:
#   make -f simulations/astrophysics/bns_cocoon/Makefile.bns_cocoon bns_run
#   make -f simulations/astrophysics/bns_cocoon/Makefile.bns_cocoon bns_compare_all
#   make -f simulations/astrophysics/bns_cocoon/Makefile.bns_cocoon bns_clean
#   make -f simulations/astrophysics/bns_cocoon/Makefile.bns_cocoon bns_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/astrophysics/bns_cocoon/results/
#
# ============================================================================

# Paths
BNS_DIR := simulations/astrophysics/bns_cocoon
BNS_CONFIG := $(BNS_DIR)/config
PRESET_DIR := $(BNS_CONFIG)/presets
BNS_RESULTS := $(BNS_DIR)/results
BNS_SCRIPTS := $(BNS_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: bns_help bns_check_dim bns_run \
        bns_clean bns_compare_all bns_compare_run \
        bns_compare_viz bns_compare_animate bns_compare_clean

# ============================================================================
# HELP
# ============================================================================

bns_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  BNS COCOON SIMULATION - Binary Neutron Star Merger Cocoon"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Simulate binary neutron star merger cocoon dynamics."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make bns_run              # Run default simulation                │"
	@echo "│  make bns_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make bns_compare_run      # Run all SPH methods                   │"
	@echo "│  make bns_compare_viz      # Generate comparison plots             │"
	@echo "│  make bns_compare_all      # Run all + visualizations              │"
	@echo "│  make bns_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(BNS_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

bns_check_dim:
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=3"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

bns_run: build/sph bns_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running BNS Cocoon Simulation"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(BNS_RESULTS)
	./build/sph bns_cocoon
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(BNS_RESULTS)/"

bns_clean:
	@echo "Cleaning bns cocoon simulation results..."
	@rm -rf $(BNS_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

bns_compare_all: bns_compare_run bns_compare_viz bns_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

bns_compare_run: build/sph bns_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  BNS Cocoon Simulation Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(BNS_RESULTS)/gsph
	@./build/sph bns_cocoon 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(BNS_RESULTS)/ssph
	@./build/sph bns_cocoon 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(BNS_RESULTS)/disph
	@./build/sph bns_cocoon 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(BNS_RESULTS)/gdisph
	@./build/sph bns_cocoon 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

bns_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(BNS_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(BNS_RESULTS)/comparison/"

bns_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(BNS_RESULTS)/animations
	@echo "✓ Animation step complete!"

bns_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(BNS_RESULTS)
	@echo "✓ Comparison results cleaned"
