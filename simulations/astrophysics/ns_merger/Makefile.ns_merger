# ============================================================================
# NS MERGER SIMULATION MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Simulate neutron star merger dynamics.
#
# USAGE:
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_run
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_compare_all
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_clean
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/astrophysics/ns_merger/results/
#
# ============================================================================

# Paths
NS_MERGER_DIR := simulations/astrophysics/ns_merger
NS_MERGER_CONFIG := $(NS_MERGER_DIR)/config
PRESET_DIR := $(NS_MERGER_CONFIG)/presets
NS_MERGER_RESULTS := $(NS_MERGER_DIR)/results
NS_MERGER_SCRIPTS := $(NS_MERGER_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: ns_merger_help ns_merger_check_dim ns_merger_run \
        ns_merger_clean ns_merger_compare_all ns_merger_compare_run \
        ns_merger_compare_viz ns_merger_compare_animate ns_merger_compare_clean

# ============================================================================
# HELP
# ============================================================================

ns_merger_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  NS MERGER SIMULATION - Neutron Star Merger"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Simulate neutron star merger dynamics."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make ns_merger_run              # Run default simulation                │"
	@echo "│  make ns_merger_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make ns_merger_compare_run      # Run all SPH methods                   │"
	@echo "│  make ns_merger_compare_viz      # Generate comparison plots             │"
	@echo "│  make ns_merger_compare_all      # Run all + visualizations              │"
	@echo "│  make ns_merger_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(NS_MERGER_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

ns_merger_check_dim:
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=3"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

ns_merger_run: build/sph ns_merger_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running NS Merger Simulation"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(NS_MERGER_RESULTS)
	./build/sph ns_merger
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(NS_MERGER_RESULTS)/"

ns_merger_clean:
	@echo "Cleaning ns merger simulation results..."
	@rm -rf $(NS_MERGER_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

ns_merger_compare_all: ns_merger_compare_run ns_merger_compare_viz ns_merger_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

ns_merger_compare_run: build/sph ns_merger_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  NS Merger Simulation Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(NS_MERGER_RESULTS)/gsph
	@./build/sph ns_merger 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(NS_MERGER_RESULTS)/ssph
	@./build/sph ns_merger 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(NS_MERGER_RESULTS)/disph
	@./build/sph ns_merger 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(NS_MERGER_RESULTS)/gdisph
	@./build/sph ns_merger 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

ns_merger_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(NS_MERGER_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(NS_MERGER_RESULTS)/comparison/"

ns_merger_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(NS_MERGER_RESULTS)/animations
	@echo "✓ Animation step complete!"

ns_merger_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(NS_MERGER_RESULTS)
	@echo "✓ Comparison results cleaned"
