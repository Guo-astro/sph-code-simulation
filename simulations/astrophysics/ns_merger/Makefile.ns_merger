# ================================================================================
# Makefile for 2D Neutron Star Merger (Shibata & Hotokezaka 2019)
# ================================================================================
#
# This Makefile provides targets for running 2D neutron star collision simulations
# and generating visualizations/animations.
#
# USAGE EXAMPLES:
# ================================================================================
#
# Quick Test (fast, low resolution):
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_quick
#
# Full Simulation (high resolution, longer):
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_run
#
# Create Animation:
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_animate
#
# Full Workflow (simulate + animate):
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_all
#
# Clean Results:
#   make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_clean
#
# ================================================================================

# Path configuration
TEST_DIR      := simulations/astrophysics/ns_merger
CONFIG_DIR    := $(TEST_DIR)/config/presets
SCRIPTS_DIR   := $(TEST_DIR)/scripts
RESULTS_DIR   := $(TEST_DIR)/results
BUILD_DIR     := build

# Config files
CONFIG_QUICK  := $(CONFIG_DIR)/ns_merger_quick_test.json
CONFIG_FULL   := $(CONFIG_DIR)/ns_merger_2d.json

# Results directories
RESULTS_QUICK := $(RESULTS_DIR)/test_quick
RESULTS_FULL  := $(RESULTS_DIR)/ns_merger_2d

# Visualization script
VIZ_SCRIPT    := $(SCRIPTS_DIR)/ns_merger_visualize.py

# ================================================================================
.PHONY: ns_merger_help ns_merger_quick ns_merger_run ns_merger_animate \
        ns_merger_animate_full ns_merger_grid ns_merger_evolution \
        ns_merger_all ns_merger_clean ns_merger_clean_full

# ================================================================================
# Help Target
# ================================================================================

ns_merger_help:
	@echo "========================================"
	@echo "2D Neutron Star Merger - Available Targets"
	@echo "========================================"
	@echo ""
	@echo "SIMULATION TARGETS:"
	@echo "  ns_merger_quick    - Run quick test (~1300 particles, 5 time units)"
	@echo "  ns_merger_run      - Run full simulation (~5400 particles, 50 time units)"
	@echo ""
	@echo "VISUALIZATION TARGETS:"
	@echo "  ns_merger_plot     - Plot final snapshot (quick test)"
	@echo "  ns_merger_animate  - Create animation GIF (quick test)"
	@echo "  ns_merger_grid     - Create evolution grid (quick test)"
	@echo "  ns_merger_evolution - Plot density evolution (quick test)"
	@echo "  ns_merger_animate_full - Create animation GIF (full simulation)"
	@echo ""
	@echo "WORKFLOW TARGETS:"
	@echo "  ns_merger_all      - Run quick test + create animation"
	@echo "  ns_merger_full_all - Run full simulation + create animation"
	@echo ""
	@echo "CLEANUP TARGETS:"
	@echo "  ns_merger_clean    - Remove quick test results"
	@echo "  ns_merger_clean_full - Remove full simulation results"
	@echo "  ns_merger_clean_all - Remove all results"
	@echo ""
	@echo "EXAMPLE:"
	@echo "  make -f simulations/astrophysics/ns_merger/Makefile.ns_merger ns_merger_all"
	@echo ""

# ================================================================================
# Simulation Targets
# ================================================================================

ns_merger_quick: $(BUILD_DIR)/sph
	@echo "========================================"
	@echo "📡 Running NS Merger Quick Test"
	@echo "========================================"
	@echo "Config: $(CONFIG_QUICK)"
	@rm -rf $(RESULTS_QUICK)
	@mkdir -p $(RESULTS_QUICK)
	./$(BUILD_DIR)/sph $(CONFIG_QUICK)
	@echo "✓ Quick test complete!"
	@echo "Results: $(RESULTS_QUICK)/"

ns_merger_run: $(BUILD_DIR)/sph
	@echo "========================================"
	@echo "📡 Running NS Merger Full Simulation"
	@echo "========================================"
	@echo "Config: $(CONFIG_FULL)"
	@rm -rf $(RESULTS_FULL)
	@mkdir -p $(RESULTS_FULL)
	./$(BUILD_DIR)/sph $(CONFIG_FULL)
	@echo "✓ Full simulation complete!"
	@echo "Results: $(RESULTS_FULL)/"

# ================================================================================
# Visualization Targets (Quick Test)
# ================================================================================

ns_merger_plot:
	@if [ ! -d "$(RESULTS_QUICK)" ]; then \
		echo "❌ Error: No results found at $(RESULTS_QUICK)"; \
		echo "   Run 'make ns_merger_quick' first"; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "📊 Plotting Final Snapshot"
	@echo "========================================"
	python3 $(VIZ_SCRIPT) --results-dir $(RESULTS_QUICK) --plot --no-show \
		--output $(RESULTS_QUICK)/ns_merger_final.png
	@echo "✓ Plot saved: $(RESULTS_QUICK)/ns_merger_final.png"

ns_merger_animate:
	@if [ ! -d "$(RESULTS_QUICK)" ]; then \
		echo "❌ Error: No results found at $(RESULTS_QUICK)"; \
		echo "   Run 'make ns_merger_quick' first"; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "🎬 Creating Animation (Quick Test)"
	@echo "========================================"
	python3 $(VIZ_SCRIPT) --results-dir $(RESULTS_QUICK) --animate \
		--output $(RESULTS_QUICK)/ns_merger.gif
	@echo "✓ Animation saved: $(RESULTS_QUICK)/ns_merger.gif"

ns_merger_grid:
	@if [ ! -d "$(RESULTS_QUICK)" ]; then \
		echo "❌ Error: No results found at $(RESULTS_QUICK)"; \
		echo "   Run 'make ns_merger_quick' first"; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "📊 Creating Evolution Grid"
	@echo "========================================"
	python3 $(VIZ_SCRIPT) --results-dir $(RESULTS_QUICK) --grid --no-show \
		--output $(RESULTS_QUICK)/ns_merger_grid.png
	@echo "✓ Grid saved: $(RESULTS_QUICK)/ns_merger_grid.png"

ns_merger_evolution:
	@if [ ! -d "$(RESULTS_QUICK)" ]; then \
		echo "❌ Error: No results found at $(RESULTS_QUICK)"; \
		echo "   Run 'make ns_merger_quick' first"; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "📊 Creating Density Evolution Plot"
	@echo "========================================"
	python3 $(VIZ_SCRIPT) --results-dir $(RESULTS_QUICK) --evolution --no-show \
		--output $(RESULTS_QUICK)/ns_merger_evolution.png
	@echo "✓ Evolution plot saved: $(RESULTS_QUICK)/ns_merger_evolution.png"

# ================================================================================
# Visualization Targets (Full Simulation)
# ================================================================================

ns_merger_animate_full:
	@if [ ! -d "$(RESULTS_FULL)" ]; then \
		echo "❌ Error: No results found at $(RESULTS_FULL)"; \
		echo "   Run 'make ns_merger_run' first"; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "🎬 Creating Animation (Full Simulation)"
	@echo "========================================"
	python3 $(VIZ_SCRIPT) --results-dir $(RESULTS_FULL) --animate \
		--output $(RESULTS_FULL)/ns_merger.gif
	@echo "✓ Animation saved: $(RESULTS_FULL)/ns_merger.gif"

# ================================================================================
# Workflow Targets
# ================================================================================

ns_merger_all: ns_merger_quick ns_merger_animate ns_merger_grid
	@echo "========================================"
	@echo "✓ Complete Quick Workflow Done!"
	@echo "========================================"
	@echo "Results:"
	@echo "  📁 $(RESULTS_QUICK)/"
	@echo "  🎬 $(RESULTS_QUICK)/ns_merger.gif"
	@echo "  📊 $(RESULTS_QUICK)/ns_merger_grid.png"

ns_merger_full_all: ns_merger_run ns_merger_animate_full
	@echo "========================================"
	@echo "✓ Complete Full Workflow Done!"
	@echo "========================================"
	@echo "Results:"
	@echo "  📁 $(RESULTS_FULL)/"
	@echo "  🎬 $(RESULTS_FULL)/ns_merger.gif"

# ================================================================================
# Cleanup Targets
# ================================================================================

ns_merger_clean:
	@echo "🧹 Cleaning quick test results..."
	rm -rf $(RESULTS_QUICK)
	@echo "✓ Done"

ns_merger_clean_full:
	@echo "🧹 Cleaning full simulation results..."
	rm -rf $(RESULTS_FULL)
	@echo "✓ Done"

ns_merger_clean_all:
	@echo "🧹 Cleaning all NS merger results..."
	rm -rf $(RESULTS_DIR)/*
	@echo "✓ Done"
