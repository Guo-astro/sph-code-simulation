# ============================================================================
# ISM COOLING/HEATING TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test ISM cooling and heating based on Koyama & Inutsuka (2000).
#
# USAGE:
#   make -f simulations/astrophysics/cooling_heating/Makefile.cooling_heating cooling_run
#   make -f simulations/astrophysics/cooling_heating/Makefile.cooling_heating cooling_compare_all
#   make -f simulations/astrophysics/cooling_heating/Makefile.cooling_heating cooling_clean
#   make -f simulations/astrophysics/cooling_heating/Makefile.cooling_heating cooling_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/astrophysics/cooling_heating/results/
#
# ============================================================================

# Paths
COOLING_DIR := simulations/astrophysics/cooling_heating
COOLING_CONFIG := $(COOLING_DIR)/config
PRESET_DIR := $(COOLING_CONFIG)/presets
COOLING_RESULTS := $(COOLING_DIR)/results
COOLING_SCRIPTS := $(COOLING_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: cooling_help cooling_check_dim cooling_run \
        cooling_clean cooling_compare_all cooling_compare_run \
        cooling_compare_viz cooling_compare_animate cooling_compare_clean

# ============================================================================
# HELP
# ============================================================================

cooling_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  ISM COOLING/HEATING TEST - Koyama-Inutsuka Cooling"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Test ISM cooling and heating based on Koyama & Inutsuka (2000)."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make cooling_run              # Run default simulation                │"
	@echo "│  make cooling_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make cooling_compare_run      # Run all SPH methods                   │"
	@echo "│  make cooling_compare_viz      # Generate comparison plots             │"
	@echo "│  make cooling_compare_all      # Run all + visualizations              │"
	@echo "│  make cooling_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(COOLING_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

cooling_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=1"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=1 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=1 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

cooling_run: build/sph cooling_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running ISM Cooling/Heating Test"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(COOLING_RESULTS)
	./build/sph ism_cooling_1d
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(COOLING_RESULTS)/"

cooling_clean:
	@echo "Cleaning ism cooling/heating test results..."
	@rm -rf $(COOLING_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

cooling_compare_all: cooling_compare_run cooling_compare_viz cooling_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

cooling_compare_run: build/sph cooling_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ISM Cooling/Heating Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(COOLING_RESULTS)/gsph
	@./build/sph ism_cooling_1d 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(COOLING_RESULTS)/ssph
	@./build/sph ism_cooling_1d 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(COOLING_RESULTS)/disph
	@./build/sph ism_cooling_1d 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(COOLING_RESULTS)/gdisph
	@./build/sph ism_cooling_1d 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

cooling_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(COOLING_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(COOLING_RESULTS)/comparison/"

cooling_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(COOLING_RESULTS)/animations
	@echo "✓ Animation step complete!"

cooling_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(COOLING_RESULTS)
	@echo "✓ Comparison results cleaned"
