# ============================================================================
# LANE-EMDEN 2D MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Multi-Method Benchmark System for Lane-Emden 2D polytrope simulations.
#   Tests 2D disk equilibrium structures.
#
# USAGE:
#   make -f simulations/astrophysics/lane_emden/Makefile.2d lane_emden_2d_run
#   make -f simulations/astrophysics/lane_emden/Makefile.2d lane_emden_2d_compare_all
#   make -f simulations/astrophysics/lane_emden/Makefile.2d lane_emden_2d_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/astrophysics/lane_emden/results/2d/
#
# ============================================================================

# Default preset
LANE_EMDEN_2D_PRESET ?= polytrope_n1_5_ssph

# Paths (using consolidated config directory)
LANE_EMDEN_2D_DIR := simulations/astrophysics/lane_emden
LANE_EMDEN_2D_PRESET_DIR := $(LANE_EMDEN_2D_DIR)/config/presets
LANE_EMDEN_2D_RESULTS_DIR := $(LANE_EMDEN_2D_DIR)/results/2d
SAMPLE_DIR := simulations/astrophysics/lane_emden

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: lane_emden_2d_help lane_emden_2d_run lane_emden_2d_clean \
        lane_emden_2d_compare_run lane_emden_2d_compare_viz \
        lane_emden_2d_compare_animate lane_emden_2d_compare_all lane_emden_2d_compare_clean

# ============================================================================
# HELP
# ============================================================================

lane_emden_2d_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  LANE-EMDEN 2D POLYTROPE - Multi-Method Benchmark"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Multi-Method Benchmark System for Lane-Emden 2D polytrope simulations."
	@echo "  Tests 2D disk equilibrium structures."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make lane_emden_2d_run                 Run default simulation         │"
	@echo "│  make lane_emden_2d_clean               Remove all results             │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make lane_emden_2d_compare_run         Run all SPH methods            │"
	@echo "│  make lane_emden_2d_compare_viz         Generate comparison plots      │"
	@echo "│  make lane_emden_2d_compare_animate     Generate comparison animation  │"
	@echo "│  make lane_emden_2d_compare_all         Run all + visualizations       │"
	@echo "│  make lane_emden_2d_compare_clean       Clean comparison results       │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Current preset: $(LANE_EMDEN_2D_PRESET)"
	@echo "  Results: $(LANE_EMDEN_2D_RESULTS_DIR)/"
	@echo ""
	@echo "  ⚠️  Note: Requires DIM=2 build"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

lane_emden_2d_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

lane_emden_2d_run: build/sph lane_emden_2d_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Lane-Emden 2D Test: $(LANE_EMDEN_2D_PRESET)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ⚠️  Note: 2D relaxation disabled (segfault issue)"
	@echo "  Using analytical initial conditions directly"
	@echo ""
	@echo "  Applying preset configuration..."
	@python3 -c "import json; \
	preset = json.load(open('$(LANE_EMDEN_2D_PRESET_DIR)/$(LANE_EMDEN_2D_PRESET).json')); \
	config = { \
	'outputDirectory': preset['simulation']['output_directory'], \
	'startTime': 0.0, \
	'endTime': preset['simulation']['end_time'], \
	'outputTime': preset['simulation']['output_time'], \
	'energyTime': preset['simulation']['output_time'], \
	'checkpoint': preset['checkpoint'], \
	'output': preset.get('output', {'formats': [{'type': 'csv', 'precision': 16}], 'enableEnergyFile': True}), \
	'avAlpha': preset['artificial_viscosity']['alpha'], \
	'useBalsaraSwitch': preset['artificial_viscosity']['use_balsara_switch'], \
	'useTimeDependentAV': preset['artificial_viscosity']['use_time_dependent_av'], \
	'neighborNumber': preset['numerical']['neighbor_number'], \
	'leafParticleNumber': preset['numerical']['leaf_particle_number'], \
	'gamma': preset['physics']['adiabatic_index'], \
	'kernel': preset['numerical']['kernel'], \
	'N': preset['initial_conditions']['shells'], \
	'periodic': preset['numerical']['periodic'], \
	'useGravity': preset['numerical']['use_gravity'], \
	'G': preset['physics']['gravitational_constant'], \
	'SPHType': preset['numerical']['sph_type'], \
	'iterativeSmoothingLength': preset['numerical']['iterative_smoothing_length'], \
	'useRelaxation': False, \
	'relaxationSteps': 0, \
	'relaxationOutputFreq': 1000, \
	'relaxationOnly': False \
	}; \
	json.dump(config, open('$(SAMPLE_DIR)/lane_emden.json', 'w'), indent=2)"
	@echo "  Output directory:"
	@grep -o '"outputDirectory"[[:space:]]*:[[:space:]]*"[^"]*"' $(SAMPLE_DIR)/lane_emden.json | sed 's/.*: *"\(.*\)"/    📁 \1/'
	@echo "  Creating results directory..."
	@mkdir -p $(LANE_EMDEN_2D_RESULTS_DIR)
	@echo ""
	@echo "────────────────────────────────────────────────────────────────────────────"
	@echo "  Running simulation..."
	@echo "────────────────────────────────────────────────────────────────────────────"
	./build/sph lane_emden
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ Simulation complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  📁 Results: $(LANE_EMDEN_2D_RESULTS_DIR)/"

lane_emden_2d_clean:
	@echo "Cleaning Lane-Emden 2D results..."
	@rm -rf $(LANE_EMDEN_2D_RESULTS_DIR)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

lane_emden_2d_compare_all: lane_emden_2d_compare_run lane_emden_2d_compare_viz lane_emden_2d_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════════════════"

lane_emden_2d_compare_run: build/sph lane_emden_2d_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Lane-Emden 2D Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: SSPH, GSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────────────────"
	@echo "  [1/4] Running SSPH simulation..."
	@echo "────────────────────────────────────────────────────────────────────────────"
	@mkdir -p $(LANE_EMDEN_2D_RESULTS_DIR)/ssph
	@echo "  ✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────────────────"
	@echo "  [2/4] Running GSPH simulation..."
	@echo "────────────────────────────────────────────────────────────────────────────"
	@mkdir -p $(LANE_EMDEN_2D_RESULTS_DIR)/gsph
	@echo "  ✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────────────────"
	@echo "  [3/4] Running DISPH simulation..."
	@echo "────────────────────────────────────────────────────────────────────────────"
	@mkdir -p $(LANE_EMDEN_2D_RESULTS_DIR)/disph
	@echo "  ✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────────────────"
	@echo "  [4/4] Running GDISPH simulation..."
	@echo "────────────────────────────────────────────────────────────────────────────"
	@mkdir -p $(LANE_EMDEN_2D_RESULTS_DIR)/gdisph
	@echo "  ✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

lane_emden_2d_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@mkdir -p $(LANE_EMDEN_2D_RESULTS_DIR)/comparison
	@echo "  ✓ Comparison plots generated!"
	@echo "  📊 Output: $(LANE_EMDEN_2D_RESULTS_DIR)/comparison/"

lane_emden_2d_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@mkdir -p $(LANE_EMDEN_2D_RESULTS_DIR)/animations
	@echo "  ✓ Animation complete!"

lane_emden_2d_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(LANE_EMDEN_2D_RESULTS_DIR)
	@echo "✓ Comparison results cleaned"
