# ============================================================================
# SR-GSPH SOD TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test special relativistic SPH with Sod shock tube (Kitajima et al. 2025).
#
# USAGE:
#   make -f simulations/relativistic/sr_sod/Makefile.sr_sod sr_sod_run
#   make -f simulations/relativistic/sr_sod/Makefile.sr_sod sr_sod_compare_all
#   make -f simulations/relativistic/sr_sod/Makefile.sr_sod sr_sod_clean
#   make -f simulations/relativistic/sr_sod/Makefile.sr_sod sr_sod_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/relativistic/sr_sod/results/
#
# ============================================================================

# Paths
SR_SOD_DIR := simulations/relativistic/sr_sod
SR_SOD_CONFIG := $(SR_SOD_DIR)/config
PRESET_DIR := $(SR_SOD_CONFIG)/presets
SR_SOD_RESULTS := $(SR_SOD_DIR)/results
SR_SOD_SCRIPTS := $(SR_SOD_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: sr_sod_help sr_sod_check_dim sr_sod_run \
        sr_sod_clean sr_sod_compare_all sr_sod_compare_run \
        sr_sod_compare_viz sr_sod_compare_animate sr_sod_compare_clean

# ============================================================================
# HELP
# ============================================================================

sr_sod_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  SR-GSPH SOD TEST - Special Relativistic Shock Tube"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Test special relativistic SPH with Sod shock tube (Kitajima et al. 2025)."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make sr_sod_run              # Run default simulation                │"
	@echo "│  make sr_sod_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make sr_sod_compare_run      # Run all SPH methods                   │"
	@echo "│  make sr_sod_compare_viz      # Generate comparison plots             │"
	@echo "│  make sr_sod_compare_all      # Run all + visualizations              │"
	@echo "│  make sr_sod_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(SR_SOD_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

sr_sod_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=1"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=1 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=1 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

sr_sod_run: build/sph sr_sod_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running SR-GSPH Sod Test"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SR_SOD_RESULTS)
	./build/sph sr_sod
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(SR_SOD_RESULTS)/"

sr_sod_clean:
	@echo "Cleaning sr-gsph sod test results..."
	@rm -rf $(SR_SOD_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

sr_sod_compare_all: sr_sod_compare_run sr_sod_compare_viz sr_sod_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

sr_sod_compare_run: build/sph sr_sod_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  SR-GSPH Sod Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(SR_SOD_RESULTS)/gsph
	@./build/sph sr_sod 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(SR_SOD_RESULTS)/ssph
	@./build/sph sr_sod 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(SR_SOD_RESULTS)/disph
	@./build/sph sr_sod 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(SR_SOD_RESULTS)/gdisph
	@./build/sph sr_sod 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

sr_sod_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SR_SOD_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(SR_SOD_RESULTS)/comparison/"

sr_sod_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SR_SOD_RESULTS)/animations
	@echo "✓ Animation step complete!"

sr_sod_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(SR_SOD_RESULTS)
	@echo "✓ Comparison results cleaned"
