{
  "_comment": "SR-GSPH Test: Sinusoidally Perturbed Shock Tube",
  "_description": "Liptai & Price (2019) MNRAS 485, 819 - Figure 13",
  "_reference": "Del Zanna & Bucciantini (2002), Rosswog (2010)",
  "_initial_left": "(n, P) = (10, 40/3)",
  "_initial_right": "(n, P) = (2 + 0.3*sin(50x), 5)",
  "_test": "Sine wave should advect through shock without loss of accuracy",
  "sample": "sr_sod",
  "testType": "sinewave_shock",
  "outputDirectory": "simulations/relativistic/sr_sod/results/sinewave_shock",
  "startTime": 0.0,
  "endTime": 0.35,
  "outputTime": 0.007,
  "energyTime": 0.01,
  "checkpoint": {
    "enabled": false,
    "resumeFile": ""
  },
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  },
  "SPHType": "srgsph",
  "use2ndOrderSRGSPH": true,
  "riemannSolver": "exact",
  "cSpeed": 1.0,
  "cShock": 3.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  "gamma": 1.666666667,
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  "N": 3000,
  "useGhostParticles": true,
  "ghostLayers": 6,
  "periodic": false,
  "rangeMax": [0.5],
  "rangeMin": [-0.5],
  "avAlpha": 0.0,
  "useBalsaraSwitch": false,
  "cflSound": 0.3,
  "cflForce": 0.25
}
