{
  "_comment": "SR-GSPH Test: Rosswog Test 1 (Standard Relativistic Shock Tube)",
  "_description": "For comparison with GR-GSPH Minkowski test",
  "_reference": "Rosswog (2010) Table 1, Kitajima et al. (2025)",
  "_initial_left": "(n, v, P) = (10, 0, 40/3)",
  "_initial_right": "(n, v, P) = (1, 0, 1e-6)",
  "sample": "sr_sod",
  "testType": "rosswog_test1",
  "outputDirectory": "simulations/relativistic/sr_sod/results/rosswog_test1",
  "startTime": 0.0,
  "endTime": 0.35,
  "outputTime": 0.007,
  "energyTime": 0.01,
  "checkpoint": {
    "enabled": false,
    "resumeFile": ""
  },
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  },
  "SPHType": "srgsph",
  "use2ndOrderSRGSPH": true,
  "riemannSolver": "exact",
  "cSpeed": 1.0,
  "cShock": 3.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  "gamma": 1.666666667,
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  "N": 1500,
  "useGhostParticles": true,
  "ghostLayers": 6,
  "periodic": false,
  "rangeMax": [0.5],
  "rangeMin": [-0.5],
  "avAlpha": 0.0,
  "useBalsaraSwitch": false,
  "cflSound": 0.3,
  "cflForce": 0.25
}
