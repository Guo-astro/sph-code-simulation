{
  "_comment": "Rosswog (2010) Test 4: Ultra-Relativistic Wall Shock",
  "_reference": "arXiv:0907.4890v3, Section 3.1.4, Fig. 9",
  "_initial": "(N, v, u) = (1, 0.9999999998, 10^-5)",
  "_lorentz_factor": "50,000 (EXTREME relativistic)",
  "_post_shock": "N_p = 4*N_i, P_p = γ*Γ*N_i, u_p = γ",
  "_note": "Wall at x=1 with reflecting ghost particles",
  "sample": "sr_wall_shock",
  "testType": "wall_shock",
  "outputDirectory": "simulations/relativistic/sr_rosswog/results/test4_wall_shock",
  "startTime": 0.0,
  "endTime": 1.0,
  "outputTime": 0.02,
  "energyTime": 0.02,
  "checkpoint": {
    "enabled": false,
    "resumeFile": ""
  },
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  },
  "SPHType": "srgsph",
  "use2ndOrderSRGSPH": true,
  "riemannSolver": "exact",
  "cSpeed": 1.0,
  "cShock": 3.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  "gamma": 1.333333333,
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  "N": 500,
  "N_init": 1.0,
  "v_init": 0.9999999998,
  "u_init": 1e-5,
  "wall_position": 1.0,
  "useGhostParticles": true,
  "ghostLayers": 10,
  "periodic": false,
  "rangeMax": [1.0],
  "rangeMin": [0.0],
  "avAlpha": 0.0,
  "useBalsaraSwitch": false,
  "cflSound": 0.2,
  "cflForce": 0.15
}
