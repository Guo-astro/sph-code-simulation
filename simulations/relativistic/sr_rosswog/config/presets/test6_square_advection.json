{
  "_comment": "Rosswog (2010) Test 6: Relativistic Square Wave Advection",
  "_reference": "arXiv:0907.4890v3, Section 3.1.6, Fig. 11",
  "_initial": "N = N_low + (N_high - N_low)*Fermi_step, v = 0.997",
  "_N_low": "1.0",
  "_N_high": "1.1",
