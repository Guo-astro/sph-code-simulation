{
  "_comment": "GR-GSPH Schwarzschild Radial Shock Tube",
  "_description": "Tests gravitational source terms in curved spacetime (Liptai & Price 2019)",
  "_reference": "Liptai & Price (2019) MNRAS 485, 819",
  "_physics": "Rosswog Test 1 initial conditions in Schwarzschild spacetime",
  "sample": "gr_schwarzschild_shock",
