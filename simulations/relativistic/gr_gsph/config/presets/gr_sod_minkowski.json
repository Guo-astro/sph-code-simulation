{
  "_comment": "GR-GSPH Test: Shock Tube in Minkowski (Flat) Spacetime",
  "_description": "This test verifies that GR-GSPH reduces to SR-GSPH in flat spacetime",
  "_reference": "Kitajima et al. (2025), Liptai & Price (2019)",
  "sample": "sr_sod",
  "testType": "rosswog_test1",
  "outputDirectory": "simulations/relativistic/gr_gsph/results/minkowski_shock_tube",
  "startTime": 0.0,
  "endTime": 0.35,
  "outputTime": 0.007,
  "energyTime": 0.01,
  "checkpoint": {
    "enabled": false,
    "resumeFile": ""
  },
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  },
  "SPHType": "grgsph",
  "use2ndOrderSRGSPH": true,
  "riemannSolver": "exact",
  "cSpeed": 1.0,
  "cShock": 3.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  "gamma": 1.666666667,
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  "N": 1500,
  "useGhostParticles": true,
  "ghostLayers": 6,
  "periodic": false,
  "rangeMax": [0.5],
  "rangeMin": [-0.5],
  "avAlpha": 0.0,
  "useBalsaraSwitch": false,
  "cflSound": 0.3,
  "cflForce": 0.25
}
