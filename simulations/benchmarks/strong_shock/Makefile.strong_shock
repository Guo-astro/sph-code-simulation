# ============================================================================
# 1D STRONG SHOCK TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test SPH handling of strong shocks with high pressure ratios (P_ratio=10000).
#
# USAGE:
#   make -f simulations/benchmarks/strong_shock/Makefile.strong_shock strong_shock_run
#   make -f simulations/benchmarks/strong_shock/Makefile.strong_shock strong_shock_compare_all
#   make -f simulations/benchmarks/strong_shock/Makefile.strong_shock strong_shock_clean
#   make -f simulations/benchmarks/strong_shock/Makefile.strong_shock strong_shock_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/benchmarks/strong_shock/results/<method>/
#
# ============================================================================

# Paths
STRONG_SHOCK_DIR := simulations/benchmarks/strong_shock
STRONG_SHOCK_CONFIG := $(STRONG_SHOCK_DIR)/config
PRESET_DIR := $(STRONG_SHOCK_CONFIG)/presets
STRONG_SHOCK_RESULTS := $(STRONG_SHOCK_DIR)/results
STRONG_SHOCK_SCRIPTS := $(STRONG_SHOCK_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: strong_shock_help strong_shock_check_dim strong_shock_run \
        strong_shock_clean strong_shock_compare_all strong_shock_compare_run \
        strong_shock_compare_viz strong_shock_compare_animate strong_shock_compare_clean

# ============================================================================
# HELP
# ============================================================================

strong_shock_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  1D STRONG SHOCK TEST - High Pressure Ratio Shock"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Strong shock test with extreme pressure jump."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make strong_shock_run  # Run default simulation                    │"
	@echo "│  make strong_shock_clean# Remove all results                       │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make strong_shock_compare_run# Run all SPH methods                      │"
	@echo "│  make strong_shock_compare_viz# Generate comparison plots                │"
	@echo "│  make strong_shock_compare_all# Run all + visualizations                 │"
	@echo "│  make strong_shock_compare_clean# Clean comparison results                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(STRONG_SHOCK_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

strong_shock_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=1"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=1 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=1 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

strong_shock_run: build/sph strong_shock_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running 1D Strong Shock Test - Default Configuration"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(STRONG_SHOCK_RESULTS)
	./build/sph strong_shock
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(STRONG_SHOCK_RESULTS)/"

strong_shock_clean:
	@echo "Cleaning 1d strong shock test results..."
	@rm -rf $(STRONG_SHOCK_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

strong_shock_compare_all: strong_shock_compare_run strong_shock_compare_viz strong_shock_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

strong_shock_compare_run: build/sph strong_shock_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  1D Strong Shock Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/strong_shock_gsph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph_wendland.json $(STRONG_SHOCK_DIR)/strong_shock.json
	@mkdir -p $(STRONG_SHOCK_RESULTS)/gsph
	@./build/sph strong_shock
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/strong_shock_ssph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph_wendland.json $(STRONG_SHOCK_DIR)/strong_shock.json
	@mkdir -p $(STRONG_SHOCK_RESULTS)/ssph
	@./build/sph strong_shock
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/strong_shock_disph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph_wendland.json $(STRONG_SHOCK_DIR)/strong_shock.json
	@mkdir -p $(STRONG_SHOCK_RESULTS)/disph
	@./build/sph strong_shock
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/strong_shock_gdisph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph.json $(STRONG_SHOCK_DIR)/strong_shock.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph_wendland.json $(STRONG_SHOCK_DIR)/strong_shock.json
	@mkdir -p $(STRONG_SHOCK_RESULTS)/gdisph
	@./build/sph strong_shock
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

strong_shock_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(STRONG_SHOCK_RESULTS)/comparison
	@for method in gsph ssph disph gdisph; do \
	if [ -d "$(STRONG_SHOCK_RESULTS)/$$method" ]; then \
	echo "Processing $$method..."; \
	fi \
	done
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(STRONG_SHOCK_RESULTS)/comparison/"

strong_shock_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(STRONG_SHOCK_RESULTS)/animations
	@echo "✓ Animation step complete!"

strong_shock_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(STRONG_SHOCK_RESULTS)
	@echo "✓ Comparison results cleaned"
