# ============================================================================
# 2D SHOCK TUBE TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Validate SPH shock-capturing with the classic Sod shock tube problem in 2D.
#
# USAGE:
#   make -f simulations/benchmarks/shock_tube_2d/Makefile.shock_tube_2d shock_tube_2d_run
#   make -f simulations/benchmarks/shock_tube_2d/Makefile.shock_tube_2d shock_tube_2d_compare_all
#   make -f simulations/benchmarks/shock_tube_2d/Makefile.shock_tube_2d shock_tube_2d_clean
#   make -f simulations/benchmarks/shock_tube_2d/Makefile.shock_tube_2d shock_tube_2d_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/benchmarks/shock_tube_2d/results/<method>/
#
# ============================================================================

# Paths
SHOCK_TUBE_2D_DIR := simulations/benchmarks/shock_tube_2d
SHOCK_TUBE_2D_CONFIG := $(SHOCK_TUBE_2D_DIR)/config
PRESET_DIR := $(SHOCK_TUBE_2D_CONFIG)/presets
SHOCK_TUBE_2D_RESULTS := $(SHOCK_TUBE_2D_DIR)/results
SHOCK_TUBE_2D_SCRIPTS := $(SHOCK_TUBE_2D_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: shock_tube_2d_help shock_tube_2d_check_dim shock_tube_2d_run \
        shock_tube_2d_clean shock_tube_2d_compare_all shock_tube_2d_compare_run \
        shock_tube_2d_compare_viz shock_tube_2d_compare_animate shock_tube_2d_compare_clean

# ============================================================================
# HELP
# ============================================================================

shock_tube_2d_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  2D SHOCK TUBE TEST - Sod Problem in 2D"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Test shock tube in 2D configuration."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make shock_tube_2d_run # Run default simulation                    │"
	@echo "│  make shock_tube_2d_clean# Remove all results                       │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make shock_tube_2d_compare_run# Run all SPH methods                      │"
	@echo "│  make shock_tube_2d_compare_viz# Generate comparison plots                │"
	@echo "│  make shock_tube_2d_compare_all# Run all + visualizations                 │"
	@echo "│  make shock_tube_2d_compare_clean# Clean comparison results                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(SHOCK_TUBE_2D_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

shock_tube_2d_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

shock_tube_2d_run: build/sph shock_tube_2d_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running 2D Shock Tube Test - Default Configuration"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SHOCK_TUBE_2D_RESULTS)
	./build/sph shock_tube_2d
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(SHOCK_TUBE_2D_RESULTS)/"

shock_tube_2d_clean:
	@echo "Cleaning 2d shock tube test results..."
	@rm -rf $(SHOCK_TUBE_2D_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

shock_tube_2d_compare_all: shock_tube_2d_compare_run shock_tube_2d_compare_viz shock_tube_2d_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

shock_tube_2d_compare_run: build/sph shock_tube_2d_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  2D Shock Tube Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_2d_gsph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph_wendland.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json
	@mkdir -p $(SHOCK_TUBE_2D_RESULTS)/gsph
	@./build/sph shock_tube_2d
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_2d_ssph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph_wendland.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json
	@mkdir -p $(SHOCK_TUBE_2D_RESULTS)/ssph
	@./build/sph shock_tube_2d
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_2d_disph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph_wendland.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json
	@mkdir -p $(SHOCK_TUBE_2D_RESULTS)/disph
	@./build/sph shock_tube_2d
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_2d_gdisph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph_wendland.json $(SHOCK_TUBE_2D_DIR)/shock_tube_2d.json
	@mkdir -p $(SHOCK_TUBE_2D_RESULTS)/gdisph
	@./build/sph shock_tube_2d
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

shock_tube_2d_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SHOCK_TUBE_2D_RESULTS)/comparison
	@for method in gsph ssph disph gdisph; do \
	if [ -d "$(SHOCK_TUBE_2D_RESULTS)/$$method" ]; then \
	echo "Processing $$method..."; \
	fi \
	done
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(SHOCK_TUBE_2D_RESULTS)/comparison/"

shock_tube_2d_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SHOCK_TUBE_2D_RESULTS)/animations
	@echo "✓ Animation step complete!"

shock_tube_2d_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(SHOCK_TUBE_2D_RESULTS)
	@echo "✓ Comparison results cleaned"
