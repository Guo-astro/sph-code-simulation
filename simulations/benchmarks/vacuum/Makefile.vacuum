# ============================================================================
# 1D VACUUM TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test SPH handling of vacuum boundaries and low-density regions.
#   Compares numerical results against analytical solution for expansion
#   into vacuum (Riemann problem with one vacuum state).
#
# USAGE:
#   make -f simulations/benchmarks/vacuum/Makefile.vacuum vacuum_run
#   make -f simulations/benchmarks/vacuum/Makefile.vacuum vacuum_compare_all
#   make -f simulations/benchmarks/vacuum/Makefile.vacuum vacuum_clean
#   make -f simulations/benchmarks/vacuum/Makefile.vacuum vacuum_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#   balsara - GDISPH with Balsara switch
#
# NOTE:
#   This is a 1D test. Wendland C4 kernel does not support DIM=1.
#   Use Cubic Spline kernel only.
#
# OUTPUT:
#   Results: simulations/benchmarks/vacuum/results/<method>_cubic/
#
# ============================================================================

# Paths
VACUUM_DIR := simulations/benchmarks/vacuum
VACUUM_CONFIG := $(VACUUM_DIR)/config
VACUUM_PRESET_DIR := $(VACUUM_CONFIG)/presets
VACUUM_RESULTS := $(VACUUM_DIR)/results
VACUUM_SCRIPTS := $(VACUUM_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: vacuum_help vacuum_check_dim vacuum_run vacuum_plot vacuum_plot_all \
        vacuum_clean vacuum_all \
        vacuum_compare_all vacuum_compare_run vacuum_compare_viz \
        vacuum_compare_animate vacuum_compare_clean \
        vacuum_gsph_cubic vacuum_ssph_cubic vacuum_disph_cubic \
        vacuum_gdisph_cubic vacuum_balsara_cubic

# ============================================================================
# HELP
# ============================================================================

vacuum_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  1D VACUUM TEST - Vacuum Boundary Handling"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Test SPH handling of vacuum boundaries and low-density regions."
	@echo "  Uses Cubic Spline kernel (Wendland C4 does not support DIM=1)."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make vacuum_run             # Run default (GSPH + Cubic Spline)       │"
	@echo "│  make vacuum_plot_all        # Generate analytical overlay plots       │"
	@echo "│  make vacuum_clean           # Remove all results                      │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON (Cubic Spline kernel)                         │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make vacuum_compare_run     # Run all 5 SPH methods                   │"
	@echo "│  make vacuum_compare_viz     # Generate analytical comparison plots    │"
	@echo "│  make vacuum_compare_animate # Create animations                       │"
	@echo "│  make vacuum_compare_all     # Run all + visualizations + animations   │"
	@echo "│  make vacuum_compare_clean   # Clean comparison results                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "│  balsara  GDISPH with Balsara switch                                   │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Config files: $(VACUUM_PRESET_DIR)/vacuum_<method>_cubic.json"
	@echo "  Results:      $(VACUUM_RESULTS)/<method>_cubic/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

vacuum_check_dim:
	@CURRENT_DIM=$$(grep "^SPH_DIM:" build/CMakeCache.txt 2>/dev/null | cut -d= -f2 || echo "2"); \
	if [ "$$CURRENT_DIM" != "1" ]; then \
		echo "❌ ERROR: Vacuum test requires DIM=1"; \
		echo ""; \
		echo "   Current build: DIM=$$CURRENT_DIM"; \
		echo "   To fix: cd build && cmake -DSPH_DIM=1 .. && make -j8"; \
		exit 1; \
	fi
	@echo "✓ DIM=1 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

vacuum_run: vacuum_gsph_cubic

vacuum_gsph_cubic: build/sph vacuum_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running 1D Vacuum Test - GSPH (Cubic Spline)"
	@echo "════════════════════════════════════════════════════════════════"
	@cp $(VACUUM_PRESET_DIR)/vacuum_gsph_cubic.json $(VACUUM_DIR)/vacuum.json
	@mkdir -p $(VACUUM_RESULTS)/gsph_cubic
	./build/sph vacuum
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(VACUUM_RESULTS)/gsph_cubic/"

vacuum_plot_all:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Processing All Snapshots"
	@echo "════════════════════════════════════════════════════════════════"
	@if [ -d "$(VACUUM_RESULTS)/gsph_cubic" ]; then \
		python3 $(VACUUM_SCRIPTS)/process_all_snapshots.py $(VACUUM_RESULTS)/gsph_cubic; \
		echo "✓ All plots generated!"; \
		echo "  📊 Output: $(VACUUM_RESULTS)/gsph_cubic/plots/"; \
	else \
		echo "❌ Results directory not found. Run 'make vacuum_run' first."; \
		exit 1; \
	fi

vacuum_clean:
	@echo "Cleaning vacuum test results..."
	@rm -rf $(VACUUM_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# COMPLETE WORKFLOW
# ============================================================================

vacuum_all: vacuum_compare_all
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Vacuum Test Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

vacuum_compare_all: vacuum_compare_run vacuum_compare_viz vacuum_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

vacuum_compare_run: build/sph vacuum_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Vacuum Multi-Method Comparison (Cubic Spline)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH, GDISPH+Balsara"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/5] GSPH (Cubic Spline)"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(VACUUM_PRESET_DIR)/vacuum_gsph_cubic.json $(VACUUM_DIR)/vacuum.json
	@mkdir -p $(VACUUM_RESULTS)/gsph_cubic
	@./build/sph vacuum
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/5] SSPH (Cubic Spline)"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(VACUUM_PRESET_DIR)/vacuum_ssph_cubic.json $(VACUUM_DIR)/vacuum.json
	@mkdir -p $(VACUUM_RESULTS)/ssph_cubic
	@./build/sph vacuum
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/5] DISPH (Cubic Spline)"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(VACUUM_PRESET_DIR)/vacuum_disph_cubic.json $(VACUUM_DIR)/vacuum.json
	@mkdir -p $(VACUUM_RESULTS)/disph_cubic
	@./build/sph vacuum
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/5] GDISPH (Cubic Spline)"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(VACUUM_PRESET_DIR)/vacuum_gdisph_cubic.json $(VACUUM_DIR)/vacuum.json
	@mkdir -p $(VACUUM_RESULTS)/gdisph_cubic
	@./build/sph vacuum
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [5/5] GDISPH+Balsara (Cubic Spline)"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(VACUUM_PRESET_DIR)/vacuum_balsara_cubic.json $(VACUUM_DIR)/vacuum.json
	@mkdir -p $(VACUUM_RESULTS)/balsara_cubic
	@./build/sph vacuum
	@echo "✓ GDISPH+Balsara complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

vacuum_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Analytical Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@for method in gsph_cubic ssph_cubic disph_cubic gdisph_cubic balsara_cubic; do \
		if [ -d "$(VACUUM_RESULTS)/$$method" ]; then \
			echo "Processing $$method..."; \
			python3 $(VACUUM_SCRIPTS)/process_all_snapshots.py $(VACUUM_RESULTS)/$$method 2>/dev/null || true; \
		fi \
	done
	@echo ""
	@echo "✓ All analytical comparison plots generated!"
	@echo "  📊 Plots saved in: $(VACUUM_RESULTS)/*/plots/"

vacuum_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(VACUUM_RESULTS)/animations
	@if [ -d "$(VACUUM_RESULTS)/gsph_cubic" ]; then \
		echo "Creating animations..."; \
		python3 $(VACUUM_SCRIPTS)/generate_animations.py --results-dir $(VACUUM_RESULTS) --fps 5 2>/dev/null || \
		echo "⚠️  Animation script not available"; \
		echo "✓ Animation step complete!"; \
	else \
		echo "❌ No results found. Run 'make vacuum_compare_run' first."; \
		exit 1; \
	fi

vacuum_compare_clean:
	@echo "Cleaning vacuum comparison results..."
	@rm -rf $(VACUUM_RESULTS)
	@echo "✓ Comparison results cleaned"
