# ============================================================================
# 1D SHOCK TUBE TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Classic Sod shock tube problem for validating basic shock-capturing.
#
# USAGE:
#   make -f simulations/benchmarks/shock_tube/Makefile.shock_tube shock_tube_run
#   make -f simulations/benchmarks/shock_tube/Makefile.shock_tube shock_tube_compare_all
#   make -f simulations/benchmarks/shock_tube/Makefile.shock_tube shock_tube_clean
#   make -f simulations/benchmarks/shock_tube/Makefile.shock_tube shock_tube_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/benchmarks/shock_tube/results/<method>/
#
# ============================================================================

# Paths
SHOCK_TUBE_DIR := simulations/benchmarks/shock_tube
SHOCK_TUBE_CONFIG := $(SHOCK_TUBE_DIR)/config
PRESET_DIR := $(SHOCK_TUBE_CONFIG)/presets
SHOCK_TUBE_RESULTS := $(SHOCK_TUBE_DIR)/results
SHOCK_TUBE_SCRIPTS := $(SHOCK_TUBE_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: shock_tube_help shock_tube_check_dim shock_tube_run \
        shock_tube_clean shock_tube_compare_all shock_tube_compare_run \
        shock_tube_compare_viz shock_tube_compare_animate shock_tube_compare_clean

# ============================================================================
# HELP
# ============================================================================

shock_tube_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  1D SHOCK TUBE TEST - Sod Problem in 1D"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Standard Sod shock tube test in 1D."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make shock_tube_run    # Run default simulation                    │"
	@echo "│  make shock_tube_clean  # Remove all results                       │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make shock_tube_compare_run# Run all SPH methods                      │"
	@echo "│  make shock_tube_compare_viz# Generate comparison plots                │"
	@echo "│  make shock_tube_compare_all# Run all + visualizations                 │"
	@echo "│  make shock_tube_compare_clean# Clean comparison results                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(SHOCK_TUBE_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

shock_tube_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=1"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=1 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=1 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

shock_tube_run: build/sph shock_tube_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running 1D Shock Tube Test - Default Configuration"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SHOCK_TUBE_RESULTS)
	./build/sph shock_tube
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(SHOCK_TUBE_RESULTS)/"

shock_tube_clean:
	@echo "Cleaning 1d shock tube test results..."
	@rm -rf $(SHOCK_TUBE_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

shock_tube_compare_all: shock_tube_compare_run shock_tube_compare_viz shock_tube_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

shock_tube_compare_run: build/sph shock_tube_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  1D Shock Tube Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_1d_sod_gsph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph_wendland.json $(SHOCK_TUBE_DIR)/shock_tube.json
	@mkdir -p $(SHOCK_TUBE_RESULTS)/gsph
	@./build/sph shock_tube
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_1d_sod_ssph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph_wendland.json $(SHOCK_TUBE_DIR)/shock_tube.json
	@mkdir -p $(SHOCK_TUBE_RESULTS)/ssph
	@./build/sph shock_tube
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_1d_sod_disph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph_wendland.json $(SHOCK_TUBE_DIR)/shock_tube.json
	@mkdir -p $(SHOCK_TUBE_RESULTS)/disph
	@./build/sph shock_tube
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/shock_tube_1d_sod_gdisph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph.json $(SHOCK_TUBE_DIR)/shock_tube.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph_wendland.json $(SHOCK_TUBE_DIR)/shock_tube.json
	@mkdir -p $(SHOCK_TUBE_RESULTS)/gdisph
	@./build/sph shock_tube
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

shock_tube_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SHOCK_TUBE_RESULTS)/comparison
	@for method in gsph ssph disph gdisph; do \
	if [ -d "$(SHOCK_TUBE_RESULTS)/$$method" ]; then \
	echo "Processing $$method..."; \
	fi \
	done
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(SHOCK_TUBE_RESULTS)/comparison/"

shock_tube_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(SHOCK_TUBE_RESULTS)/animations
	@echo "✓ Animation step complete!"

shock_tube_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(SHOCK_TUBE_RESULTS)
	@echo "✓ Comparison results cleaned"
