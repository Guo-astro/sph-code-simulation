{
    "_comment": "PRESSURE-DRIVEN TEST: Long wavelength, strong amplitude, NO grad-h → may show instability",
    "name": "pressure_instability_nogradh",
    "sample": "sinusoidal_perturbation",
    
    "N": 500,
    "wavelength": 0.5,
    "amplitude": 0.3,
    "rho_mean": 1.0,
    "pressure": 1.0,
    
    "SPHType": "gsph",
    "gamma": 1.4,
    "kernel": "cubic_spline",
    
    "useGradH": false,
    
    "neighborNumber": 30,
    "iterativeSmoothingLength": true,
    
    "periodic": true,
    "rangeMin": [0.0],
    "rangeMax": [1.0],
    
    "avAlpha": 0.5,
    "useBalsaraSwitch": true,
    
    "use2ndOrderGSPH": true,
    "riemannSolver": "hll",
    
    "startTime": 0.0,
    "endTime": 5.0,
    "outputTime": 0.05,
    "energyTime": 0.01,
    
    "cflSound": 0.3,
    "cflForce": 0.125,
    
    "useGravity": false,
    
    "outputDirectory": "simulations/misc/sinusoidal/results/pressure_instability_nogradh",
    "output": {
        "formats": [{"type": "csv", "precision": 16}],
        "enableEnergyFile": true
    }
}
