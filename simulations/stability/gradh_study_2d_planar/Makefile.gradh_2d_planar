# ============================================================================
# GRAD-H STUDY 2D PLANAR MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Study grad-h corrections in 2D planar geometry.
#
# USAGE:
#   make -f simulations/stability/gradh_study_2d_planar/Makefile.gradh_2d_planar gradh_2d_run
#   make -f simulations/stability/gradh_study_2d_planar/Makefile.gradh_2d_planar gradh_2d_compare_all
#   make -f simulations/stability/gradh_study_2d_planar/Makefile.gradh_2d_planar gradh_2d_clean
#   make -f simulations/stability/gradh_study_2d_planar/Makefile.gradh_2d_planar gradh_2d_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/stability/gradh_study_2d_planar/results/
#
# ============================================================================

# Paths
GRADH_2D_DIR := simulations/stability/gradh_study_2d_planar
GRADH_2D_CONFIG := $(GRADH_2D_DIR)/config
PRESET_DIR := $(GRADH_2D_CONFIG)/presets
GRADH_2D_RESULTS := $(GRADH_2D_DIR)/results
GRADH_2D_SCRIPTS := $(GRADH_2D_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: gradh_2d_help gradh_2d_check_dim gradh_2d_run \
        gradh_2d_clean gradh_2d_compare_all gradh_2d_compare_run \
        gradh_2d_compare_viz gradh_2d_compare_animate gradh_2d_compare_clean

# ============================================================================
# HELP
# ============================================================================

gradh_2d_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  GRAD-H STUDY 2D PLANAR - Smoothing Length Gradient Test (2D Planar)"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Study grad-h corrections in 2D planar geometry."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make gradh_2d_run              # Run default simulation                │"
	@echo "│  make gradh_2d_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make gradh_2d_compare_run      # Run all SPH methods                   │"
	@echo "│  make gradh_2d_compare_viz      # Generate comparison plots             │"
	@echo "│  make gradh_2d_compare_all      # Run all + visualizations              │"
	@echo "│  make gradh_2d_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(GRADH_2D_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

gradh_2d_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

gradh_2d_run: build/sph gradh_2d_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running Grad-h Study 2D Planar"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRADH_2D_RESULTS)
	./build/sph gradh_2d_planar
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(GRADH_2D_RESULTS)/"

gradh_2d_clean:
	@echo "Cleaning grad-h study 2d planar results..."
	@rm -rf $(GRADH_2D_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

gradh_2d_compare_all: gradh_2d_compare_run gradh_2d_compare_viz gradh_2d_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

gradh_2d_compare_run: build/sph gradh_2d_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Grad-h Study 2D Planar Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_2D_RESULTS)/gsph
	@./build/sph gradh_2d_planar 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_2D_RESULTS)/ssph
	@./build/sph gradh_2d_planar 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_2D_RESULTS)/disph
	@./build/sph gradh_2d_planar 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_2D_RESULTS)/gdisph
	@./build/sph gradh_2d_planar 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

gradh_2d_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRADH_2D_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(GRADH_2D_RESULTS)/comparison/"

gradh_2d_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRADH_2D_RESULTS)/animations
	@echo "✓ Animation step complete!"

gradh_2d_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(GRADH_2D_RESULTS)
	@echo "✓ Comparison results cleaned"
