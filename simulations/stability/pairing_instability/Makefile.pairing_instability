# ============================================================================
# PAIRING INSTABILITY TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test for particle pairing instability in SPH simulations.
#
# USAGE:
#   make -f simulations/stability/pairing_instability/Makefile.pairing_instability pairing_run
#   make -f simulations/stability/pairing_instability/Makefile.pairing_instability pairing_compare_all
#   make -f simulations/stability/pairing_instability/Makefile.pairing_instability pairing_clean
#   make -f simulations/stability/pairing_instability/Makefile.pairing_instability pairing_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/stability/pairing_instability/results/
#
# ============================================================================

# Paths
PAIRING_DIR := simulations/stability/pairing_instability
PAIRING_CONFIG := $(PAIRING_DIR)/config
PRESET_DIR := $(PAIRING_CONFIG)/presets
PAIRING_RESULTS := $(PAIRING_DIR)/results
PAIRING_SCRIPTS := $(PAIRING_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: pairing_help pairing_check_dim pairing_run \
        pairing_clean pairing_compare_all pairing_compare_run \
        pairing_compare_viz pairing_compare_animate pairing_compare_clean

# ============================================================================
# HELP
# ============================================================================

pairing_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  PAIRING INSTABILITY TEST - Particle Pairing Detection"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Test for particle pairing instability in SPH simulations."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make pairing_run              # Run default simulation                │"
	@echo "│  make pairing_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make pairing_compare_run      # Run all SPH methods                   │"
	@echo "│  make pairing_compare_viz      # Generate comparison plots             │"
	@echo "│  make pairing_compare_all      # Run all + visualizations              │"
	@echo "│  make pairing_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(PAIRING_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

pairing_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

pairing_run: build/sph pairing_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running Pairing Instability Test"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(PAIRING_RESULTS)
	./build/sph pairing_instability
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(PAIRING_RESULTS)/"

pairing_clean:
	@echo "Cleaning pairing instability test results..."
	@rm -rf $(PAIRING_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

pairing_compare_all: pairing_compare_run pairing_compare_viz pairing_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

pairing_compare_run: build/sph pairing_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Pairing Instability Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(PAIRING_RESULTS)/gsph
	@./build/sph pairing_instability 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(PAIRING_RESULTS)/ssph
	@./build/sph pairing_instability 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(PAIRING_RESULTS)/disph
	@./build/sph pairing_instability 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(PAIRING_RESULTS)/gdisph
	@./build/sph pairing_instability 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

pairing_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(PAIRING_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(PAIRING_RESULTS)/comparison/"

pairing_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(PAIRING_RESULTS)/animations
	@echo "✓ Animation step complete!"

pairing_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(PAIRING_RESULTS)
	@echo "✓ Comparison results cleaned"
