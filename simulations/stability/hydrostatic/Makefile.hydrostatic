# ============================================================================
# HYDROSTATIC EQUILIBRIUM MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test hydrostatic equilibrium maintenance in pressure-supported systems.
#
# USAGE:
#   make -f simulations/stability/hydrostatic/Makefile.hydrostatic hydrostatic_run
#   make -f simulations/stability/hydrostatic/Makefile.hydrostatic hydrostatic_compare_all
#   make -f simulations/stability/hydrostatic/Makefile.hydrostatic hydrostatic_clean
#   make -f simulations/stability/hydrostatic/Makefile.hydrostatic hydrostatic_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/stability/hydrostatic/results/<method>/
#
# ============================================================================

# Paths
HYDROSTATIC_DIR := simulations/stability/hydrostatic
HYDROSTATIC_CONFIG := $(HYDROSTATIC_DIR)/config
PRESET_DIR := $(HYDROSTATIC_CONFIG)/presets
HYDROSTATIC_RESULTS := $(HYDROSTATIC_DIR)/results
HYDROSTATIC_SCRIPTS := $(HYDROSTATIC_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: hydrostatic_help hydrostatic_check_dim hydrostatic_run \
        hydrostatic_clean hydrostatic_compare_all hydrostatic_compare_run \
        hydrostatic_compare_viz hydrostatic_compare_animate hydrostatic_compare_clean

# ============================================================================
# HELP
# ============================================================================

hydrostatic_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  HYDROSTATIC EQUILIBRIUM - Pressure Balance Test"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Hydrostatic equilibrium stability test."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make hydrostatic_run   # Run default simulation                    │"
	@echo "│  make hydrostatic_clean # Remove all results                       │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make hydrostatic_compare_run# Run all SPH methods                      │"
	@echo "│  make hydrostatic_compare_viz# Generate comparison plots                │"
	@echo "│  make hydrostatic_compare_all# Run all + visualizations                 │"
	@echo "│  make hydrostatic_compare_clean# Clean comparison results                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(HYDROSTATIC_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

hydrostatic_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

hydrostatic_run: build/sph hydrostatic_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running Hydrostatic Equilibrium - Default Configuration"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(HYDROSTATIC_RESULTS)
	./build/sph hydrostatic
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(HYDROSTATIC_RESULTS)/"

hydrostatic_clean:
	@echo "Cleaning hydrostatic equilibrium results..."
	@rm -rf $(HYDROSTATIC_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

hydrostatic_compare_all: hydrostatic_compare_run hydrostatic_compare_viz hydrostatic_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

hydrostatic_compare_run: build/sph hydrostatic_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Hydrostatic Equilibrium Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/hydrostatic_gsph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph_wendland.json $(HYDROSTATIC_DIR)/hydrostatic.json
	@mkdir -p $(HYDROSTATIC_RESULTS)/gsph
	@./build/sph hydrostatic
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/hydrostatic_ssph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph_wendland.json $(HYDROSTATIC_DIR)/hydrostatic.json
	@mkdir -p $(HYDROSTATIC_RESULTS)/ssph
	@./build/sph hydrostatic
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/hydrostatic_disph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph_wendland.json $(HYDROSTATIC_DIR)/hydrostatic.json
	@mkdir -p $(HYDROSTATIC_RESULTS)/disph
	@./build/sph hydrostatic
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/hydrostatic_gdisph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph.json $(HYDROSTATIC_DIR)/hydrostatic.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph_wendland.json $(HYDROSTATIC_DIR)/hydrostatic.json
	@mkdir -p $(HYDROSTATIC_RESULTS)/gdisph
	@./build/sph hydrostatic
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

hydrostatic_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(HYDROSTATIC_RESULTS)/comparison
	@for method in gsph ssph disph gdisph; do \
	if [ -d "$(HYDROSTATIC_RESULTS)/$$method" ]; then \
	echo "Processing $$method..."; \
	fi \
	done
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(HYDROSTATIC_RESULTS)/comparison/"

hydrostatic_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(HYDROSTATIC_RESULTS)/animations
	@echo "✓ Animation step complete!"

hydrostatic_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(HYDROSTATIC_RESULTS)
	@echo "✓ Comparison results cleaned"
