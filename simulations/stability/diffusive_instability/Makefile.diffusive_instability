# ============================================================================
# DIFFUSIVE INSTABILITY TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test for numerical diffusion and dissipation in SPH.
#
# USAGE:
#   make -f simulations/stability/diffusive_instability/Makefile.diffusive_instability diffusive_run
#   make -f simulations/stability/diffusive_instability/Makefile.diffusive_instability diffusive_compare_all
#   make -f simulations/stability/diffusive_instability/Makefile.diffusive_instability diffusive_clean
#   make -f simulations/stability/diffusive_instability/Makefile.diffusive_instability diffusive_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/stability/diffusive_instability/results/
#
# ============================================================================

# Paths
DIFFUSIVE_DIR := simulations/stability/diffusive_instability
DIFFUSIVE_CONFIG := $(DIFFUSIVE_DIR)/config
PRESET_DIR := $(DIFFUSIVE_CONFIG)/presets
DIFFUSIVE_RESULTS := $(DIFFUSIVE_DIR)/results
DIFFUSIVE_SCRIPTS := $(DIFFUSIVE_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: diffusive_help diffusive_check_dim diffusive_run \
        diffusive_clean diffusive_compare_all diffusive_compare_run \
        diffusive_compare_viz diffusive_compare_animate diffusive_compare_clean

# ============================================================================
# HELP
# ============================================================================

diffusive_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  DIFFUSIVE INSTABILITY TEST - Numerical Diffusion Analysis"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Test for numerical diffusion and dissipation in SPH."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make diffusive_run              # Run default simulation                │"
	@echo "│  make diffusive_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make diffusive_compare_run      # Run all SPH methods                   │"
	@echo "│  make diffusive_compare_viz      # Generate comparison plots             │"
	@echo "│  make diffusive_compare_all      # Run all + visualizations              │"
	@echo "│  make diffusive_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(DIFFUSIVE_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

diffusive_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

diffusive_run: build/sph diffusive_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running Diffusive Instability Test"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(DIFFUSIVE_RESULTS)
	./build/sph diffusive_instability
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(DIFFUSIVE_RESULTS)/"

diffusive_clean:
	@echo "Cleaning diffusive instability test results..."
	@rm -rf $(DIFFUSIVE_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

diffusive_compare_all: diffusive_compare_run diffusive_compare_viz diffusive_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

diffusive_compare_run: build/sph diffusive_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Diffusive Instability Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(DIFFUSIVE_RESULTS)/gsph
	@./build/sph diffusive_instability 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(DIFFUSIVE_RESULTS)/ssph
	@./build/sph diffusive_instability 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(DIFFUSIVE_RESULTS)/disph
	@./build/sph diffusive_instability 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(DIFFUSIVE_RESULTS)/gdisph
	@./build/sph diffusive_instability 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

diffusive_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(DIFFUSIVE_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(DIFFUSIVE_RESULTS)/comparison/"

diffusive_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(DIFFUSIVE_RESULTS)/animations
	@echo "✓ Animation step complete!"

diffusive_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(DIFFUSIVE_RESULTS)
	@echo "✓ Comparison results cleaned"
