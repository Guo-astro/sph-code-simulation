# ============================================================================
# GRAD-H STUDY 3D CYLINDER MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Study grad-h corrections in 3D cylindrical geometry.
#
# USAGE:
#   make -f simulations/stability/gradh_study_3d_cylinder/Makefile.gradh_3d_cylinder gradh_3d_cyl_run
#   make -f simulations/stability/gradh_study_3d_cylinder/Makefile.gradh_3d_cylinder gradh_3d_cyl_compare_all
#   make -f simulations/stability/gradh_study_3d_cylinder/Makefile.gradh_3d_cylinder gradh_3d_cyl_clean
#   make -f simulations/stability/gradh_study_3d_cylinder/Makefile.gradh_3d_cylinder gradh_3d_cyl_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/stability/gradh_study_3d_cylinder/results/
#
# ============================================================================

# Paths
GRADH_3D_CYL_DIR := simulations/stability/gradh_study_3d_cylinder
GRADH_3D_CYL_CONFIG := $(GRADH_3D_CYL_DIR)/config
PRESET_DIR := $(GRADH_3D_CYL_CONFIG)/presets
GRADH_3D_CYL_RESULTS := $(GRADH_3D_CYL_DIR)/results
GRADH_3D_CYL_SCRIPTS := $(GRADH_3D_CYL_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: gradh_3d_cyl_help gradh_3d_cyl_check_dim gradh_3d_cyl_run \
        gradh_3d_cyl_clean gradh_3d_cyl_compare_all gradh_3d_cyl_compare_run \
        gradh_3d_cyl_compare_viz gradh_3d_cyl_compare_animate gradh_3d_cyl_compare_clean

# ============================================================================
# HELP
# ============================================================================

gradh_3d_cyl_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  GRAD-H STUDY 3D CYLINDER - Smoothing Length Gradient Test (3D Cylinder)"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Study grad-h corrections in 3D cylindrical geometry."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make gradh_3d_cyl_run              # Run default simulation                │"
	@echo "│  make gradh_3d_cyl_clean            # Remove all results                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make gradh_3d_cyl_compare_run      # Run all SPH methods                   │"
	@echo "│  make gradh_3d_cyl_compare_viz      # Generate comparison plots             │"
	@echo "│  make gradh_3d_cyl_compare_all      # Run all + visualizations              │"
	@echo "│  make gradh_3d_cyl_compare_clean    # Clean comparison results              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(GRADH_3D_CYL_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

gradh_3d_cyl_check_dim:
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=3"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

gradh_3d_cyl_run: build/sph gradh_3d_cyl_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running Grad-h Study 3D Cylinder"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRADH_3D_CYL_RESULTS)
	./build/sph gradh_3d_cylinder
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(GRADH_3D_CYL_RESULTS)/"

gradh_3d_cyl_clean:
	@echo "Cleaning grad-h study 3d cylinder results..."
	@rm -rf $(GRADH_3D_CYL_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

gradh_3d_cyl_compare_all: gradh_3d_cyl_compare_run gradh_3d_cyl_compare_viz gradh_3d_cyl_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

gradh_3d_cyl_compare_run: build/sph gradh_3d_cyl_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Grad-h Study 3D Cylinder Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_3D_CYL_RESULTS)/gsph
	@./build/sph gradh_3d_cylinder 2>/dev/null || echo "⚠️  GSPH config not found"
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_3D_CYL_RESULTS)/ssph
	@./build/sph gradh_3d_cylinder 2>/dev/null || echo "⚠️  SSPH config not found"
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_3D_CYL_RESULTS)/disph
	@./build/sph gradh_3d_cylinder 2>/dev/null || echo "⚠️  DISPH config not found"
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@mkdir -p $(GRADH_3D_CYL_RESULTS)/gdisph
	@./build/sph gradh_3d_cylinder 2>/dev/null || echo "⚠️  GDISPH config not found"
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

gradh_3d_cyl_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRADH_3D_CYL_RESULTS)/comparison
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(GRADH_3D_CYL_RESULTS)/comparison/"

gradh_3d_cyl_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRADH_3D_CYL_RESULTS)/animations
	@echo "✓ Animation step complete!"

gradh_3d_cyl_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(GRADH_3D_CYL_RESULTS)
	@echo "✓ Comparison results cleaned"
