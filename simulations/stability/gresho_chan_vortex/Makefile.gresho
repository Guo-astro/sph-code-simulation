# ============================================================================
# GRESHO-CHAN VORTEX MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test preservation of angular momentum and vortex structure.
#
# USAGE:
#   make -f simulations/stability/gresho_chan_vortex/Makefile.gresho gresho_run
#   make -f simulations/stability/gresho_chan_vortex/Makefile.gresho gresho_compare_all
#   make -f simulations/stability/gresho_chan_vortex/Makefile.gresho gresho_clean
#   make -f simulations/stability/gresho_chan_vortex/Makefile.gresho gresho_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/stability/gresho_chan_vortex/results/<method>/
#
# ============================================================================

# Paths
GRESHO_DIR := simulations/stability/gresho_chan_vortex
GRESHO_CONFIG := $(GRESHO_DIR)/config
PRESET_DIR := $(GRESHO_CONFIG)/presets
GRESHO_RESULTS := $(GRESHO_DIR)/results
GRESHO_SCRIPTS := $(GRESHO_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: gresho_help gresho_check_dim gresho_run \
        gresho_clean gresho_compare_all gresho_compare_run \
        gresho_compare_viz gresho_compare_animate gresho_compare_clean

# ============================================================================
# HELP
# ============================================================================

gresho_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  GRESHO-CHAN VORTEX - Vortex Preservation Test"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Gresho-Chan vortex stability test."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make gresho_run        # Run default simulation                    │"
	@echo "│  make gresho_clean      # Remove all results                       │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make gresho_compare_run# Run all SPH methods                      │"
	@echo "│  make gresho_compare_viz# Generate comparison plots                │"
	@echo "│  make gresho_compare_all# Run all + visualizations                 │"
	@echo "│  make gresho_compare_clean# Clean comparison results                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(GRESHO_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

gresho_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

gresho_run: build/sph gresho_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running Gresho-Chan Vortex - Default Configuration"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRESHO_RESULTS)
	./build/sph gresho_chan_vortex
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(GRESHO_RESULTS)/"

gresho_clean:
	@echo "Cleaning gresho-chan vortex results..."
	@rm -rf $(GRESHO_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

gresho_compare_all: gresho_compare_run gresho_compare_viz gresho_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

gresho_compare_run: build/sph gresho_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Gresho-Chan Vortex Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/gresho_gsph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph_wendland.json $(GRESHO_DIR)/gresho_chan_vortex.json
	@mkdir -p $(GRESHO_RESULTS)/gsph
	@./build/sph gresho_chan_vortex
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/gresho_ssph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph_wendland.json $(GRESHO_DIR)/gresho_chan_vortex.json
	@mkdir -p $(GRESHO_RESULTS)/ssph
	@./build/sph gresho_chan_vortex
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/gresho_disph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph_wendland.json $(GRESHO_DIR)/gresho_chan_vortex.json
	@mkdir -p $(GRESHO_RESULTS)/disph
	@./build/sph gresho_chan_vortex
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/gresho_gdisph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph.json $(GRESHO_DIR)/gresho_chan_vortex.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph_wendland.json $(GRESHO_DIR)/gresho_chan_vortex.json
	@mkdir -p $(GRESHO_RESULTS)/gdisph
	@./build/sph gresho_chan_vortex
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

gresho_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRESHO_RESULTS)/comparison
	@for method in gsph ssph disph gdisph; do \
	if [ -d "$(GRESHO_RESULTS)/$$method" ]; then \
	echo "Processing $$method..."; \
	fi \
	done
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(GRESHO_RESULTS)/comparison/"

gresho_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(GRESHO_RESULTS)/animations
	@echo "✓ Animation step complete!"

gresho_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(GRESHO_RESULTS)
	@echo "✓ Comparison results cleaned"
