{
    "name": "1d_gsph_gradh_n100",
    "description": "GSPH with grad-h, neighborNumber=100 (smoother h variation)",
    
    "resumeFromSnapshot": "simulations/stability/gradh_study_1d/results/relaxation/snapshot_0005.csv",
    "resetTimeOnResume": true,
    
    "outputDirectory": "simulations/stability/gradh_study_1d/results/smooth_h_test/gsph_gradh_n100",
    "outputFormat": "csv",
    "enableEnergyFile": true,
    
    "SPHType": "gsph",
    "use2ndOrderGSPH": true,
    "useGradH": true,
    "riemannSolver": "hll",
    
    "kernel": "cubic_spline",
    "neighborNumber": 100,
    
    "useGravity": true,
    "G": 1.0,
    "theta": 0.5,
    "useKernelGravity1D": true,
    
    "periodic": false,
    "rangeMin": [-2.0],
    "rangeMax": [2.0],
    "boundaryType": "outflow",
    
    "avAlpha": 1.0,
    "useBalsaraSwitch": true,
    
    "cflSound": 0.3,
    "cflForce": 0.125,
    
    "startTime": 0.0,
    "endTime": 500.0,
    "outputTime": 5.0,
    
    "gamma": 1.6666666666666667,
    
    "iterativeSmoothingLength": true
}
