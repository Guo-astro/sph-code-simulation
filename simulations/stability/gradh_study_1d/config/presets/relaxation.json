{
    "name": "1d_polytropic_slab_relaxation",
    "description": "Relaxation to create equilibrium IC for 1D polytropic slab with kernel gravity",
    
    "sample": "polytropic_slab",
    "N": 200,
    "rho_center": 1.0,
    "K": 1.0,
    
    "outputDirectory": "simulations/stability/gradh_study_1d/results/relaxation",
    "outputFormat": "csv",
    "enableEnergyFile": true,
    
    "SPHType": "gsph",
    "use2ndOrderGSPH": true,
    "useGradH": true,
    "riemannSolver": "hll",
    
    "kernel": "cubic_spline",
    "neighborNumber": 50,
    
    "useGravity": true,
    "G": 1.0,
    "theta": 0.5,
    "useKernelGravity1D": true,
    
    "periodic": false,
    "rangeMin": [-2.0],
    "rangeMax": [2.0],
    "boundaryType": "outflow",
    
    "avAlpha": 1.0,
    "useBalsaraSwitch": true,
    
    "cflSound": 0.3,
    "cflForce": 0.125,
    
    "startTime": 0.0,
    "endTime": 30.0,
    "outputTime": 5.0,
    
    "gamma": 1.6666666666666667,
    
    "iterativeSmoothingLength": true,
    
    "useRelaxation": true,
    "relaxationSteps": 500,
    "relaxationOutputFreq": 100,
    "relaxationTimestepFactor": 0.1
}
