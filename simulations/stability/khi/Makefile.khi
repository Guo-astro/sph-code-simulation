# ============================================================================
# KHI TEST MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Test development of Kelvin-Helmholtz instability at shear interfaces.
#
# USAGE:
#   make -f simulations/stability/khi/Makefile.khi khi_run
#   make -f simulations/stability/khi/Makefile.khi khi_compare_all
#   make -f simulations/stability/khi/Makefile.khi khi_clean
#   make -f simulations/stability/khi/Makefile.khi khi_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: simulations/stability/khi/results/<method>/
#
# ============================================================================

# Paths
KHI_DIR := simulations/stability/khi
KHI_CONFIG := $(KHI_DIR)/config
PRESET_DIR := $(KHI_CONFIG)/presets
KHI_RESULTS := $(KHI_DIR)/results
KHI_SCRIPTS := $(KHI_DIR)/scripts

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: khi_help khi_check_dim khi_run \
        khi_clean khi_compare_all khi_compare_run \
        khi_compare_viz khi_compare_animate khi_compare_clean

# ============================================================================
# HELP
# ============================================================================

khi_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  KHI TEST - Kelvin-Helmholtz Instability"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Kelvin-Helmholtz instability growth test."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make khi_run           # Run default simulation                    │"
	@echo "│  make khi_clean         # Remove all results                       │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  MULTI-METHOD COMPARISON                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make khi_compare_run   # Run all SPH methods                      │"
	@echo "│  make khi_compare_viz   # Generate comparison plots                │"
	@echo "│  make khi_compare_all   # Run all + visualizations                 │"
	@echo "│  make khi_compare_clean # Clean comparison results                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(KHI_RESULTS)/"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

khi_check_dim:
	@if ! grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=2"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=2 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=2 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

khi_run: build/sph khi_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running KHI Test - Default Configuration"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(KHI_RESULTS)
	./build/sph khi
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "  📊 Output: $(KHI_RESULTS)/"

khi_clean:
	@echo "Cleaning khi test results..."
	@rm -rf $(KHI_RESULTS)
	@echo "✓ Cleaned!"

# ============================================================================
# MULTI-METHOD COMPARISON TARGETS
# ============================================================================

khi_compare_all: khi_compare_run khi_compare_viz khi_compare_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Comparison Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════"

khi_compare_run: build/sph khi_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  KHI Test Multi-Method Comparison"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: GSPH, SSPH, DISPH, GDISPH"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [1/4] GSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/khi_gsph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/gsph_wendland.json $(KHI_DIR)/khi.json
	@mkdir -p $(KHI_RESULTS)/gsph
	@./build/sph khi
	@echo "✓ GSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [2/4] SSPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/khi_ssph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/ssph_wendland.json $(KHI_DIR)/khi.json
	@mkdir -p $(KHI_RESULTS)/ssph
	@./build/sph khi
	@echo "✓ SSPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [3/4] DISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/khi_disph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/disph_wendland.json $(KHI_DIR)/khi.json
	@mkdir -p $(KHI_RESULTS)/disph
	@./build/sph khi
	@echo "✓ DISPH complete"
	@echo ""
	@echo "────────────────────────────────────────────────────────────────"
	@echo "  [4/4] GDISPH"
	@echo "────────────────────────────────────────────────────────────────"
	@cp $(PRESET_DIR)/khi_gdisph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph.json $(KHI_DIR)/khi.json 2>/dev/null || \
	cp $(PRESET_DIR)/gdisph_wendland.json $(KHI_DIR)/khi.json
	@mkdir -p $(KHI_RESULTS)/gdisph
	@./build/sph khi
	@echo "✓ GDISPH complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ All simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"

khi_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(KHI_RESULTS)/comparison
	@for method in gsph ssph disph gdisph; do \
	if [ -d "$(KHI_RESULTS)/$$method" ]; then \
	echo "Processing $$method..."; \
	fi \
	done
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "  📊 Output: $(KHI_RESULTS)/comparison/"

khi_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(KHI_RESULTS)/animations
	@echo "✓ Animation step complete!"

khi_compare_clean:
	@echo "Cleaning comparison results..."
	@rm -rf $(KHI_RESULTS)
	@echo "✓ Comparison results cleaned"
