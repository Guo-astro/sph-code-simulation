# ============================================================================
# VALIDATION
# ============================================================================

gradh1d_check_dim:
	@if ! grep -q "DIM=1" build/CMakeCache.txt 2>/dev/null && \
	   ! grep -q "DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
		echo "❌ ERROR: This test requires DIM=1"; \
		echo ""; \
		echo "   To rebuild for 1D:"; \
		echo "   cd build && cmake -DDIM=1 .. && make -j"; \
		echo ""; \
		exit 1; \
	fi
	@echo "✓ DIM=1 confirmed"

# ============================================================================
# RELAXATION (Generate Initial Condition)
# ============================================================================

gradh1d_relax: gradh1d_check_dim build/sph
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating Relaxed Lane-Emden Initial Condition"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/relaxation
	@if [ -f "$(PRESET_DIR)/relaxation.json" ]; then \
		cp $(PRESET_DIR)/relaxation.json $(CONFIG_DIR)/active_config.json; \
		./build/sph $(CONFIG_DIR)/active_config.json; \
		echo ""; \
		echo "✓ Relaxation complete!"; \
		echo "📁 IC saved to: $(RESULTS_DIR)/relaxation/"; \
	else \
		echo "❌ Config not found: $(PRESET_DIR)/relaxation.json"; \
		exit 1; \
	fi

gradh1d_relax_clean:
	@echo "Cleaning relaxation results..."
	@rm -rf $(RESULTS_DIR)/relaxation
	@echo "✓ Cleaned"

# ============================================================================
# SINGLE METHOD RUN
# ============================================================================

gradh1d_run: gradh1d_check_dim build/sph
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running: $(METHOD)"
	@echo "════════════════════════════════════════════════════════════════"
	@if [ -f "$(PRESET_DIR)/$(METHOD).json" ]; then \
		mkdir -p $(RESULTS_DIR)/kernel_gravity/$(METHOD); \
		cp $(PRESET_DIR)/$(METHOD).json $(CONFIG_DIR)/active_config.json; \
		./build/sph $(CONFIG_DIR)/active_config.json; \
		echo ""; \
		echo "✓ Simulation complete!"; \
		echo "📁 Results: $(RESULTS_DIR)/kernel_gravity/$(METHOD)/"; \
	else \
		echo "❌ Config not found: $(PRESET_DIR)/$(METHOD).json"; \
		echo ""; \
		echo "Available methods:"; \
		ls $(PRESET_DIR)/*.json 2>/dev/null | xargs -I {} basename {} .json | grep -v relaxation | sed 's/^/  • /'; \
		exit 1; \
	fi

gradh1d_clean:
	@echo "Cleaning results for $(METHOD)..."
	@rm -rf $(RESULTS_DIR)/kernel_gravity/$(METHOD)
	@echo "✓ Cleaned"

# ============================================================================
# 6-METHOD COMPARISON (GSPH/SSPH/GDISPH × grad-h/no-grad-h)
# ============================================================================

gradh1d_compare_run: gradh1d_check_dim build/sph
