# ============================================================================
# GRAD-H STUDY 1D - Makefile
# ============================================================================
#
# PURPOSE:
#   Study the importance of grad-h correction in 1D polytropic slab with
#   kernel-convolved gravity. Compare 6 SPH methods (GSPH/SSPH/GDISPH × 
#   grad-h/no-grad-h) plus C_smooth=2 variants.
#
# SINGLE METHOD USAGE:
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_run METHOD=gsph_gradh
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_clean
#
# MULTI-METHOD COMPARISON (6 Methods):
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_compare_run
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_compare_viz
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_compare_animate
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_compare_all
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_compare_clean
#
# C_SMOOTH=2 COMPARISON (4 Methods with smoother h):
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_csmooth_run
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_csmooth_viz
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_csmooth_all
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_csmooth_clean
#
# FULL COMPARISON (6 Methods + 4 C_smooth variants + all animations):
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_full
#
# RELAXATION (Generate initial condition):
#   make -f sample/gradh_study_1d/Makefile.gradh_study_1d gradh1d_relax
#
# ============================================================================

# Paths
GRADH1D_DIR := sample/gradh_study_1d
CONFIG_DIR := $(GRADH1D_DIR)/config
PRESET_DIR := $(CONFIG_DIR)/presets
RESULTS_DIR := $(GRADH1D_DIR)/results
SCRIPTS_DIR := $(GRADH1D_DIR)/scripts
ANIM_DIR := $(RESULTS_DIR)/comparison

# Default method
METHOD ?= gsph_gradh

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: gradh1d_help gradh1d_check_dim \
        gradh1d_run gradh1d_clean \
        gradh1d_relax gradh1d_relax_clean \
        gradh1d_compare_run gradh1d_compare_viz gradh1d_compare_animate \
        gradh1d_compare_all gradh1d_compare_clean \
        gradh1d_csmooth_run gradh1d_csmooth_viz gradh1d_csmooth_animate \
        gradh1d_csmooth_all gradh1d_csmooth_clean \
        gradh1d_full gradh1d_clean_all

