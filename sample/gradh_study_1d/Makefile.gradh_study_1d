# ============================================================================
# UTILITY TARGETS
# ============================================================================

# List available configs
gradh1d_list_configs:
	@echo "Available configurations:"
	@echo ""
	@echo "Standard methods (C_smooth=1):"
	@ls $(PRESET_DIR)/*.json 2>/dev/null | xargs -I {} basename {} .json | grep -v relaxation | sed 's/^/  • /'
	@echo ""
	@echo "C_smooth=2 methods:"
	@ls $(PRESET_DIR)/csmooth_test/*.json 2>/dev/null | xargs -I {} basename {} .json | sed 's/^/  • /' || echo "  (none)"
	@echo ""

# Show results summary
gradh1d_summary:
	@echo "Results summary:"
	@echo ""
	@echo "Standard methods (kernel_gravity/):"
	@for dir in $(RESULTS_DIR)/kernel_gravity/*/; do \
		if [ -d "$$dir" ]; then \
			count=$$(ls -1 "$$dir"snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
			method=$$(basename "$$dir"); \
			echo "  • $$method: $$count snapshots"; \
		fi \
	done
	@echo ""
	@echo "C_smooth=2 methods (csmooth_test/):"
	@for dir in $(RESULTS_DIR)/csmooth_test/*/; do \
		if [ -d "$$dir" ]; then \
			count=$$(ls -1 "$$dir"snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
			method=$$(basename "$$dir"); \
			echo "  • $$method: $$count snapshots"; \
		fi \
	done
	@echo ""
	@echo "Animations:"
	@ls -lh $(ANIM_DIR)/*.gif 2>/dev/null | awk '{print "  🎬 " $$NF " (" $$5 ")"}' || echo "  (none)"
	@echo ""
