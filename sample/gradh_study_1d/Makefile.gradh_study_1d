	@echo "  1D Polytropic Slab with Kernel-Convolved Gravity"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "[1/6] GSPH + grad-h..."
	@echo "════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/kernel_gravity/gsph_gradh
	@cp $(PRESET_DIR)/gsph_gradh.json $(CONFIG_DIR)/active_config.json
	@./build/sph $(CONFIG_DIR)/active_config.json
	@echo "✓ [1/6] Complete"
	@echo ""
	@echo "[2/6] GSPH - grad-h..."
	@echo "════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/kernel_gravity/gsph_nogradh
	@cp $(PRESET_DIR)/gsph_nogradh.json $(CONFIG_DIR)/active_config.json
	@./build/sph $(CONFIG_DIR)/active_config.json
	@echo "✓ [2/6] Complete"
	@echo ""
	@echo "[3/6] SSPH + grad-h..."
	@echo "════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/kernel_gravity/ssph_gradh
	@cp $(PRESET_DIR)/ssph_gradh.json $(CONFIG_DIR)/active_config.json
	@./build/sph $(CONFIG_DIR)/active_config.json
	@echo "✓ [3/6] Complete"
	@echo ""
	@echo "[4/6] SSPH - grad-h..."
	@echo "════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/kernel_gravity/ssph_nogradh
	@cp $(PRESET_DIR)/ssph_nogradh.json $(CONFIG_DIR)/active_config.json
	@./build/sph $(CONFIG_DIR)/active_config.json
	@echo "✓ [4/6] Complete"
	@echo ""
	@echo "[5/6] GDISPH + grad-h..."
	@echo "════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/kernel_gravity/gdisph_gradh
	@cp $(PRESET_DIR)/gdisph_gradh.json $(CONFIG_DIR)/active_config.json
	@./build/sph $(CONFIG_DIR)/active_config.json
	@echo "✓ [5/6] Complete"
	@echo ""
	@echo "[6/6] GDISPH - grad-h..."
	@echo "════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/kernel_gravity/gdisph_nogradh
	@cp $(PRESET_DIR)/gdisph_nogradh.json $(CONFIG_DIR)/active_config.json
	@./build/sph $(CONFIG_DIR)/active_config.json
	@echo "✓ [6/6] Complete"
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✅ All 6 simulations complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Results saved to: $(RESULTS_DIR)/kernel_gravity/"
	@echo ""

gradh1d_compare_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating 6-Method Comparison Plots"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(ANIM_DIR)
	@if [ -f "$(SCRIPTS_DIR)/compare_methods.py" ]; then \
		python3 $(SCRIPTS_DIR)/compare_methods.py; \
		echo ""; \
		echo "✓ Comparison plots generated!"; \
		echo "📊 Plots saved to: $(ANIM_DIR)/"; \
	else \
		echo "❌ Script not found: $(SCRIPTS_DIR)/compare_methods.py"; \
		exit 1; \
	fi

gradh1d_compare_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating 6-Method Comparison Animations"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(ANIM_DIR)
	@if [ -f "$(SCRIPTS_DIR)/compare_methods.py" ]; then \
		python3 $(SCRIPTS_DIR)/compare_methods.py; \
		echo ""; \
		echo "✓ Animations generated!"; \
		ls -lh $(ANIM_DIR)/*.gif 2>/dev/null || echo "  (No GIF files found)"; \
	else \
		echo "❌ Script not found: $(SCRIPTS_DIR)/compare_methods.py"; \
		exit 1; \
	fi

gradh1d_compare_all: gradh1d_compare_run gradh1d_compare_viz
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✅ 6-METHOD COMPARISON COMPLETE!"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Results:    $(RESULTS_DIR)/kernel_gravity/"
	@echo "  Plots:      $(ANIM_DIR)/*.png"
	@echo "  Animations: $(ANIM_DIR)/*.gif"
	@echo ""
	@echo "  Generated outputs:"
	@ls -1 $(ANIM_DIR)/*.png 2>/dev/null | head -5 | sed 's/^/    📊 /' || true
	@ls -1 $(ANIM_DIR)/*.gif 2>/dev/null | head -5 | sed 's/^/    🎬 /' || true
	@echo ""

gradh1d_compare_clean:
	@echo "Cleaning 6-method comparison results..."
	@rm -rf $(RESULTS_DIR)/kernel_gravity
	@rm -rf $(ANIM_DIR)
	@echo "✓ Cleaned"

