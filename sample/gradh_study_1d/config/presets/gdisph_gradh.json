{
    "name": "1d_gdisph_gradh_kernel_gravity",
    "description": "GDISPH with grad-h correction and kernel gravity",
    
    "resumeFromSnapshot": "sample/gradh_study_1d/results/relaxation/snapshot_0005.csv",
    "resetTimeOnResume": true,
    
    "outputDirectory": "sample/gradh_study_1d/results/kernel_gravity/gdisph_gradh",
    "outputFormat": "csv",
    "enableEnergyFile": true,
    
    "SPHType": "gdisph",
    "useGradH": true,
    "riemannSolver": "hll",
    
    "kernel": "cubic_spline",
    "neighborNumber": 50,
    
    "useGravity": true,
    "G": 1.0,
    "theta": 0.5,
    "useKernelGravity1D": true,
    
    "periodic": false,
    "rangeMin": [-2.0],
    "rangeMax": [2.0],
    "boundaryType": "outflow",
    
    "avAlpha": 1.0,
    "useBalsaraSwitch": true,
    
    "cflSound": 0.3,
    "cflForce": 0.125,
    
    "startTime": 0.0,
    "endTime": 500.0,
    "outputTime": 5.0,
    
    "gamma": 1.6666666666666667,
    
    "iterativeSmoothingLength": true
}
