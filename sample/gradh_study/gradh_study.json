{
    "name": "gradh_study_default",
    "description": "Default configuration for grad-h study",
    
    "outputDirectory": "sample/gradh_study/results",
    "outputFormat": "csv",
    "enableEnergyFile": true,
    
    "SPHType": "gsph",
    "use2ndOrderGSPH": false,
    "useGradH": true,
    "riemannSolver": "iterative",
    
    "kernel": "wendland",
    "neighborNumber": 32,
    
    "periodic": true,
    "rangeMax": [0.5, 0.5],
    "rangeMin": [-0.5, -0.5],
    
    "startTime": 0.0,
    "endTime": 10.0,
    "outputTime": 0.1,
    
    "gamma": 1.6666666666666667,
    
    "avAlpha": 1.0,
    "useBalsaraSwitch": false,
    
    "leafParticleNumber": 16,
    "N": 64,
    "iterativeSmoothingLength": true
}
