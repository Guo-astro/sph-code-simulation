    "useGravity": true,
    "G": 1.0,
    "theta": 0.5,
    
    "periodic": false,
    
    "cflSound": 0.3,
    "cflForce": 0.125,
    
    "startTime": 0.0,
    "endTime": 50.0,
    "outputTime": 0.5,
    
    "gamma": 1.6666666666666667,
    
    "maxTreeLevel": 20,
    "leafParticleNumber": 1,
    "iterativeSmoothingLength": true
}
