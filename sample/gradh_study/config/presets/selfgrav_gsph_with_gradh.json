{
    "name": "selfgrav_gsph_with_gradh",
    "description": "Self-gravitating hydrostatic equilibrium with grad-h correction (stable)",
    
    "resumeFromSnapshot": "sample/imbh_cloud/results/relaxation/61k/GSPH/snapshot_0004.csv",
    "resetTimeOnResume": true,
    
    "outputDirectory": "sample/gradh_study/results/selfgrav_with_gradh",
