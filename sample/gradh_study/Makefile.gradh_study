# Grad-H Study Makefile - Comparing With and Without Grad-H Correction
# ================================================================================
#
# This study demonstrates that the grad-h correction term is essential for
# preventing artificial core collapse in hydrostatic equilibrium simulations.
#
# Usage:
# ================================================================================
#
# Periodic Box Hydrostatic Tests (2D):
#   make -f sample/gradh_study/Makefile.gradh_study gradh_hydro_run      # Run both with/without grad-h
#   make -f sample/gradh_study/Makefile.gradh_study gradh_hydro_viz      # Generate comparison plots
#   make -f sample/gradh_study/Makefile.gradh_study gradh_hydro_animate  # Generate comparison animation
#   make -f sample/gradh_study/Makefile.gradh_study gradh_hydro_all      # Run all + visualizations
#   make -f sample/gradh_study/Makefile.gradh_study gradh_hydro_clean    # Clean results
#
# Self-Gravitating Cloud Tests (3D, requires relaxed IC):
#   make -f sample/gradh_study/Makefile.gradh_study gradh_selfgrav_run   # Run both cases
#   make -f sample/gradh_study/Makefile.gradh_study gradh_selfgrav_viz   # Generate comparison plots
#   make -f sample/gradh_study/Makefile.gradh_study gradh_selfgrav_all   # Run all + visualizations
#   make -f sample/gradh_study/Makefile.gradh_study gradh_selfgrav_clean # Clean results
#
# Paper Figure Generation:
#   make -f sample/gradh_study/Makefile.gradh_study gradh_paper_figs     # Generate publication-ready figures
#
# Help:
#   make -f sample/gradh_study/Makefile.gradh_study gradh_help           # Show this help

# ================================================================================
# Paths
# ================================================================================
GRADH_DIR = sample/gradh_study
PRESET_DIR = $(GRADH_DIR)/config/presets
RESULTS_DIR = $(GRADH_DIR)/results
SCRIPTS_DIR = $(GRADH_DIR)/scripts
ANIM_DIR = $(GRADH_DIR)/animations
FIG_DIR = $(GRADH_DIR)/figures

# ================================================================================
# PHONY Targets
# ================================================================================
.PHONY: gradh_help \
        gradh_hydro_run gradh_hydro_viz gradh_hydro_animate gradh_hydro_all gradh_hydro_clean \
        gradh_selfgrav_run gradh_selfgrav_viz gradh_selfgrav_all gradh_selfgrav_clean \
        gradh_paper_figs gradh_clean_all

# ================================================================================
# Help Target
# ================================================================================
gradh_help:
	@echo "================================================================================"
	@echo "Grad-H Study Makefile - Effect of Grad-H Term on Hydrostatic Equilibrium"
	@echo "================================================================================"
	@echo ""
	@echo "This study demonstrates that the grad-h correction term (Ω_i) is essential"
	@echo "for preventing artificial core collapse in hydrostatic equilibrium simulations."
	@echo ""
	@echo "THEORY:"
	@echo "  The grad-h correction factor Ω_i = 1 / (1 + (h/Dρ) * dρ/dh) accounts for"
	@echo "  variable smoothing length in the kernel gradient. Without this correction,"
	@echo "  the density summation becomes inconsistent with pressure gradients, leading"
	@echo "  to spurious forces that cause core collapse even in equilibrium configurations."
	@echo ""
	@echo "PERIODIC BOX TESTS (2D):"
	@echo "  gradh_hydro_run      - Run hydrostatic tests with and without grad-h"
	@echo "  gradh_hydro_viz      - Generate comparison plots"
	@echo "  gradh_hydro_animate  - Generate side-by-side animation"
	@echo "  gradh_hydro_all      - Run simulations + all visualizations"
	@echo "  gradh_hydro_clean    - Clean periodic box results"
	@echo ""
	@echo "SELF-GRAVITATING TESTS (3D):"
	@echo "  gradh_selfgrav_run   - Run self-gravitating tests (requires relaxed IC)"
	@echo "  gradh_selfgrav_viz   - Generate comparison plots"
	@echo "  gradh_selfgrav_all   - Run simulations + visualizations"
	@echo "  gradh_selfgrav_clean - Clean self-gravitating results"
	@echo ""
	@echo "PAPER FIGURES:"
	@echo "  gradh_paper_figs     - Generate publication-ready figures"
	@echo ""
	@echo "UTILITIES:"
	@echo "  gradh_clean_all      - Clean all results and figures"
	@echo "  gradh_help           - Show this help message"
	@echo ""
	@echo "EXAMPLES:"
	@echo "  # Run full hydrostatic comparison workflow:"
	@echo "  make -f sample/gradh_study/Makefile.gradh_study gradh_hydro_all"
	@echo ""
	@echo "  # Generate paper figures after running simulations:"
	@echo "  make -f sample/gradh_study/Makefile.gradh_study gradh_paper_figs"
	@echo "================================================================================"

# ================================================================================
# Periodic Box Hydrostatic Tests (2D)
# ================================================================================

gradh_hydro_run: build/sph
	@echo "================================================================================"
	@echo "Grad-H Study: Periodic Box Hydrostatic Equilibrium"
	@echo "Comparing: WITH grad-h vs WITHOUT grad-h correction"
	@echo "================================================================================"
	@echo ""
	@echo "Checking build configuration..."
	@if grep -q "^#define DIM 2" include/defines.hpp; then \
		echo "✓ DIM=2 build detected"; \
	else \
		echo "❌ ERROR: Hydrostatic test requires DIM=2 build"; \
		echo ""; \
		echo "To rebuild for 2D:"; \
		echo "  sed -i '' 's/#define DIM [0-9]/#define DIM 2/' include/defines.hpp"; \
		echo "  cd build && make -j8 && cd .."; \
		exit 1; \
	fi
	@echo ""
	@echo "========================================"
	@echo "[1/2] Running WITH grad-h correction..."
	@echo "========================================"
	@cp $(PRESET_DIR)/hydrostatic_gsph_with_gradh.json $(GRADH_DIR)/gradh_study.json
	@mkdir -p $(RESULTS_DIR)/with_gradh
	@./build/sph gradh_study
	@echo "✓ WITH grad-h simulation complete"
	@echo ""
	@echo "========================================"
	@echo "[2/2] Running WITHOUT grad-h correction..."
	@echo "========================================"
	@cp $(PRESET_DIR)/hydrostatic_gsph_no_gradh.json $(GRADH_DIR)/gradh_study.json
	@mkdir -p $(RESULTS_DIR)/no_gradh
	@./build/sph gradh_study
	@echo "✓ WITHOUT grad-h simulation complete"
	@echo ""
	@echo "================================================================================"
	@echo "✓ All simulations complete!"
	@echo "📁 Results saved to:"
	@echo "   - $(RESULTS_DIR)/with_gradh/"
	@echo "   - $(RESULTS_DIR)/no_gradh/"
	@echo "================================================================================"

gradh_hydro_viz: 
	@echo "================================================================================"
	@echo "Generating Grad-H Comparison Plots"
	@echo "================================================================================"
	@if [ ! -d "$(RESULTS_DIR)/with_gradh" ] || [ ! -d "$(RESULTS_DIR)/no_gradh" ]; then \
		echo "❌ ERROR: Results not found. Run 'gradh_hydro_run' first."; \
		exit 1; \
	fi
	@mkdir -p $(FIG_DIR)
	@chmod +x $(SCRIPTS_DIR)/compare_gradh.py 2>/dev/null || true
	@python3 $(SCRIPTS_DIR)/compare_gradh.py \
		--with-gradh $(RESULTS_DIR)/with_gradh \
		--no-gradh $(RESULTS_DIR)/no_gradh \
		--output $(FIG_DIR)
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "📊 Figures saved to: $(FIG_DIR)/"

gradh_hydro_animate:
	@echo "================================================================================"
	@echo "Generating Grad-H Comparison Animation"
	@echo "================================================================================"
	@if [ ! -d "$(RESULTS_DIR)/with_gradh" ] || [ ! -d "$(RESULTS_DIR)/no_gradh" ]; then \
		echo "❌ ERROR: Results not found. Run 'gradh_hydro_run' first."; \
		exit 1; \
	fi
	@mkdir -p $(ANIM_DIR)
	@chmod +x $(SCRIPTS_DIR)/animate_gradh_comparison.py 2>/dev/null || true
	@python3 $(SCRIPTS_DIR)/animate_gradh_comparison.py \
		--with-gradh $(RESULTS_DIR)/with_gradh \
		--no-gradh $(RESULTS_DIR)/no_gradh \
		--output $(ANIM_DIR)/gradh_comparison.gif
	@echo ""
	@echo "✓ Animation complete!"
	@echo "🎬 Animation saved to: $(ANIM_DIR)/gradh_comparison.gif"

gradh_hydro_all: gradh_hydro_run gradh_hydro_viz gradh_hydro_animate
	@echo ""
	@echo "================================================================================"
	@echo "✓ Complete Hydrostatic Grad-H Study Done!"
	@echo "================================================================================"
	@echo "📁 Results: $(RESULTS_DIR)/"
	@echo "📊 Figures: $(FIG_DIR)/"
	@echo "🎬 Animation: $(ANIM_DIR)/gradh_comparison.gif"

gradh_hydro_clean:
	@echo "Cleaning hydrostatic grad-h study results..."
	@rm -rf $(RESULTS_DIR)/with_gradh
	@rm -rf $(RESULTS_DIR)/no_gradh
	@rm -f $(FIG_DIR)/hydrostatic_*.png
	@rm -f $(ANIM_DIR)/gradh_comparison.gif
	@echo "✓ Hydrostatic results cleaned"

# ================================================================================
# Self-Gravitating Cloud Tests (3D)
# ================================================================================

gradh_selfgrav_run: build/sph
	@echo "================================================================================"
	@echo "Grad-H Study: Self-Gravitating Cloud"
	@echo "Comparing: WITH grad-h vs WITHOUT grad-h correction"
	@echo "================================================================================"
	@echo ""
	@echo "Checking build configuration..."
	@if grep -q "^#define DIM 3" include/defines.hpp; then \
		echo "✓ DIM=3 build detected"; \
	else \
		echo "❌ ERROR: Self-gravitating test requires DIM=3 build"; \
		echo ""; \
		echo "To rebuild for 3D:"; \
		echo "  sed -i '' 's/#define DIM [0-9]/#define DIM 3/' include/defines.hpp"; \
		echo "  cd build && make -j8 && cd .."; \
		exit 1; \
	fi
	@echo ""
	@echo "Checking for relaxed initial conditions..."
	@if [ ! -f "sample/imbh_cloud/results/relaxation/61k/GSPH/snapshot_0004.csv" ]; then \
		echo "❌ ERROR: Relaxed IC not found."; \
		echo ""; \
		echo "Please run the relaxation first:"; \
		echo "  make -f sample/imbh_cloud/Makefile.relaxation relax_oneshot SIZE=61k METHOD=gsph"; \
		exit 1; \
	fi
	@echo "✓ Relaxed IC found"
	@echo ""
	@echo "========================================"
	@echo "[1/2] Running WITH grad-h correction..."
	@echo "========================================"
	@cp $(PRESET_DIR)/selfgrav_gsph_with_gradh.json $(GRADH_DIR)/gradh_study.json
	@mkdir -p $(RESULTS_DIR)/selfgrav_with_gradh
	@./build/sph gradh_study
	@echo "✓ WITH grad-h simulation complete"
	@echo ""
	@echo "========================================"
	@echo "[2/2] Running WITHOUT grad-h correction..."
	@echo "========================================"
	@cp $(PRESET_DIR)/selfgrav_gsph_no_gradh.json $(GRADH_DIR)/gradh_study.json
	@mkdir -p $(RESULTS_DIR)/selfgrav_no_gradh
	@./build/sph gradh_study
	@echo "✓ WITHOUT grad-h simulation complete"
	@echo ""
	@echo "================================================================================"
	@echo "✓ All self-gravitating simulations complete!"
	@echo "📁 Results saved to:"
	@echo "   - $(RESULTS_DIR)/selfgrav_with_gradh/"
	@echo "   - $(RESULTS_DIR)/selfgrav_no_gradh/"
	@echo "================================================================================"

gradh_selfgrav_viz:
	@echo "================================================================================"
	@echo "Generating Self-Gravitating Grad-H Comparison Plots"
	@echo "================================================================================"
	@if [ ! -d "$(RESULTS_DIR)/selfgrav_with_gradh" ] || [ ! -d "$(RESULTS_DIR)/selfgrav_no_gradh" ]; then \
		echo "❌ ERROR: Results not found. Run 'gradh_selfgrav_run' first."; \
		exit 1; \
	fi
	@mkdir -p $(FIG_DIR)
	@chmod +x $(SCRIPTS_DIR)/compare_gradh_selfgrav.py 2>/dev/null || true
	@python3 $(SCRIPTS_DIR)/compare_gradh_selfgrav.py \
		--with-gradh $(RESULTS_DIR)/selfgrav_with_gradh \
		--no-gradh $(RESULTS_DIR)/selfgrav_no_gradh \
		--output $(FIG_DIR)
	@echo ""
	@echo "✓ Self-gravitating comparison plots generated!"
	@echo "📊 Figures saved to: $(FIG_DIR)/"

gradh_selfgrav_all: gradh_selfgrav_run gradh_selfgrav_viz
	@echo ""
	@echo "================================================================================"
	@echo "✓ Complete Self-Gravitating Grad-H Study Done!"
	@echo "================================================================================"

gradh_selfgrav_clean:
	@echo "Cleaning self-gravitating grad-h study results..."
	@rm -rf $(RESULTS_DIR)/selfgrav_with_gradh
	@rm -rf $(RESULTS_DIR)/selfgrav_no_gradh
	@rm -f $(FIG_DIR)/selfgrav_*.png
	@echo "✓ Self-gravitating results cleaned"

# ================================================================================
# Paper Figure Generation
# ================================================================================

gradh_paper_figs:
	@echo "================================================================================"
	@echo "Generating Publication-Ready Figures"
	@echo "================================================================================"
	@mkdir -p $(FIG_DIR)/paper
	@chmod +x $(SCRIPTS_DIR)/generate_paper_figures.py 2>/dev/null || true
	@python3 $(SCRIPTS_DIR)/generate_paper_figures.py \
		--results-dir $(RESULTS_DIR) \
		--output $(FIG_DIR)/paper
	@echo ""
	@echo "✓ Paper figures generated!"
	@echo "📊 Figures saved to: $(FIG_DIR)/paper/"

# ================================================================================
# Clean All
# ================================================================================

gradh_clean_all:
	@echo "Cleaning all grad-h study results..."
	@rm -rf $(RESULTS_DIR)/*
	@rm -rf $(ANIM_DIR)/*
	@rm -rf $(FIG_DIR)/*
	@echo "✓ All grad-h study results cleaned"
