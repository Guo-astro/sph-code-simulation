{
  "_comment": "Medium resolution configuration for BNS cocoon 2D",
  "_description": "Publication quality. ~64k particles, ~10 hour runtime.",
  "_physics": "Based on Gutiérrez et al. (2024) arXiv:2408.15973v3",
  
  "outputDirectory": "sample/bns_cocoon/results/medium_res",
  "startTime": 0.0,
  "endTime": 3.0,
  "outputTime": 0.02,
  "energyTime": 0.01,
  
  "checkpoint": {
    "enabled": true,
    "interval": 0.25
  },
  
  "output": {
    "formats": [{"type": "csv", "precision": 16}],
    "enableEnergyFile": true
  },
  
  "SPHType": "srgsph",
  "use2ndOrderSRGSPH": false,
  "cSpeed": 1.0,
  "cShock": 3.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  "gamma": 1.333333333,
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  "testType": "bns_cocoon_2d",
  "periodic": false,
  "avAlpha": 1.0,
  "useBalsaraSwitch": true,
  "cflSound": 0.3,
  "cflForce": 0.25,
  
  "bns_cocoon": {
    "M_ej": 0.01,
    "v_min": 0.05,
    "v_max": 0.7,
    "v_break": 0.5,
    "beta": 0.5,
    "alpha_tail": 6.0,
    "t0": 1.0,
    "gamma": 1.333333333,
    "rho_floor": 1e-12,
    "profile_type": 1,
    "theta_polar": 0.2618,
    "polar_density_factor": 0.1,
    "angular_power": 2.0,
    "E_cocoon": 1e-4,
    "r_cocoon_frac": 0.3,
    "theta_jet": 0.2094,
    "Gamma_cocoon": 2.0,
    "jet_injection": false,
    "n_radial": 200,
    "n_angular": 160
  }
}
