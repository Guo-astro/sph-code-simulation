{
  "_comment": "BNS cocoon shock breakout simulation - 1D spherical",
  "_description": "Relativistic cocoon shock propagating through BNS ejecta",
  "_reference": "Nakar & Piran (2017), Gottlieb et al. (2018)",
  "_physics": "Mildly relativistic jet-driven cocoon (Γ ~ 2-10) breaking through BNS ejecta",
  
  "outputDirectory": "sample/bns_cocoon/results/cocoon_1d",
  
  "startTime": 0.0,
  "endTime": 1.0,
  "outputTime": 0.01,
  "energyTime": 0.01,
  
  "checkpoint": {
    "enabled": true,
    "interval": 0.1,
    "resumeFile": ""
  },
  
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  },
  
  "SPHType": "srgsph",
  "use2ndOrderSRGSPH": true,
  
  "cSpeed": 1.0,
  "cShock": 2.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  
  "gamma": 1.333333333,
  
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  
  "N": 10000,
  "testType": "custom",
  "customICFile": "sample/bns_cocoon/data/ic/cocoon_1d_ic.csv",
  
  "periodic": false,
  "rangeMax": [1.0],
  "rangeMin": [0.0],
  
  "avAlpha": 0.0,
  "useBalsaraSwitch": false,
  
  "cflSound": 0.3,
  "cflForce": 0.25
}
