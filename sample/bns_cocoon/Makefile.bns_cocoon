# ================================================================================
# Makefile for BNS Cocoon Shock Breakout Simulations
# ================================================================================
#
# Special relativistic Godunov SPH simulations of cocoon shock breakout and 
# fast ejecta from binary neutron star mergers.
#
# Reference: Shibata & Hotokezaka (2019), Nakar & Piran (2017)
#
# USAGE EXAMPLES:
# ================================================================================
#
# Quick Test (using built-in blast wave):
#   make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_test
#
# Generate Initial Conditions:
#   make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_generate_ic
#
# Run Simulations:
#   make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_1d_run
#   make -f sample/bns_cocoon/Makefile.bns_cocoon grb170817a_run
#
# Visualization:
#   make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_viz
#
# Full Workflow:
#   make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_1d_all
#
# ================================================================================

# Path configuration
TEST_DIR      := sample/bns_cocoon
CONFIG_DIR    := $(TEST_DIR)/config/presets
SCRIPTS_DIR   := $(TEST_DIR)/scripts
EJECTA_DIR    := $(SCRIPTS_DIR)/ejecta_models
ANALYSIS_DIR  := $(SCRIPTS_DIR)/analysis
DATA_DIR      := $(TEST_DIR)/data
RESULTS_DIR   := $(TEST_DIR)/results
BUILD_DIR     := build

# Python
PYTHON        := python3

# Config files
CONFIG_TEST     := $(CONFIG_DIR)/sr_sod_cocoon_test.json
CONFIG_FIDUCIAL := $(CONFIG_DIR)/cocoon_1d_fiducial.json
CONFIG_GRB      := $(CONFIG_DIR)/grb170817a_like.json

# Results directories
RESULTS_TEST     := $(RESULTS_DIR)/cocoon_test
RESULTS_FIDUCIAL := $(RESULTS_DIR)/cocoon_1d_fiducial
RESULTS_GRB      := $(RESULTS_DIR)/grb170817a_like

# ================================================================================
.PHONY: bns_cocoon_help cocoon_test cocoon_test_viz \
        cocoon_generate_ic cocoon_1d_run grb170817a_run \
        cocoon_viz cocoon_animate \
        cocoon_1d_all grb170817a_all \
        clean_results download_radice download_sample \
        cocoon_2d_test cocoon_2d_run cocoon_2d_viz cocoon_2d_animate

# ================================================================================
# Help Target
# ================================================================================

bns_cocoon_help:
	@echo "========================================"
	@echo "BNS Cocoon Shock Breakout Simulations"
	@echo "========================================"
	@echo ""
	@echo "2D SIMULATIONS (C++ samples):"
	@echo "  cocoon_2d_test     - Quick 2D test (built-in sample)"
	@echo "  cocoon_2d_run      - Full 2D cocoon simulation"
	@echo "  cocoon_2d_viz      - Visualize 2D results"
	@echo "  cocoon_2d_animate  - Create 2D animation"
	@echo ""
	@echo "1D SIMULATIONS (blast wave based):"
	@echo "  cocoon_test        - Run quick test simulation"
	@echo "  cocoon_test_viz    - Run test + visualize results"
	@echo ""
	@echo "INITIAL CONDITION GENERATION:"
	@echo "  cocoon_generate_ic - Generate custom IC from analytic profile"
	@echo "  download_sample    - Create sample test data (no download needed)"
	@echo ""
	@echo "SIMULATION TARGETS:"
	@echo "  cocoon_1d_run      - Run 1D fiducial cocoon simulation"
	@echo "  grb170817a_run     - Run GRB 170817A-like simulation"
	@echo ""
	@echo "VISUALIZATION:"
	@echo "  cocoon_viz         - Generate radial profile plots"
	@echo "  cocoon_animate     - Create evolution animation"
	@echo ""
	@echo "WORKFLOW TARGETS:"
	@echo "  cocoon_1d_all      - Full workflow: IC + simulation + viz"
	@echo "  grb170817a_all     - Full GRB 170817A comparison workflow"
	@echo ""
	@echo "UTILITIES:"
	@echo "  download_radice    - Download Radice+2018 data from Zenodo"
	@echo "  clean_results      - Remove all results"
	@echo ""
	@echo "EXAMPLE:"
	@echo "  make -j4 DIM=2  # Build for 2D"
	@echo "  make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_2d_test"
	@echo ""

# ================================================================================
# Quick Test Target (using built-in blast wave)
# ================================================================================

cocoon_test: $(BUILD_DIR)/sph
	@echo "========================================"
	@echo "� Running Cocoon Test (Blast Wave)"
	@echo "========================================"
	@if [ "$(shell head -c 4 $(BUILD_DIR)/sph | xxd -p)" = "7f454c46" ] || \
	   file $(BUILD_DIR)/sph | grep -q "Mach-O"; then \
		echo "Build found: $(BUILD_DIR)/sph"; \
	else \
		echo "❌ Error: Need to build for 1D first: make -j4 DIM=1"; \
		exit 1; \
	fi
	@mkdir -p $(RESULTS_TEST)
	@echo "Config: $(CONFIG_TEST)"
	./$(BUILD_DIR)/sph $(CONFIG_TEST)
	@echo "========================================" 
	@echo "✓ Test simulation complete!"
	@echo "Results: $(RESULTS_TEST)/"
	@echo "========================================"

cocoon_test_viz: cocoon_test
	@echo "========================================"
	@echo "� Visualizing Test Results"
	@echo "========================================"
	$(PYTHON) $(SCRIPTS_DIR)/bns_cocoon_visualize.py $(RESULTS_TEST) \
		--profile --shock --no-show
	@echo "✓ Plots saved to $(RESULTS_TEST)/"

# ================================================================================
# IC Generation and Simulation Targets
# ================================================================================

cocoon_generate_ic:
	@echo "========================================"
	@echo "📐 Generating Custom Cocoon IC"
	@echo "========================================"
	@mkdir -p $(DATA_DIR)/ic
	$(PYTHON) $(SCRIPTS_DIR)/generate_cocoon_ic.py \
		--n-particles 10000 \
		--gamma-cocoon 5.0 \
		--r-cocoon 0.1 \
		--v-min 0.05 \
		--v-max 0.30 \
		--output $(DATA_DIR)/ic/cocoon_1d_ic.csv \
		--plot
	@echo "✓ IC generated: $(DATA_DIR)/ic/cocoon_1d_ic.csv"

cocoon_1d_run: $(BUILD_DIR)/sph
	@echo "========================================"
	@echo "🚀 Running 1D Cocoon Simulation (Fiducial)"
	@echo "========================================"
	@echo "Config: $(CONFIG_FIDUCIAL)"
	@mkdir -p $(RESULTS_FIDUCIAL)
	./$(BUILD_DIR)/sph $(CONFIG_FIDUCIAL)
	@echo "✓ Simulation complete!"
	@echo "Results: $(RESULTS_FIDUCIAL)/"

grb170817a_run: $(BUILD_DIR)/sph
	@echo "========================================"
	@echo "🚀 Running GRB 170817A-like Simulation"
	@echo "========================================"
	@echo "Config: $(CONFIG_GRB)"
	@mkdir -p $(RESULTS_GRB)
	./$(BUILD_DIR)/sph $(CONFIG_GRB)
	@echo "✓ Simulation complete!"
	@echo "Results: $(RESULTS_GRB)/"

# ================================================================================
# Visualization Targets
# ================================================================================

cocoon_viz:
	@if [ ! -d "$(RESULTS_TEST)" ] && [ ! -d "$(RESULTS_FIDUCIAL)" ]; then \
		echo "❌ Error: No results found. Run simulation first:"; \
		echo "   make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_test"; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "📊 Generating Visualization"
	@echo "========================================"
	@if [ -d "$(RESULTS_TEST)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/bns_cocoon_visualize.py $(RESULTS_TEST) \
			--profile --shock --observables --no-show; \
	elif [ -d "$(RESULTS_FIDUCIAL)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/bns_cocoon_visualize.py $(RESULTS_FIDUCIAL) \
			--profile --shock --observables --no-show; \
	fi
	@echo "✓ Plots generated"

cocoon_animate:
	@if [ ! -d "$(RESULTS_TEST)" ] && [ ! -d "$(RESULTS_FIDUCIAL)" ]; then \
		echo "❌ Error: No results found. Run simulation first."; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "🎬 Creating Animation"
	@echo "========================================"
	@if [ -d "$(RESULTS_TEST)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/bns_cocoon_visualize.py $(RESULTS_TEST) \
			--animate --no-show; \
	elif [ -d "$(RESULTS_FIDUCIAL)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/bns_cocoon_visualize.py $(RESULTS_FIDUCIAL) \
			--animate --no-show; \
	fi
	@echo "✓ Animation created"

# ================================================================================
# Full Workflow Targets
# ================================================================================

cocoon_1d_all: cocoon_generate_ic cocoon_1d_run cocoon_viz cocoon_animate
	@echo "========================================"
	@echo "✓ Complete 1D Cocoon Workflow Done!"
	@echo "========================================"
	@echo "Results: $(RESULTS_FIDUCIAL)/"

grb170817a_all: grb170817a_run cocoon_viz
	@echo "========================================"
	@echo "✓ Complete GRB 170817A Workflow Done!"
	@echo "========================================"
	@echo "Results: $(RESULTS_GRB)/"

# ================================================================================
# 2D Simulation Targets (C++ built-in samples)
# ================================================================================

RESULTS_2D_TEST := $(RESULTS_DIR)/test
RESULTS_2D      := $(RESULTS_DIR)/2d
CONFIG_2D_TEST  := $(TEST_DIR)/config/bns_cocoon_2d_test.json
CONFIG_2D       := $(TEST_DIR)/config/bns_cocoon_2d.json

cocoon_2d_test: $(BUILD_DIR)/sph
	@echo "========================================"
	@echo " Running 2D Cocoon Quick Test"
	@echo "========================================"
	@mkdir -p $(RESULTS_2D_TEST)
	./$(BUILD_DIR)/sph $(CONFIG_2D_TEST)
	@echo "========================================"
	@echo "✓ 2D test simulation complete!"
	@echo "Results: $(RESULTS_2D_TEST)/"
	@echo "========================================"

cocoon_2d_run: $(BUILD_DIR)/sph
	@echo "========================================"
	@echo " Running 2D Cocoon Full Simulation"
	@echo "========================================"
	@mkdir -p $(RESULTS_2D)
	./$(BUILD_DIR)/sph $(CONFIG_2D)
	@echo "========================================"
	@echo "✓ 2D simulation complete!"
	@echo "Results: $(RESULTS_2D)/"
	@echo "========================================"

cocoon_2d_viz:
	@if [ ! -d "$(RESULTS_2D_TEST)" ] && [ ! -d "$(RESULTS_2D)" ]; then \
		echo "❌ Error: No 2D results found. Run simulation first:"; \
		echo "   make -f sample/bns_cocoon/Makefile.bns_cocoon cocoon_2d_test"; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "📊 Visualizing 2D Results"
	@echo "========================================"
	@if [ -d "$(RESULTS_2D)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/visualization/plot_snapshot_2d.py \
			--input $(RESULTS_2D) --output $(RESULTS_2D)/plots; \
	elif [ -d "$(RESULTS_2D_TEST)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/visualization/plot_snapshot_2d.py \
			--input $(RESULTS_2D_TEST) --output $(RESULTS_2D_TEST)/plots; \
	fi
	@echo "✓ 2D plots generated"

cocoon_2d_animate:
	@if [ ! -d "$(RESULTS_2D_TEST)" ] && [ ! -d "$(RESULTS_2D)" ]; then \
		echo "❌ Error: No 2D results found. Run simulation first."; \
		exit 1; \
	fi
	@echo "========================================"
	@echo "🎬 Creating 2D Animation"
	@echo "========================================"
	@if [ -d "$(RESULTS_2D)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/visualization/animate_2d.py \
			--input $(RESULTS_2D) \
			--output $(RESULTS_2D)/animation/bns_cocoon_2d.gif; \
	elif [ -d "$(RESULTS_2D_TEST)" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/visualization/animate_2d.py \
			--input $(RESULTS_2D_TEST) \
			--output $(RESULTS_2D_TEST)/animation/bns_cocoon_2d.gif; \
	fi
	@echo "✓ 2D animation created"

# ================================================================================
# Utility Targets
# ================================================================================

download_radice:
	@echo "========================================"
	@echo "📥 Downloading Radice+2018 Data"
	@echo "========================================"
	$(PYTHON) $(SCRIPTS_DIR)/download_radice_data.py --list
	@echo ""
	@echo "To download default file:"
	@echo "  $(PYTHON) $(SCRIPTS_DIR)/download_radice_data.py"
	@echo ""
	@echo "Or download manually from:"
	@echo "  https://zenodo.org/record/1298474"

download_sample:
	@echo "========================================"
	@echo "📥 Creating Sample Test Data"
	@echo "========================================"
	$(PYTHON) $(SCRIPTS_DIR)/download_radice_data.py --sample
	@echo "✓ Sample data created in $(DATA_DIR)/radice2018/"

clean_results:
	@echo "🧹 Cleaning results..."
	rm -rf $(RESULTS_DIR)/*
	@echo "✓ Done"

# ================================================================================
# Build dependency
# ================================================================================

$(BUILD_DIR)/sph:
	@echo "========================================"
	@echo "❌ SPH executable not found!"
	@echo "========================================"
	@echo "Please build the code first:"
	@echo ""
	@echo "  For 1D simulations:"
	@echo "    make -j4 DIM=1"
	@echo ""
	@echo "  For 2D simulations:"
	@echo "    make -j4 DIM=2"
	@echo ""
	@exit 1
