{
  "name": "simulation_10k_b3pc_nocool",
  "description": "IMBH tidal disruption WITHOUT Koyama-Inutsuka cooling (adiabatic evolution)",
  
  "comment": "=== IMBH-Cloud Tidal Disruption from Relaxed IC (NO COOLING) ===",
  "comment2": "This configuration loads snapshot_0032.csv from ic_relax_10k",
  "comment3": "CORRECT PHYSICS: IMBH stationary at origin, cloud at [-20,3,0]pc moving with v=[10,0,0]km/s",
  "comment4": "Impact parameter b=3pc (strong tidal disruption expected)",
  "comment5": "ADIABATIC evolution - no thermal equilibrium, shock heating preserved",
  
  "units": {
    "type": "IMBH_ENCOUNTER",
    "length_pc": 1.0,
    "mass_1e3Msun": 1.0,
    "velocity_kms": 1.0,
    "comment": "IMBH Encounter units: [L]=1pc, [M]=1000 M_☉, [V]=km/s, [T]=0.978 kyr",
    "comment2": "With these units:",
    "comment3": "  - M_BH = 10^5 M_☉ = 100 code_mass",
    "comment4": "  - M_cloud = 10^4 M_☉ = 10 code_mass (recommended for 10k particles)",
    "comment5": "  - R_cloud = 5 pc = 5 code_length (from RESEARCH_SETUP.md Table A)",
    "comment6": "  - v = 10 km/s = 10 code_velocity",
    "comment7": "  - Time unit: t = L/V = 1pc / 1km/s = 0.978 kyr"
  },
  
  "outputDirectory": "sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool",
  "outputFormat": "csv",
  "enableEnergyFile": true,
  
  "SPHType": "gdisph",
  "use2ndOrderGSPH": false,
  "kernel": "wendland",
  "neighborNumber": 50,
  "gamma": 1.6666666666666667,
  
  "cflSound": 0.3,
  "cflForce": 0.125,
  
  "avAlpha": 1.0,
  "useBalsaraSwitch": true,
  "useTimeDependentAV": false,
  
  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true,
  "periodic": false,
  
  "startTime": 0.0,
  "endTime": 4.0,
  "outputTime": 0.02,
  
  "useGravity": true,
  "G": 1.0,
  
  "resumeFromSnapshot": "sample/imbh_cloud/results/ic_relax_10k/snapshot_0032.csv",
  "resetTimeOnResume": true,
  
  "physics": {
    "gamma": 1.6666666666666667,
    "gravitational_constant": 1.0,
    "use_gravity": true
  },
  
  "checkpoint": {
    "enabled": true,
    "saveInterval": 500,
    "directory": "sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool/checkpoints",
    "saveOnExit": true,
    "maxCheckpoints": 5,
    "autoResume": false,
    "resumeFile": "sample/imbh_cloud/results/ic_relax_10k/snapshot_0032.csv",
    "resetTimeOnResume": true
  },
  
  "imbh_parameters": {
    "enabled": true,
    "comment": "Correct physics: IMBH stationary, cloud moves toward it",
    "M_BH": 100000.0,
    "BH_initial_position": {
      "0": 0.0,
      "1": 0.0,
      "2": 0.0
    },
    "BH_initial_velocity": {
      "0": 0.0,
      "1": 0.0,
      "2": 0.0
    },
    "cloud_initial_position": {
      "0": -20.0,
      "1": 3.0,
      "2": 0.0
    },
    "cloud_initial_velocity": {
      "0": 10.0,
      "1": 0.0,
      "2": 0.0
    },
    "cloud_scale_factor": 0.005,
    "comment_scale": "Relaxation creates cloud with R~1 code unit. Scale to R~5pc=0.005kpc. Factor = 5pc/1000pc = 0.005",
    "impact_parameter_b": 3.0,
    "softening_epsilon": 0.05,
    "note": "IMBH at origin (standard frame). Cloud starts at [-20,3,0]pc, velocity [10,0,0]km/s. Impact parameter b=3pc (y-offset)."
  },
  
  "numerical": {
    "neighbor_number": 50,
    "kernel": "wendland",
    "SPHType": "gdisph",
    "use_gravity": true,
    "periodic": false,
    "iterative_smoothing_length": true,
    "max_tree_level": 20,
    "leaf_particle_number": 32
  },
  
  "simulation": {
    "start_time": 0.0,
    "end_time": 2.0,
    "output_time": 0.02,
    "energy_time": 0.01,
    "output_directory": "sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool",
    "comment": "end_time = 2.0 Myr ≈ 4 crossing times (R/v = 5pc/10km/s = 0.49 Myr)"
  },
  
  "timestep": {
    "CFL_sound": 0.3,
    "CFL_force": 0.25,
    "max_timestep": 0.01,
    "comment": "Conservative timestep for tidal dynamics"
  },
  
  "artificial_viscosity": {
    "alpha": 1.0,
    "use_balsara_switch": true,
    "use_time_dependent_av": true,
    "alpha_max": 2.0,
    "alpha_min": 0.1,
    "use_artificial_conductivity": false
  },
  
  "thermal": {
    "enable_cooling": false,
    "comment": "NO COOLING - adiabatic evolution only (γ=5/3)",
    "comment2": "Shock heating will be preserved, no thermal equilibrium"
  },
  
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  }
}
