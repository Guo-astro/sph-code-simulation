{
  "name": "hydro_10k_GSPH_long",
  "description": "Hydrostatic equilibrium test - 10k particles, GSPH (pure Riemann), long duration",
  
  "scenario": {
    "size": "10k",
    "duration": "long",
    "end_time": 1000,
    "purpose": "Extended stability verification with GSPH"
  },
  
  "resumeFromSnapshot": "sample/imbh_cloud/results/relaxation/10k/GSPH/snapshot_0400.csv",
  "resetTimeOnResume": true,
  
  "outputDirectory": "sample/imbh_cloud/results/hydrostatic/10k/GSPH_long",
  "outputFormat": "csv",
  "enableEnergyFile": true,
  
  "SPHType": "gsph",
  "use2ndOrderGSPH": false,
  "kernel": "wendland",
  "neighborNumber": 50,
  "riemannSolver": "hll",
  
  "useGravity": true,
  "G": 1.0,
  "theta": 0.5,
  
  "periodic": false,
  
  "cflSound": 0.3,
  "cflForce": 0.125,
  
  "startTime": 0.0,
  "endTime": 1000.0,
  "outputTime": 10.0,
  
  "gamma": 1.666666667,
  
  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true
}
