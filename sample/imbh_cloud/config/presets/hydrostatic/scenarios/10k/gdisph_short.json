{
  "name": "hydro_10k_GDISPH_short",
  "description": "Hydrostatic equilibrium test - 10k particles, GDISPH, short duration",
  
  "scenario": {
    "size": "10k",
    "duration": "short",
    "end_time": 100,
    "purpose": "Quick stability check"
  },
  
  "resumeFromSnapshot": "sample/imbh_cloud/results/relaxation/10k/GDISPH/snapshot_0400.csv",
  "resetTimeOnResume": true,
  
  "outputDirectory": "sample/imbh_cloud/results/hydrostatic/10k/GDISPH_short",
  "outputFormat": "csv",
  "enableEnergyFile": true,
  
  "SPHType": "gdisph",
  "use2ndOrderGSPH": false,
  "kernel": "wendland",
  "neighborNumber": 50,
  "riemannSolver": "hll",
  
  "avAlpha": 0.0,
  "useBalsaraSwitch": true,
  "useTimeDependentAV": false,
  
  "useGravity": true,
  "G": 1.0,
  "theta": 0.5,
  
  "periodic": false,
  
  "cflSound": 0.3,
  "cflForce": 0.125,
  
  "startTime": 0.0,
  "endTime": 100.0,
  "outputTime": 1.0,
  
  "gamma": 1.666666667,
  
  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true
}
