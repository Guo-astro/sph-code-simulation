{
  "name": "hydro_10k_GSPH",
  "description": "Hydrostatic equilibrium test - 10k particles, GSPH with exact Riemann solver",
  
  "resumeFromSnapshot": "sample/imbh_cloud/results/relaxation/10k/GSPH/snapshot_0020.csv",
  "resetTimeOnResume": true,
  
  "outputDirectory": "sample/imbh_cloud/results/hydrostatic/10k/GSPH",
  "outputFormat": "csv",
  "enableEnergyFile": true,
  
  "SPHType": "gsph",
  "use2ndOrderGSPH": false,
  "kernel": "wendland",
  "neighborNumber": 50,
  "riemannSolver": "iterative",
  
  "useGravity": true,
  "G": 1.0,
  "theta": 0.5,
  
  "periodic": false,
  
  "cflSound": 0.3,
  "cflForce": 0.125,
  
  "startTime": 0.0,
  "endTime": 100.0,
  "outputTime": 1.0,
  
  "gamma": 1.666666667,
  
  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true
}
