{
  "name": "hydro_200k_GDISPH_short",
  "description": "Hydrostatic equilibrium test - 200k particles, GDISPH, short duration (production)",
  
  "scenario": {
    "size": "200k",
    "duration": "short",
    "end_time": 100,
    "purpose": "Production stability check"
  },
  
  "resumeFromSnapshot": "sample/imbh_cloud/results/relaxation/200k/GDISPH/snapshot_0050.csv",
  "resetTimeOnResume": true,
  
  "outputDirectory": "sample/imbh_cloud/results/hydrostatic/200k/GDISPH_short",
  "outputFormat": "csv",
  "enableEnergyFile": true,
  
  "SPHType": "gdisph",
  "use2ndOrderGSPH": true,
  "kernel": "wendland",
  "neighborNumber": 50,
  "riemannSolver": "hll",
  
  "avAlpha": 0.0,
  "useBalsaraSwitch": true,
  "useTimeDependentAV": false,
  
  "useGravity": true,
  "G": 1.0,
  "theta": 0.5,
  
  "periodic": false,
  
  "cflSound": 0.3,
  "cflForce": 0.125,
  
  "startTime": 0.0,
  "endTime": 100.0,
  "outputTime": 1.0,
  
  "gamma": 1.666666667,
  
  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true
}
