{
  "name": "relax_61k_GDISPH",
  "description": "Lane-Emden 3D Relaxation - 61k particles with GDISPH method (high resolution for 5% accuracy)",
  
  "scenario": {
    "size": "61k",
    "particles": "~64,000 (N=40)",
    "steps": 200000,
    "derivation": "SPH error ε ~ N^(-2/3), need ~61k for 5% accuracy on ρ_c"
  },
  
  "N": 40,
  "sample": "lane_emden",
  
  "relaxationSteps": 200000,
  "relaxationOutputFreq": 1000,
  "relaxationOnly": true,
  "useRelaxation": true,
  
  "outputDirectory": "sample/imbh_cloud/results/relaxation/61k/GDISPH",
  "outputFormat": "csv",
  "enableEnergyFile": true,
  
  "SPHType": "gdisph",
  "use2ndOrderGSPH": false,
  "kernel": "wendland",
  "neighborNumber": 50,
  "riemannSolver": "hll",
  
  "avAlpha": 1.0,
  "useBalsaraSwitch": true,
  "useTimeDependentAV": false,
  
  "useGravity": false,
  "periodic": false,
  
  "cflSound": 0.3,
  "cflForce": 0.125,
  
  "startTime": 0.0,
  "endTime": 0.0,
  "outputTime": 0.01,
  
  "gamma": 1.666666667,
  
  "maxTreeLevel": 20,
  "leafParticleNumber": 1,
  "iterativeSmoothingLength": true
}
