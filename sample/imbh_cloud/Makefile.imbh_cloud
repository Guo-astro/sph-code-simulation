# ============================================================================
# IMBH-Molecular Cloud Tidal Disruption Makefile
# ============================================================================
#
# Simulates intermediate-mass black hole (M_BH ~ 10^5 M_☉) tidal disruption
# of molecular clouds with impact parameters b = 3-6 parsecs.
#
# Physics:
#   - 3D Lane-Emden sphere (polytropic index n=1.5, γ=5/3)
#   - Koyama & Inutsuka (2000) thermal equilibrium
#   - GDISPH method for tidal disruption dynamics
#
# Usage Examples:
# ===============
#
# Single run (b = 3 pc):
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_b3pc_run
#
# Parameter scan (b = 3, 4, 5, 6 pc):
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_run
#
# Visualization:
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_visualize
#
# Clean all results:
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_clean
#
# ============================================================================

# Path definitions
IMBH_DIR := sample/imbh_cloud
PRESET_DIR := $(IMBH_DIR)/config/presets
RESULTS_DIR := $(IMBH_DIR)/results
SCRIPTS_DIR := $(IMBH_DIR)/scripts

# Targets are phony (always run)
.PHONY: imbh_help imbh_quick_test \
        imbh_relax_2k imbh_relax_2k_viz \
        imbh_relax_200k imbh_relax_200k_viz \
        imbh_relax_resume \
        imbh_hydrostatic_2k imbh_hydrostatic_2k_viz \
        imbh_hydrostatic_200k imbh_hydrostatic_200k_viz \
        imbh_b3pc_run imbh_b6pc_run \
        imbh_scan_impact imbh_scan_velocity imbh_scan_full \
        imbh_visualize imbh_compare_impact imbh_compare_velocity \
        imbh_clean imbh_relax_clean imbh_check_dim

# ============================================================================
# Help Target
# ============================================================================

imbh_help:
	@echo "=========================================="
	@echo "  IMBH-Cloud Tidal Disruption Targets"
	@echo "=========================================="
	@echo ""
	@echo "Quick Test & Relaxation:"
	@echo "  imbh_quick_test     - ONE-SHOT: Relaxation test (legacy, see imbh_relax_2k)"
	@echo "  imbh_relax_2k       - TESTING: 2k particles (N=22), 20k steps - fast test run"
	@echo "  imbh_relax_2k_viz   - Visualize 2k particle relaxation results"
	@echo "  imbh_relax_200k     - PRODUCTION: 200k particles (N=100), 100k steps"
	@echo "  imbh_relax_200k_viz - Visualize 200k particle relaxation results"
	@echo "  imbh_relax_resume   - Resume relaxation from checkpoint (requires SNAPSHOT=path)"
	@echo "                        Example: make imbh_relax_resume SNAPSHOT=results/.../snapshot_0021.csv"
	@echo ""
	@echo "Hydrostatic Self-Gravity Test (NEW!):"
	@echo "  imbh_hydrostatic_2k      - TESTING: Test self-gravity on relaxed 2k sphere (10 t_cross)"
	@echo "  imbh_hydrostatic_2k_viz  - Visualize 2k hydrostatic test results"
	@echo "  imbh_hydrostatic_200k    - PRODUCTION: Test self-gravity on relaxed 200k sphere"
	@echo "  imbh_hydrostatic_200k_viz - Visualize 200k hydrostatic test results"
	@echo "  Note: Must run relaxation first! Tests stability >> tidal disruption timescale"
	@echo ""
	@echo "Single Runs:"
	@echo "  imbh_b3pc_run    - Run with impact parameter b=3pc, v=10km/s"
	@echo "  imbh_b6pc_run    - Run with impact parameter b=6pc, v=10km/s"
	@echo ""
	@echo "Parameter Scans:"
	@echo "  imbh_scan_impact - Impact parameter scan: b=3,4,5,6 pc (v=10km/s fixed) [4 runs]"
	@echo "  imbh_scan_velocity - Velocity scan: v=0,5,10,15,20 km/s (b=4pc fixed) [5 runs]"
	@echo "  imbh_scan_full   - Full matrix scan: 4 impact x 5 velocity [20 runs]"
	@echo ""
	@echo "Comparison & Visualization:"
	@echo "  imbh_compare_impact   - Generate impact parameter comparison plots"
	@echo "  imbh_compare_velocity - Generate velocity comparison plots"
	@echo "  imbh_visualize        - Generate all IMBH disruption plots and animations"
	@echo "                          (NOTE: For relaxation viz, use imbh_relax_viz)"
	@echo ""
	@echo "Cleanup:"
	@echo "  imbh_clean       - Remove all results"
	@echo "  imbh_relax_clean - Remove only relaxation results"
	@echo ""
	@echo "Examples:"
	@echo "  # Complete workflow (relaxation + hydrostatic + IMBH):"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_2k"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_hydrostatic_2k"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_b3pc_run"
	@echo ""
	@echo "  # Production workflow:"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_200k"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_hydrostatic_200k"
	@echo ""
	@echo "  # Visualization only:"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_2k_viz"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_hydrostatic_2k_viz"
	@echo ""

# ============================================================================
# Dimension Check
# ============================================================================

imbh_check_dim: build/sph
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
		echo "❌ Error: IMBH-cloud simulation requires DIM=3"; \
		echo ""; \
		echo "Current build is configured for DIM=$$(grep 'SPH_DIM:STRING=' build/CMakeCache.txt 2>/dev/null | cut -d'=' -f2 || echo 'unknown')"; \
		echo ""; \
		echo "To fix:"; \
		echo "  1. Reconfigure CMake: cd ../../build && cmake -DSPH_DIM=3 .."; \
		echo "  2. Rebuild: make clean && make -j8"; \
		echo "  3. Re-run this target"; \
		exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

# ============================================================================
# Quick Test Target - ONE-SHOT: Legacy Particle Lane-Emden Relaxation + Viz
# ============================================================================

imbh_quick_test: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ONE-SHOT: Lane-Emden Relaxation Test (Legacy)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "⚠️  NOTE: This is a legacy target. For new work, use:"
	@echo "    • imbh_relax_2k (testing: 2k particles)"
	@echo "    • imbh_relax_200k (production: 200k particles)"
	@echo ""
	@echo "This will perform:"
	@echo "  1. 3D Lane-Emden n=1.5 sphere generation (legacy configuration)"
	@echo "  2. Relaxation: 500 steps with analytical force"
	@echo "  3. Automatic visualization and quality checks"
	@echo ""
	@echo "Expected runtime: ~2-5 minutes"
	@echo ""
	@read -p "Press Enter to continue or Ctrl+C to cancel..." dummy
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/3: Creating results directory"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/lane_emden_50k_relax
	@echo "✓ Directory created: $(RESULTS_DIR)/lane_emden_50k_relax"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/3: Running relaxation simulation"
	@echo "════════════════════════════════════════════════════════"
	@echo "Parameters:"
	@echo "  - N_shells: 37 (→ ~50,653 particles = 37³)"
	@echo "  - Polytropic index: n=1.5 (γ=5/3)"
	@echo "  - Relaxation steps: 500"
	@echo "  - Output frequency: every 50 steps"
	@echo "  - SPH method: GDISPH with Wendland kernel"
	@echo ""
	@echo "Starting simulation (this will take 2-5 minutes)..."
	@echo ""
	@chmod +x $(SCRIPTS_DIR)/run_lane_emden_50k.sh
	@$(SCRIPTS_DIR)/run_lane_emden_50k.sh || \
		(echo "❌ Simulation failed! Check $(RESULTS_DIR)/lane_emden_50k_relax/run.log"; exit 1)
	@echo ""
	@if [ -f $(RESULTS_DIR)/lane_emden_50k_relax/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Quick stats:"; \
		tail -3 $(RESULTS_DIR)/lane_emden_50k_relax/energy.dat | head -1; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/3: Generating visualizations"
	@echo "════════════════════════════════════════════════════════"
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/lane_emden_50k_relax \
		$(RESULTS_DIR)/lane_emden_50k_relax || \
		(echo "⚠️  Visualization failed (plots may require matplotlib)"; echo "   Data is still available in results directory")
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ ONE-SHOT TEST COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results location:"
	@echo "   $(RESULTS_DIR)/lane_emden_50k_relax/"
	@echo ""
	@echo "� Generated files:"
	@echo "   - snapshot_*.csv      : Particle data at each output"
	@echo "   - energy.dat          : Energy evolution (check conservation)"
	@echo "   - relaxation_summary.png : Comprehensive visualization"
	@echo "   - run.log             : Full simulation log"
	@echo ""
	@echo "🔍 Quality checks:"
	@if [ -f $(RESULTS_DIR)/lane_emden_50k_relax/relaxation_summary.png ]; then \
		echo "   ✓ Visualization generated"; \
	else \
		echo "   ⚠  Visualization not created (matplotlib may be needed)"; \
	fi
	@echo ""
	@echo "📈 View results:"
	@echo "   open $(RESULTS_DIR)/lane_emden_50k_relax/relaxation_summary.png"
	@echo ""
	@echo "Next steps for IMBH research:"
	@echo "  1. Verify relaxation converged (velocities → 0)"
	@echo "  2. Check density profile matches Lane-Emden theory"
	@echo "  3. If successful, proceed with IMBH integration"
	@echo "  4. Add Koyama-Inutsuka thermal equilibrium"
	@echo "  5. Include external BH force and tidal disruption"
	@echo ""

# ============================================================================
# Testing Relaxation: 2k Particles (N=22), 20k Steps
# ============================================================================

imbh_relax_2k: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 Lane-Emden Relaxation - TESTING (2k particles)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "This workflow will:"
	@echo "  1. Generate 3D Lane-Emden n=1.5 sphere (N=22 → ~2,130 particles)"
	@echo "  2. Run relaxation: 20,000 steps with analytical force"
	@echo "  3. Create animation with analytic solution overlay"
	@echo "  4. Generate comparison plots (SPH vs analytic density profile)"
	@echo ""
	@echo "Expected runtime: ~2-5 minutes (simulation + visualization)"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/4: Setup"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/lane_emden_2k_relax
	@echo "✓ Results directory: $(RESULTS_DIR)/lane_emden_2k_relax"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/4: Running Relaxation Simulation"
	@echo "════════════════════════════════════════════════════════"
	@echo "Configuration:"
	@echo "  • Particle count: ~2,130 (N=22, using N³/5 formula)"
	@echo "  • Polytropic index: n=1.5 (γ=5/3)"
	@echo "  • Relaxation steps: 20,000"
	@echo "  • Output frequency: 1000 steps → 21 snapshots"
	@echo "  • SPH method: GDISPH + Balsara viscosity limiter"
	@echo "  • Kernel: Wendland C4"
	@echo "  • Unit system: CODE UNITS (M=1, R=1, ρ_c=1.43)"
	@echo ""
	@echo "Lane-Emden Solution Parameters:"
	@echo "  • ξ₁ = 3.6537540101 (first zero)"
	@echo "  • α = R/ξ₁ = 0.273691 (scaling factor)"
	@echo "  • ρ_center = 1.43 [code units]"
	@echo "  • M_total = 1.0 [code units]"
	@echo ""
	@echo "Starting simulation (2-5 minutes)..."
	@./build/sph $(PRESET_DIR)/lane_emden_2k_relax.json 2>&1 | tee $(RESULTS_DIR)/lane_emden_2k_relax/run.log || \
		(echo "❌ Simulation failed! Check $(RESULTS_DIR)/lane_emden_2k_relax/run.log"; exit 1)
	@echo ""
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Energy conservation check:"; \
		tail -1 $(RESULTS_DIR)/lane_emden_2k_relax/energy.dat; \
		SNAPSHOT_COUNT=$$(ls -1 $(RESULTS_DIR)/lane_emden_2k_relax/snapshot_*.csv 2>/dev/null | wc -l); \
		echo "📁 Snapshots generated: $$SNAPSHOT_COUNT"; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/4: Creating Animation with Analytic Overlay"
	@echo "════════════════════════════════════════════════════════"
	@echo "Generating 6-panel animation:"
	@echo "  • 3D density distribution"
	@echo "  • XY slice (|z| < 0.1)"
	@echo "  • XZ slice (|y| < 0.1)"
	@echo "  • Radial density profile (SPH vs analytic Lane-Emden)"
	@echo "  • Velocity magnitude histogram"
	@echo "  • Energy evolution"
	@echo ""
	@echo "This will take 1-3 minutes..."
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/lane_emden_2k_relax \
		$(RESULTS_DIR)/lane_emden_2k_relax || \
		(echo "⚠️  Visualization failed (matplotlib required)"; echo "   Simulation data is still valid")
	@echo ""
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif | cut -f1); \
		echo "✓ Animation created: relaxation_animation.gif ($$GIF_SIZE)"; \
	else \
		echo "⚠️  Animation not created (check matplotlib installation)"; \
	fi
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_summary.png ]; then \
		echo "✓ Summary plot created: relaxation_summary.png"; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 4/4: Quality Verification"
	@echo "════════════════════════════════════════════════════════"
	@echo "Checking relaxation quality..."
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/snapshot_0020.csv ]; then \
		python3 -c "import numpy as np; import sys; data = np.loadtxt('$(RESULTS_DIR)/lane_emden_2k_relax/snapshot_0020.csv', delimiter=',', skiprows=61); vel = data[:, 4:7]; v_mag = np.sqrt(np.sum(vel**2, axis=1)); rho = data[:, 11]; r = np.sqrt(np.sum(data[:, 1:4]**2, axis=1)); print(f'  • Final velocity: max={v_mag.max():.6f}, median={np.median(v_mag):.6f} [code units]'); print(f'  • Density range: [{rho.min():.3f}, {rho.max():.3f}] [code units]'); print(f'  • Particle radius: [0, {r.max():.3f}] [code units]'); central = rho[r < 0.05]; print(f'  • Central density (r<0.05): mean={central.mean():.3f} (analytic ρ_c=1.43)') if len(central) > 0 else print('  ⚠️  No particles in central region (r<0.05)')"; \
	else \
		echo "  ⚠️  Final snapshot not found"; \
	fi
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ RELAXATION WORKFLOW COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results location:"
	@echo "   $(RESULTS_DIR)/lane_emden_2k_relax/"
	@echo ""
	@echo "📊 Generated files:"
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif ]; then \
		echo "   ✓ relaxation_animation.gif - 6-panel animation with analytic overlay"; \
	fi
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_summary.png ]; then \
		echo "   ✓ relaxation_summary.png   - Final state summary"; \
	fi
	@echo "   ✓ snapshot_*.csv           - Particle data (21 snapshots)"
	@echo "   ✓ energy.dat               - Energy evolution"
	@echo "   ✓ run.log                  - Simulation log"
	@echo ""
	@echo "🎬 View animation:"
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif ]; then \
		echo "   open $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif"; \
	else \
		echo "   (Animation not available - install matplotlib)"; \
	fi
	@echo ""
	@echo "📈 View summary:"
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_summary.png ]; then \
		echo "   open $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_summary.png"; \
	else \
		echo "   (Summary plot not available - install matplotlib)"; \
	fi
	@echo ""
	@echo "✅ Quality checks:"
	@echo "   • Animation shows density evolution with Lane-Emden analytic overlay"
	@echo "   • Radial profile compares SPH vs analytic ρ(r) = ρ_c θ^1.5"
	@echo "   • Velocities should decay toward zero (thermal equilibrium)"
	@echo "   • Energy should be conserved (small fluctuations OK)"
	@echo ""
	@echo "📝 Next steps:"
	@echo "   1. Verify density profile matches analytic solution in animation"
	@echo "   2. Check velocity convergence (should approach ~0)"
	@echo "   3. For production runs, use: imbh_relax_200k"
	@echo "   4. To clean: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_clean"
	@echo ""

# ============================================================================
# Testing Relaxation Visualization Only - No Simulation
# ============================================================================

imbh_relax_2k_viz:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 Visualizing 2k Particle Relaxation Results"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/lane_emden_2k_relax" ]; then \
		echo "❌ No 2k relaxation results found!"; \
		echo "   Expected directory: $(RESULTS_DIR)/lane_emden_2k_relax"; \
		echo ""; \
		echo "   Run relaxation first:"; \
		echo "   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_2k"; \
		exit 1; \
	fi
	@SNAPSHOT_COUNT=$$(ls -1 $(RESULTS_DIR)/lane_emden_2k_relax/snapshot_*.csv 2>/dev/null | wc -l); \
	if [ $$SNAPSHOT_COUNT -lt 2 ]; then \
		echo "❌ Insufficient snapshots found (need at least 2)"; \
		echo "   Found: $$SNAPSHOT_COUNT snapshots"; \
		exit 1; \
	fi
	@echo "✓ Found results directory with $$SNAPSHOT_COUNT snapshots"
	@echo ""
	@echo "Generating 6-panel animation with analytic overlay..."
	@echo "This will take 1-3 minutes..."
	@echo ""
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/lane_emden_2k_relax \
		$(RESULTS_DIR)/lane_emden_2k_relax || \
		(echo "❌ Visualization failed!"; \
		 echo "   Check that matplotlib and numpy are installed"; \
		 echo "   pip3 install matplotlib numpy scipy"; \
		 exit 1)
	@echo ""
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif | cut -f1); \
		echo "✓ Animation created: relaxation_animation.gif ($$GIF_SIZE)"; \
	else \
		echo "❌ Animation not created"; \
		exit 1; \
	fi
	@if [ -f $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_summary.png ]; then \
		echo "✓ Summary plot created: relaxation_summary.png"; \
	fi
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ VISUALIZATION COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Output files:"
	@echo "   $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif"
	@echo "   $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_summary.png"
	@echo ""
	@echo "🎬 View animation:"
	@echo "   open $(RESULTS_DIR)/lane_emden_2k_relax/relaxation_animation.gif"
	@echo ""

# ============================================================================
# Production Relaxation: 200k Particles, 100k Steps
# ============================================================================

imbh_relax_200k: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🚀 PRODUCTION Lane-Emden Relaxation (200k particles)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "⚠️  WARNING: This is a HIGH-RESOLUTION production run!"
	@echo ""
	@echo "Configuration:"
	@echo "  • Particle count: 200,000 (N=100)"
	@echo "  • Relaxation steps: 100,000"
	@echo "  • Output frequency: 2,000 steps → 51 snapshots"
	@echo "  • Expected runtime: ~4-8 hours (hardware dependent)"
	@echo "  • Expected disk usage: ~5-10 GB"
	@echo ""
	@echo "Physics:"
	@echo "  • Polytrope: n=1.5, γ=5/3 (Lane-Emden)"
	@echo "  • SPH method: GDISPH + Balsara viscosity"
	@echo "  • Kernel: Wendland C4, N_neighbors=50"
	@echo "  • Gravity: Enabled (tree code)"
	@echo ""
	@echo "This configuration is suitable for:"
	@echo "  ✓ Production IMBH-cloud simulations"
	@echo "  ✓ High-resolution tidal disruption studies"
	@echo "  ✓ Jeans mass resolution (N_J > 50-100 particles)"
	@echo ""
	@read -p "Press Enter to continue or Ctrl+C to cancel..." dummy
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/4: Setup"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/lane_emden_200k_relax
	@echo "✓ Results directory: $(RESULTS_DIR)/lane_emden_200k_relax"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/4: Running Relaxation (4-8 hours)"
	@echo "════════════════════════════════════════════════════════"
	@echo "Starting simulation at $$(date '+%Y-%m-%d %H:%M:%S')..."
	@echo ""
	@./build/sph $(PRESET_DIR)/lane_emden_200k_relax.json 2>&1 | tee $(RESULTS_DIR)/lane_emden_200k_relax/run.log || \
		(echo "❌ Simulation failed! Check $(RESULTS_DIR)/lane_emden_200k_relax/run.log"; exit 1)
	@echo ""
	@echo "Simulation completed at $$(date '+%Y-%m-%d %H:%M:%S')"
	@if [ -f $(RESULTS_DIR)/lane_emden_200k_relax/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Final energy (last 3 timesteps):"; \
		tail -3 $(RESULTS_DIR)/lane_emden_200k_relax/energy.dat; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/4: Generating Visualizations"
	@echo "════════════════════════════════════════════════════════"
	@echo "Creating animation and plots (2-5 minutes)..."
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/lane_emden_200k_relax \
		$(RESULTS_DIR)/lane_emden_200k_relax || \
		(echo "⚠️  Visualization failed (data is still available)"; echo "   Install matplotlib: pip3 install matplotlib numpy scipy")
	@echo ""
	@if [ -f $(RESULTS_DIR)/lane_emden_200k_relax/relaxation_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/lane_emden_200k_relax/relaxation_animation.gif | cut -f1); \
		echo "✓ Animation created: relaxation_animation.gif ($$GIF_SIZE)"; \
	fi
	@if [ -f $(RESULTS_DIR)/lane_emden_200k_relax/relaxation_summary.png ]; then \
		echo "✓ Summary plot created: relaxation_summary.png"; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 4/4: Quality Verification"
	@echo "════════════════════════════════════════════════════════"
	@if [ -f $(RESULTS_DIR)/lane_emden_200k_relax/snapshot_0050.csv ]; then \
		python3 -c "import numpy as np; data = np.loadtxt('$(RESULTS_DIR)/lane_emden_200k_relax/snapshot_0050.csv', delimiter=',', skiprows=61); vel = data[:, 4:7]; v_mag = np.sqrt(np.sum(vel**2, axis=1)); rho = data[:, 11]; r = np.sqrt(np.sum(data[:, 1:4]**2, axis=1)); print(f'  • Final velocity: max={v_mag.max():.6f}, median={np.median(v_mag):.6f}'); print(f'  • Density range: [{rho.min():.3f}, {rho.max():.3f}]'); print(f'  • Negative densities: {(rho<0).sum()}/{len(rho)} particles'); central = rho[r < 0.05]; print(f'  • Central density (r<0.05): mean={central.mean():.3f} (analytic=1.43)') if len(central) > 0 else None"; \
	fi
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ PRODUCTION RELAXATION COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results: $(RESULTS_DIR)/lane_emden_200k_relax/"
	@echo ""
	@echo "📊 Generated files:"
	@echo "   ✓ 51 snapshots (snapshot_0000.csv to snapshot_0050.csv)"
	@echo "   ✓ energy.dat - Energy evolution"
	@if [ -f $(RESULTS_DIR)/lane_emden_200k_relax/relaxation_animation.gif ]; then \
		echo "   ✓ relaxation_animation.gif - 6-panel evolution"; \
	fi
	@if [ -f $(RESULTS_DIR)/lane_emden_200k_relax/relaxation_summary.png ]; then \
		echo "   ✓ relaxation_summary.png - Final state"; \
	fi
	@echo ""
	@echo "🎬 View results:"
	@if [ -f $(RESULTS_DIR)/lane_emden_200k_relax/relaxation_animation.gif ]; then \
		echo "   open $(RESULTS_DIR)/lane_emden_200k_relax/relaxation_animation.gif"; \
	fi
	@echo ""
	@echo "📝 Next steps:"
	@echo "   1. Verify relaxation quality in animation"
	@echo "   2. Check final snapshot for IMBH initial conditions"
	@echo "   3. Use snapshot_0050.csv for production IMBH runs"
	@echo "   4. Visualize only: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_200k_viz"
	@echo ""

