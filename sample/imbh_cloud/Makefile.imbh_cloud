# ============================================================================
# Resume Relaxation from Checkpoint
# ============================================================================

imbh_relax_resume: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔄 Resume Relaxation from Checkpoint"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ -z "$(SNAPSHOT)" ]; then \
		echo "❌ ERROR: SNAPSHOT parameter required!"; \
		echo ""; \
		echo "Usage:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_resume \\"; \
		echo "       SNAPSHOT=<path_to_snapshot.csv> \\"; \
		echo "       [STEPS=10000] [FREQ=500] [OUTDIR=results/resumed_relax]"; \
		echo ""; \
		echo "Example:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_resume \\"; \
		echo "       SNAPSHOT=sample/imbh_cloud/results/lane_emden_2k_relax/snapshot_0020.csv \\"; \
		echo "       STEPS=20000 FREQ=1000"; \
		echo ""; \
		echo "Parameters:"; \
		echo "  SNAPSHOT - Path to checkpoint file (required)"; \
		echo "  STEPS    - Additional relaxation steps (default: 10000)"; \
		echo "  FREQ     - Output frequency (default: 500)"; \
		echo "  OUTDIR   - Output directory (default: results/resumed_relax)"; \
		echo ""; \
		exit 1; \
	fi
	@if [ ! -f "$(SNAPSHOT)" ]; then \
		echo "❌ ERROR: Snapshot file not found!"; \
		echo "   Looking for: $(SNAPSHOT)"; \
		echo ""; \
		echo "Available snapshots from 2k run:"; \
		ls -1 $(RESULTS_DIR)/lane_emden_2k_relax/snapshot_*.csv 2>/dev/null || echo "   (none found)"; \
		echo ""; \
		echo "Available snapshots from 200k run:"; \
		ls -1 $(RESULTS_DIR)/lane_emden_200k_relax/snapshot_*.csv 2>/dev/null || echo "   (none found)"; \
		exit 1; \
	fi
	@RELAX_STEPS=$${STEPS:-10000}; \
	RELAX_FREQ=$${FREQ:-500}; \
	OUTPUT_DIR=$${OUTDIR:-$(RESULTS_DIR)/resumed_relax}; \
	SNAPSHOT_ABS=$$(cd $$(dirname $(SNAPSHOT)) && pwd)/$$(basename $(SNAPSHOT)); \
	echo "✓ Found checkpoint: $(SNAPSHOT)"; \
	echo ""; \
	echo "Configuration:"; \
	echo "  • Input snapshot: $$(basename $(SNAPSHOT))"; \
	echo "  • Additional steps: $$RELAX_STEPS"; \
	echo "  • Output frequency: $$RELAX_FREQ"; \
	echo "  • Output directory: $$OUTPUT_DIR"; \
	echo ""; \
	PARTICLE_COUNT=$$(tail -n +54 $(SNAPSHOT) | wc -l | tr -d ' '); \
	echo "  • Particles in checkpoint: $$PARTICLE_COUNT"; \
	echo ""; \
	mkdir -p $$OUTPUT_DIR; \
	echo "Creating resume configuration..."; \
	echo "{" > $$OUTPUT_DIR/resume_config.json; \
	echo "  \"comment\": \"Resume relaxation from checkpoint\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"description\": \"Continue relaxation from snapshot with $$RELAX_STEPS additional steps\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"sample\": \"lane_emden\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"N\": 22," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"alpha_scaling\": 0.273691," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"rho_center\": 1.43009692," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"K\": 0.424209," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"R\": 1.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"M_total\": 1.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"checkpoint\": {" >> $$OUTPUT_DIR/resume_config.json; \
	echo "    \"resumeFile\": \"$$SNAPSHOT_ABS\"" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  }," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"relaxationSteps\": $$RELAX_STEPS," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"relaxationOutputFreq\": $$RELAX_FREQ," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"relaxationOnly\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useRelaxation\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"outputDirectory\": \"$$OUTPUT_DIR\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"outputFormat\": \"csv\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"enableEnergyFile\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"neighborNumber\": 50," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"kernel\": \"wendland\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"SPHType\": \"gdisph\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useGravity\": false," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"periodic\": false," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"use2ndOrderGSPH\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"riemannSolver\": \"hll\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"alpha\": 1.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useBalsaraSwitch\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useTimeDependentAV\": false," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"cflSound\": 0.3," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"cflForce\": 0.125," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"startTime\": 0.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"endTime\": 0.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"outputTime\": 0.01," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"gamma\": 1.666666667," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"maxTreeLevel\": 20," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"leafParticleNumber\": 1," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"iterativeSmoothingLength\": true" >> $$OUTPUT_DIR/resume_config.json; \
	echo "}" >> $$OUTPUT_DIR/resume_config.json; \
	echo "✓ Configuration created: $$OUTPUT_DIR/resume_config.json"; \
	echo ""; \
	echo "════════════════════════════════════════════════════════"; \
	echo "  Running Resumed Relaxation"; \
	echo "════════════════════════════════════════════════════════"; \
	echo ""; \
	./build/sph $$OUTPUT_DIR/resume_config.json 2>&1 | tee $$OUTPUT_DIR/run.log || \
		(echo "❌ Simulation failed! Check $$OUTPUT_DIR/run.log"; exit 1); \
	echo ""; \
	if [ -f $$OUTPUT_DIR/energy.dat ]; then \
		echo "✓ Resumed relaxation complete!"; \
		echo ""; \
		echo "📊 Final energy:"; \
		tail -1 $$OUTPUT_DIR/energy.dat; \
		NEW_SNAPSHOT_COUNT=$$(ls -1 $$OUTPUT_DIR/snapshot_*.csv 2>/dev/null | wc -l); \
		echo "📁 New snapshots generated: $$NEW_SNAPSHOT_COUNT"; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi; \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ RESUMED RELAXATION COMPLETE!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo ""; \
	echo "📁 Results location:"; \
	echo "   $$OUTPUT_DIR/"; \
	echo ""; \
	echo "📊 Generated files:"; \
	echo "   ✓ snapshot_*.csv           - Particle data at each output"; \
	echo "   ✓ energy.dat               - Energy evolution"; \
	echo "   ✓ run.log                  - Simulation log"; \
	echo "   ✓ resume_config.json       - Configuration used"; \
	echo ""; \
	echo "📈 To visualize:"; \
	echo "   python3 $(SCRIPTS_DIR)/visualize_relaxation.py $$OUTPUT_DIR $$OUTPUT_DIR"; \
	echo ""; \
	echo "🔄 To continue further:"; \
	LAST_SNAP=$$(ls -1 $$OUTPUT_DIR/snapshot_*.csv 2>/dev/null | tail -1); \
	if [ -n "$$LAST_SNAP" ]; then \
		echo "   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_resume \\"; \
		echo "        SNAPSHOT=$$LAST_SNAP STEPS=10000"; \
	fi; \
	echo ""

# ============================================================================
# Single Run Targets
# ============================================================================

imbh_b3pc_run: imbh_check_dim
	@echo "=========================================="
	@echo "  Running IMBH Simulation (b = 3 pc)"
	@echo "=========================================="
	@echo ""
	@cp $(PRESET_DIR)/imbh_cloud_b3pc_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b3pc_gdisph
	@./build/sph imbh_cloud
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b3pc_gdisph/"
	@echo ""

imbh_b6pc_run: imbh_check_dim
	@echo "=========================================="
	@echo "  Running IMBH Simulation (b = 6 pc)"
	@echo "=========================================="
	@echo ""
	@cp $(PRESET_DIR)/imbh_cloud_b6pc_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b6pc_gdisph
	@./build/sph imbh_cloud
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b6pc_gdisph/"
	@echo ""

# ============================================================================
# Parameter Scan Targets
# ============================================================================

# Impact parameter scan (fixed velocity v=10km/s)
imbh_scan_impact: imbh_check_dim
	@echo "=========================================="
	@echo "  IMBH Impact Parameter Scan"
	@echo "  b = 3, 4, 5, 6 pc (v = 10 km/s fixed)"
	@echo "=========================================="
	@echo ""
	@echo "[1/4] Running b = 3 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b3pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b3pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=3pc, v=10km/s complete"
	@echo ""
	@echo "[2/4] Running b = 4 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=4pc, v=10km/s complete"
	@echo ""
	@echo "[3/4] Running b = 5 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b5pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b5pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=5pc, v=10km/s complete"
	@echo ""
	@echo "[4/4] Running b = 6 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b6pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b6pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=6pc, v=10km/s complete"
	@echo ""
	@echo "=========================================="
	@echo "✓ Impact parameter scan complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b*pc_v10_gdisph/"
	@echo "=========================================="

# Velocity scan (fixed impact parameter b=4pc)
imbh_scan_velocity: imbh_check_dim
	@echo "=========================================="
	@echo "  IMBH Velocity Scan"
	@echo "  v = 0, 5, 10, 15, 20 km/s (b = 4 pc fixed)"
	@echo "=========================================="
	@echo ""
	@echo "[1/5] Running v = 0 km/s (static infall)..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v0_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v0_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=0km/s complete"
	@echo ""
	@echo "[2/5] Running v = 5 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v5_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v5_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=5km/s complete"
	@echo ""
	@echo "[3/5] Running v = 10 km/s (BASELINE)..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=10km/s complete"
	@echo ""
	@echo "[4/5] Running v = 15 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v15_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v15_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=15km/s complete"
	@echo ""
	@echo "[5/5] Running v = 20 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v20_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v20_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=20km/s complete"
	@echo ""
	@echo "=========================================="
	@echo "✓ Velocity scan complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b4pc_v*_gdisph/"
	@echo "=========================================="

# Full matrix scan (4 impact x 5 velocity = 20 runs)
imbh_scan_full: imbh_check_dim
	@echo "=========================================="
	@echo "  IMBH Full Parameter Matrix Scan"
	@echo "  Impact: b = 3, 4, 5, 6 pc"
	@echo "  Velocity: v = 0, 5, 10, 15, 20 km/s"
	@echo "  Total: 20 simulations"
	@echo "=========================================="
	@echo ""
	@echo "⚠️  WARNING: This will take several hours!"
	@echo ""
	@echo "Running impact parameter scan (4 runs)..."
	@$(MAKE) -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_impact
	@echo ""
	@echo "Running velocity scan at b=3pc (5 runs)..."
	@for v in 0 5 15 20; do \
		echo "----------------------------------------"; \
		echo "Running b=3pc, v=$${v}km/s..."; \
		python3 -c "import json; \
			preset = json.load(open('$(PRESET_DIR)/imbh_cloud_b3pc_v10_gdisph.json')); \
			preset['sample']['v_x'] = -$${v} / 1.02; \
			preset['simulation']['output_directory'] = '$(RESULTS_DIR)/b3pc_v$${v}_gdisph'; \
			json.dump(preset, open('$(IMBH_DIR)/imbh_cloud.json', 'w'), indent=2)"; \
		mkdir -p $(RESULTS_DIR)/b3pc_v$${v}_gdisph; \
		./build/sph imbh_cloud; \
		echo "✓ b=3pc, v=$${v}km/s complete"; \
		echo ""; \
	done
	@echo "Running velocity scan at b=5pc (5 runs)..."
	@for v in 0 5 15 20; do \
		echo "----------------------------------------"; \
		echo "Running b=5pc, v=$${v}km/s..."; \
		python3 -c "import json; \
			preset = json.load(open('$(PRESET_DIR)/imbh_cloud_b5pc_v10_gdisph.json')); \
			preset['sample']['v_x'] = -$${v} / 1.02; \
			preset['simulation']['output_directory'] = '$(RESULTS_DIR)/b5pc_v$${v}_gdisph'; \
			json.dump(preset, open('$(IMBH_DIR)/imbh_cloud.json', 'w'), indent=2)"; \
		mkdir -p $(RESULTS_DIR)/b5pc_v$${v}_gdisph; \
		./build/sph imbh_cloud; \
		echo "✓ b=5pc, v=$${v}km/s complete"; \
		echo ""; \
	done
	@echo "Running velocity scan at b=6pc (5 runs)..."
	@for v in 0 5 15 20; do \
		echo "----------------------------------------"; \
		echo "Running b=6pc, v=$${v}km/s..."; \
		python3 -c "import json; \
			preset = json.load(open('$(PRESET_DIR)/imbh_cloud_b6pc_v10_gdisph.json')); \
			preset['sample']['v_x'] = -$${v} / 1.02; \
			preset['simulation']['output_directory'] = '$(RESULTS_DIR)/b6pc_v$${v}_gdisph'; \
			json.dump(preset, open('$(IMBH_DIR)/imbh_cloud.json', 'w'), indent=2)"; \
		mkdir -p $(RESULTS_DIR)/b6pc_v$${v}_gdisph; \
		./build/sph imbh_cloud; \
		echo "✓ b=6pc, v=$${v}km/s complete"; \
		echo ""; \
	done
	@echo ""
	@echo "=========================================="
	@echo "✓ Full parameter matrix complete!"
	@echo "📁 Total: 20 simulations in $(RESULTS_DIR)/"
	@echo "=========================================="

# ============================================================================
# Visualization Targets
# ============================================================================

imbh_compare_impact:
	@echo "=========================================="
	@echo "  Generating Impact Parameter Comparison"
	@echo "=========================================="
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/b3pc_v10_gdisph" ]; then \
		echo "❌ No impact scan results found."; \
		echo "   Run: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_impact"; \
		exit 1; \
	fi
	@echo "Generating multi-panel comparison plots..."
	@chmod +x $(SCRIPTS_DIR)/compare_impact_parameters.py
	@mkdir -p $(RESULTS_DIR)/comparison_plots
	@python3 $(SCRIPTS_DIR)/compare_impact_parameters.py \
		--results-dir $(RESULTS_DIR) \
		--output-dir $(RESULTS_DIR)/comparison_plots
	@echo ""
	@echo "✓ Impact parameter comparison complete!"
	@echo "📊 Plots: $(RESULTS_DIR)/comparison_plots/impact_comparison_*.png"
	@echo ""

imbh_compare_velocity:
	@echo "=========================================="
	@echo "  Generating Velocity Comparison"
	@echo "=========================================="
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/b4pc_v0_gdisph" ]; then \
		echo "❌ No velocity scan results found."; \
		echo "   Run: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_velocity"; \
		exit 1; \
	fi
	@echo "Generating multi-panel comparison plots..."
	@chmod +x $(SCRIPTS_DIR)/compare_velocities.py
	@mkdir -p $(RESULTS_DIR)/comparison_plots
	@python3 $(SCRIPTS_DIR)/compare_velocities.py \
		--results-dir $(RESULTS_DIR) \
		--output-dir $(RESULTS_DIR)/comparison_plots
	@echo ""
	@echo "✓ Velocity comparison complete!"
	@echo "📊 Plots: $(RESULTS_DIR)/comparison_plots/velocity_comparison_*.png"
	@echo ""

imbh_visualize:
	@echo "=========================================="
	@echo "  Generating All Visualizations"
	@echo "=========================================="
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/b3pc_v10_gdisph" ] && [ ! -d "$(RESULTS_DIR)/b4pc_v10_gdisph" ]; then \
		echo "❌ No results found. Run simulation first."; \
		echo "   Example: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_impact"; \
		exit 1; \
	fi
	@echo "Generating individual plots and animations..."
	@chmod +x $(SCRIPTS_DIR)/visualize_disruption.py
	@python3 $(SCRIPTS_DIR)/visualize_disruption.py --results-dir $(RESULTS_DIR)
	@echo ""
	@if [ -d "$(RESULTS_DIR)/b3pc_v10_gdisph" ]; then \
		echo "Generating impact parameter comparison..."; \
		$(MAKE) -f sample/imbh_cloud/Makefile.imbh_cloud imbh_compare_impact; \
	fi
	@if [ -d "$(RESULTS_DIR)/b4pc_v0_gdisph" ]; then \
		echo "Generating velocity comparison..."; \
		$(MAKE) -f sample/imbh_cloud/Makefile.imbh_cloud imbh_compare_velocity; \
	fi
	@echo ""
	@echo "✓ All visualizations complete!"
	@echo "📊 Individual plots: $(RESULTS_DIR)/plots/"
	@echo "📊 Comparison plots: $(RESULTS_DIR)/comparison_plots/"
	@echo "🎬 Animations: $(RESULTS_DIR)/animations/"
	@echo ""

# ============================================================================
# Cleanup Targets
# ============================================================================

imbh_relax_clean:
	@echo "Cleaning relaxation results..."
	@rm -rf $(RESULTS_DIR)/lane_emden_2k_relax
	@rm -rf $(RESULTS_DIR)/lane_emden_200k_relax
	@rm -rf $(RESULTS_DIR)/resumed_relax
	@echo "✓ Relaxation cleanup complete"

imbh_clean:
	@echo "Cleaning IMBH-cloud results..."
	@rm -rf $(RESULTS_DIR)/b*pc_v*_gdisph
	@rm -rf $(RESULTS_DIR)/b*pc_gdisph
	@rm -rf $(RESULTS_DIR)/lane_emden_2k_relax
	@rm -rf $(RESULTS_DIR)/lane_emden_200k_relax
	@rm -rf $(RESULTS_DIR)/resumed_relax
	@rm -rf $(RESULTS_DIR)/plots
	@rm -rf $(RESULTS_DIR)/comparison_plots
	@rm -rf $(RESULTS_DIR)/animations
	@echo "✓ IMBH-cloud cleanup complete"
	@rm -f $(IMBH_DIR)/imbh_cloud.json
	@echo "✓ Full cleanup complete"
