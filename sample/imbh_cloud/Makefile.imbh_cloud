imbh_hydrostatic_200k: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🚀 PRODUCTION Hydrostatic Self-Gravity Test (200k particles)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "⚠️  WARNING: This is a HIGH-RESOLUTION production test!"
	@echo ""
	@echo "Configuration:"
	@echo "  • Particle count: 200,000 (N=100)"
	@echo "  • Test duration: 10.0 code units ~ 10 crossing times"
	@echo "  • Output frequency: 0.2 → 50 snapshots"
	@echo "  • Expected runtime: ~8-16 hours (hardware dependent)"
	@echo "  • Expected disk usage: ~10-20 GB"
	@echo ""
	@echo "Physics verification:"
	@echo "  ✓ Self-gravity with Barnes-Hut tree (θ=0.5)"
	@echo "  ✓ DISPH conservative formulation"
	@echo "  ✓ Jeans mass resolution: N_J > 50-100 particles"
	@echo "  ✓ Test >> tidal disruption timescale"
	@echo ""
	@if [ ! -f "$(RESULTS_DIR)/ic_relax_200k/snapshot_0050.csv" ]; then \
		echo "❌ ERROR: Relaxed 200k initial conditions not found!"; \
		echo ""; \
