# ============================================================================
# §3 RELAXATION - Resume from Checkpoint
# ============================================================================

imbh_relax_resume: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔄 Resume Relaxation from Checkpoint"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ -z "$(SNAPSHOT)" ]; then \
		echo "❌ ERROR: SNAPSHOT parameter required!"; \
		echo ""; \
		echo "Usage:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_resume \\"; \
		echo "       SNAPSHOT=<path_to_snapshot.csv> \\"; \
		echo "       [STEPS=10000] [FREQ=500] [OUTDIR=results/resumed_relax]"; \
		echo ""; \
		echo "Example:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_resume \\"; \
		echo "       SNAPSHOT=sample/imbh_cloud/results/ic_relax_10k/snapshot_0020.csv \\"; \
		echo "       STEPS=20000 FREQ=1000"; \
		echo ""; \
		echo "Parameters:"; \
		echo "  SNAPSHOT - Path to checkpoint file (required)"; \
		echo "  STEPS    - Additional relaxation steps (default: 10000)"; \
		echo "  FREQ     - Output frequency (default: 500)"; \
		echo "  OUTDIR   - Output directory (default: results/resumed_relax)"; \
		echo ""; \
		exit 1; \
	fi
	@if [ ! -f "$(SNAPSHOT)" ]; then \
		echo "❌ ERROR: Snapshot file not found!"; \
		echo "   Looking for: $(SNAPSHOT)"; \
		echo ""; \
		echo "Available snapshots from 2k run:"; \
		ls -1 $(RESULTS_DIR)/ic_relax_10k/snapshot_*.csv 2>/dev/null || echo "   (none found)"; \
		echo ""; \
		echo "Available snapshots from 200k run:"; \
		ls -1 $(RESULTS_DIR)/ic_relax_200k/snapshot_*.csv 2>/dev/null || echo "   (none found)"; \
		exit 1; \
	fi
	@RELAX_STEPS=$${STEPS:-10000}; \
	RELAX_FREQ=$${FREQ:-500}; \
	OUTPUT_DIR=$${OUTDIR:-$(RESULTS_DIR)/resumed_relax}; \
	SNAPSHOT_ABS=$$(cd $$(dirname $(SNAPSHOT)) && pwd)/$$(basename $(SNAPSHOT)); \
	echo "✓ Found checkpoint: $(SNAPSHOT)"; \
	echo ""; \
	echo "Configuration:"; \
	echo "  • Input snapshot: $$(basename $(SNAPSHOT))"; \
	echo "  • Additional steps: $$RELAX_STEPS"; \
	echo "  • Output frequency: $$RELAX_FREQ"; \
	echo "  • Output directory: $$OUTPUT_DIR"; \
	echo ""; \
	PARTICLE_COUNT=$$(tail -n +54 $(SNAPSHOT) | wc -l | tr -d ' '); \
	echo "  • Particles in checkpoint: $$PARTICLE_COUNT"; \
	echo ""; \
	mkdir -p $$OUTPUT_DIR; \
	echo "Creating resume configuration..."; \
	echo "{" > $$OUTPUT_DIR/resume_config.json; \
	echo "  \"comment\": \"Resume relaxation from checkpoint\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"description\": \"Continue relaxation from snapshot with $$RELAX_STEPS additional steps\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"sample\": \"lane_emden\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"N\": 22," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"alpha_scaling\": 0.273691," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"rho_center\": 1.43009692," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"K\": 0.424209," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"R\": 1.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"M_total\": 1.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"checkpoint\": {" >> $$OUTPUT_DIR/resume_config.json; \
	echo "    \"resumeFile\": \"$$SNAPSHOT_ABS\"" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  }," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"relaxationSteps\": $$RELAX_STEPS," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"relaxationOutputFreq\": $$RELAX_FREQ," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"relaxationOnly\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useRelaxation\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"outputDirectory\": \"$$OUTPUT_DIR\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"outputFormat\": \"csv\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"enableEnergyFile\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"neighborNumber\": 50," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"kernel\": \"wendland\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"SPHType\": \"gdisph\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useGravity\": false," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"periodic\": false," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"use2ndOrderGSPH\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"riemannSolver\": \"hll\"," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"alpha\": 1.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useBalsaraSwitch\": true," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"useTimeDependentAV\": false," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"cflSound\": 0.3," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"cflForce\": 0.125," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"startTime\": 0.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"endTime\": 0.0," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"outputTime\": 0.01," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"gamma\": 1.666666667," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"maxTreeLevel\": 20," >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"leafParticleNumber\": 1," >> $$OUTPUT_DIR/resume_config.json; \
	echo "" >> $$OUTPUT_DIR/resume_config.json; \
	echo "  \"iterativeSmoothingLength\": true" >> $$OUTPUT_DIR/resume_config.json; \
	echo "}" >> $$OUTPUT_DIR/resume_config.json; \
	echo "✓ Configuration created: $$OUTPUT_DIR/resume_config.json"; \
	echo ""; \
	echo "════════════════════════════════════════════════════════"; \
	echo "  Running Resumed Relaxation"; \
	echo "════════════════════════════════════════════════════════"; \
	echo ""; \
	./build/sph $$OUTPUT_DIR/resume_config.json 2>&1 | tee $$OUTPUT_DIR/run.log || \
		(echo "❌ Simulation failed! Check $$OUTPUT_DIR/run.log"; exit 1); \
	echo ""; \
	if [ -f $$OUTPUT_DIR/energy.dat ]; then \
		echo "✓ Resumed relaxation complete!"; \
		echo ""; \
		echo "📊 Final energy:"; \
		tail -1 $$OUTPUT_DIR/energy.dat; \
		NEW_SNAPSHOT_COUNT=$$(ls -1 $$OUTPUT_DIR/snapshot_*.csv 2>/dev/null | wc -l); \
		echo "📁 New snapshots generated: $$NEW_SNAPSHOT_COUNT"; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi; \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ RESUMED RELAXATION COMPLETE!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo ""; \
	echo "📁 Results location:"; \
	echo "   $$OUTPUT_DIR/"; \
	echo ""; \
	echo "📊 Generated files:"; \
	echo "   ✓ snapshot_*.csv           - Particle data at each output"; \
	echo "   ✓ energy.dat               - Energy evolution"; \
	echo "   ✓ run.log                  - Simulation log"; \
	echo "   ✓ resume_config.json       - Configuration used"; \
	echo ""; \
	echo "📈 To visualize:"; \
	echo "   python3 $(SCRIPTS_DIR)/visualize_relaxation.py $$OUTPUT_DIR $$OUTPUT_DIR"; \
	echo ""; \
	echo "🔄 To continue further:"; \
	LAST_SNAP=$$(ls -1 $$OUTPUT_DIR/snapshot_*.csv 2>/dev/null | tail -1); \
	if [ -n "$$LAST_SNAP" ]; then \
		echo "   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_resume \\"; \
		echo "        SNAPSHOT=$$LAST_SNAP STEPS=10000"; \
	fi; \
	echo ""

# ============================================================================
# §5 IMBH SIMULATION - From Relaxed Initial Condition
# ============================================================================

simulation_10k_b3pc_check:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔍 Checking Relaxed Initial Condition Availability"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@SNAPSHOT="$(RESULTS_DIR)/ic_relax_10k/snapshot_0032.csv"; \
	if [ ! -f "$$SNAPSHOT" ]; then \
		echo "❌ Relaxed snapshot not found!"; \
		echo "   Expected: $$SNAPSHOT"; \
		echo ""; \
		echo "You need to run relaxation first:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_2k"; \
		echo ""; \
		exit 1; \
	else \
		echo "✓ Found relaxed initial condition: $$SNAPSHOT"; \
		echo ""; \
		FILESIZE=$$(du -h "$$SNAPSHOT" | cut -f1); \
		LINECOUNT=$$(wc -l < "$$SNAPSHOT"); \
		echo "File properties:"; \
		echo "  Size: $$FILESIZE"; \
		echo "  Lines: $$LINECOUNT"; \
		echo ""; \
		echo "Checking header..."; \
		head -5 "$$SNAPSHOT"; \
		echo ""; \
		echo "✓ Snapshot appears valid"; \
		echo ""; \
		echo "Configuration file:"; \
		echo "  $(SIM_CONFIG_DIR)/simulation_10k_b3pc.json"; \
		echo ""; \
	fi

simulation_10k_b3pc: imbh_check_dim simulation_10k_b3pc_check
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🌌 IMBH Tidal Disruption from Relaxed IC"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "Purpose:"
	@echo "  Simulate IMBH (10⁵ M_☉) tidal disruption of relaxed"
	@echo "  molecular cloud starting from equilibrium state."
	@echo ""
	@echo "Physics:"
	@echo "  • Cloud: Relaxed Lane-Emden n=1.5 sphere (~2000 particles)"
	@echo "  • IMBH Mass: M_BH = 10⁵ M_☉"
	@echo "  • Impact parameter: b = 3 pc (strong disruption)"
	@echo "  • Relative velocity: v = 10 km/s"
	@echo "  • Initial BH position: (-20, 0, 0) pc"
	@echo "  • BH velocity: (+10, 0, 0) km/s toward cloud at origin"
	@echo ""
	@echo "Expected timeline:"
	@echo "  t = 0.0 Myr:  Cloud at origin (equilibrium)"
	@echo "  t ~ 1.5 Myr:  Pericenter passage → peak tidal forces"
	@echo "  t = 2.0 Myr:  Post-encounter, tidal tails formed"
	@echo ""
	@echo "Configuration:"
	@echo "  JSON: $(SIM_CONFIG_DIR)/simulation_10k_b3pc.json"
	@echo "  IC:   $(RESULTS_DIR)/ic_relax_10k/snapshot_0032.csv"
	@echo ""
	@echo "⚠️  IMPORTANT NOTES:"
	@echo "  1. This simulation requires IMBH external force module"
	@echo "  2. If not implemented, you'll see an error about missing force"
	@echo "  3. See docs/RESEARCH_SETUP.md for implementation details"
	@echo ""
	@read -p "Press Enter to start IMBH simulation or Ctrl+C to cancel..." dummy
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/3: Setup"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc
	@mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/checkpoints
	@echo "✓ Results directory: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/3: Running IMBH Simulation (~10-30 minutes)"
	@echo "════════════════════════════════════════════════════════"
	@echo "Starting simulation at $$(date '+%Y-%m-%d %H:%M:%S')..."
	@echo ""
	@./build/sph $(SIM_CONFIG_DIR)/simulation_10k_b3pc.json 2>&1 | tee $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/run.log || \
		(echo ""; \
		 echo "❌ Simulation failed! Check $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/run.log"; \
		 echo ""; \
		 echo "Common issues:"; \
		 echo "  1. IMBH external force module not implemented"; \
		 echo "  2. Configuration parameter mismatch"; \
		 echo "  3. Snapshot file format incompatibility"; \
		 echo ""; \
		 echo "See docs/RESEARCH_SETUP.md section 'Using Relaxed Initial Conditions'"; \
		 echo "and docs/QUICK_START_IMBH.md for troubleshooting."; \
		 exit 1)
	@echo ""
	@echo "Simulation completed at $$(date '+%Y-%m-%d %H:%M:%S')"
	@if [ -f $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Energy conservation check:"; \
		tail -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/energy.dat; \
		SNAPSHOT_COUNT=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/snapshot_*.csv 2>/dev/null | wc -l); \
		echo "📁 Snapshots generated: $$SNAPSHOT_COUNT"; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/3: Quick Verification"
	@echo "════════════════════════════════════════════════════════"
	@echo "Checking simulation output files..."
	@ls -lh $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/snapshot_*.csv 2>/dev/null | wc -l | xargs -I {} echo "  ✓ Generated {} snapshot files"
	@echo "  ✓ Check energy.dat for energy conservation"
	@echo "  ✓ Check run.log for simulation details"
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ IMBH SIMULATION COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/"
	@echo ""
	@echo "📊 Generated files:"
	@echo "   ✓ snapshot_*.csv - Particle data (~100 snapshots)"
	@echo "   ✓ energy.dat - Energy conservation tracking"
	@echo "   ✓ run.log - Simulation log"
	@echo "   ✓ checkpoints/ - Auto-saved checkpoints"
	@echo ""
	@echo "📈 Next steps:"
	@echo "   1. Check energy conservation:"
	@echo "      cat $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/energy.dat"
	@echo ""
	@echo "   2. Visualize results (create Python visualization script):"
	@echo "      python3 scripts/visualize_imbh_cloud.py $(RESULTS_DIR)/imbh_relaxed_2k_b3pc"
	@echo ""
	@echo "   3. Create animation:"
	@echo "      python3 scripts/animate_tidal_disruption.py $(RESULTS_DIR)/imbh_relaxed_2k_b3pc"
	@echo ""
	@echo "   4. Parameter variations:"
	@echo "      • Edit config: $(SIM_CONFIG_DIR)/simulation_10k_b3pc.json"
	@echo "      • Change impact_parameter_b: 3 → 4, 5, or 6 pc"
	@echo "      • Change BH_initial_velocity: 10 → 5, 15, or 20 km/s"
	@echo "      • Update output_directory to avoid overwriting"
	@echo ""
	@echo "📚 Documentation:"
	@echo "   • Full guide: sample/imbh_cloud/docs/RESEARCH_SETUP.md"
	@echo "   • Quick start: sample/imbh_cloud/docs/QUICK_START_IMBH.md"
	@echo ""

# ============================================================================
# §6 CONTINUATION - Extend Existing Simulations
# ============================================================================
#
# Continue/extend simulations from intermediate snapshots.
# Key: resetTimeOnResume=false (continues from snapshot time, not t=0)
#
# Usage:
#   1. Auto-generate continuation config:
#      make imbh_continue_generate ORIG_CONFIG=config/presets/simulation_10k_b3pc_nocool.json \
#          SNAPSHOT=results/imbh_relaxed_2k_b3pc_nocool/snapshot_0100.csv END_TIME=4.0
#
#   2. Run existing continuation config:
#      make imbh_continue_b3pc_nocool
#
# ============================================================================

CONTINUE_DIR := $(IMBH_DIR)/config/continue

.PHONY: imbh_continue_help imbh_continue_generate imbh_continue_b3pc_nocool imbh_continue_list

imbh_continue_help:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔄 SIMULATION CONTINUATION TARGETS"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "Purpose: Extend completed/interrupted simulations from snapshots"
	@echo ""
	@echo "IMPORTANT: These differ from 'new simulation' targets!"
	@echo "  • New simulation: resetTimeOnResume=true (restarts at t=0)"
	@echo "  • Continuation:   resetTimeOnResume=false (continues from snapshot time)"
	@echo ""
	@echo "Available Targets:"
	@echo ""
	@echo "  imbh_continue_help      - Show this help"
	@echo "  imbh_continue_list      - List available continuation configs"
	@echo "  imbh_continue_generate  - Auto-generate continuation config"
	@echo "  imbh_continue_b3pc_nocool - Continue b3pc_nocool from snapshot_0100"
	@echo ""
	@echo "Generate New Continuation Config:"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_continue_generate \\"
	@echo "      ORIG_CONFIG=config/presets/simulation_10k_b3pc_nocool.json \\"
	@echo "      SNAPSHOT=results/imbh_relaxed_2k_b3pc_nocool/snapshot_0100.csv \\"
	@echo "      END_TIME=4.0"
	@echo ""
	@echo "Run Existing Continuation Config:"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_continue_b3pc_nocool"
	@echo ""

imbh_continue_list:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  📋 Available Continuation Configs"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ -d "$(CONTINUE_DIR)" ]; then \
		CONFIG_COUNT=$$(ls -1 $(CONTINUE_DIR)/*.json 2>/dev/null | wc -l); \
		if [ $$CONFIG_COUNT -gt 0 ]; then \
			echo "Found $$CONFIG_COUNT continuation config(s):"; \
			echo ""; \
			for f in $(CONTINUE_DIR)/*.json; do \
				echo "  📄 $$f"; \
				if grep -q '"source_snapshot"' "$$f" 2>/dev/null; then \
					echo "     └─ From: $$(grep '"source_snapshot"' "$$f" | cut -d'"' -f4)"; \
				fi; \
			done; \
		else \
			echo "No continuation configs found in $(CONTINUE_DIR)"; \
			echo ""; \
			echo "Generate one with:"; \
			echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_continue_generate ..."; \
		fi; \
	else \
		echo "Continuation directory does not exist: $(CONTINUE_DIR)"; \
		echo ""; \
		echo "Create it with:"; \
		echo "  mkdir -p $(CONTINUE_DIR)"; \
	fi
	@echo ""

imbh_continue_generate:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔧 Generate Continuation Config"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ -z "$(ORIG_CONFIG)" ] || [ -z "$(SNAPSHOT)" ] || [ -z "$(END_TIME)" ]; then \
		echo "❌ Missing required parameters!"; \
		echo ""; \
		echo "Usage:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_continue_generate \\"; \
		echo "      ORIG_CONFIG=<path> SNAPSHOT=<path> END_TIME=<float>"; \
		echo ""; \
		echo "Example:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_continue_generate \\"; \
		echo "      ORIG_CONFIG=sample/imbh_cloud/config/presets/simulation_10k_b3pc_nocool.json \\"; \
		echo "      SNAPSHOT=sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool/snapshot_0100.csv \\"; \
		echo "      END_TIME=4.0"; \
		echo ""; \
		exit 1; \
	fi
	@if [ ! -f "$(ORIG_CONFIG)" ]; then \
		echo "❌ Original config not found: $(ORIG_CONFIG)"; \
		exit 1; \
	fi
	@if [ ! -f "$(SNAPSHOT)" ]; then \
		echo "❌ Snapshot not found: $(SNAPSHOT)"; \
		exit 1; \
	fi
	@echo "Running generate_continue_config.py..."
	@echo ""
	@mkdir -p $(CONTINUE_DIR)
	@chmod +x $(SCRIPTS_DIR)/generate_continue_config.py
	@python3 $(SCRIPTS_DIR)/generate_continue_config.py \
		--original-config "$(ORIG_CONFIG)" \
		--snapshot "$(SNAPSHOT)" \
		--end-time $(END_TIME)
	@echo ""
	@echo "✓ Continuation config generated!"
	@echo ""

# Pre-built continuation target: b3pc_nocool from snapshot_0100
imbh_continue_b3pc_nocool: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔄 CONTINUE: IMBH b=3pc No-Cooling from snapshot_0100"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@CONFIG="$(CONTINUE_DIR)/simulation_10k_b3pc_nocool_from_snap0100.json"; \
	if [ ! -f "$$CONFIG" ]; then \
		echo "❌ Continuation config not found: $$CONFIG"; \
		echo ""; \
		echo "Generate it with:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_continue_generate \\"; \
		echo "      ORIG_CONFIG=sample/imbh_cloud/config/presets/simulation_10k_b3pc_nocool.json \\"; \
		echo "      SNAPSHOT=sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool/snapshot_0100.csv \\"; \
		echo "      END_TIME=4.0"; \
		exit 1; \
	fi; \
	SNAPSHOT="sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool/snapshot_0100.csv"; \
	if [ ! -f "$$SNAPSHOT" ]; then \
		echo "❌ Source snapshot not found: $$SNAPSHOT"; \
		echo ""; \
		echo "This continuation requires an existing completed/interrupted simulation."; \
		exit 1; \
	fi; \
	echo "Configuration: $$CONFIG"; \
	echo "Source snapshot: $$SNAPSHOT"; \
	echo ""; \
	echo "KEY SETTING: resetTimeOnResume=false"; \
	echo "  → Simulation will CONTINUE from snapshot time, not restart at t=0"; \
	echo ""; \
	read -p "Press Enter to start continuation or Ctrl+C to cancel..." dummy; \
	echo ""; \
	echo "Starting continuation at $$(date '+%Y-%m-%d %H:%M:%S')..."; \
	./build/sph "$$CONFIG" 2>&1 | tee $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/continue.log; \
	echo ""; \
	echo "✓ Continuation complete!"; \
	echo ""; \
	SNAPSHOT_COUNT=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/snapshot_*.csv 2>/dev/null | wc -l); \
	echo "📁 Total snapshots: $$SNAPSHOT_COUNT"; \
	echo "📊 Check energy.dat for energy conservation"; \
	echo ""

# ============================================================================
# §6b CONCATENATED ANIMATIONS - Combine Multiple Run Segments
# ============================================================================
#
# Create animations from original + continuation runs concatenated together.
# Snapshots are sorted by simulation time and merged automatically.
#
# Usage:
#   make imbh_concat_help              # Show help
#   make imbh_concat_nocool_t0to4      # Concatenate nocool t=0→4 Myr
#   make imbh_concat_nocool_t0to4_tidal # Same with tidal mode
#
# ============================================================================

.PHONY: imbh_concat_help imbh_concat_nocool_t0to4 imbh_concat_nocool_t0to4_tidal

imbh_concat_help:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 CONCATENATED ANIMATION TARGETS"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "Purpose: Create animations combining original + continuation runs"
	@echo ""
	@echo "The script automatically:"
	@echo "  • Discovers snapshots from multiple directories"
	@echo "  • Sorts them by simulation time"
	@echo "  • Removes overlapping duplicates (prefers later segment)"
	@echo "  • Creates unified animation across all segments"
	@echo ""
	@echo "Available Targets:"
	@echo ""
	@echo "  imbh_concat_help               - Show this help"
	@echo "  imbh_concat_nocool_t0to4       - Combine nocool t=0→2 + t=2→4 (single mode)"
	@echo "  imbh_concat_nocool_t0to4_tidal - Same with tidal physics mode (3x4 grid)"
	@echo ""
	@echo "Custom Concatenation:"
	@echo "  python3 $(SCRIPTS_DIR)/animate_concatenated.py \\"
	@echo "      --input-dirs <dir1> <dir2> [<dir3>...] \\"
	@echo "      --output-dir <output> --mode single|tidal --bh-mass 100000"
	@echo ""
	@echo "Example (custom):"
	@echo "  python3 $(SCRIPTS_DIR)/animate_concatenated.py \\"
	@echo "      --input-dirs $(RESULTS_DIR)/imbh_relaxed_10k_b3pc_nocool \\"
	@echo "                   $(RESULTS_DIR)/continuation/10k_b3pc_nocool_t2to4 \\"
	@echo "      --output-dir $(RESULTS_DIR)/combined/nocool_full \\"
	@echo "      --mode tidal --bh-mass 100000"
	@echo ""

# Concatenate nocool: original (t=0→2) + continuation (t=2→4)
imbh_concat_nocool_t0to4:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 CONCATENATED ANIMATION: No-Cooling t=0→4 Myr"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@ORIG_DIR="$(RESULTS_DIR)/imbh_relaxed_10k_b3pc_nocool"; \
	CONT_DIR="$(RESULTS_DIR)/continuation/10k_b3pc_nocool_t2to4"; \
	OUT_DIR="$(RESULTS_DIR)/combined/nocool_full"; \
	echo "Source directories:"; \
	echo "  1. Original:     $$ORIG_DIR"; \
	echo "  2. Continuation: $$CONT_DIR"; \
	echo ""; \
	echo "Output: $$OUT_DIR"; \
	echo "Mode: single (3x3 diagnostic grid)"; \
	echo ""; \
	if [ ! -d "$$ORIG_DIR" ]; then \
		echo "❌ Original results not found: $$ORIG_DIR"; \
		echo "   Run simulation first!"; \
		exit 1; \
	fi; \
	if [ ! -d "$$CONT_DIR" ]; then \
		echo "❌ Continuation results not found: $$CONT_DIR"; \
		echo "   Run continuation first!"; \
		exit 1; \
	fi; \
	mkdir -p "$$OUT_DIR"; \
	echo "Running concatenated animation..."; \
	echo ""; \
	python3 $(SCRIPTS_DIR)/animate_concatenated.py \
		--input-dirs "$$ORIG_DIR" "$$CONT_DIR" \
		--output-dir "$$OUT_DIR" \
		--mode single --bh-mass 100000 --fps 10; \
	echo ""; \
	echo "✅ Animation saved to: $$OUT_DIR/concatenated_single.gif"

imbh_concat_nocool_t0to4_tidal:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 CONCATENATED ANIMATION: No-Cooling t=0→4 Myr (Tidal Mode)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@ORIG_DIR="$(RESULTS_DIR)/imbh_relaxed_10k_b3pc_nocool"; \
	CONT_DIR="$(RESULTS_DIR)/continuation/10k_b3pc_nocool_t2to4"; \
	OUT_DIR="$(RESULTS_DIR)/combined/nocool_full"; \
	echo "Source directories:"; \
	echo "  1. Original:     $$ORIG_DIR"; \
	echo "  2. Continuation: $$CONT_DIR"; \
	echo ""; \
	echo "Output: $$OUT_DIR"; \
	echo "Mode: tidal (3x4 cross-section grid)"; \
	echo ""; \
	if [ ! -d "$$ORIG_DIR" ]; then \
		echo "❌ Original results not found: $$ORIG_DIR"; \
		echo "   Run simulation first!"; \
		exit 1; \
	fi; \
	if [ ! -d "$$CONT_DIR" ]; then \
		echo "❌ Continuation results not found: $$CONT_DIR"; \
		echo "   Run continuation first!"; \
		exit 1; \
	fi; \
	mkdir -p "$$OUT_DIR"; \
	echo "Running concatenated animation (tidal mode)..."; \
	echo ""; \
	python3 $(SCRIPTS_DIR)/animate_concatenated.py \
		--input-dirs "$$ORIG_DIR" "$$CONT_DIR" \
		--output-dir "$$OUT_DIR" \
		--mode tidal --bh-mass 100000 --fps 10; \
	echo ""; \
	echo "✅ Animation saved to: $$OUT_DIR/concatenated_tidal.gif"

# ============================================================================
# §7 THERMAL COMPARISON - With vs Without Cooling
# ============================================================================

imbh_thermal_compare_run: imbh_check_dim simulation_10k_b3pc_check
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔥 THERMAL PHYSICS COMPARISON"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "Purpose:"
	@echo "  Compare IMBH tidal disruption with and without"
	@echo "  Koyama & Inutsuka (2000) thermal equilibrium cooling"
	@echo ""
	@echo "Physics comparison:"
	@echo "  [1] WITH Cooling (thermal equilibrium):"
	@echo "      • Koyama-Inutsuka cooling curve active"
	@echo "      • Temperature locked to n-T equilibrium"
	@echo "      • Shock heating immediately radiated away"
	@echo "      • Mimics ISM thermal state (P/k ~ 10³⁻⁴ K cm⁻³)"
	@echo ""
	@echo "  [2] WITHOUT Cooling (adiabatic):"
	@echo "      • Pure adiabatic evolution (γ = 5/3)"
	@echo "      • Shock heating preserved in gas"
	@echo "      • Temperature rises at compression sites"
	@echo "      • Higher pressure support against gravity"
	@echo ""
	@echo "Expected differences:"
	@echo "  • Cooling ON:  More compact, denser tidal tails"
	@echo "  • Cooling OFF: Puffier, thermally supported structures"
	@echo "  • Cooling ON:  Lower post-shock temperatures"
	@echo "  • Cooling OFF: Hot shocked gas (T >> T_equilibrium)"
	@echo ""
	@echo "Unit system (GALACTIC):"
	@echo "  [Length]  = 1 kpc  (scale: 1 code unit = 1e-3 kpc = 1 pc)"
	@echo "  [Mass]    = 1e10 M_☉  (scale: 1 code unit = 1e-5 × 1e10 M_☉ = 1e5 M_☉)"
	@echo "  [Velocity]= 1 km/s"
	@echo "  [Time]    = 0.978 Myr  (derived: L/V = 1 kpc / 1 km/s)"
	@echo "  [Density] = 6.77e-23 g/cm³  (M/L³)"
	@echo "  [Pressure]= 6.77e-13 dyne/cm²  (M V²/L³)"
	@echo ""
	@echo "Simulation parameters (IDENTICAL except cooling):"
	@echo "  • M_BH = 10⁵ M_☉"
	@echo "  • Impact parameter b = 3 pc"
	@echo "  • Relative velocity v = 10 km/s"
	@echo "  • Initial separation = 20 pc"
	@echo "  • Cloud mass M_cloud ~ 10⁴ M_☉ (Lane-Emden n=1.5)"
	@echo "  • Cloud radius R ~ 5 pc"
	@echo ""
	@read -p "Press Enter to run BOTH simulations sequentially (~20-60 min) or Ctrl+C to cancel..." dummy
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  [RUN 1/2] WITH Koyama-Inutsuka Cooling"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc
	@mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/checkpoints
	@echo "Configuration: $(SIM_CONFIG_DIR)/simulation_10k_b3pc_cool.json"
	@echo "Output: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/"
	@echo ""
	@echo "Starting WITH cooling at $$(date '+%Y-%m-%d %H:%M:%S')..."
	@./build/sph $(SIM_CONFIG_DIR)/simulation_10k_b3pc_cool.json 2>&1 | tee $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/run.log || \
		(echo "❌ Simulation WITH cooling failed!"; exit 1)
	@echo "✓ Completed WITH cooling at $$(date '+%Y-%m-%d %H:%M:%S')"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  [RUN 2/2] WITHOUT Cooling (Adiabatic)"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool
	@mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/checkpoints
	@echo "Configuration: $(SIM_CONFIG_DIR)/simulation_10k_b3pc_nocool.json"
	@echo "Output: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/"
	@echo ""
	@echo "Starting WITHOUT cooling at $$(date '+%Y-%m-%d %H:%M:%S')..."
	@./build/sph $(SIM_CONFIG_DIR)/simulation_10k_b3pc_nocool.json 2>&1 | tee $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/run.log || \
		(echo "❌ Simulation WITHOUT cooling failed!"; exit 1)
	@echo "✓ Completed WITHOUT cooling at $$(date '+%Y-%m-%d %H:%M:%S')"
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ THERMAL COMPARISON COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results directories:"
	@echo "   [WITH cooling]:    $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/"
	@echo "   [WITHOUT cooling]: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/"
	@echo ""
	@echo "📊 Quick comparison:"
	@echo "   Energy files:"
	@echo "     WITH:    $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/energy.dat"
	@echo "     WITHOUT: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/energy.dat"
	@echo ""
	@echo "📈 Analysis suggestions:"
	@echo "   1. Compare final density distributions"
	@echo "   2. Compare temperature evolution (cooling ON should be cooler)"
	@echo "   3. Compare tail morphology (cooling affects fragmentation)"
	@echo "   4. Energy conservation check (both should conserve E_total)"
	@echo ""
	@echo "See RESEARCH_SETUP.md Appendix for thermal physics details"
	@echo ""

imbh_thermal_compare_viz:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  📊 Creating Thermal Comparison Animations & Plots"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc" ] || [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool" ]; then \
		echo "❌ Missing simulation results!"; \
		echo "   Run thermal comparison first:"; \
		echo "   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_thermal_compare_run"; \
		exit 1; \
	fi
	@SNAP_COUNT_COOL=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	SNAP_COUNT_NOCOOL=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	echo "Found simulation results:"; \
	echo "  • WITH cooling:    $$SNAP_COUNT_COOL snapshots"; \
	echo "  • WITHOUT cooling: $$SNAP_COUNT_NOCOOL snapshots"; \
	echo ""; \
	if [ "$$SNAP_COUNT_COOL" -lt 2 ] || [ "$$SNAP_COUNT_NOCOOL" -lt 2 ]; then \
		echo "⚠️  Warning: Very few snapshots found"; \
		echo "   Simulations may still be running or failed"; \
		echo "   Expected: ~100 snapshots each for full run (t=0 to 2.0 Myr)"; \
		echo ""; \
		read -p "Continue with available data? (y/N): " confirm; \
		if [ "$$confirm" != "y" ] && [ "$$confirm" != "Y" ]; then \
			echo "Cancelled."; \
			exit 1; \
		fi; \
	fi; \
	echo "Creating animations (this may take 5-15 minutes)..."; \
	echo ""; \
	mkdir -p $(RESULTS_DIR)/thermal_comparison; \
	chmod +x $(SCRIPTS_DIR)/animate_thermal_3d_multiview.py; \
	python3 $(SCRIPTS_DIR)/animate_thermal_3d_multiview.py \
		$(RESULTS_DIR)/imbh_relaxed_2k_b3pc \
		$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		$(RESULTS_DIR)/thermal_comparison || \
		(echo "❌ Animation failed!"; \
		 echo "   Make sure matplotlib is installed: pip3 install matplotlib numpy"; \
		 exit 1); \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ THERMAL COMPARISON VISUALIZATIONS COMPLETE!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo ""; \
	echo "📁 Output directory: $(RESULTS_DIR)/thermal_comparison/"; \
	echo ""; \
	echo "📊 Generated files:"; \
	if [ -f $(RESULTS_DIR)/thermal_comparison/thermal_comparison_edge_on.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/thermal_comparison/thermal_comparison_edge_on.gif | cut -f1); \
		echo "   ✓ thermal_comparison_edge_on.gif      ($$GIF_SIZE) - XY projection (tidal tail view)"; \
	fi; \
	if [ -f $(RESULTS_DIR)/thermal_comparison/thermal_comparison_face_on.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/thermal_comparison/thermal_comparison_face_on.gif | cut -f1); \
		echo "   ✓ thermal_comparison_face_on.gif      ($$GIF_SIZE) - XZ projection (perpendicular)"; \
	fi; \
	if [ -f $(RESULTS_DIR)/thermal_comparison/thermal_comparison_3d_rotating.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/thermal_comparison/thermal_comparison_3d_rotating.gif | cut -f1); \
		echo "   ✓ thermal_comparison_3d_rotating.gif  ($$GIF_SIZE) - 3D perspective rotation"; \
	fi; \
	echo ""; \
	echo "🔬 Views:"; \
	echo "   • Edge-on:  XY plane - Shows tidal tail development"; \
	echo "   • Face-on:  XZ plane - Perpendicular to impact parameter"; \
	echo "   • 3D:       Rotating perspective view"; \
	echo ""; \
	echo "🎯 Physics (CORRECTED):"; \
	echo "   • IMBH: Stationary at origin [0,0,0] pc"; \
	echo "   • Cloud: Starts at [-20, 3, 0] pc with v=[10, 0, 0] km/s"; \
	echo "   • Impact parameter b = 3 pc"; \
	echo ""; \
	echo "📖 Scientific Context:"; \
	echo "   See RESEARCH_SETUP.md Appendix B for thermal physics details"; \
	echo ""

