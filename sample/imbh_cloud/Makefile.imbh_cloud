	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  imbh_hydrostatic_2k      Test self-gravity on 10k sphere (10 t_cross) │"
	@echo "│  imbh_hydrostatic_2k_viz  Visualize 10k hydrostatic test               │"
	@echo "│  imbh_hydrostatic_200k    Test self-gravity on 200k sphere             │"
