	@echo "│  imbh_relax_clean      Remove only relaxation results                  │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  §12 TEMPLATE-BASED SIMULATIONS (Easy to Add New Cases!)               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  imbh_list_cases       List all registered simulation cases            │"
