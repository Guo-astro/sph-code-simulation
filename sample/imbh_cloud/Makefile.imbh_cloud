# ============================================================================
# §4 HYDROSTATIC - Testing: 2k Particles
# ============================================================================

imbh_hydrostatic_2k: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🧪 Hydrostatic Self-Gravity Test (2k particles)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "Purpose:"
	@echo "  Verify self-gravity implementation by testing hydrostatic"
	@echo "  equilibrium stability over multiple crossing times."
	@echo ""
	@echo "Physics:"
	@echo "  • Lane-Emden n=1.5 polytrope (γ=5/3)"
	@echo "  • DISPH method (conservative formulation)"
	@echo "  • Self-gravity enabled (Barnes-Hut tree)"
	@echo "  • Test duration: 10.0 code units ~ 10 crossing times"
	@echo "  • Output frequency: 0.2 → 50 snapshots"
	@echo ""
	@echo "Expected behavior:"
	@echo "  ✓ Density profile remains constant (RMS < 5%%)"
	@echo "  ✓ Velocities stay small (|v| < 1%% c_s)"
	@echo "  ✓ Total energy conserved (drift < 1%%)"
	@echo "  ✓ No expansion or collapse"
	@echo ""
	@echo "Timescales (code units):"
	@echo "  • Crossing time: t_cross ~ 1.0 (R/c_s)"
	@echo "  • Dynamical time: t_dyn = 1.0 (sqrt(R³/GM))"
	@echo "  • Tidal time (IMBH): t_tidal ~ 3.2 (M_BH/M_cloud = 10)"
	@echo "  • Test duration: 10.0 >> t_tidal >> t_scatter"
	@echo ""
	@echo "Checking configuration (JSON as SSOT)..."
	@SNAPSHOT_PATH=$$(python3 -c "import json; \
		config = json.load(open('$(HYDRO_CONFIG_DIR)/ic_verify_10k_hydrostatic.json')); \
		print(config.get('resumeFromSnapshot', ''))" 2>/dev/null || echo ""); \
	if [ -z "$$SNAPSHOT_PATH" ]; then \
		echo "❌ ERROR: No resumeFromSnapshot specified in JSON config!"; \
		echo ""; \
		echo "Please edit: $(HYDRO_CONFIG_DIR)/ic_verify_10k_hydrostatic.json"; \
		echo "And set 'resumeFromSnapshot' to a valid snapshot path"; \
		echo ""; \
		exit 1; \
	elif [ ! -f "$$SNAPSHOT_PATH" ]; then \
		echo "❌ ERROR: Snapshot file not found!"; \
		echo ""; \
		echo "JSON config specifies: $$SNAPSHOT_PATH"; \
		echo "But this file does not exist."; \
		echo ""; \
		echo "You may need to run relaxation first:"; \
		echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_2k"; \
		echo ""; \
		exit 1; \
	else \
		echo "✓ Found relaxed initial conditions"; \
		echo "  Source (from JSON): $$SNAPSHOT_PATH"; \
	fi
	@echo ""
	@read -p "Press Enter to start hydrostatic test or Ctrl+C to cancel..." dummy
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/3: Setup"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/ic_verify_10k_hydrostatic
	@echo "✓ Results directory: $(RESULTS_DIR)/ic_verify_10k_hydrostatic"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/3: Running Hydrostatic Test (5-10 minutes)"
	@echo "════════════════════════════════════════════════════════"
	@echo "Starting simulation at $$(date '+%Y-%m-%d %H:%M:%S')..."
	@echo ""
	@./build/sph $(HYDRO_CONFIG_DIR)/ic_verify_10k_hydrostatic.json 2>&1 | tee $(RESULTS_DIR)/ic_verify_10k_hydrostatic/run.log || \
		(echo "❌ Simulation failed! Check $(RESULTS_DIR)/ic_verify_10k_hydrostatic/run.log"; exit 1)
	@echo ""
	@echo "Simulation completed at $$(date '+%Y-%m-%d %H:%M:%S')"
	@if [ -f $(RESULTS_DIR)/ic_verify_10k_hydrostatic/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Energy conservation check:"; \
		tail -1 $(RESULTS_DIR)/ic_verify_10k_hydrostatic/energy.dat; \
		SNAPSHOT_COUNT=$$(ls -1 $(RESULTS_DIR)/ic_verify_10k_hydrostatic/snapshot_*.csv 2>/dev/null | wc -l); \
		echo "📁 Snapshots generated: $$SNAPSHOT_COUNT"; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/3: Generating Visualizations"
	@echo "════════════════════════════════════════════════════════"
	@echo "Creating hydrostatic test animation (2-4 minutes)..."
	@chmod +x $(SCRIPTS_DIR)/visualize_hydrostatic.py
	@python3 $(SCRIPTS_DIR)/visualize_hydrostatic.py \
		$(RESULTS_DIR)/ic_verify_10k_hydrostatic \
		$(RESULTS_DIR)/ic_verify_10k_hydrostatic || \
		(echo "⚠️  Visualization failed (data is still available)"; echo "   Install matplotlib: pip3 install matplotlib numpy")
	@echo ""
	@if [ -f $(RESULTS_DIR)/ic_verify_10k_hydrostatic/hydrostatic_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/ic_verify_10k_hydrostatic/hydrostatic_animation.gif | cut -f1); \
		echo "✓ Animation created: hydrostatic_animation.gif ($$GIF_SIZE)"; \
	fi
	@if [ -f $(RESULTS_DIR)/ic_verify_10k_hydrostatic/hydrostatic_summary.png ]; then \
		echo "✓ Summary plot created: hydrostatic_summary.png"; \
	fi
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ HYDROSTATIC TEST COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results: $(RESULTS_DIR)/ic_verify_10k_hydrostatic/"
	@echo ""
	@echo "📊 Generated files:"
	@if [ -f $(RESULTS_DIR)/ic_verify_10k_hydrostatic/hydrostatic_animation.gif ]; then \
		echo "   ✓ hydrostatic_animation.gif - 6-panel evolution with quality metrics"; \
	fi
	@if [ -f $(RESULTS_DIR)/ic_verify_10k_hydrostatic/hydrostatic_summary.png ]; then \
		echo "   ✓ hydrostatic_summary.png - Final state analysis"; \
	fi
	@echo "   ✓ snapshot_*.csv - Particle data (50 snapshots)"
	@echo "   ✓ energy.dat - Energy evolution"
	@echo "   ✓ run.log - Simulation log"
	@echo ""
	@echo "🎬 View results:"
	@if [ -f $(RESULTS_DIR)/ic_verify_10k_hydrostatic/hydrostatic_animation.gif ]; then \
		echo "   open $(RESULTS_DIR)/ic_verify_10k_hydrostatic/hydrostatic_animation.gif"; \
	fi
	@echo ""
	@echo "✅ Verification checklist:"
	@echo "   1. Density profile matches Lane-Emden analytic solution"
	@echo "   2. Velocities remain << 1%% sound speed"
	@echo "   3. Energy drift < 1%% over 10 crossing times"
	@echo "   4. No systematic expansion or collapse"
	@echo ""
	@echo "📝 Next steps:"
	@echo "   • If test passes → Self-gravity implementation is correct"
	@echo "   • Ready for IMBH tidal disruption simulations"
	@echo "   • For production: make imbh_hydrostatic_200k"
	@echo ""

