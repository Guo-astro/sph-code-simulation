	@echo "════════════════════════════════════════════════════════"
	@chmod +x $(SCRIPTS_DIR)/visualize_hydrostatic.py
	@python3 $(SCRIPTS_DIR)/visualize_hydrostatic.py \
		$(RESULTS_DIR)/ic_verify_200k_hydrostatic \
