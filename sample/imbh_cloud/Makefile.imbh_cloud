	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  Available cases: $(SIMULATION_CASES)"
	@echo "│                                                                         │"
	@echo "│  To add a new case:                                                     │"
	@echo "│    1. Create: config/presets/simulation_<name>.json                     │"
	@echo "│    2. Edit Makefile: SIMULATION_CASES += <name>                         │"
	@echo "│    3. Run: make sim_<name>                                              │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  QUICK START EXAMPLES"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  # Complete workflow (relaxation → hydrostatic → IMBH):"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_2k"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_hydrostatic_2k"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud simulation_10k_b3pc"
	@echo ""
	@echo "  # Template-based simulation (recommended for new cases):"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud sim_200k_b3pc_cool"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud sim_200k_b3pc_cool_viz"
	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud sim_200k_b3pc_cool_tidal"
