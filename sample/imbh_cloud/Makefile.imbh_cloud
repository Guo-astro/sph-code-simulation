	@echo "  make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_nocool_tidal_viz"
	@echo ""

# ============================================================================
# §2 UTILITIES
# ============================================================================

imbh_check_dim: build/sph
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
		echo "❌ Error: IMBH-cloud simulation requires DIM=3"; \
		echo ""; \
		echo "Current build: DIM=$$(grep 'SPH_DIM:STRING=' build/CMakeCache.txt 2>/dev/null | cut -d'=' -f2 || echo 'unknown')"; \
		echo ""; \
		echo "To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
		exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

# ============================================================================
# §2b ONE-SHOT SIMULATION + ANIMATION (Scenario-Based)
# ============================================================================
#
# Usage (scenario + method):
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b3pc_nocool METHOD=gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b3pc_nocool METHOD=gsph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b3pc_cool METHOD=gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b6pc_nocool METHOD=gdisph
#
# Available scenarios:
#   b3pc_nocool   - Impact parameter 3pc, adiabatic (no cooling)
#   b3pc_cool     - Impact parameter 3pc, with cooling
#   b6pc_nocool   - Impact parameter 6pc, adiabatic (wide orbit)
#   b1p5pc_optimal- Impact parameter 1.5pc, adiabatic (closer, stronger disruption)
#
# Available methods:
#   gdisph - Godunov DISPH (Riemann + density-independent, can tune AV)
#   gsph   - Godunov SPH (pure Riemann solver, no AV)
#
# Additional parameters:
#   FPS     - Animation frames per second: 15 (default)
#
# ============================================================================

# Default parameters (can be overridden from command line)
SCENARIO ?= b3pc_nocool
METHOD ?= gdisph
FPS ?= 15

# Scenario config directories
SCENARIO_DIR := $(CONFIG_DIR)/simulation/scenarios/$(SCENARIO)
SCENARIO_CONFIG := $(SCENARIO_DIR)/$(METHOD).json

# Method name in uppercase for folder naming
METHOD_UPPER := $(shell echo $(METHOD) | tr '[:lower:]' '[:upper:]')

# Results and animation directories based on scenario and method
ONESHOT_RESULTS := $(RESULTS_DIR)/$(SCENARIO)/$(METHOD_UPPER)
ONESHOT_ANIM_DIR := $(IMBH_DIR)/animations/$(SCENARIO)/$(METHOD_UPPER)

# Help for one-shot targets
imbh_oneshot_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  ONE-SHOT SIMULATION + ANIMATION (Scenario-Based)"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Run simulation and generate all animations in one command!"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  BASIC USAGE                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make imbh_oneshot                                # Default scenario   │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_nocool METHOD=gdisph                  │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_nocool METHOD=gsph                    │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_cool METHOD=gdisph                    │"
	@echo "│  make imbh_oneshot SCENARIO=b6pc_nocool METHOD=gdisph                  │"
	@echo "│  make imbh_oneshot SCENARIO=b1p5pc_optimal METHOD=gdisph               │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SCENARIOS                                                             │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  b3pc_nocool    Impact parameter 3pc, adiabatic (standard case)        │"
	@echo "│  b3pc_cool      Impact parameter 3pc, with radiative cooling           │"
	@echo "│  b6pc_nocool    Impact parameter 6pc, adiabatic (wide orbit)           │"
	@echo "│  b1p5pc_optimal Impact parameter 1.5pc, adiabatic (closer, stronger)   │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  METHODS                                                               │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  gdisph   Godunov-type DISPH (Riemann + density-independent)           │"
	@echo "│           - Uses pure Riemann solver (avAlpha=0)                       │"
	@echo "│           - Balsara switch enabled for viscosity limiting              │"
	@echo "│           Best for: shocks, discontinuities, tidal disruption          │"
	@echo "│                                                                         │"
	@echo "│  gsph     Godunov-type SPH (pure Riemann solver)                       │"
	@echo "│           - No artificial viscosity parameters                         │"
	@echo "│           - Riemann solver handles all dissipation                     │"
	@echo "│           Best for: strong shocks, blast waves, shock tubes            │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  EXAMPLE WORKFLOWS                                                     │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # Compare GDISPH vs GSPH for standard scenario:                       │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_nocool METHOD=gdisph                  │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_nocool METHOD=gsph                    │"
	@echo "│                                                                         │"
	@echo "│  # Compare impact parameters with GDISPH:                              │"
	@echo "│  make imbh_oneshot SCENARIO=b1p5pc_optimal METHOD=gdisph               │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_nocool METHOD=gdisph                  │"
	@echo "│  make imbh_oneshot SCENARIO=b6pc_nocool METHOD=gdisph                  │"
	@echo "│                                                                         │"
	@echo "│  # Test cooling effect:                                                │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_nocool METHOD=gdisph                  │"
	@echo "│  make imbh_oneshot SCENARIO=b3pc_cool METHOD=gdisph                    │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Config files:  $(CONFIG_DIR)/simulation/scenarios/<scenario>/<method>.json"
	@echo "  Results:       $(RESULTS_DIR)/<scenario>/<METHOD>/"
	@echo "  Animations:    $(IMBH_DIR)/animations/<scenario>/<METHOD>/"
	@echo ""

# Main one-shot target: run simulation + generate all animations
imbh_oneshot: imbh_check_dim imbh_oneshot_validate imbh_oneshot_run imbh_oneshot_animate
	@echo ""
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  ✅ ONE-SHOT COMPLETE: $(SCENARIO) / $(METHOD_UPPER)"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Scenario:   $(SCENARIO)"
	@echo "  Method:     $(METHOD_UPPER)"
	@echo "  Config:     $(SCENARIO_CONFIG)"
	@echo ""
	@echo "  Results:    $(ONESHOT_RESULTS)/"
	@echo "  Animations: $(ONESHOT_ANIM_DIR)/"
	@echo ""
	@echo "  Generated animations:"
	@ls -1 $(ONESHOT_ANIM_DIR)/*.gif 2>/dev/null | xargs -I {} basename {} || echo "    (none found)"
	@echo ""

# Validate that config exists
imbh_oneshot_validate:
	@if [ ! -f "$(SCENARIO_CONFIG)" ]; then \
		echo "❌ ERROR: Config not found: $(SCENARIO_CONFIG)"; \
		echo ""; \
		echo "Available scenarios:"; \
		ls -d $(CONFIG_DIR)/simulation/scenarios/*/ 2>/dev/null | xargs -I {} basename {} || echo "  (none)"; \
		echo ""; \
		echo "Available methods for $(SCENARIO):"; \
		ls $(SCENARIO_DIR)/*.json 2>/dev/null | xargs -I {} basename {} .json || echo "  (none)"; \
		exit 1; \
	fi
	@echo "✓ Config validated: $(SCENARIO_CONFIG)"

# Run the simulation using preset config
imbh_oneshot_run:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Running simulation: $(SCENARIO) / $(METHOD_UPPER)"
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Scenario: $(SCENARIO)"
	@echo "  Method:   $(METHOD_UPPER)"
	@echo "  Config:   $(SCENARIO_CONFIG)"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(ONESHOT_RESULTS)/checkpoints
	./build/sph $(SCENARIO_CONFIG)
	@echo ""
	@echo "✓ Simulation complete: $(ONESHOT_RESULTS)/"
	@echo "  Snapshots: $$(ls $(ONESHOT_RESULTS)/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' ')"

# Generate all animations
imbh_oneshot_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════"
	@echo "  Generating animations: $(SCENARIO) / $(METHOD_UPPER)"
	@echo "════════════════════════════════════════════════════════════════"
	@mkdir -p $(ONESHOT_ANIM_DIR)
	@# Main tidal disruption with energy panel
	@echo "[1/7] Tidal disruption (with energy panel)..."
	@python $(SCRIPTS_DIR)/animate_single_run.py $(ONESHOT_RESULTS) \
		-o $(ONESHOT_ANIM_DIR)/tidal.gif --mode tidal --fps $(FPS)
	@# Shock diagnostics (3x2 panel) - lab frame
	@echo "[2/7] Shock diagnostics (lab frame)..."
	@python $(SCRIPTS_DIR)/animate_shock_diagnostics.py $(ONESHOT_RESULTS) \
		-o $(ONESHOT_ANIM_DIR)/shock_diagnostics.gif --fps $(FPS)
	@# Shock diagnostics (3x2 panel) - center of mass frame
	@echo "[3/7] Shock diagnostics (COM frame)..."
	@python $(SCRIPTS_DIR)/animate_shock_diagnostics.py $(ONESHOT_RESULTS) \
		-o $(ONESHOT_ANIM_DIR)/shock_diagnostics_com.gif --fps $(FPS) --center-of-mass
	@# Density animation
	@echo "[4/7] Density field..."
	@python $(SCRIPTS_DIR)/animate_single_run.py $(ONESHOT_RESULTS) \
		-o $(ONESHOT_ANIM_DIR)/density.gif --mode density --fps $(FPS)
	@# Temperature animation
	@echo "[5/7] Temperature field..."
	@python $(SCRIPTS_DIR)/animate_single_run.py $(ONESHOT_RESULTS) \
		-o $(ONESHOT_ANIM_DIR)/temperature.gif --mode temperature --fps $(FPS)
	@# Mach number animation
	@echo "[6/7] Mach number field..."
	@python $(SCRIPTS_DIR)/animate_single_run.py $(ONESHOT_RESULTS) \
		-o $(ONESHOT_ANIM_DIR)/mach.gif --mode mach --fps $(FPS)
	@# Shock indicator animation
	@echo "[7/7] Shock indicator..."
	@python $(SCRIPTS_DIR)/animate_single_run.py $(ONESHOT_RESULTS) \
		-o $(ONESHOT_ANIM_DIR)/shock.gif --mode shock --fps $(FPS)
	@echo ""
	@echo "✓ All animations generated in $(ONESHOT_ANIM_DIR)/"
	@ls -lh $(ONESHOT_ANIM_DIR)/*.gif

# Clean one-shot results for current scenario/method
imbh_oneshot_clean:
	@echo "Cleaning $(SCENARIO)/$(METHOD_UPPER)..."
	rm -rf $(ONESHOT_RESULTS)
	rm -rf $(ONESHOT_ANIM_DIR)
	@echo "✓ Cleaned"

# Clean ALL one-shot results for a scenario
imbh_oneshot_clean_scenario:
	@echo "Cleaning all results for scenario: $(SCENARIO)..."
	rm -rf $(RESULTS_DIR)/$(SCENARIO)
	rm -rf $(IMBH_DIR)/animations/$(SCENARIO)
	@echo "✓ Cleaned all methods for $(SCENARIO)"

# ============================================================================
# §2c CONVENIENCE TARGETS (Pre-configured Scenarios)
# ============================================================================
#
# Quick targets for common scenarios - no need to specify SCENARIO and METHOD
#
# ============================================================================

# Standard b=3pc adiabatic scenario
imbh_b3pc_gdisph: SCENARIO := b3pc_nocool
imbh_b3pc_gdisph: METHOD := gdisph
imbh_b3pc_gdisph: imbh_oneshot

imbh_b3pc_gsph: SCENARIO := b3pc_nocool
imbh_b3pc_gsph: METHOD := gsph
imbh_b3pc_gsph: imbh_oneshot

# Close encounter b=1.5pc
imbh_b1p5pc_gdisph: SCENARIO := b1p5pc_optimal
imbh_b1p5pc_gdisph: METHOD := gdisph
imbh_b1p5pc_gdisph: imbh_oneshot

imbh_b1p5pc_gsph: SCENARIO := b1p5pc_optimal
imbh_b1p5pc_gsph: METHOD := gsph
imbh_b1p5pc_gsph: imbh_oneshot

# Wide orbit b=6pc
imbh_b6pc_gdisph: SCENARIO := b6pc_nocool
imbh_b6pc_gdisph: METHOD := gdisph
imbh_b6pc_gdisph: imbh_oneshot

imbh_b6pc_gsph: SCENARIO := b6pc_nocool
imbh_b6pc_gsph: METHOD := gsph
imbh_b6pc_gsph: imbh_oneshot

# With cooling
imbh_cool_gdisph: SCENARIO := b3pc_cool
imbh_cool_gdisph: METHOD := gdisph
imbh_cool_gdisph: imbh_oneshot

imbh_cool_gsph: SCENARIO := b3pc_cool
imbh_cool_gsph: METHOD := gsph
imbh_cool_gsph: imbh_oneshot

# ============================================================================
# §3 RELAXATION - Quick Test Target (Legacy)
# ============================================================================

imbh_quick_test: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ONE-SHOT: Lane-Emden Relaxation Test (Legacy)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "⚠️  NOTE: This is a legacy target. For new work, use:"
	@echo "    • imbh_relax_2k (testing: 2k particles)"
	@echo "    • imbh_relax_200k (production: 200k particles)"
	@echo ""
	@echo "This will perform:"
	@echo "  1. 3D Lane-Emden n=1.5 sphere generation (legacy configuration)"
	@echo "  2. Relaxation: 500 steps with analytical force"
	@echo "  3. Automatic visualization and quality checks"
	@echo ""
	@echo "Expected runtime: ~2-5 minutes"
	@echo ""
	@read -p "Press Enter to continue or Ctrl+C to cancel..." dummy
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/3: Creating results directory"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/lane_emden_50k_relax
	@echo "✓ Directory created: $(RESULTS_DIR)/lane_emden_50k_relax"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/3: Running relaxation simulation"
	@echo "════════════════════════════════════════════════════════"
	@echo "Parameters:"
	@echo "  - N_shells: 37 (→ ~50,653 particles = 37³)"
	@echo "  - Polytropic index: n=1.5 (γ=5/3)"
	@echo "  - Relaxation steps: 500"
	@echo "  - Output frequency: every 50 steps"
	@echo "  - SPH method: GDISPH with Wendland kernel"
	@echo ""
	@echo "Starting simulation (this will take 2-5 minutes)..."
	@echo ""
	@chmod +x $(SCRIPTS_DIR)/run_lane_emden_50k.sh
	@$(SCRIPTS_DIR)/run_lane_emden_50k.sh || \
		(echo "❌ Simulation failed! Check $(RESULTS_DIR)/lane_emden_50k_relax/run.log"; exit 1)
	@echo ""
	@if [ -f $(RESULTS_DIR)/lane_emden_50k_relax/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Quick stats:"; \
		tail -3 $(RESULTS_DIR)/lane_emden_50k_relax/energy.dat | head -1; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/3: Generating visualizations"
	@echo "════════════════════════════════════════════════════════"
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/lane_emden_50k_relax \
		$(RESULTS_DIR)/lane_emden_50k_relax || \
		(echo "⚠️  Visualization failed (plots may require matplotlib)"; echo "   Data is still available in results directory")
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ ONE-SHOT TEST COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results location:"
	@echo "   $(RESULTS_DIR)/lane_emden_50k_relax/"
	@echo ""
	@echo "� Generated files:"
	@echo "   - snapshot_*.csv      : Particle data at each output"
	@echo "   - energy.dat          : Energy evolution (check conservation)"
	@echo "   - relaxation_summary.png : Comprehensive visualization"
	@echo "   - run.log             : Full simulation log"
	@echo ""
	@echo "🔍 Quality checks:"
	@if [ -f $(RESULTS_DIR)/lane_emden_50k_relax/relaxation_summary.png ]; then \
		echo "   ✓ Visualization generated"; \
	else \
		echo "   ⚠  Visualization not created (matplotlib may be needed)"; \
	fi
	@echo ""
	@echo "📈 View results:"
	@echo "   open $(RESULTS_DIR)/lane_emden_50k_relax/relaxation_summary.png"
	@echo ""
	@echo "Next steps for IMBH research:"
	@echo "  1. Verify relaxation converged (velocities → 0)"
	@echo "  2. Check density profile matches Lane-Emden theory"
	@echo "  3. If successful, proceed with IMBH integration"
	@echo "  4. Add Koyama-Inutsuka thermal equilibrium"
	@echo "  5. Include external BH force and tidal disruption"
	@echo ""

# ============================================================================
# §3 RELAXATION - Testing: 2k Particles
# ============================================================================

imbh_relax_2k: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 Lane-Emden Relaxation - TESTING (2k particles)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "This workflow will:"
	@echo "  1. Generate 3D Lane-Emden n=1.5 sphere (N=22 → ~2,130 particles)"
	@echo "  2. Run relaxation: 20,000 steps with analytical force"
	@echo "  3. Create animation with analytic solution overlay"
	@echo "  4. Generate comparison plots (SPH vs analytic density profile)"
	@echo ""
	@echo "Expected runtime: ~2-5 minutes (simulation + visualization)"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/4: Setup"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/ic_relax_10k
	@echo "✓ Results directory: $(RESULTS_DIR)/ic_relax_10k"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/4: Running Relaxation Simulation"
	@echo "════════════════════════════════════════════════════════"
	@echo "Configuration:"
	@echo "  • Particle count: ~2,130 (N=22, using N³/5 formula)"
	@echo "  • Polytropic index: n=1.5 (γ=5/3)"
	@echo "  • Relaxation steps: 20,000"
	@echo "  • Output frequency: 1000 steps → 21 snapshots"
	@echo "  • SPH method: GDISPH + Balsara viscosity limiter"
	@echo "  • Kernel: Wendland C4"
	@echo "  • Unit system: CODE UNITS (M=1, R=1, ρ_c=1.43)"
	@echo ""
	@echo "Lane-Emden Solution Parameters:"
	@echo "  • ξ₁ = 3.6537540101 (first zero)"
	@echo "  • α = R/ξ₁ = 0.273691 (scaling factor)"
	@echo "  • ρ_center = 1.43 [code units]"
	@echo "  • M_total = 1.0 [code units]"
	@echo ""
	@echo "Starting simulation (2-5 minutes)..."
	@./build/sph $(RELAX_CONFIG_DIR)/ic_relax_10k.json 2>&1 | tee $(RESULTS_DIR)/ic_relax_10k/run.log || \
		(echo "❌ Simulation failed! Check $(RESULTS_DIR)/ic_relax_10k/run.log"; exit 1)
	@echo ""
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Energy conservation check:"; \
		tail -1 $(RESULTS_DIR)/ic_relax_10k/energy.dat; \
		SNAPSHOT_COUNT=$$(ls -1 $(RESULTS_DIR)/ic_relax_10k/snapshot_*.csv 2>/dev/null | wc -l); \
		echo "📁 Snapshots generated: $$SNAPSHOT_COUNT"; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/4: Creating Animation with Analytic Overlay"
	@echo "════════════════════════════════════════════════════════"
	@echo "Generating 6-panel animation:"
	@echo "  • 3D density distribution"
	@echo "  • XY slice (|z| < 0.1)"
	@echo "  • XZ slice (|y| < 0.1)"
	@echo "  • Radial density profile (SPH vs analytic Lane-Emden)"
	@echo "  • Velocity magnitude histogram"
	@echo "  • Energy evolution"
	@echo ""
	@echo "This will take 1-3 minutes..."
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/ic_relax_10k \
		$(RESULTS_DIR)/ic_relax_10k || \
		(echo "⚠️  Visualization failed (matplotlib required)"; echo "   Simulation data is still valid")
	@echo ""
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif | cut -f1); \
		echo "✓ Animation created: relaxation_animation.gif ($$GIF_SIZE)"; \
	else \
		echo "⚠️  Animation not created (check matplotlib installation)"; \
	fi
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_summary.png ]; then \
		echo "✓ Summary plot created: relaxation_summary.png"; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 4/4: Quality Verification"
	@echo "════════════════════════════════════════════════════════"
	@echo "Checking relaxation quality..."
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/snapshot_0020.csv ]; then \
		python3 -c "import numpy as np; import sys; data = np.loadtxt('$(RESULTS_DIR)/ic_relax_10k/snapshot_0020.csv', delimiter=',', skiprows=61); vel = data[:, 4:7]; v_mag = np.sqrt(np.sum(vel**2, axis=1)); rho = data[:, 11]; r = np.sqrt(np.sum(data[:, 1:4]**2, axis=1)); print(f'  • Final velocity: max={v_mag.max():.6f}, median={np.median(v_mag):.6f} [code units]'); print(f'  • Density range: [{rho.min():.3f}, {rho.max():.3f}] [code units]'); print(f'  • Particle radius: [0, {r.max():.3f}] [code units]'); central = rho[r < 0.05]; print(f'  • Central density (r<0.05): mean={central.mean():.3f} (analytic ρ_c=1.43)') if len(central) > 0 else print('  ⚠️  No particles in central region (r<0.05)')"; \
	else \
		echo "  ⚠️  Final snapshot not found"; \
	fi
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ RELAXATION WORKFLOW COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results location:"
	@echo "   $(RESULTS_DIR)/ic_relax_10k/"
	@echo ""
	@echo "📊 Generated files:"
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif ]; then \
		echo "   ✓ relaxation_animation.gif - 6-panel animation with analytic overlay"; \
	fi
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_summary.png ]; then \
		echo "   ✓ relaxation_summary.png   - Final state summary"; \
	fi
	@echo "   ✓ snapshot_*.csv           - Particle data (21 snapshots)"
	@echo "   ✓ energy.dat               - Energy evolution"
	@echo "   ✓ run.log                  - Simulation log"
	@echo ""
	@echo "🎬 View animation:"
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif ]; then \
		echo "   open $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif"; \
	else \
		echo "   (Animation not available - install matplotlib)"; \
	fi
	@echo ""
	@echo "📈 View summary:"
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_summary.png ]; then \
		echo "   open $(RESULTS_DIR)/ic_relax_10k/relaxation_summary.png"; \
	else \
		echo "   (Summary plot not available - install matplotlib)"; \
	fi
	@echo ""
	@echo "✅ Quality checks:"
	@echo "   • Animation shows density evolution with Lane-Emden analytic overlay"
	@echo "   • Radial profile compares SPH vs analytic ρ(r) = ρ_c θ^1.5"
	@echo "   • Velocities should decay toward zero (thermal equilibrium)"
	@echo "   • Energy should be conserved (small fluctuations OK)"
	@echo ""
	@echo "📝 Next steps:"
	@echo "   1. Verify density profile matches analytic solution in animation"
	@echo "   2. Check velocity convergence (should approach ~0)"
	@echo "   3. For production runs, use: imbh_relax_200k"
	@echo "   4. To clean: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_clean"
	@echo ""

# ============================================================================
# §3 RELAXATION - Visualization (2k)
# ============================================================================

imbh_relax_2k_viz:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 Visualizing 2k Particle Relaxation Results"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/ic_relax_10k" ]; then \
		echo "❌ No 2k relaxation results found!"; \
		echo "   Expected directory: $(RESULTS_DIR)/ic_relax_10k"; \
		echo ""; \
		echo "   Run relaxation first:"; \
		echo "   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_2k"; \
		exit 1; \
	fi
	@SNAPSHOT_COUNT=$$(ls -1 $(RESULTS_DIR)/ic_relax_10k/snapshot_*.csv 2>/dev/null | wc -l); \
	if [ $$SNAPSHOT_COUNT -lt 2 ]; then \
		echo "❌ Insufficient snapshots found (need at least 2)"; \
		echo "   Found: $$SNAPSHOT_COUNT snapshots"; \
		exit 1; \
	fi
	@echo "✓ Found results directory with $$SNAPSHOT_COUNT snapshots"
	@echo ""
	@echo "Generating 6-panel animation with analytic overlay..."
	@echo "This will take 1-3 minutes..."
	@echo ""
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/ic_relax_10k \
		$(RESULTS_DIR)/ic_relax_10k || \
		(echo "❌ Visualization failed!"; \
		 echo "   Check that matplotlib and numpy are installed"; \
		 echo "   pip3 install matplotlib numpy scipy"; \
		 exit 1)
	@echo ""
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif | cut -f1); \
		echo "✓ Animation created: relaxation_animation.gif ($$GIF_SIZE)"; \
	else \
		echo "❌ Animation not created"; \
		exit 1; \
	fi
	@if [ -f $(RESULTS_DIR)/ic_relax_10k/relaxation_summary.png ]; then \
		echo "✓ Summary plot created: relaxation_summary.png"; \
	fi
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ VISUALIZATION COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Output files:"
	@echo "   $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif"
	@echo "   $(RESULTS_DIR)/ic_relax_10k/relaxation_summary.png"
	@echo ""
	@echo "🎬 View animation:"
	@echo "   open $(RESULTS_DIR)/ic_relax_10k/relaxation_animation.gif"
	@echo ""

# ============================================================================
# §3 RELAXATION - Production: 200k Particles
# ============================================================================

imbh_relax_200k: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🚀 PRODUCTION Lane-Emden Relaxation (200k particles)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "⚠️  WARNING: This is a HIGH-RESOLUTION production run!"
	@echo ""
	@echo "Configuration:"
	@echo "  • Particle count: 200,000 (N=100)"
	@echo "  • Relaxation steps: 100,000"
	@echo "  • Output frequency: 2,000 steps → 51 snapshots"
	@echo "  • Expected runtime: ~4-8 hours (hardware dependent)"
	@echo "  • Expected disk usage: ~5-10 GB"
	@echo ""
	@echo "Physics:"
	@echo "  • Polytrope: n=1.5, γ=5/3 (Lane-Emden)"
	@echo "  • SPH method: GDISPH + Balsara viscosity"
	@echo "  • Kernel: Wendland C4, N_neighbors=50"
	@echo "  • Gravity: Enabled (tree code)"
	@echo ""
	@echo "This configuration is suitable for:"
	@echo "  ✓ Production IMBH-cloud simulations"
	@echo "  ✓ High-resolution tidal disruption studies"
	@echo "  ✓ Jeans mass resolution (N_J > 50-100 particles)"
	@echo ""
	@read -p "Press Enter to continue or Ctrl+C to cancel..." dummy
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 1/4: Setup"
	@echo "════════════════════════════════════════════════════════"
	@mkdir -p $(RESULTS_DIR)/ic_relax_200k
	@echo "✓ Results directory: $(RESULTS_DIR)/ic_relax_200k"
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 2/4: Running Relaxation (4-8 hours)"
	@echo "════════════════════════════════════════════════════════"
	@echo "Starting simulation at $$(date '+%Y-%m-%d %H:%M:%S')..."
	@echo ""
	@./build/sph $(RELAX_CONFIG_DIR)/ic_relax_200k.json 2>&1 | tee $(RESULTS_DIR)/ic_relax_200k/run.log || \
		(echo "❌ Simulation failed! Check $(RESULTS_DIR)/ic_relax_200k/run.log"; exit 1)
	@echo ""
	@echo "Simulation completed at $$(date '+%Y-%m-%d %H:%M:%S')"
	@if [ -f $(RESULTS_DIR)/ic_relax_200k/energy.dat ]; then \
		echo "✓ Simulation complete!"; \
		echo ""; \
		echo "📊 Final energy (last 3 timesteps):"; \
		tail -3 $(RESULTS_DIR)/ic_relax_200k/energy.dat; \
	else \
		echo "❌ Energy file not found - simulation may have failed"; \
		exit 1; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 3/4: Generating Visualizations"
	@echo "════════════════════════════════════════════════════════"
	@echo "Creating animation and plots (2-5 minutes)..."
	@chmod +x $(SCRIPTS_DIR)/visualize_relaxation.py
	@python3 $(SCRIPTS_DIR)/visualize_relaxation.py \
		$(RESULTS_DIR)/ic_relax_200k \
		$(RESULTS_DIR)/ic_relax_200k || \
		(echo "⚠️  Visualization failed (data is still available)"; echo "   Install matplotlib: pip3 install matplotlib numpy scipy")
	@echo ""
	@if [ -f $(RESULTS_DIR)/ic_relax_200k/relaxation_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/ic_relax_200k/relaxation_animation.gif | cut -f1); \
		echo "✓ Animation created: relaxation_animation.gif ($$GIF_SIZE)"; \
	fi
	@if [ -f $(RESULTS_DIR)/ic_relax_200k/relaxation_summary.png ]; then \
		echo "✓ Summary plot created: relaxation_summary.png"; \
	fi
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  STEP 4/4: Quality Verification"
	@echo "════════════════════════════════════════════════════════"
	@if [ -f $(RESULTS_DIR)/ic_relax_200k/snapshot_0050.csv ]; then \
		python3 -c "import numpy as np; data = np.loadtxt('$(RESULTS_DIR)/ic_relax_200k/snapshot_0050.csv', delimiter=',', skiprows=61); vel = data[:, 4:7]; v_mag = np.sqrt(np.sum(vel**2, axis=1)); rho = data[:, 11]; r = np.sqrt(np.sum(data[:, 1:4]**2, axis=1)); print(f'  • Final velocity: max={v_mag.max():.6f}, median={np.median(v_mag):.6f}'); print(f'  • Density range: [{rho.min():.3f}, {rho.max():.3f}]'); print(f'  • Negative densities: {(rho<0).sum()}/{len(rho)} particles'); central = rho[r < 0.05]; print(f'  • Central density (r<0.05): mean={central.mean():.3f} (analytic=1.43)') if len(central) > 0 else None"; \
	fi
	@echo ""
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ PRODUCTION RELAXATION COMPLETE!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Results: $(RESULTS_DIR)/ic_relax_200k/"
	@echo ""
	@echo "📊 Generated files:"
	@echo "   ✓ 51 snapshots (snapshot_0000.csv to snapshot_0050.csv)"
	@echo "   ✓ energy.dat - Energy evolution"
	@if [ -f $(RESULTS_DIR)/ic_relax_200k/relaxation_animation.gif ]; then \
		echo "   ✓ relaxation_animation.gif - 6-panel evolution"; \
	fi
	@if [ -f $(RESULTS_DIR)/ic_relax_200k/relaxation_summary.png ]; then \
		echo "   ✓ relaxation_summary.png - Final state"; \
	fi
	@echo ""
	@echo "🎬 View results:"
	@if [ -f $(RESULTS_DIR)/ic_relax_200k/relaxation_animation.gif ]; then \
		echo "   open $(RESULTS_DIR)/ic_relax_200k/relaxation_animation.gif"; \
	fi
	@echo ""
	@echo "📝 Next steps:"
	@echo "   1. Verify relaxation quality in animation"
	@echo "   2. Check final snapshot for IMBH initial conditions"
	@echo "   3. Use snapshot_0050.csv for production IMBH runs"
	@echo "   4. Visualize only: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_relax_200k_viz"
	@echo ""

