	@echo "│  imbh_relax_2k_viz    Visualize 10k relaxation results                 │"
	@echo "│  imbh_relax_200k      Production: 200k particles, 100k steps           │"
	@echo "│  imbh_relax_200k_viz  Visualize 200k relaxation results                │"
	@echo "│  imbh_relax_resume    Resume from checkpoint (SNAPSHOT=path)           │"
