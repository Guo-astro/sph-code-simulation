# ============================================================================
# IMBH-Molecular Cloud Tidal Disruption Makefile
# ============================================================================
#
# Simulates intermediate-mass black hole (M_BH ~ 10^5 M_☉) tidal disruption
# of molecular clouds with impact parameters b = 1.5-6 parsecs.
#
# Physics:
#   - 3D Lane-Emden sphere (polytropic index n=1.5, γ=5/3)
#   - Koyama & Inutsuka (2000) thermal equilibrium
#   - GDISPH/GSPH methods for tidal disruption dynamics
#
# ============================================================================
# USAGE - ONE-SHOT SIMULATION + ANIMATION
# ============================================================================
#
# Run simulation and generate all 7 animations in one command:
#
#   # Default scenario (b3pc_nocool with GDISPH)
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot
#
#   # With scenario and method selection
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b3pc_nocool METHOD=gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b3pc_nocool METHOD=gsph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b3pc_cool METHOD=gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b6pc_nocool METHOD=gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b1p5pc_optimal METHOD=gdisph
#
#   # Convenience targets (no parameters needed)
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_b3pc_gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_b3pc_gsph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_b1p5pc_gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_b6pc_gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_cool_gdisph
#
#   # Cleaning
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot_clean SCENARIO=b3pc_nocool METHOD=gdisph
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot_clean_scenario SCENARIO=b3pc_nocool
#
#   # Show help
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot_help
#
# PARAMETERS:
#   SCENARIO - Physics scenario: b3pc_nocool, b3pc_cool, b6pc_nocool, b1p5pc_optimal
#   METHOD   - SPH method: gdisph (recommended), gsph (pure Riemann)
#   FPS      - Animation frames per second (default: 15)
#
# OUTPUT:
#   Results:    sample/imbh_cloud/results/<SCENARIO>/<METHOD>/
#   Animations: sample/imbh_cloud/animations/<SCENARIO>/<METHOD>/
#               - tidal.gif, shock_diagnostics.gif, shock_diagnostics_com.gif
#               - density.gif, temperature.gif, mach.gif, shock.gif
#
# ============================================================================
# COMPLETE WORKFLOW (from scratch)
# ============================================================================
#
#   # Step 1: Generate relaxed initial conditions
#   make -f sample/imbh_cloud/Makefile.relaxation relax_10k
#
#   # Step 2: Verify hydrostatic equilibrium (optional but recommended)
#   make -f sample/imbh_cloud/Makefile.hydrostatic hydro_10k
#
#   # Step 3: Run IMBH encounter simulation
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_oneshot SCENARIO=b3pc_nocool METHOD=gdisph
#
# ============================================================================
# TABLE OF CONTENTS
# ============================================================================
#
#   §0  PATH DEFINITIONS & PHONY TARGETS
#   §1  HELP
#   §2  UTILITIES (dimension check)
#   §2b ONE-SHOT SIMULATION + ANIMATION (Scenario-Based)
#   §2c CONVENIENCE TARGETS
#   §3  RELAXATION (create initial conditions) - LEGACY, use Makefile.relaxation
#   §4  HYDROSTATIC TESTS - LEGACY, use Makefile.hydrostatic
#   §5  IMBH SIMULATION (tidal disruption)
#   §6  CONTINUATION (extend existing runs)
#   §7  THERMAL COMPARISON (with/without cooling)
#   §8  SINGLE RUN VISUALIZATION
#   §9  PARAMETER SCANS
#   §10 COMPARISON PLOTS
#   §11 CLEANUP
#
# ============================================================================
# §0 PATH DEFINITIONS & PHONY TARGETS
# ============================================================================

# Path definitions
IMBH_DIR := sample/imbh_cloud
CONFIG_DIR := $(IMBH_DIR)/config/presets
RESULTS_DIR := $(IMBH_DIR)/results
SCRIPTS_DIR := $(IMBH_DIR)/scripts

# Organized config subdirectories
RELAX_CONFIG_DIR := $(CONFIG_DIR)/relaxation
HYDRO_CONFIG_DIR := $(CONFIG_DIR)/hydrostatic
SIM_CONFIG_DIR := $(CONFIG_DIR)/simulation
CONT_CONFIG_DIR := $(CONFIG_DIR)/continuation

# Legacy alias (for backward compatibility)
PRESET_DIR := $(CONFIG_DIR)

# ============================================================================
# SIMULATION CASE REGISTRY
# ============================================================================
# To add a new simulation case:
#   1. Create JSON config in $(SIM_CONFIG_DIR)/simulation_<name>.json
#   2. Add the case name to SIMULATION_CASES below
#   3. Run: make -f sample/imbh_cloud/Makefile.imbh_cloud sim_<name>
#   4. Visualize: make -f sample/imbh_cloud/Makefile.imbh_cloud sim_<name>_viz
#
# Config folder structure:
#   config/presets/
#   ├── relaxation/     # ic_relax_*.json
#   ├── hydrostatic/    # ic_verify_*.json  
#   ├── simulation/     # simulation_*.json
#   └── continuation/   # continue_*.json
#
# Example:
#   SIMULATION_CASES += 200k_b3pc_cool
#   Then:
#   make sim_200k_b3pc_cool       # Run simulation
#   make sim_200k_b3pc_cool_viz   # Standard visualization
#   make sim_200k_b3pc_cool_tidal # Tidal physics visualization
# ============================================================================

# Registry of available simulation cases (add new ones here)
SIMULATION_CASES := 10k_b3pc_cool 10k_b3pc_nocool 10k_b1p5pc_optimal 200k_b6pc 200k_b3pc_cool

# Auto-generate phony targets for all registered cases
SIM_RUN_TARGETS := $(addprefix sim_,$(SIMULATION_CASES))
SIM_VIZ_TARGETS := $(addsuffix _viz,$(SIM_RUN_TARGETS))
SIM_TIDAL_TARGETS := $(addsuffix _tidal,$(SIM_RUN_TARGETS))
SIM_CLEAN_TARGETS := $(addsuffix _clean,$(SIM_RUN_TARGETS))

# All targets are phony (always run)
.PHONY: imbh_help imbh_check_dim imbh_quick_test \
        imbh_relax_2k imbh_relax_2k_viz \
        imbh_relax_200k imbh_relax_200k_viz \
        imbh_relax_resume imbh_relax_clean \
        imbh_hydrostatic_2k imbh_hydrostatic_2k_viz \
        imbh_hydrostatic_200k imbh_hydrostatic_200k_viz \
        simulation_10k_b3pc simulation_10k_b3pc_check \
        imbh_continue_help imbh_continue_list imbh_continue_generate imbh_continue_b3pc_nocool \
        imbh_thermal_compare_run imbh_thermal_compare_viz imbh_thermal_compare_animate imbh_thermal_compare_clean \
        imbh_nocool_viz imbh_nocool_tidal_viz imbh_relaxed_2k_b3pc_nocool_viz \
        imbh_anim_main imbh_anim_shock imbh_anim_all imbh_anim_clean \
        imbh_b3pc_run imbh_b6pc_run imbh_b1p5pc_optimal imbh_b1p5pc_optimal_viz \
        imbh_scan_impact imbh_scan_velocity imbh_scan_full \
        imbh_compare_impact imbh_compare_velocity imbh_visualize \
        imbh_oneshot imbh_oneshot_clean imbh_oneshot_help \
        imbh_clean imbh_list_cases \
        $(SIM_RUN_TARGETS) $(SIM_VIZ_TARGETS) $(SIM_TIDAL_TARGETS) $(SIM_CLEAN_TARGETS)

# ============================================================================
# §1 HELP
# ============================================================================

