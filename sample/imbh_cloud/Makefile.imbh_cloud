# ============================================================================

imbh_nocool_viz:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  📊 Creating IMBH Tidal Disruption Animation (No Cooling)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool" ]; then \
		echo "❌ Results directory not found!"; \
		echo "   Expected: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool"; \
		echo ""; \
		echo "Run simulation first:"; \
		echo "   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_sim_nocool"; \
		exit 1; \
	fi
	@SNAP_COUNT=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	echo "Found $$SNAP_COUNT snapshots in results directory"; \
	echo ""; \
	if [ "$$SNAP_COUNT" -lt 2 ]; then \
		echo "❌ Not enough snapshots found!"; \
		echo "   Expected: ~100 snapshots for full run"; \
		exit 1; \
	fi; \
	echo "Creating comprehensive animation..."; \
	echo "  • 3D particle distribution"; \
	echo "  • XY plane (edge-on view)"; \
	echo "  • XZ plane (face-on view)"; \
	echo "  • Density histogram"; \
	echo "  • Energy evolution"; \
	echo "  • Cloud COM trajectory"; \
	echo ""; \
	mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool; \
	chmod +x $(SCRIPTS_DIR)/animate_single_run.py; \
	python3 $(SCRIPTS_DIR)/animate_single_run.py \
		--input-dir $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		--output-dir $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		--bh-mass 100000 \
		--fps 10 || \
		(echo "❌ Animation failed!"; \
		 echo "   Install dependencies: pip3 install matplotlib numpy pillow"; \
		 exit 1); \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ ANIMATION COMPLETE!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo ""; \
	echo "📁 Output: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/imbh_disruption_animation.gif"; \
	if [ -f $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/imbh_disruption_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/imbh_disruption_animation.gif | cut -f1); \
		echo "   Size: $$GIF_SIZE"; \
	fi; \
	echo ""; \
	echo "🎯 Physics:"; \
	echo "   • IMBH: 10⁵ M_☉ stationary at origin [0,0,0] pc"; \
	echo "   • Cloud: ~10⁴ M_☉ starts at [-20,3,0] pc"; \
	echo "   • Initial velocity: [10,0,0] km/s"; \
	echo "   • Impact parameter: b=3 pc"; \
	echo "   • Runtime: 2 Myr ($$SNAP_COUNT snapshots)"; \
	echo ""

# Alias for consistency
imbh_relaxed_2k_b3pc_nocool_viz: imbh_nocool_viz

# Tidal physics animation with cross-sections
imbh_nocool_tidal_viz:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 Creating Tidal Physics Animation (Cross-Sections)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool" ]; then \
		echo "❌ Missing simulation results!"; \
		echo "   Run: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_nocool_run"; \
		exit 1; \
	fi
	@SNAP_COUNT=$$(ls $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	if [ "$$SNAP_COUNT" -lt 10 ]; then \
		echo "❌ Insufficient snapshots (found: $$SNAP_COUNT, need: 10+)"; \
		exit 1; \
	fi; \
	echo "Creating tidal physics animation with cross-sections..."; \
	echo "  • XY/XZ/YZ density slices (in-plane vs vertical compression)"; \
	echo "  • XY/XZ/YZ temperature slices (shock heating)"; \
	echo "  • Shock detection map (P/P_adiabatic)"; \
	echo "  • Mach number distribution"; \
	echo "  • Tidal deformation (R_XY vs R_Z)"; \
	echo ""; \
	mkdir -p $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool; \
	chmod +x $(SCRIPTS_DIR)/animate_single_run.py; \
	python3 $(SCRIPTS_DIR)/animate_single_run.py \
		--input-dir $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		--output-dir $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		--bh-mass 100000 \
		--fps 10 \
		--mode tidal || \
		(echo "❌ Animation failed!"; \
		 echo "   Install dependencies: pip3 install matplotlib numpy pillow"; \
		 exit 1); \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ TIDAL PHYSICS ANIMATION COMPLETE!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo ""; \
	echo "📁 Output: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/tidal_physics_animation.gif"; \
	if [ -f $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/tidal_physics_animation.gif ]; then \
		GIF_SIZE=$$(du -h $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/tidal_physics_animation.gif | cut -f1); \
		echo "   Size: $$GIF_SIZE"; \
	fi; \
	echo ""

# Animation-only target (no simulation dependency)
imbh_thermal_compare_animate:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 Creating Thermal Comparison Animations (Visualization Only)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc" ] || [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool" ]; then \
		echo "❌ Missing simulation results!"; \
		echo "   Required directories:"; \
		echo "   • $(RESULTS_DIR)/imbh_relaxed_2k_b3pc"; \
		echo "   • $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool"; \
		echo ""; \
		echo "   Run simulations first:"; \
		echo "   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_thermal_compare_run"; \
		exit 1; \
	fi
	@SNAP_COUNT_COOL=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	SNAP_COUNT_NOCOOL=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	echo "Found simulation results:"; \
	echo "  • WITH cooling:    $$SNAP_COUNT_COOL snapshots"; \
	echo "  • WITHOUT cooling: $$SNAP_COUNT_NOCOOL snapshots"; \
	echo ""; \
	echo "Creating animations (5-15 minutes)..."; \
	echo ""; \
	mkdir -p $(RESULTS_DIR)/thermal_comparison; \
	chmod +x $(SCRIPTS_DIR)/animate_thermal_3d_multiview.py; \
	python3 $(SCRIPTS_DIR)/animate_thermal_3d_multiview.py \
		$(RESULTS_DIR)/imbh_relaxed_2k_b3pc \
		$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		$(RESULTS_DIR)/thermal_comparison || \
		(echo "❌ Animation failed!"; \
		 echo "   Install dependencies: pip3 install matplotlib numpy"; \
		 exit 1); \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ ANIMATIONS COMPLETE!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo ""; \
	echo "📁 Output: $(RESULTS_DIR)/thermal_comparison/"; \
	ls -lh $(RESULTS_DIR)/thermal_comparison/*.gif 2>/dev/null || true; \
	echo ""

imbh_thermal_compare_clean:
	@echo "Cleaning thermal comparison results..."
	@rm -rf $(RESULTS_DIR)/imbh_relaxed_2k_b3pc
	@rm -rf $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool
	@rm -rf $(RESULTS_DIR)/thermal_comparison
	@echo "✓ Cleaned thermal comparison outputs"

# ============================================================================
# §8b ORGANIZED ANIMATION OUTPUTS (CoM Frame)
# ============================================================================
#
# All animations are saved to: animations/tidal_disruption/
# with descriptive prefixes for easy identification.
#
# Targets:
#   imbh_anim_main       : Main 6-panel animation (CoM frame)
#   imbh_anim_shock      : Shock diagnostics animation (2D + 1D profiles)
#   imbh_anim_all        : Generate all animations
#
# ============================================================================

# Animation output directory
ANIM_DIR := $(IMBH_DIR)/animations/tidal_disruption

# Main 6-panel animation (CoM frame: cloud centered, IMBH moves)
imbh_anim_main:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🎬 Creating Main Animation (CoM Frame)"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool" ]; then \
		echo "❌ Results not found: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool"; \
		echo "   Run simulation first."; \
		exit 1; \
	fi
	@SNAP_COUNT=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	if [ "$$SNAP_COUNT" -lt 10 ]; then \
		echo "❌ Insufficient snapshots (found: $$SNAP_COUNT, need: 10+)"; \
		exit 1; \
	fi; \
	echo "Found $$SNAP_COUNT snapshots"; \
	echo ""; \
	mkdir -p $(ANIM_DIR); \
	echo "Output: $(ANIM_DIR)/main_com_frame.gif"; \
	echo ""; \
	python3 $(SCRIPTS_DIR)/animate_single_run.py \
		$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		-o $(ANIM_DIR)/main_com_frame.gif \
		--mode tidal \
		--fps 12; \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ Main animation complete!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "📁 Output: $(ANIM_DIR)/main_com_frame.gif"; \
	if [ -f $(ANIM_DIR)/main_com_frame.gif ]; then \
		GIF_SIZE=$$(du -h $(ANIM_DIR)/main_com_frame.gif | cut -f1); \
		echo "   Size: $$GIF_SIZE"; \
	fi; \
	echo ""

# Shock diagnostics animation (2D scatter + 1D profiles with adiabatic references)
imbh_anim_shock:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔬 Creating Shock Diagnostics Animation"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool" ]; then \
		echo "❌ Results not found: $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool"; \
		echo "   Run simulation first."; \
		exit 1; \
	fi
	@SNAP_COUNT=$$(ls -1 $(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool/snapshot_*.csv 2>/dev/null | wc -l | tr -d ' '); \
	if [ "$$SNAP_COUNT" -lt 10 ]; then \
		echo "❌ Insufficient snapshots (found: $$SNAP_COUNT, need: 10+)"; \
		exit 1; \
	fi; \
	echo "Found $$SNAP_COUNT snapshots"; \
	echo ""; \
	mkdir -p $(ANIM_DIR); \
	echo "Output: $(ANIM_DIR)/shock_diagnostics_com.gif"; \
	echo ""; \
	echo "Features:"; \
	echo "  • 2D density & temperature (XY, XZ planes)"; \
	echo "  • 1D profiles: ρ/ρ₀, P/P₀, T/T₀ vs position"; \
	echo "  • Adiabatic reference lines (γ=5/3 Lane-Emden)"; \
	echo "  • CoM frame: cloud stays centered"; \
	echo ""; \
	python3 $(SCRIPTS_DIR)/animate_shock_diagnostics.py \
		$(RESULTS_DIR)/imbh_relaxed_2k_b3pc_nocool \
		--output $(ANIM_DIR)/shock_diagnostics_com.gif \
		--fps 12; \
	echo ""; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "  ✓ Shock diagnostics animation complete!"; \
	echo "══════════════════════════════════════════════════════════"; \
	echo "📁 Output: $(ANIM_DIR)/shock_diagnostics_com.gif"; \
	if [ -f $(ANIM_DIR)/shock_diagnostics_com.gif ]; then \
		GIF_SIZE=$$(du -h $(ANIM_DIR)/shock_diagnostics_com.gif | cut -f1); \
		echo "   Size: $$GIF_SIZE"; \
	fi; \
	echo ""

# Generate all animations
imbh_anim_all: imbh_anim_main imbh_anim_shock
	@echo "══════════════════════════════════════════════════════════"
	@echo "  ✓ All animations complete!"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "📁 Output directory: $(ANIM_DIR)/"
	@ls -lh $(ANIM_DIR)/*.gif 2>/dev/null || echo "   No GIF files found"
	@echo ""

# Clean animation outputs
imbh_anim_clean:
	@echo "Cleaning animation outputs..."
	@rm -rf $(ANIM_DIR)/*.gif
	@echo "✓ Cleaned: $(ANIM_DIR)/"

# ============================================================================
# §5 IMBH SIMULATION - Single Runs
# ============================================================================

imbh_b3pc_run: imbh_check_dim
	@echo "=========================================="
	@echo "  Running IMBH Simulation (b = 3 pc)"
	@echo "=========================================="
	@echo ""
	@cp $(PRESET_DIR)/imbh_cloud_b3pc_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b3pc_gdisph
	@./build/sph imbh_cloud
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b3pc_gdisph/"
	@echo ""

imbh_b6pc_run: imbh_check_dim
	@echo "=========================================="
	@echo "  Running IMBH Simulation (b = 6 pc)"
	@echo "=========================================="
	@echo ""
	@cp $(SIM_CONFIG_DIR)/simulation_200k_b6pc.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b6pc_gdisph
	@./build/sph imbh_cloud
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b6pc_gdisph/"
	@echo ""

# ============================================================================
# §9 PARAMETER SCANS
# ============================================================================

imbh_scan_impact: imbh_check_dim
	@echo "=========================================="
	@echo "  IMBH Impact Parameter Scan"
	@echo "  b = 3, 4, 5, 6 pc (v = 10 km/s fixed)"
	@echo "=========================================="
	@echo ""
	@echo "[1/4] Running b = 3 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b3pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b3pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=3pc, v=10km/s complete"
	@echo ""
	@echo "[2/4] Running b = 4 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=4pc, v=10km/s complete"
	@echo ""
	@echo "[3/4] Running b = 5 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b5pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b5pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=5pc, v=10km/s complete"
	@echo ""
	@echo "[4/4] Running b = 6 pc, v = 10 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b6pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b6pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ b=6pc, v=10km/s complete"
	@echo ""
	@echo "=========================================="
	@echo "✓ Impact parameter scan complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b*pc_v10_gdisph/"
	@echo "=========================================="

# Velocity scan (fixed impact parameter b=4pc)
imbh_scan_velocity: imbh_check_dim
	@echo "=========================================="
	@echo "  IMBH Velocity Scan"
	@echo "  v = 0, 5, 10, 15, 20 km/s (b = 4 pc fixed)"
	@echo "=========================================="
	@echo ""
	@echo "[1/5] Running v = 0 km/s (static infall)..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v0_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v0_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=0km/s complete"
	@echo ""
	@echo "[2/5] Running v = 5 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v5_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v5_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=5km/s complete"
	@echo ""
	@echo "[3/5] Running v = 10 km/s (BASELINE)..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v10_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v10_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=10km/s complete"
	@echo ""
	@echo "[4/5] Running v = 15 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v15_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v15_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=15km/s complete"
	@echo ""
	@echo "[5/5] Running v = 20 km/s..."
	@echo "----------------------------------------"
	@cp $(PRESET_DIR)/imbh_cloud_b4pc_v20_gdisph.json $(IMBH_DIR)/imbh_cloud.json
	@mkdir -p $(RESULTS_DIR)/b4pc_v20_gdisph
	@./build/sph imbh_cloud
	@echo "✓ v=20km/s complete"
	@echo ""
	@echo "=========================================="
	@echo "✓ Velocity scan complete!"
	@echo "📁 Results: $(RESULTS_DIR)/b4pc_v*_gdisph/"
	@echo "=========================================="

# Full matrix scan (4 impact x 5 velocity = 20 runs)
imbh_scan_full: imbh_check_dim
	@echo "=========================================="
	@echo "  IMBH Full Parameter Matrix Scan"
	@echo "  Impact: b = 3, 4, 5, 6 pc"
	@echo "  Velocity: v = 0, 5, 10, 15, 20 km/s"
	@echo "  Total: 20 simulations"
	@echo "=========================================="
	@echo ""
	@echo "⚠️  WARNING: This will take several hours!"
	@echo ""
	@echo "Running impact parameter scan (4 runs)..."
	@$(MAKE) -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_impact
	@echo ""
	@echo "Running velocity scan at b=3pc (5 runs)..."
	@for v in 0 5 15 20; do \
		echo "----------------------------------------"; \
		echo "Running b=3pc, v=$${v}km/s..."; \
		python3 -c "import json; \
			preset = json.load(open('$(PRESET_DIR)/imbh_cloud_b3pc_v10_gdisph.json')); \
			preset['sample']['v_x'] = -$${v} / 1.02; \
			preset['simulation']['output_directory'] = '$(RESULTS_DIR)/b3pc_v$${v}_gdisph'; \
			json.dump(preset, open('$(IMBH_DIR)/imbh_cloud.json', 'w'), indent=2)"; \
		mkdir -p $(RESULTS_DIR)/b3pc_v$${v}_gdisph; \
		./build/sph imbh_cloud; \
		echo "✓ b=3pc, v=$${v}km/s complete"; \
		echo ""; \
	done
	@echo "Running velocity scan at b=5pc (5 runs)..."
	@for v in 0 5 15 20; do \
		echo "----------------------------------------"; \
		echo "Running b=5pc, v=$${v}km/s..."; \
		python3 -c "import json; \
			preset = json.load(open('$(PRESET_DIR)/imbh_cloud_b5pc_v10_gdisph.json')); \
			preset['sample']['v_x'] = -$${v} / 1.02; \
			preset['simulation']['output_directory'] = '$(RESULTS_DIR)/b5pc_v$${v}_gdisph'; \
			json.dump(preset, open('$(IMBH_DIR)/imbh_cloud.json', 'w'), indent=2)"; \
		mkdir -p $(RESULTS_DIR)/b5pc_v$${v}_gdisph; \
		./build/sph imbh_cloud; \
		echo "✓ b=5pc, v=$${v}km/s complete"; \
		echo ""; \
	done
	@echo "Running velocity scan at b=6pc (5 runs)..."
	@for v in 0 5 15 20; do \
		echo "----------------------------------------"; \
		echo "Running b=6pc, v=$${v}km/s..."; \
		python3 -c "import json; \
			preset = json.load(open('$(PRESET_DIR)/imbh_cloud_b6pc_v10_gdisph.json')); \
			preset['sample']['v_x'] = -$${v} / 1.02; \
			preset['simulation']['output_directory'] = '$(RESULTS_DIR)/b6pc_v$${v}_gdisph'; \
			json.dump(preset, open('$(IMBH_DIR)/imbh_cloud.json', 'w'), indent=2)"; \
		mkdir -p $(RESULTS_DIR)/b6pc_v$${v}_gdisph; \
		./build/sph imbh_cloud; \
		echo "✓ b=6pc, v=$${v}km/s complete"; \
		echo ""; \
	done
	@echo ""
	@echo "=========================================="
	@echo "✓ Full parameter matrix complete!"
	@echo "📁 Total: 20 simulations in $(RESULTS_DIR)/"
	@echo "=========================================="

# ============================================================================
# §10 COMPARISON PLOTS
# ============================================================================

imbh_compare_impact:
	@echo "=========================================="
	@echo "  Generating Impact Parameter Comparison"
	@echo "=========================================="
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/b3pc_v10_gdisph" ]; then \
		echo "❌ No impact scan results found."; \
		echo "   Run: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_impact"; \
		exit 1; \
	fi
	@echo "Generating multi-panel comparison plots..."
	@chmod +x $(SCRIPTS_DIR)/compare_impact_parameters.py
	@mkdir -p $(RESULTS_DIR)/comparison_plots
	@python3 $(SCRIPTS_DIR)/compare_impact_parameters.py \
		--results-dir $(RESULTS_DIR) \
		--output-dir $(RESULTS_DIR)/comparison_plots
	@echo ""
	@echo "✓ Impact parameter comparison complete!"
	@echo "📊 Plots: $(RESULTS_DIR)/comparison_plots/impact_comparison_*.png"
	@echo ""

imbh_compare_velocity:
	@echo "=========================================="
	@echo "  Generating Velocity Comparison"
	@echo "=========================================="
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/b4pc_v0_gdisph" ]; then \
		echo "❌ No velocity scan results found."; \
		echo "   Run: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_velocity"; \
		exit 1; \
	fi
	@echo "Generating multi-panel comparison plots..."
	@chmod +x $(SCRIPTS_DIR)/compare_velocities.py
	@mkdir -p $(RESULTS_DIR)/comparison_plots
	@python3 $(SCRIPTS_DIR)/compare_velocities.py \
		--results-dir $(RESULTS_DIR) \
		--output-dir $(RESULTS_DIR)/comparison_plots
	@echo ""
	@echo "✓ Velocity comparison complete!"
	@echo "📊 Plots: $(RESULTS_DIR)/comparison_plots/velocity_comparison_*.png"
	@echo ""

imbh_visualize:
	@echo "=========================================="
	@echo "  Generating All Visualizations"
	@echo "=========================================="
	@echo ""
	@if [ ! -d "$(RESULTS_DIR)/b3pc_v10_gdisph" ] && [ ! -d "$(RESULTS_DIR)/b4pc_v10_gdisph" ]; then \
		echo "❌ No results found. Run simulation first."; \
		echo "   Example: make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_scan_impact"; \
		exit 1; \
	fi
	@echo "Generating individual plots and animations..."
	@chmod +x $(SCRIPTS_DIR)/visualize_disruption.py
	@python3 $(SCRIPTS_DIR)/visualize_disruption.py --results-dir $(RESULTS_DIR)
	@echo ""
	@if [ -d "$(RESULTS_DIR)/b3pc_v10_gdisph" ]; then \
		echo "Generating impact parameter comparison..."; \
		$(MAKE) -f sample/imbh_cloud/Makefile.imbh_cloud imbh_compare_impact; \
	fi
	@if [ -d "$(RESULTS_DIR)/b4pc_v0_gdisph" ]; then \
		echo "Generating velocity comparison..."; \
		$(MAKE) -f sample/imbh_cloud/Makefile.imbh_cloud imbh_compare_velocity; \
	fi
	@echo ""
	@echo "✓ All visualizations complete!"
	@echo "📊 Individual plots: $(RESULTS_DIR)/plots/"
	@echo "📊 Comparison plots: $(RESULTS_DIR)/comparison_plots/"
	@echo "🎬 Animations: $(RESULTS_DIR)/animations/"
	@echo ""

# ============================================================================
# §11 CLEANUP
# ============================================================================

imbh_relax_clean:
	@echo "Cleaning relaxation results..."
	@rm -rf $(RESULTS_DIR)/ic_relax_10k
	@rm -rf $(RESULTS_DIR)/ic_relax_200k
	@rm -rf $(RESULTS_DIR)/resumed_relax
	@echo "✓ Relaxation cleanup complete"

imbh_clean:
	@echo "Cleaning IMBH-cloud results..."
	@rm -rf $(RESULTS_DIR)/b*pc_v*_gdisph
	@rm -rf $(RESULTS_DIR)/b*pc_gdisph
	@rm -rf $(RESULTS_DIR)/ic_relax_10k
	@rm -rf $(RESULTS_DIR)/ic_relax_200k
	@rm -rf $(RESULTS_DIR)/resumed_relax
	@rm -rf $(RESULTS_DIR)/plots
	@rm -rf $(RESULTS_DIR)/comparison_plots
	@rm -rf $(RESULTS_DIR)/animations
	@echo "✓ IMBH-cloud cleanup complete"
	@rm -f $(IMBH_DIR)/imbh_cloud.json
	@echo "✓ Full cleanup complete"

# ============================================================================
# §12 TEMPLATE-BASED SIMULATION TARGETS
# ============================================================================
#
# This section provides a DRY (Don't Repeat Yourself) pattern for adding
# new simulation cases. Instead of writing 100+ lines per case, just:
#
#   1. Create config: $(SIM_CONFIG_DIR)/simulation_<NAME>.json
#   2. Add to registry: SIMULATION_CASES += <NAME>
#   3. Use: make sim_<NAME>, make sim_<NAME>_viz, make sim_<NAME>_tidal
#
# The targets automatically:
#   - Check DIM=3
#   - Extract output directory from JSON config
#   - Create results directory
#   - Run simulation with logging
#   - Generate visualizations
# ============================================================================

# List all available simulation cases
imbh_list_cases:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  📋 Registered Simulation Cases"
	@echo "══════════════════════════════════════════════════════════"
	@echo ""
	@echo "Available cases (from SIMULATION_CASES registry):"
	@for case in $(SIMULATION_CASES); do \
		CONFIG="$(SIM_CONFIG_DIR)/simulation_$${case}.json"; \
		if [ -f "$$CONFIG" ]; then \
			echo "  ✓ $$case"; \
			echo "    Config: $$CONFIG"; \
		else \
			echo "  ❌ $$case (missing: $$CONFIG)"; \
		fi; \
	done
	@echo ""
	@echo "Usage:"
	@echo "  make sim_<case>       # Run simulation"
	@echo "  make sim_<case>_viz   # Standard 3x3 visualization"
	@echo "  make sim_<case>_tidal # Tidal physics 3x4 visualization"
	@echo "  make sim_<case>_clean # Clean results"
	@echo ""
	@echo "To add a new case:"
	@echo "  1. Create: $(SIM_CONFIG_DIR)/simulation_<name>.json"
	@echo "  2. Edit Makefile: SIMULATION_CASES += <name>"
	@echo "  3. Run: make sim_<name>"
	@echo ""

# Helper function to extract outputDirectory from JSON config
# Usage: $(call get_output_dir,config_path)
define get_output_dir
$(shell python3 -c "import json; print(json.load(open('$(1)'))['outputDirectory'])" 2>/dev/null || echo "$(RESULTS_DIR)/unknown")
endef

# Helper function to extract BH mass from JSON config
define get_bh_mass
$(shell python3 -c "import json; c=json.load(open('$(1)')); print(c.get('imbh_parameters',{}).get('M_BH', 100000))" 2>/dev/null || echo "100000")
endef

# Template target for running a simulation case
# Pattern: sim_<case>
define SIM_RUN_TEMPLATE
sim_$(1): imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🌌 Running Simulation: $(1)"
	@echo "══════════════════════════════════════════════════════════"
	@CONFIG="$$(SIM_CONFIG_DIR)/simulation_$(1).json"; \
	if [ ! -f "$$$$CONFIG" ]; then \
		echo "❌ Configuration not found: $$$$CONFIG"; \
		echo ""; \
		echo "Available configs:"; \
		ls -1 $$(SIM_CONFIG_DIR)/simulation_*.json 2>/dev/null | sed 's/.*simulation_/  • /; s/.json//'; \
		exit 1; \
	fi; \
	OUTPUT_DIR=$$$$(python3 -c "import json; print(json.load(open('$$$$CONFIG'))['outputDirectory'])" 2>/dev/null); \
	if [ -z "$$$$OUTPUT_DIR" ]; then \
		echo "❌ Cannot extract outputDirectory from $$$$CONFIG"; \
		exit 1; \
	fi; \
	echo ""; \
	echo "Configuration: $$$$CONFIG"; \
	echo "Output Dir:    $$$$OUTPUT_DIR"; \
	echo ""; \
	mkdir -p "$$$$OUTPUT_DIR"; \
	mkdir -p "$$$$OUTPUT_DIR/checkpoints"; \
	echo "Starting simulation at $$$$(date '+%Y-%m-%d %H:%M:%S')..."; \
	echo ""; \
	./build/sph "$$$$CONFIG" 2>&1 | tee "$$$$OUTPUT_DIR/run.log" || \
		(echo ""; echo "❌ Simulation failed! Check $$$$OUTPUT_DIR/run.log"; exit 1); \
	echo ""; \
	echo "✓ Simulation complete at $$$$(date '+%Y-%m-%d %H:%M:%S')"; \
	if [ -f "$$$$OUTPUT_DIR/energy.dat" ]; then \
		SNAPSHOT_COUNT=$$$$(ls -1 "$$$$OUTPUT_DIR"/snapshot_*.csv 2>/dev/null | wc -l); \
		echo "📁 Snapshots: $$$$SNAPSHOT_COUNT"; \
		echo "📊 Energy file: $$$$OUTPUT_DIR/energy.dat"; \
	fi; \
	echo ""; \
	echo "Next steps:"; \
	echo "  Visualize: make sim_$(1)_viz"; \
	echo "  Tidal viz: make sim_$(1)_tidal"; \
	echo ""
endef

# Template target for standard visualization (3x3 grid)
# Pattern: sim_<case>_viz
define SIM_VIZ_TEMPLATE
sim_$(1)_viz:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  📊 Standard Visualization: $(1)"
	@echo "══════════════════════════════════════════════════════════"
	@CONFIG="$$(SIM_CONFIG_DIR)/simulation_$(1).json"; \
	if [ ! -f "$$$$CONFIG" ]; then \
		echo "❌ Configuration not found: $$$$CONFIG"; \
		exit 1; \
	fi; \
	OUTPUT_DIR=$$$$(python3 -c "import json; print(json.load(open('$$$$CONFIG'))['outputDirectory'])" 2>/dev/null); \
	BH_MASS=$$$$(python3 -c "import json; c=json.load(open('$$$$CONFIG')); print(c.get('imbh_parameters',{}).get('M_BH', 100000))" 2>/dev/null); \
	if [ ! -d "$$$$OUTPUT_DIR" ]; then \
		echo "❌ Results not found: $$$$OUTPUT_DIR"; \
		echo "   Run simulation first: make sim_$(1)"; \
		exit 1; \
	fi; \
	echo ""; \
	echo "Input:  $$$$OUTPUT_DIR"; \
	echo "BH Mass: $$$$BH_MASS M_☉"; \
	echo "Mode:   single (3x3 grid)"; \
	echo ""; \
	python3 $$(SCRIPTS_DIR)/animate_single_run.py \
		--input-dir "$$$$OUTPUT_DIR" \
		--output-dir "$$$$OUTPUT_DIR" \
		--bh-mass "$$$$BH_MASS" \
		--mode single \
		--fps 10; \
	echo ""; \
	echo "✓ Visualization complete!"; \
	echo "🎬 Animation: $$$$OUTPUT_DIR/imbh_disruption_animation.gif"; \
	echo ""
endef

# Template target for tidal physics visualization (3x4 grid with cross-sections)
# Pattern: sim_<case>_tidal
define SIM_TIDAL_TEMPLATE
sim_$(1)_tidal:
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🌊 Tidal Physics Visualization: $(1)"
	@echo "══════════════════════════════════════════════════════════"
	@CONFIG="$$(SIM_CONFIG_DIR)/simulation_$(1).json"; \
	if [ ! -f "$$$$CONFIG" ]; then \
		echo "❌ Configuration not found: $$$$CONFIG"; \
		exit 1; \
	fi; \
	OUTPUT_DIR=$$$$(python3 -c "import json; print(json.load(open('$$$$CONFIG'))['outputDirectory'])" 2>/dev/null); \
	BH_MASS=$$$$(python3 -c "import json; c=json.load(open('$$$$CONFIG')); print(c.get('imbh_parameters',{}).get('M_BH', 100000))" 2>/dev/null); \
	if [ ! -d "$$$$OUTPUT_DIR" ]; then \
		echo "❌ Results not found: $$$$OUTPUT_DIR"; \
		echo "   Run simulation first: make sim_$(1)"; \
		exit 1; \
	fi; \
	echo ""; \
	echo "Input:  $$$$OUTPUT_DIR"; \
	echo "BH Mass: $$$$BH_MASS M_☉"; \
	echo "Mode:   tidal (3x4 grid with cross-sections)"; \
	echo ""; \
	python3 $$(SCRIPTS_DIR)/animate_single_run.py \
		--input-dir "$$$$OUTPUT_DIR" \
		--output-dir "$$$$OUTPUT_DIR" \
		--bh-mass "$$$$BH_MASS" \
		--mode tidal \
		--fps 10; \
	echo ""; \
	echo "✓ Tidal visualization complete!"; \
	echo "🎬 Animation: $$$$OUTPUT_DIR/imbh_tidal_physics.gif"; \
	echo ""
endef

# Template target for cleaning simulation results
# Pattern: sim_<case>_clean
define SIM_CLEAN_TEMPLATE
sim_$(1)_clean:
	@echo "Cleaning results for: $(1)"
	@CONFIG="$$(SIM_CONFIG_DIR)/simulation_$(1).json"; \
	if [ ! -f "$$$$CONFIG" ]; then \
		echo "❌ Configuration not found: $$$$CONFIG"; \
		exit 1; \
	fi; \
	OUTPUT_DIR=$$$$(python3 -c "import json; print(json.load(open('$$$$CONFIG'))['outputDirectory'])" 2>/dev/null); \
	if [ -d "$$$$OUTPUT_DIR" ]; then \
		rm -rf "$$$$OUTPUT_DIR"; \
		echo "✓ Cleaned: $$$$OUTPUT_DIR"; \
	else \
		echo "⚠️  Directory not found: $$$$OUTPUT_DIR"; \
	fi
endef

# Generate targets for all registered simulation cases
$(foreach case,$(SIMULATION_CASES),$(eval $(call SIM_RUN_TEMPLATE,$(case))))
$(foreach case,$(SIMULATION_CASES),$(eval $(call SIM_VIZ_TEMPLATE,$(case))))
$(foreach case,$(SIMULATION_CASES),$(eval $(call SIM_TIDAL_TEMPLATE,$(case))))
$(foreach case,$(SIMULATION_CASES),$(eval $(call SIM_CLEAN_TEMPLATE,$(case))))

# ============================================================================
# §13 GENERIC CONTINUATION TARGET
# ============================================================================
#
# Continue any simulation from a snapshot with custom end time
#
# Usage:
#   make -f sample/imbh_cloud/Makefile.imbh_cloud imbh_continue \
#        SNAPSHOT=path/to/snapshot.csv \
#        END_TIME=4.0 \
#        [CONFIG=base_config.json]
#
# Example:
#   make imbh_continue \
#        SNAPSHOT=sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool/snapshot_0100.csv \
#        END_TIME=4.0
# ============================================================================

.PHONY: imbh_continue

imbh_continue: imbh_check_dim
	@echo "══════════════════════════════════════════════════════════"
	@echo "  🔄 Continue Simulation from Snapshot"
	@echo "══════════════════════════════════════════════════════════"
	@if [ -z "$(SNAPSHOT)" ]; then \
		echo "❌ ERROR: SNAPSHOT parameter required!"; \
		echo ""; \
		echo "Usage:"; \
		echo "  make imbh_continue SNAPSHOT=<path> END_TIME=<time>"; \
		echo ""; \
		echo "Example:"; \
		echo "  make imbh_continue \\"; \
		echo "       SNAPSHOT=sample/imbh_cloud/results/imbh_relaxed_2k_b3pc_nocool/snapshot_0100.csv \\"; \
		echo "       END_TIME=4.0"; \
		echo ""; \
		echo "Available snapshots:"; \
		find $(RESULTS_DIR) -name "snapshot_*.csv" 2>/dev/null | head -10 || echo "  (none found)"; \
		exit 1; \
	fi
	@if [ ! -f "$(SNAPSHOT)" ]; then \
		echo "❌ ERROR: Snapshot not found: $(SNAPSHOT)"; \
		exit 1; \
	fi
	@END=$${END_TIME:-4.0}; \
	OUTPUT_DIR=$$(dirname "$(SNAPSHOT)"); \
	CURRENT_TIME=$$(head -20 "$(SNAPSHOT)" | grep "^# Time (code):" | cut -d: -f2 | tr -d ' '); \
	echo ""; \
	echo "Snapshot:     $(SNAPSHOT)"; \
	echo "Current time: $$CURRENT_TIME [code units]"; \
	echo "End time:     $$END [code units]"; \
	echo "Output dir:   $$OUTPUT_DIR"; \
	echo ""; \
	if [ -z "$$CURRENT_TIME" ]; then \
		echo "⚠️  Could not read current time from snapshot header"; \
		CURRENT_TIME="unknown"; \
	fi; \
	echo "Creating continuation config..."; \
	CONT_CONFIG="$$OUTPUT_DIR/continue_config.json"; \
	python3 -c " \
import json \
config = { \
    'name': 'continuation', \
    'description': 'Continue from $(SNAPSHOT)', \
    'outputDirectory': '$$OUTPUT_DIR', \
    'outputFormat': 'csv', \
    'enableEnergyFile': True, \
    'SPHType': 'gdisph', \
    'use2ndOrderGSPH': False, \
    'kernel': 'wendland', \
    'neighborNumber': 50, \
    'gamma': 1.6666666666666667, \
    'cflSound': 0.3, \
    'cflForce': 0.125, \
    'avAlpha': 1.0, \
    'useBalsaraSwitch': True, \
    'useTimeDependentAV': False, \
    'maxTreeLevel': 20, \
    'leafParticleNumber': 1, \
    'iterativeSmoothingLength': True, \
    'periodic': False, \
    'startTime': 0.0, \
    'endTime': $$END, \
    'outputTime': 0.02, \
    'useGravity': True, \
    'G': 1.0, \
    'resumeFromSnapshot': '$(SNAPSHOT)', \
    'resetTimeOnResume': False, \
    'imbh_parameters': { \
        'enabled': True, \
        'M_BH': 100000.0, \
        'BH_initial_position': {'0': 0.0, '1': 0.0, '2': 0.0}, \
        'BH_initial_velocity': {'0': 0.0, '1': 0.0, '2': 0.0}, \
        'cloud_initial_position': {'0': -20.0, '1': 3.0, '2': 0.0}, \
        'cloud_initial_velocity': {'0': 10.0, '1': 0.0, '2': 0.0}, \
        'impact_parameter_b': 3.0, \
        'softening_epsilon': 0.05 \
    }, \
    'checkpoint': { \
        'enabled': True, \
        'saveInterval': 500, \
        'directory': '$$OUTPUT_DIR/checkpoints', \
        'saveOnExit': True, \
        'maxCheckpoints': 5, \
        'autoResume': False \
    } \
} \
json.dump(config, open('$$CONT_CONFIG', 'w'), indent=2) \
print('✓ Config: $$CONT_CONFIG') \
"; \
	echo ""; \
	echo "════════════════════════════════════════════════════════"; \
	echo "  Starting Continuation..."; \
	echo "════════════════════════════════════════════════════════"; \
	echo ""; \
	./build/sph "$$CONT_CONFIG" 2>&1 | tee "$$OUTPUT_DIR/continue.log" || \
		(echo ""; echo "❌ Continuation failed! Check $$OUTPUT_DIR/continue.log"; exit 1); \
	echo ""; \
	echo "✓ Continuation complete!"; \
	SNAPSHOT_COUNT=$$(ls -1 "$$OUTPUT_DIR"/snapshot_*.csv 2>/dev/null | wc -l); \
	echo "📁 Total snapshots: $$SNAPSHOT_COUNT"; \
	echo ""
