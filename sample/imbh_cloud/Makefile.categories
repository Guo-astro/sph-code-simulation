# ============================================================================
# CAT_OKA: OKA ET AL. (2017) EXACT ORBIT
# ============================================================================
# Uses exact orbital parameters from Nature Astronomy paper, scaled for
# our SPH cloud radius R=1.13 pc:
#   - Initial position: (20.0, -5.17, 0) pc
#   - Initial velocity: (-9.35, 4.48, 0) km/s
#   - Pericentre: 1.69 pc (1.5 × cloud radius)
#   - Eccentricity: 1.241 (hyperbolic orbit)
# ============================================================================

# Resolution A (61k)
CAT_OKA_A_oka: check_dim
	$(call run_category,CAT_OKA,A,61k,oka)
	$(call animate_category,CAT_OKA,A,61k,oka)

CAT_OKA_A_oka_run: check_dim
