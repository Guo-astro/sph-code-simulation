# ============================================================================
# IMBH-Cloud Simulation Category System Makefile
# ============================================================================
#
# Systematic simulation categories for IMBH-molecular cloud tidal disruption.
#
# Categories:
#   CAT1    - Adiabatic (no cooling)      : Pure gas dynamics baseline
#   CAT2    - Radiative (Inoue-Inutsuka)  : ISM thermal physics
#   CAT3    - Full Physics (Rad + SG)     : Radiative + enhanced self-gravity
#   CAT_OKA - Oka et al. (2017) orbit     : Exact orbital parameters from paper
#
# Resolutions:
#   A - 61k particles  (quick tests, parameter exploration)
#   B - 200k particles (production runs, convergence studies)
#   C - 1M particles   (high resolution, publication quality)
#
# Scenarios (impact parameter):
#   b1p5 - b=1.5 pc (deep disruption,   b/r_t=0.41)
#   b3   - b=3.0 pc (partial disruption, b/r_t=0.83)
#   b6   - b=6.0 pc (weak interaction,   b/r_t=1.65)
#   oka  - Oka et al. orbit (pericentre=1.69 pc, hyperbolic e=1.24)
#
# ============================================================================
# USAGE
# ============================================================================
#
# Single simulation:
#   make -f sample/imbh_cloud/Makefile.categories CAT1_A_b3
#   make -f sample/imbh_cloud/Makefile.categories CAT2_B_b3
#   make -f sample/imbh_cloud/Makefile.categories CAT3_C_b3
#   make -f sample/imbh_cloud/Makefile.categories CAT_OKA_A_oka
#
# All resolutions for a category/scenario:
#   make -f sample/imbh_cloud/Makefile.categories CAT1_all_b3
#   make -f sample/imbh_cloud/Makefile.categories CAT_OKA_all_oka
#
# All categories for a resolution/scenario:
#   make -f sample/imbh_cloud/Makefile.categories all_A_b3
#   make -f sample/imbh_cloud/Makefile.categories all_B_b3
#
# Comparison workflows:
#   make -f sample/imbh_cloud/Makefile.categories compare_physics_b3
#   make -f sample/imbh_cloud/Makefile.categories compare_resolution_CAT2_b3
#
# List available targets:
#   make -f sample/imbh_cloud/Makefile.categories help
#
# ============================================================================

# Path definitions
IMBH_DIR := sample/imbh_cloud
CONFIG_DIR := $(IMBH_DIR)/config/presets/categories
RESULTS_DIR := $(IMBH_DIR)/results
SCRIPTS_DIR := $(IMBH_DIR)/scripts
ANIM_DIR := $(IMBH_DIR)/animations

# Animation FPS
FPS ?= 15

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: help cat_help check_dim generate_configs \
        CAT1_A_b1p5 CAT1_A_b3 CAT1_A_b6 \
        CAT1_B_b1p5 CAT1_B_b3 CAT1_B_b6 \
        CAT1_C_b1p5 CAT1_C_b3 CAT1_C_b6 \
        CAT2_A_b1p5 CAT2_A_b3 CAT2_A_b6 \
        CAT2_B_b1p5 CAT2_B_b3 CAT2_B_b6 \
        CAT2_C_b1p5 CAT2_C_b3 CAT2_C_b6 \
        CAT3_A_b1p5 CAT3_A_b3 CAT3_A_b6 \
        CAT3_B_b1p5 CAT3_B_b3 CAT3_B_b6 \
        CAT3_C_b1p5 CAT3_C_b3 CAT3_C_b6 \
        CAT_OKA_A_oka CAT_OKA_B_oka CAT_OKA_C_oka \
        CAT1_all_b1p5 CAT1_all_b3 CAT1_all_b6 \
        CAT2_all_b1p5 CAT2_all_b3 CAT2_all_b6 \
        CAT3_all_b1p5 CAT3_all_b3 CAT3_all_b6 \
        CAT_OKA_all_oka \
        all_A_b1p5 all_A_b3 all_A_b6 \
        all_B_b1p5 all_B_b3 all_B_b6 \
        all_C_b1p5 all_C_b3 all_C_b6 \
        compare_physics_b1p5 compare_physics_b3 compare_physics_b6 \
        compare_resolution_CAT1_b3 compare_resolution_CAT2_b3 compare_resolution_CAT3_b3 \
        clean_CAT1 clean_CAT2 clean_CAT3 clean_CAT_OKA clean_all

# ============================================================================
# HELP
# ============================================================================

help: cat_help

cat_help:
	@echo "══════════════════════════════════════════════════════════════════════════════"
	@echo "  IMBH-Cloud Simulation Category System"
	@echo "══════════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  CATEGORIES                                                                  │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  CAT1     Adiabatic         Pure gas dynamics, no cooling (baseline)         │"
	@echo "│  CAT2     Radiative         Inoue-Inutsuka ISM cooling/heating               │"
	@echo "│  CAT3     Full Physics      Radiative + enhanced self-gravity (fragmentation)│"
	@echo "│  CAT_OKA  Oka et al.(2017)  Exact orbit from Nature Astronomy paper          │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  RESOLUTIONS                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  A     61k particles     Quick tests, parameter exploration (~10 min)        │"
	@echo "│  B     200k particles    Production runs, convergence (~1-3 hours)           │"
	@echo "│  C     1M particles      High resolution, publication (~12-36 hours)         │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SCENARIOS (Impact Parameter)                                                │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  b1p5  b=1.5 pc          Deep disruption (b/r_tidal = 0.41)                  │"
	@echo "│  b3    b=3.0 pc          Partial disruption (b/r_tidal = 0.83)               │"
	@echo "│  b6    b=6.0 pc          Weak interaction (b/r_tidal = 1.65)                 │"
	@echo "│  oka   Oka et al. orbit  Hyperbolic, pericentre=1.69pc (only for CAT_OKA)    │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # Run single simulation:                                                    │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories CAT1_A_b3                     │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories CAT2_B_b3                     │"
	@echo "│                                                                              │"
	@echo "│  # Run with animation only (no simulation):                                  │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories CAT1_A_b3_anim                │"
	@echo "│                                                                              │"
	@echo "│  # Run simulation only (no animation):                                       │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories CAT1_A_b3_run                 │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  BATCH RUNS                                                                  │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # All resolutions for one category/scenario:                                │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories CAT1_all_b3                   │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories CAT2_all_b3                   │"
	@echo "│                                                                              │"
	@echo "│  # All categories for one resolution/scenario:                               │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories all_A_b3                      │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories all_B_b3                      │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  COMPARISONS                                                                 │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  # Physics comparison (CAT1 vs CAT2 vs CAT3) at b=3pc, Res B:                │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories compare_physics_b3            │"
	@echo "│                                                                              │"
	@echo "│  # Resolution convergence for CAT2 at b=3pc:                                 │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories compare_resolution_CAT2_b3    │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌──────────────────────────────────────────────────────────────────────────────┐"
	@echo "│  CLEANUP                                                                     │"
	@echo "├──────────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories clean_CAT1                    │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories clean_CAT2                    │"
	@echo "│  make -f sample/imbh_cloud/Makefile.categories clean_all                     │"
	@echo "└──────────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Config files:  $(CONFIG_DIR)/<CAT>/<RES>/<SCENARIO>.json"
	@echo "  Results:       $(RESULTS_DIR)/<CAT>/<RES>/<SCENARIO>/"
	@echo "  Animations:    $(ANIM_DIR)/<CAT>/<RES>/<SCENARIO>/"
	@echo ""

# ============================================================================
# UTILITIES
# ============================================================================

check_dim: build/sph
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
		echo "❌ Error: IMBH-cloud simulation requires DIM=3"; \
		echo ""; \
		echo "To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
		exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

generate_configs:
	@echo "Generating all category configurations..."
	python $(SCRIPTS_DIR)/generate_category_configs.py

# ============================================================================
# GENERIC RUN TEMPLATE
# ============================================================================
#
# This template is used by all CAT*_*_* targets.
# Usage: $(call run_category,CAT1,A,61k,b3)
#

define run_category
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Running: $(1)_$(2)_$(4)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Category:    $(1)"
	@echo "  Resolution:  $(2) ($(3) particles)"
	@echo "  Scenario:    $(4)"
	@echo "  Config:      $(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@if [ ! -f "$(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json" ]; then \
		echo "❌ Config not found. Run 'make generate_configs' first."; \
		exit 1; \
	fi
	@mkdir -p $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)/checkpoints
	./build/sph $(CONFIG_DIR)/$(1)/$(2)_$(3)/$(4).json
	@echo ""
	@echo "✓ Simulation complete: $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4)/"
endef

define animate_category
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Animating: $(1)_$(2)_$(4)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@mkdir -p $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)
	@echo "[1/4] Tidal disruption..."
	@python $(SCRIPTS_DIR)/animate_single_run.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/tidal.gif --mode tidal --fps $(FPS) 2>/dev/null || \
		echo "  ⚠ Skipped (no snapshots?)"
	@echo "[2/4] Shock diagnostics..."
	@python $(SCRIPTS_DIR)/animate_shock_diagnostics.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/shock.gif --fps $(FPS) 2>/dev/null || \
		echo "  ⚠ Skipped"
	@echo "[3/4] Density field..."
	@python $(SCRIPTS_DIR)/animate_single_run.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/density.gif --mode density --fps $(FPS) 2>/dev/null || \
		echo "  ⚠ Skipped"
	@echo "[4/4] 3D view..."
	@python $(SCRIPTS_DIR)/animate_3d_view.py $(RESULTS_DIR)/$(1)/$(2)_$(3)/$(4) \
		-o $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/3d.gif --mode density --fps $(FPS) 2>/dev/null || \
		echo "  ⚠ Skipped"
	@echo ""
	@echo "✓ Animations: $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/"
	@ls -lh $(ANIM_DIR)/$(1)/$(2)_$(3)/$(4)/*.gif 2>/dev/null || true
endef

# ============================================================================
# CAT1: ADIABATIC SIMULATIONS
# ============================================================================

# Resolution A (61k)
CAT1_A_b1p5: check_dim
	$(call run_category,CAT1,A,61k,b1p5)
	$(call animate_category,CAT1,A,61k,b1p5)

CAT1_A_b3: check_dim
