# SR-GSPH Test Suite Makefile
#
# Usage:
#   make sr_sod                    # Run SR Sod + animation
#   make sr_blast_wave             # Run standard blast wave + animation
#   make sr_strong_blast           # Run strong blast wave + animation
#   make sr_ultra_relat            # Run ultra-relativistic (v varies) + animation
#   make sr_ultra_v090             # Run v=0.9c + animation
#   make sr_ultra_v099             # Run v=0.99c + animation
#   make sr_ultra_v0999            # Run v=0.999c + animation
#
#   make sr_all                    # Run all 7 tests + animations
#   make sr_clean                  # Clean all results
#   make sr_help                   # Show help

# Paths
SR_SOD_DIR = sample/sr_sod
PRESET_DIR = $(SR_SOD_DIR)/config/presets
RESULTS_DIR = $(SR_SOD_DIR)/results
SCRIPTS_DIR = $(SR_SOD_DIR)/scripts

.PHONY: sr_sod sr_blast_wave sr_strong_blast sr_ultra_relat sr_ultra_v090 sr_ultra_v099 sr_ultra_v0999 \
        sr_all sr_clean sr_help sr_check_dim

# ============================================================================
# Dimension Check
# ============================================================================

sr_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
		echo "❌ ERROR: SR tests require DIM=1 build"; \
		echo ""; \
		echo "To rebuild for 1D:"; \
		echo "  cd build && cmake -DSPH_DIM=1 .. && make -j8 && cd .."; \
		exit 1; \
	fi

# ============================================================================
# Individual Test Targets (Simulation + Animation)
# ============================================================================

# SR Sod shock tube
sr_sod: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Sod Shock Tube"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_sod.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/sharp
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "✓ Simulation complete!"
	@echo ""
	@echo "[2/2] Generating animation..."
	@chmod +x $(SCRIPTS_DIR)/animate_sr_sod.py
	@python3 $(SCRIPTS_DIR)/animate_sr_sod.py $(RESULTS_DIR)/sharp
	@echo "✓ Animation complete!"
	@echo "📁 Results: $(RESULTS_DIR)/sharp/"

# Standard blast wave
sr_blast_wave: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Standard Blast Wave"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_blast_wave.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/blast_wave
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "✓ Simulation complete!"
	@echo ""
	@echo "[2/2] Generating animation..."
	@chmod +x $(SCRIPTS_DIR)/animate_sr_sod.py
	@python3 $(SCRIPTS_DIR)/animate_sr_sod.py
	@echo "✓ Animation complete!"
	@echo "� Results: $(RESULTS_DIR)/blast_wave/"

# Strong blast wave
sr_strong_blast: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Strong Blast Wave"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_strong_blast.json sr_sod.json
