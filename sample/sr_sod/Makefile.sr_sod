# ==============================================================================
# Makefile.sr_sod - SR-GSPH Sod Shock Tube Test Suite (Kitajima et al. 2025)
# ==============================================================================
#
# ONE-SHOT Commands (Run Simulation + Generate Comparison GIF):
# -------------------------------------------------------------
#   make -f sample/sr_sod/Makefile.sr_sod sr_gif_sod        # Sod test
#   make -f sample/sr_sod/Makefile.sr_sod sr_gif_blast      # Blast wave
#   make -f sample/sr_sod/Makefile.sr_sod sr_gif_strong     # Strong blast
#   make -f sample/sr_sod/Makefile.sr_sod sr_gif_ultra      # Ultra-relativistic (v=0.9c)
#   make -f sample/sr_sod/Makefile.sr_sod sr_gif_all        # All tests
#
# Conservation Analysis:
# ----------------------
#   make -f sample/sr_sod/Makefile.sr_sod sr_conservation_sod
#   make -f sample/sr_sod/Makefile.sr_sod sr_conservation_all
#
# ==============================================================================

.PHONY: sr_gif_sod sr_gif_blast sr_gif_strong sr_gif_ultra sr_gif_all
.PHONY: sr_conservation_sod sr_conservation_blast sr_conservation_strong sr_conservation_ultra sr_conservation_all
.PHONY: sr_clean_all sr_help sr_check_dim

# Path Variables
TEST_DIR       := sample/sr_sod
CONFIG_DIR     := $(TEST_DIR)/config/presets
RESULTS_DIR    := $(TEST_DIR)/results
SCRIPTS_DIR    := $(TEST_DIR)/scripts
COMPARE_SCRIPT := $(SCRIPTS_DIR)/animate_sr_sod_with_exact.py
CONSERV_SCRIPT := $(SCRIPTS_DIR)/analyze_srgsph_conservation.py
SPH_BINARY     := build/sph

# Config Files
SOD_CONFIG     := $(CONFIG_DIR)/sr_sod.json
BLAST_CONFIG   := $(CONFIG_DIR)/sr_blast_wave.json
STRONG_CONFIG  := $(CONFIG_DIR)/sr_strong_blast.json
ULTRA_CONFIG   := $(CONFIG_DIR)/sr_ultra_relat.json

# Results Directories
SOD_RESULTS    := $(RESULTS_DIR)/sod_fig1
BLAST_RESULTS  := $(RESULTS_DIR)/blast_wave
STRONG_RESULTS := $(RESULTS_DIR)/strong_blast
ULTRA_RESULTS  := $(RESULTS_DIR)/ultra_relat

# ==============================================================================
# Dimension Check
# ==============================================================================
sr_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
		echo "ERROR: SR tests require DIM=1 build"; \
		echo "Run: cd build && cmake -DSPH_DIM=1 .. && make"; \
		exit 1; \
	fi

# ==============================================================================
# ONE-SHOT GIF Generation (Run + Analytic Solution Comparison Animation)
# ==============================================================================

sr_gif_sod: $(SPH_BINARY) sr_check_dim
	@echo "========================================"
	@echo "Sod Test: Run + SPH vs Exact Comparison"
	@echo "========================================"
	@echo "[1/3] Running simulation..."
	@mkdir -p $(SOD_RESULTS)
	@./$(SPH_BINARY) $(SOD_CONFIG)
	@echo "[2/3] Generating comparison animation..."
	@python3 $(COMPARE_SCRIPT) $(SOD_RESULTS) $(SOD_RESULTS)/sod_vs_exact.gif
	@echo "[3/3] Generating conservation analysis..."
	@mkdir -p $(SOD_RESULTS)/analysis
	@python3 $(CONSERV_SCRIPT) $(SOD_RESULTS)
	@echo "========================================"
	@echo "Done: $(SOD_RESULTS)/sod_vs_exact.gif"
	@echo "      $(SOD_RESULTS)/analysis/conservation_analysis.png"
	@echo "========================================"

sr_gif_blast: $(SPH_BINARY) sr_check_dim
	@echo "========================================"
	@echo "Blast Wave: Run + SPH vs Exact Comparison"
	@echo "========================================"
	@echo "[1/3] Running simulation..."
	@mkdir -p $(BLAST_RESULTS)
	@./$(SPH_BINARY) $(BLAST_CONFIG)
	@echo "[2/3] Generating comparison animation..."
	@python3 $(COMPARE_SCRIPT) $(BLAST_RESULTS) $(BLAST_RESULTS)/blast_vs_exact.gif
	@echo "[3/3] Generating conservation analysis..."
	@mkdir -p $(BLAST_RESULTS)/analysis
	@python3 $(CONSERV_SCRIPT) $(BLAST_RESULTS)
	@echo "========================================"
	@echo "Done: $(BLAST_RESULTS)/blast_vs_exact.gif"
	@echo "      $(BLAST_RESULTS)/analysis/conservation_analysis.png"
	@echo "========================================"

sr_gif_strong: $(SPH_BINARY) sr_check_dim
	@echo "========================================"
	@echo "Strong Blast: Run + SPH vs Exact Comparison"
	@echo "========================================"
	@echo "[1/3] Running simulation..."
	@mkdir -p $(STRONG_RESULTS)
	@./$(SPH_BINARY) $(STRONG_CONFIG)
	@echo "[2/3] Generating comparison animation..."
	@python3 $(COMPARE_SCRIPT) $(STRONG_RESULTS) $(STRONG_RESULTS)/strong_vs_exact.gif
	@echo "[3/3] Generating conservation analysis..."
	@mkdir -p $(STRONG_RESULTS)/analysis
	@python3 $(CONSERV_SCRIPT) $(STRONG_RESULTS)
	@echo "========================================"
	@echo "Done: $(STRONG_RESULTS)/strong_vs_exact.gif"
	@echo "      $(STRONG_RESULTS)/analysis/conservation_analysis.png"
	@echo "========================================"

sr_gif_ultra: $(SPH_BINARY) sr_check_dim
	@echo "========================================"
	@echo "Ultra-Relativistic (v=0.9c): Run + SPH vs Exact"
	@echo "========================================"
	@echo "[1/3] Running simulation..."
	@mkdir -p $(ULTRA_RESULTS)
	@./$(SPH_BINARY) $(ULTRA_CONFIG)
	@echo "[2/3] Generating comparison animation..."
	@python3 $(COMPARE_SCRIPT) $(ULTRA_RESULTS) $(ULTRA_RESULTS)/ultra_vs_exact.gif
	@echo "[3/3] Generating conservation analysis..."
	@mkdir -p $(ULTRA_RESULTS)/analysis
	@python3 $(CONSERV_SCRIPT) $(ULTRA_RESULTS)
	@echo "========================================"
	@echo "Done: $(ULTRA_RESULTS)/ultra_vs_exact.gif"
	@echo "      $(ULTRA_RESULTS)/analysis/conservation_analysis.png"
	@echo "========================================"

sr_gif_all: sr_gif_sod sr_gif_blast sr_gif_strong sr_gif_ultra
	@echo "========================================"
	@echo "All GIFs Complete!"
	@echo "========================================"
	@echo "  $(SOD_RESULTS)/sod_vs_exact.gif"
	@echo "  $(BLAST_RESULTS)/blast_vs_exact.gif"
	@echo "  $(STRONG_RESULTS)/strong_vs_exact.gif"
	@echo "  $(ULTRA_RESULTS)/ultra_vs_exact.gif"
	@echo "========================================"

# ==============================================================================
# Conservation Analysis (Energy, Momentum, Baryon Number)
# ==============================================================================

sr_conservation_sod:
	@echo "========================================"
	@echo "Conservation Analysis: Sod Test"
	@echo "========================================"
	@if [ ! -d "$(SOD_RESULTS)" ]; then echo "No results. Run sr_gif_sod first."; exit 1; fi
	@mkdir -p $(SOD_RESULTS)/analysis
	python3 $(CONSERV_SCRIPT) $(SOD_RESULTS)
	@echo "Done: $(SOD_RESULTS)/analysis/"

sr_conservation_blast:
	@echo "========================================"
	@echo "Conservation Analysis: Blast Wave"
	@echo "========================================"
	@if [ ! -d "$(BLAST_RESULTS)" ]; then echo "No results. Run sr_gif_blast first."; exit 1; fi
	@mkdir -p $(BLAST_RESULTS)/analysis
	python3 $(CONSERV_SCRIPT) $(BLAST_RESULTS)
	@echo "Done: $(BLAST_RESULTS)/analysis/"

sr_conservation_strong:
	@echo "========================================"
	@echo "Conservation Analysis: Strong Blast"
	@echo "========================================"
	@if [ ! -d "$(STRONG_RESULTS)" ]; then echo "No results. Run sr_gif_strong first."; exit 1; fi
	@mkdir -p $(STRONG_RESULTS)/analysis
	python3 $(CONSERV_SCRIPT) $(STRONG_RESULTS)
	@echo "Done: $(STRONG_RESULTS)/analysis/"

sr_conservation_ultra:
	@echo "========================================"
	@echo "Conservation Analysis: Ultra-Relativistic"
	@echo "========================================"
	@if [ ! -d "$(ULTRA_RESULTS)" ]; then echo "No results. Run sr_gif_ultra first."; exit 1; fi
	@mkdir -p $(ULTRA_RESULTS)/analysis
	python3 $(CONSERV_SCRIPT) $(ULTRA_RESULTS)
	@echo "Done: $(ULTRA_RESULTS)/analysis/"

sr_conservation_all: sr_conservation_sod sr_conservation_blast sr_conservation_strong sr_conservation_ultra
	@echo "========================================"
	@echo "All Conservation Analyses Complete!"
	@echo "========================================"

# ==============================================================================
# Cleanup
# ==============================================================================

sr_clean_all:
	rm -rf $(SOD_RESULTS) $(BLAST_RESULTS) $(STRONG_RESULTS) $(ULTRA_RESULTS)
	@echo "All results cleaned"

# ==============================================================================
# Help
# ==============================================================================

sr_help:
	@echo "SR-GSPH Shock Tube Tests (Kitajima 2025)"
	@echo ""
	@echo "ONE-SHOT GIF (Run + SPH vs Exact Animation):"
	@echo "  sr_gif_sod      - Sod shock tube"
	@echo "  sr_gif_blast    - Relativistic blast wave"
	@echo "  sr_gif_strong   - Strong blast wave"
	@echo "  sr_gif_ultra    - Ultra-relativistic (v=0.9c)"
	@echo "  sr_gif_all      - All tests"
	@echo ""
	@echo "CONSERVATION ANALYSIS (Energy, Momentum, Baryon):"
	@echo "  sr_conservation_sod    - Sod test"
	@echo "  sr_conservation_blast  - Blast wave"
	@echo "  sr_conservation_strong - Strong blast"
	@echo "  sr_conservation_ultra  - Ultra-relativistic"
	@echo "  sr_conservation_all    - All tests"
	@echo ""
	@echo "CLEANUP:"
	@echo "  sr_clean_all    - Remove all results"
	@echo ""
	@echo "Reference: Kitajima et al. (2025) arXiv:2510.18251v1"
