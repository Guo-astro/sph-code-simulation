# ==============================================================================
# Makefile.sr_sod - SR-GSPH Sod Shock Tube Test Suite (Kitajima et al. 2025)
# ==============================================================================
#
# USAGE EXAMPLES:
# ---------------
# Run simulation and visualize:
#   make -f Makefile.sr_sod sr_sod_all
#   make -f Makefile.sr_sod sr_kitajima_all
#
# Benchmark with analytic solution:
#   make -f Makefile.sr_sod sr_benchmark_sod       # Sod test vs exact solution
#   make -f Makefile.sr_sod sr_benchmark_blast     # Blast wave vs exact
#   make -f Makefile.sr_sod sr_benchmark_all       # All benchmarks
#
# ==============================================================================

.PHONY: sr_sod_run sr_sod_clean sr_viz_sod sr_sod_all
.PHONY: sr_kitajima_run sr_kitajima_clean sr_viz_kitajima sr_kitajima_all
.PHONY: sr_blast_run sr_blast_clean sr_viz_blast sr_blast_all
.PHONY: sr_strong_run sr_strong_clean sr_viz_strong sr_strong_all
.PHONY: sr_ultra_run sr_ultra_clean sr_viz_ultra sr_ultra_all
.PHONY: sr_all sr_viz_all sr_clean_all sr_help sr_check_dim
.PHONY: sr_benchmark_sod sr_benchmark_kitajima sr_benchmark_blast
.PHONY: sr_benchmark_strong sr_benchmark_ultra sr_benchmark_all

# Path Variables
TEST_DIR     := sample/sr_sod
CONFIG_DIR   := $(TEST_DIR)/config/presets
RESULTS_DIR  := $(TEST_DIR)/results
SCRIPTS_DIR  := $(TEST_DIR)/scripts
VIZ_SCRIPT   := $(SCRIPTS_DIR)/sr_sod_visualize.py
SPH_BINARY   := build/sph

# Config Files
SOD_CONFIG       := $(CONFIG_DIR)/sr_sod.json
KITAJIMA_CONFIG  := $(CONFIG_DIR)/sr_sod_kitajima.json
BLAST_CONFIG     := $(CONFIG_DIR)/sr_blast_wave.json
STRONG_CONFIG    := $(CONFIG_DIR)/sr_strong_blast.json
ULTRA_CONFIG     := $(CONFIG_DIR)/sr_ultra_v090.json

# Results Directories (must match outputDirectory in JSON configs)
SOD_RESULTS      := $(RESULTS_DIR)/sod_fig1
KITAJIMA_RESULTS := $(RESULTS_DIR)/sod_kitajima
BLAST_RESULTS    := $(RESULTS_DIR)/blast_wave
STRONG_RESULTS   := $(RESULTS_DIR)/strong_blast
ULTRA_RESULTS    := $(RESULTS_DIR)/ultra_v090

# Dimension Check
sr_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
		echo "ERROR: SR tests require DIM=1 build"; \
		exit 1; \
	fi

# Standard SR Sod Test
sr_sod_run: $(SPH_BINARY) sr_check_dim
	@echo "Running SR Sod Test (Standard)"
	@mkdir -p $(SOD_RESULTS)
	./$(SPH_BINARY) $(SOD_CONFIG)
	@echo "Done: $(SOD_RESULTS)"

sr_viz_sod:
	@if [ ! -d "$(SOD_RESULTS)" ]; then echo "No results in $(SOD_RESULTS)"; exit 1; fi
	python3 $(VIZ_SCRIPT) $(SOD_RESULTS) --all

sr_sod_all: sr_sod_run sr_viz_sod

sr_sod_clean:
	rm -rf $(SOD_RESULTS)

# Kitajima Paper Test
sr_kitajima_run: $(SPH_BINARY) sr_check_dim
	@echo "Running Kitajima Test (Fig.2)"
	@mkdir -p $(KITAJIMA_RESULTS)
	./$(SPH_BINARY) $(KITAJIMA_CONFIG)
	@echo "Done: $(KITAJIMA_RESULTS)"

sr_viz_kitajima:
	@if [ ! -d "$(KITAJIMA_RESULTS)" ]; then echo "No results in $(KITAJIMA_RESULTS)"; exit 1; fi
	python3 $(VIZ_SCRIPT) $(KITAJIMA_RESULTS) --all

sr_kitajima_all: sr_kitajima_run sr_viz_kitajima

sr_kitajima_clean:
	rm -rf $(KITAJIMA_RESULTS)

# Blast Wave Test
sr_blast_run: $(SPH_BINARY) sr_check_dim
	@echo "Running Blast Wave Test"
	@mkdir -p $(BLAST_RESULTS)
	./$(SPH_BINARY) $(BLAST_CONFIG)
	@echo "Done: $(BLAST_RESULTS)"

sr_viz_blast:
	@if [ ! -d "$(BLAST_RESULTS)" ]; then echo "No results in $(BLAST_RESULTS)"; exit 1; fi
	python3 $(VIZ_SCRIPT) $(BLAST_RESULTS) --all

sr_blast_all: sr_blast_run sr_viz_blast

sr_blast_clean:
	rm -rf $(BLAST_RESULTS)

# Strong Blast Test
sr_strong_run: $(SPH_BINARY) sr_check_dim
	@echo "Running Strong Blast Test"
	@mkdir -p $(STRONG_RESULTS)
	./$(SPH_BINARY) $(STRONG_CONFIG)
	@echo "Done: $(STRONG_RESULTS)"

sr_viz_strong:
	@if [ ! -d "$(STRONG_RESULTS)" ]; then echo "No results in $(STRONG_RESULTS)"; exit 1; fi
	python3 $(VIZ_SCRIPT) $(STRONG_RESULTS) --all

sr_strong_all: sr_strong_run sr_viz_strong

sr_strong_clean:
	rm -rf $(STRONG_RESULTS)

# Ultra-Relativistic Test
sr_ultra_run: $(SPH_BINARY) sr_check_dim
	@echo "Running Ultra-Relativistic Test"
	@mkdir -p $(ULTRA_RESULTS)
	./$(SPH_BINARY) $(ULTRA_CONFIG)
	@echo "Done: $(ULTRA_RESULTS)"

sr_viz_ultra:
	@if [ ! -d "$(ULTRA_RESULTS)" ]; then echo "No results in $(ULTRA_RESULTS)"; exit 1; fi
	python3 $(VIZ_SCRIPT) $(ULTRA_RESULTS) --all

sr_ultra_all: sr_ultra_run sr_viz_ultra

sr_ultra_clean:
	rm -rf $(ULTRA_RESULTS)

# Full Suite
sr_all: sr_sod_all sr_kitajima_all sr_blast_all sr_strong_all sr_ultra_all
sr_viz_all: sr_viz_sod sr_viz_kitajima sr_viz_blast sr_viz_strong sr_viz_ultra
sr_clean_all: sr_sod_clean sr_kitajima_clean sr_blast_clean sr_strong_clean sr_ultra_clean

# ==============================================================================
# Benchmark Targets (with Analytic Solution Overlay)
# ==============================================================================
# These targets create animations comparing SPH results with exact Riemann solution

sr_benchmark_sod:
	@echo "========================================"
	@echo "Benchmark: Sod Test vs Exact Solution"
	@echo "========================================"
	@if [ ! -d "$(SOD_RESULTS)" ]; then echo "No results in $(SOD_RESULTS). Run sr_sod_run first."; exit 1; fi
	python3 $(VIZ_SCRIPT) $(SOD_RESULTS) --analytic --animate
	@echo "✓ Benchmark animation created"

sr_benchmark_kitajima:
	@echo "========================================"
	@echo "Benchmark: Kitajima Test vs Exact Solution"
	@echo "========================================"
	@if [ ! -d "$(KITAJIMA_RESULTS)" ]; then echo "No results in $(KITAJIMA_RESULTS). Run sr_kitajima_run first."; exit 1; fi
	python3 $(VIZ_SCRIPT) $(KITAJIMA_RESULTS) --analytic --animate
	@echo "✓ Benchmark animation created"

sr_benchmark_blast:
	@echo "========================================"
	@echo "Benchmark: Blast Wave vs Exact Solution"
	@echo "========================================"
	@if [ ! -d "$(BLAST_RESULTS)" ]; then echo "No results in $(BLAST_RESULTS). Run sr_blast_run first."; exit 1; fi
	python3 $(VIZ_SCRIPT) $(BLAST_RESULTS) --analytic --animate
	@echo "✓ Benchmark animation created"

sr_benchmark_strong:
	@echo "========================================"
	@echo "Benchmark: Strong Blast vs Exact Solution"
	@echo "========================================"
	@if [ ! -d "$(STRONG_RESULTS)" ]; then echo "No results in $(STRONG_RESULTS). Run sr_strong_run first."; exit 1; fi
	python3 $(VIZ_SCRIPT) $(STRONG_RESULTS) --analytic --animate
	@echo "✓ Benchmark animation created"

sr_benchmark_ultra:
	@echo "========================================"
	@echo "Benchmark: Ultra-Relativistic vs Exact Solution"
	@echo "========================================"
	@if [ ! -d "$(ULTRA_RESULTS)" ]; then echo "No results in $(ULTRA_RESULTS). Run sr_ultra_run first."; exit 1; fi
	python3 $(VIZ_SCRIPT) $(ULTRA_RESULTS) --analytic --animate
	@echo "✓ Benchmark animation created"

sr_benchmark_all: sr_benchmark_sod sr_benchmark_kitajima sr_benchmark_blast sr_benchmark_strong sr_benchmark_ultra
	@echo "========================================"
	@echo "✓ All Benchmark Animations Complete!"
	@echo "========================================"

# Help
sr_help:
	@echo "SR-GSPH Sod Test Suite (Kitajima 2025)"
	@echo ""
	@echo "Run & Visualize:"
	@echo "  sr_sod_run / sr_viz_sod / sr_sod_all / sr_sod_clean"
	@echo "  sr_kitajima_run / sr_viz_kitajima / sr_kitajima_all / sr_kitajima_clean"
	@echo "  sr_blast_run / sr_viz_blast / sr_blast_all / sr_blast_clean"
	@echo "  sr_strong_run / sr_viz_strong / sr_strong_all / sr_strong_clean"
	@echo "  sr_ultra_run / sr_viz_ultra / sr_ultra_all / sr_ultra_clean"
	@echo "  sr_all / sr_viz_all / sr_clean_all"
	@echo ""
	@echo "Benchmark (with Exact Analytic Solution):"
	@echo "  sr_benchmark_sod       - Sod test vs exact Riemann solution"
	@echo "  sr_benchmark_kitajima  - Kitajima test vs exact solution"
	@echo "  sr_benchmark_blast     - Blast wave vs exact solution"
	@echo "  sr_benchmark_strong    - Strong blast vs exact solution"
	@echo "  sr_benchmark_ultra     - Ultra-relativistic vs exact solution"
	@echo "  sr_benchmark_all       - All benchmarks"
	@echo ""
	@echo "Physical Units: c=1, time in L/c, velocity in c"
	@echo "Reference: Kitajima et al. (2025) arXiv:2510.18251v1"
