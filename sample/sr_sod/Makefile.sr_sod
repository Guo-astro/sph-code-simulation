# SR-GSPH Test Suite Makefile
# Based on Kitajima et al. (2025) arXiv:2510.18251v1
#
# Usage:
#   make -f sample/sr_sod/Makefile.sr_sod sr_sod          # Sod Fig.1 (3200+400)
#   make -f sample/sr_sod/Makefile.sr_sod sr_sod_kitajima # Sod Fig.2 (1800+1800)
#   make -f sample/sr_sod/Makefile.sr_sod sr_blast_wave   # Standard blast wave
#   make -f sample/sr_sod/Makefile.sr_sod sr_strong_blast # Strong blast wave
#   make -f sample/sr_sod/Makefile.sr_sod sr_ultra_v090   # v=0.9c
#   make -f sample/sr_sod/Makefile.sr_sod sr_ultra_v099   # v=0.99c
#   make -f sample/sr_sod/Makefile.sr_sod sr_ultra_v0999  # v=0.999c
#
#   make -f sample/sr_sod/Makefile.sr_sod sr_all          # Run all tests
#   make -f sample/sr_sod/Makefile.sr_sod sr_clean        # Clean results

# Paths
SR_SOD_DIR = sample/sr_sod
PRESET_DIR = $(SR_SOD_DIR)/config/presets
RESULTS_DIR = $(SR_SOD_DIR)/results
SCRIPTS_DIR = $(SR_SOD_DIR)/scripts

# Animation script (use the one in sample/sr_sod/scripts or fall back to scripts/)
ANIMATE_SCRIPT = $(shell if [ -f $(SCRIPTS_DIR)/animate_sr_sod.py ]; then echo $(SCRIPTS_DIR)/animate_sr_sod.py; else echo scripts/animate_sr_sod.py; fi)

.PHONY: sr_sod sr_sod_kitajima sr_blast_wave sr_strong_blast \
        sr_ultra_relat sr_ultra_v090 sr_ultra_v099 sr_ultra_v0999 \
        sr_all sr_clean sr_help sr_check_dim sr_quick

# ============================================================================
# Dimension Check
# ============================================================================

sr_check_dim:
	@if ! grep -q "SPH_DIM:STRING=1" build/CMakeCache.txt 2>/dev/null; then \
		echo "ERROR: SR tests require DIM=1 build"; \
		echo ""; \
		echo "To rebuild for 1D:"; \
		echo "  cd build && cmake -DSPH_DIM=1 .. && make -j8 && cd .."; \
		exit 1; \
	fi

# ============================================================================
# Individual Test Targets (Simulation + Animation)
# ============================================================================

# Quick test (200+200 particles)
sr_quick: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Sod Quick Test (200+200)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_sod_sharp.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/sod_quick
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/sod_quick/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/sod_quick $(RESULTS_DIR)/sod_quick/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/sod_quick/animation.mp4"

# Sod Figure 1: 3200+400 particles (equal baryon number)
sr_sod: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Sod Fig.1 (3200+400 particles)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_sod.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/sod_fig1
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/sod_fig1/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/sod_fig1 $(RESULTS_DIR)/sod_fig1/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/sod_fig1/animation.mp4"

# Sod Figure 2: 1800+1800 particles (volume-based approach)
sr_sod_kitajima: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Sod Fig.2 (1800+1800 particles)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_sod_kitajima.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/sod_kitajima
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/sod_kitajima/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/sod_kitajima $(RESULTS_DIR)/sod_kitajima/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/sod_kitajima/animation.mp4"

