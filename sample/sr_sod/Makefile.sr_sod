sr_blast_wave: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Standard Blast Wave (5000+500)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_blast_wave.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/blast_wave
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/blast_wave/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/blast_wave $(RESULTS_DIR)/blast_wave/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/blast_wave/animation.mp4"

# Strong blast wave: 900+900 particles
sr_strong_blast: build/sph sr_check_dim
	@echo "=========================================="
	@echo "SR Strong Blast Wave (900+900)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_strong_blast.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/strong_blast
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/strong_blast/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/strong_blast $(RESULTS_DIR)/strong_blast/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/strong_blast/animation.mp4"

# Ultra-relativistic: v=0.9c (gamma=2.29)
sr_ultra_v090: build/sph sr_check_dim
	@echo "=========================================="
	@echo "Ultra-Relativistic v=0.9c (gamma=2.29)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_ultra_v090.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/ultra_v090
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/ultra_v090/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/ultra_v090 $(RESULTS_DIR)/ultra_v090/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/ultra_v090/animation.mp4"

# Ultra-relativistic: v=0.99c (gamma=7.09)
sr_ultra_v099: build/sph sr_check_dim
	@echo "=========================================="
	@echo "Ultra-Relativistic v=0.99c (gamma=7.09)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_ultra_v099.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/ultra_v099
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/ultra_v099/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/ultra_v099 $(RESULTS_DIR)/ultra_v099/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/ultra_v099/animation.mp4"

# Ultra-relativistic: v=0.999c (gamma=22.4)
sr_ultra_v0999: build/sph sr_check_dim
	@echo "=========================================="
	@echo "Ultra-Relativistic v=0.999c (gamma=22.4)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_ultra_v0999.json sr_sod.json
	@mkdir -p $(RESULTS_DIR)/ultra_v0999
	@echo "[1/2] Running simulation..."
	@./build/sph sr_sod.json
	@echo "Done! Results in $(RESULTS_DIR)/ultra_v0999/"
	@echo ""
	@echo "[2/2] Generating animation..."
	@python3 $(ANIMATE_SCRIPT) $(RESULTS_DIR)/ultra_v0999 $(RESULTS_DIR)/ultra_v0999/animation.mp4 5
	@echo "Animation: $(RESULTS_DIR)/ultra_v0999/animation.mp4"

# ============================================================================
# Multi-Test Workflow
# ============================================================================

# Run all Kitajima benchmark tests
sr_all: build/sph sr_check_dim
	@echo "=========================================="
	@echo "Running All Kitajima Benchmark Tests"
	@echo "=========================================="
	@echo ""
	@echo "[1/7] Sod Fig.1 (3200+400)..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_sod
	@echo ""
	@echo "[2/7] Sod Fig.2 (1800+1800)..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_sod_kitajima
	@echo ""
	@echo "[3/7] Standard Blast Wave..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_blast_wave
	@echo ""
	@echo "[4/7] Strong Blast Wave..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_strong_blast
	@echo ""
	@echo "[5/7] Ultra v=0.9c..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_ultra_v090
	@echo ""
	@echo "[6/7] Ultra v=0.99c..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_ultra_v099
	@echo ""
	@echo "[7/7] Ultra v=0.999c..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_ultra_v0999
	@echo ""
	@echo "=========================================="
	@echo "All 7 Kitajima benchmark tests complete!"
	@echo "=========================================="

# ============================================================================
# Clean Target
# ============================================================================

sr_clean:
	@echo "Cleaning all SR test results..."
	@rm -rf $(RESULTS_DIR)
	@rm -f sr_sod.json
	@echo "Done"

# ============================================================================
# Help
# ============================================================================

sr_help:
	@echo "SR-GSPH Test Suite - Kitajima et al. (2025)"
	@echo "==========================================="
	@echo ""
	@echo "Based on arXiv:2510.18251v1"
	@echo ""
	@echo "Individual Tests:"
	@echo "  sr_quick         - Quick Sod test (200+200) for debugging"
	@echo "  sr_sod           - Sod Fig.1: 3200+400 particles, equal nu"
	@echo "  sr_sod_kitajima  - Sod Fig.2: 1800+1800 particles, volume-based"
	@echo "  sr_blast_wave    - Standard blast wave: 5000+500 particles"
	@echo "  sr_strong_blast  - Strong blast wave: 900+900 particles"
	@echo "  sr_ultra_v090    - Ultra-relativistic v=0.9c (gamma=2.29)"
	@echo "  sr_ultra_v099    - Ultra-relativistic v=0.99c (gamma=7.09)"
	@echo "  sr_ultra_v0999   - Ultra-relativistic v=0.999c (gamma=22.4)"
	@echo ""
	@echo "Batch Operations:"
	@echo "  sr_all           - Run all 7 benchmark tests"
	@echo "  sr_clean         - Clean all results"
	@echo ""
	@echo "Parameters (from Kitajima paper):"
	@echo "  eta = 1.0, C_smooth = 2.0, C_shock = 3.0, C_cd = 1.0"
	@echo "  CFL = 0.3, gamma_c = 5/3, kernel = Gaussian"
	@echo ""
	@echo "Example:"
	@echo "  make -f sample/sr_sod/Makefile.sr_sod sr_sod_kitajima"
