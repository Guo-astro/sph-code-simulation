# Ultra-relativistic v=0.999c
sr_ultra_v0999: build/sph sr_check_dim
	@echo "=========================================="
	@echo "Ultra-Relativistic v=0.999c (γ≈22.4)"
	@echo "=========================================="
	@cp $(PRESET_DIR)/sr_ultra_v0999.json sr_sod.json
