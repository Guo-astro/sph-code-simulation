	@echo "📁 Results: $(RESULTS_DIR)/ultra_v0999/"

# ============================================================================
# Multi-Test Workflow
# ============================================================================

# Run all 7 tests
sr_all: build/sph sr_check_dim
	@echo "=========================================="
	@echo "Running All 7 SR Tests"
	@echo "=========================================="
	@echo ""
	@echo "[1/7] SR Sod..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_sod
	@echo ""
	@echo "[2/7] Standard Blast Wave..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_blast_wave
	@echo ""
	@echo "[3/7] Strong Blast Wave..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_strong_blast
	@echo ""
	@echo "[4/7] Ultra-Relativistic (general)..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_ultra_relat
	@echo ""
	@echo "[5/7] Ultra v=0.9c..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_ultra_v090
	@echo ""
	@echo "[6/7] Ultra v=0.99c..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_ultra_v099
	@echo ""
	@echo "[7/7] Ultra v=0.999c..."
	@$(MAKE) -f sample/sr_sod/Makefile.sr_sod sr_ultra_v0999
	@echo ""
	@echo "=========================================="
	@echo "✓ All 7 tests complete!"
	@echo "=========================================="

# ============================================================================
# Clean Target
# ============================================================================

sr_clean:
	@echo "Cleaning all SR test results..."
	@rm -rf $(RESULTS_DIR)
	@rm -f sr_sod.json
	@echo "✓ Cleaned"

# ============================================================================
# Help
# ============================================================================

sr_help:
	@echo "SR-GSPH Test Suite Makefile"
	@echo "============================"
	@echo ""
	@echo "Individual Tests (run simulation + create animation):"
	@echo "  make sr_sod          - SR Sod shock tube"
	@echo "  make sr_blast_wave   - Standard blast wave"
	@echo "  make sr_strong_blast - Strong blast wave"
	@echo "  make sr_ultra_relat  - Ultra-relativistic (general)"
	@echo "  make sr_ultra_v090   - Ultra-relativistic v=0.9c"
	@echo "  make sr_ultra_v099   - Ultra-relativistic v=0.99c"
	@echo "  make sr_ultra_v0999  - Ultra-relativistic v=0.999c"
	@echo ""
	@echo "Batch Operations:"
	@echo "  make sr_all          - Run all 7 tests"
	@echo "  make sr_clean        - Clean all results"
	@echo ""
	@echo "Examples:"
	@echo "  make -f sample/sr_sod/Makefile.sr_sod sr_sod"
	@echo "  make -f sample/sr_sod/Makefile.sr_sod sr_all"
	@echo ""
	@echo "Note: Requires DIM=1 build configuration."
