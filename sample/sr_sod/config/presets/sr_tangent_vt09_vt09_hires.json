{
  "_comment": "Kitajima et al. (2025) Section 3.1.5 Figure 9: High-resolution tangent velocity test",
  "_reference": "arXiv:2510.18251v1, Fig. 9 (51200 left + 1600 right particles)",
  "_initial_left": "(P, n, v^x, v^t) = (1000, 1.0, 0, 0.9)",
  "_initial_right": "(P, n, v^x, v^t) = (0.01, 1.0, 0, 0.9)",
  "_note": "High resolution on left side to resolve rarefaction wave",
  "outputDirectory": "sample/sr_sod/results/tangent_vt09_vt09_hires",
  "startTime": 0.0,
  "endTime": 0.25,
  "outputTime": 0.005,
  "energyTime": 0.01,
  "checkpoint": {
    "enabled": false,
    "resumeFile": ""
  },
  "output": {
    "formats": [
      {
        "type": "csv",
        "precision": 16
      }
    ],
    "enableEnergyFile": true
  },
  "SPHType": "srgsph",
  "use2ndOrderSRGSPH": true,
  "riemannSolver": "exact",
  "cSpeed": 1.0,
  "cShock": 3.0,
  "cContactDiscontinuity": 1.0,
  "etaSmoothingLength": 1.0,
  "gamma": 1.666666667,
  "kernel": "gaussian",
  "iterativeSmoothingLength": true,
  "neighborNumber": 50,
  "N": 51200,
  "vt_left": 0.9,
  "vt_right": 0.9,
  "useGhostParticles": true,
  "ghostLayers": 6,
  "periodic": false,
  "rangeMax": [0.5],
  "rangeMin": [-0.5],
  "avAlpha": 0.0,
  "useBalsaraSwitch": false,
  "cflSound": 0.3,
  "cflForce": 0.25
}
