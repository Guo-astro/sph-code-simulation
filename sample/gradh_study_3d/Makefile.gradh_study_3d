# Grad-H & Kernel-Convolved Gravity Study - Unified Makefile (SSOT)
# ================================================================================
#
# This study investigates the interaction between:
# 1. Grad-H correction term (Ω): accounts for variable smoothing length
# 2. Gravitational softening kernel: Hernquist-Katz vs Wendland C4
#
# PHYSICS: Lane-Emden n=1.5 polytrope (γ=5/3) in hydrostatic equilibrium.
# Without the Ω correction, the cloud undergoes artificial numerical collapse.
#
# HYPOTHESIS: True kernel-convolved gravity (Wendland C4) may eliminate
# the need for grad-h correction because gravity and SPH use the same kernel.
#
# ================================================================================
# Usage (from repository root):
# ================================================================================
#
# Quick Start - 2-Case Comparison (Ω ON vs OFF with Hernquist-Katz):
#   make -f sample/gradh_study_3d/Makefile.gradh_study gradh_run     # Run both cases
#   make -f sample/gradh_study_3d/Makefile.gradh_study viz_html      # Generate interactive HTML
#   make -f sample/gradh_study_3d/Makefile.gradh_study gradh_all     # Run + visualize
#
# 4-Case Kernel Study (2×2 matrix: Ω × softening kernel):
#   make -f sample/gradh_study_3d/Makefile.gradh_study kernel_all    # Run all 4 cases + viz
#
# Individual Cases:
#   make -f sample/gradh_study_3d/Makefile.gradh_study case1         # Ω ON  + H-K (baseline)
#   make -f sample/gradh_study_3d/Makefile.gradh_study case2         # Ω OFF + H-K (collapse expected)
#   make -f sample/gradh_study_3d/Makefile.gradh_study case3         # Ω ON  + Wendland
#   make -f sample/gradh_study_3d/Makefile.gradh_study case4         # Ω OFF + Wendland (KEY TEST)
#
# Long Runs (t=150 for collapse observation):
#   make -f sample/gradh_study_3d/Makefile.gradh_study long_case2    # Long H-K without Ω
#   make -f sample/gradh_study_3d/Makefile.gradh_study long_case4    # Long Wendland without Ω
#
# Visualization:
#   make -f sample/gradh_study_3d/Makefile.gradh_study viz_html      # Interactive HTML with Lane-Emden
#
# Help:
#   make -f sample/gradh_study_3d/Makefile.gradh_study help

# ================================================================================
# Paths (Single Source of Truth)
# ================================================================================
GRADH_DIR      := sample/gradh_study_3d
PRESET_DIR     := $(GRADH_DIR)/config/presets
RESULTS_DIR    := $(GRADH_DIR)/results
KERNEL_RESULTS := $(RESULTS_DIR)/kernel_test
LONG_RESULTS   := $(RESULTS_DIR)/long_test
SCRIPTS_DIR    := $(GRADH_DIR)/scripts
FIG_DIR        := $(GRADH_DIR)/figures_v2

# Python executable (with numpy, pandas, scipy)
PYTHON         := /usr/local/bin/python3

# Executable
SPH := ./build/sph

# Relaxed IC (10k particles)
RELAXED_IC := sample/imbh_cloud/results/relaxation/10k/GSPH/snapshot_0020.csv

# ================================================================================
# Test Matrix
# ================================================================================
# | Case | Grad-H (Ω) | Softening Type | Config File                    | Expected    |
# |------|------------|----------------|--------------------------------|-------------|
# | 1    | YES        | Hernquist-Katz | selfgrav_gradh_hk.json         | ✅ Stable   |
# | 2    | NO         | Hernquist-Katz | selfgrav_no_gradh_hk.json      | ❌ Collapse |
# | 3    | YES        | Wendland C4    | selfgrav_gradh_wendland.json   | ✅ Stable   |
# | 4    | NO         | Wendland C4    | selfgrav_no_gradh_wendland.json| ❓ KEY TEST |
# ================================================================================

# ================================================================================
# PHONY Targets
# ================================================================================
.PHONY: help check_build check_ic \
        case1 case2 case3 case4 kernel_run kernel_all \
        gradh_run gradh_all \
        long_case2 long_case4 long_run long_all \
        viz_html viz viz_v2 viz_long \
        clean clean_kernel clean_long clean_gradh

