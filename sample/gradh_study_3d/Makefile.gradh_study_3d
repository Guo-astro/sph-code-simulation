	@echo "  the gravitational softening matches the SPH kernel may eliminate"
	@echo "  the need for Ω correction."
	@echo ""
	@echo "TEST MATRIX:"
	@echo "  ┌──────┬────────┬──────────────┬──────────────┐"
	@echo "  │ Case │ Grad-H │ Grav Kernel  │ Expected     │"
	@echo "  ├──────┼────────┼──────────────┼──────────────┤"
	@echo "  │  1   │  ON    │ Hernquist-K  │ ✅ Stable    │"
	@echo "  │  2   │  OFF   │ Hernquist-K  │ ❌ Collapse  │"
	@echo "  │  3   │  ON    │ Wendland C4  │ ✅ Stable    │"
