# ================================================================================
# Build & IC Checks
# ================================================================================
check_build:
	@if grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
		echo "✓ DIM=3 build detected"; \
	else \
		echo "ERROR: This test requires DIM=3 build"; \
		echo "Run: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
		exit 1; \
	fi

check_ic:
	@if [ ! -f "$(RELAXED_IC)" ]; then \
		echo "ERROR: Relaxed IC not found: $(RELAXED_IC)"; \
		echo "Run: make -f sample/imbh_cloud/Makefile.relaxation relax_oneshot SIZE=10k METHOD=gsph"; \
		exit 1; \
	fi
	@echo "✓ Relaxed IC found: $(RELAXED_IC)"

# ================================================================================
# Individual Cases (Short Runs, t=5)
# ================================================================================
case1: check_build check_ic
	@echo "========================================"
	@echo "[Case 1] Grad-H ON + Hernquist-Katz"
	@echo "========================================"
	@mkdir -p $(KERNEL_RESULTS)/gradh_hk
	$(SPH) $(PRESET_DIR)/selfgrav_gradh_hk.json
	@echo "✓ Case 1 complete"

case2: check_build check_ic
	@echo "========================================"
	@echo "[Case 2] Grad-H OFF + Hernquist-Katz"
	@echo "========================================"
	@mkdir -p $(KERNEL_RESULTS)/no_gradh_hk
	$(SPH) $(PRESET_DIR)/selfgrav_no_gradh_hk.json
	@echo "✓ Case 2 complete"

case3: check_build check_ic
	@echo "========================================"
	@echo "[Case 3] Grad-H ON + Wendland C4"
	@echo "========================================"
	@mkdir -p $(KERNEL_RESULTS)/gradh_wendland
	$(SPH) $(PRESET_DIR)/selfgrav_gradh_wendland.json
	@echo "✓ Case 3 complete"

case4: check_build check_ic
	@echo "========================================"
	@echo "[Case 4] Grad-H OFF + Wendland C4 (KEY TEST)"
	@echo "========================================"
	@mkdir -p $(KERNEL_RESULTS)/no_gradh_wendland
	$(SPH) $(PRESET_DIR)/selfgrav_no_gradh_wendland.json
	@echo "✓ Case 4 complete"

kernel_run: case1 case2 case3 case4
	@echo ""
	@echo "================================================================================"
	@echo "✓ All 4 kernel test cases complete!"
	@echo "================================================================================"

# ================================================================================
# 2-Case Grad-H Comparison (Quick Study)
# ================================================================================
gradh_run: check_build check_ic
	@echo "========================================"
	@echo "[1/2] Grad-H ON + Hernquist-Katz (baseline)"
	@echo "========================================"
	@mkdir -p $(RESULTS_DIR)/case1_gradh_hk
	$(SPH) $(PRESET_DIR)/selfgrav_gradh_hk.json
	@echo "✓ Case 1 complete"
	@echo ""
	@echo "========================================"
	@echo "[2/2] Grad-H OFF + Hernquist-Katz (collapse expected)"
	@echo "========================================"
	@mkdir -p $(RESULTS_DIR)/case2_no_gradh_hk
	$(SPH) $(PRESET_DIR)/selfgrav_no_gradh_hk.json
	@echo "✓ Case 2 complete"
	@echo ""
	@echo "================================================================================"
	@echo "✓ 2-case grad-h comparison complete!"
	@echo "Run: make -f $(GRADH_DIR)/Makefile.gradh_study viz_html"
	@echo "================================================================================"

# ================================================================================
# Long Runs (t=150)
# ================================================================================
long_case2: check_build check_ic
	@echo "========================================"
	@echo "[Long Case 2] Grad-H OFF + H-K (t=150)"
	@echo "========================================"
	@mkdir -p $(LONG_RESULTS)/no_gradh_hk
	$(SPH) $(PRESET_DIR)/selfgrav_no_gradh_hk_long.json
	@echo "✓ Long Case 2 complete"

long_case4: check_build check_ic
	@echo "========================================"
	@echo "[Long Case 4] Grad-H OFF + Wendland (t=150)"
	@echo "========================================"
	@mkdir -p $(LONG_RESULTS)/no_gradh_wendland
	$(SPH) $(PRESET_DIR)/selfgrav_no_gradh_wendland_long.json
	@echo "✓ Long Case 4 complete"

long_run: long_case2 long_case4
	@echo ""
	@echo "================================================================================"
	@echo "✓ Both long runs complete!"
	@echo "================================================================================"

# ================================================================================
# Visualization
# ================================================================================
viz_html:
	@echo "================================================================================"
	@echo "Generating Interactive HTML with Lane-Emden Analytic Overlay"
	@echo "================================================================================"
	@mkdir -p $(FIG_DIR)
	@if [ -d "$(KERNEL_RESULTS)/gradh_hk" ] && [ -d "$(KERNEL_RESULTS)/no_gradh_hk" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/gen_html_viewer.py \
			--case1 results/kernel_test/gradh_hk \
			--case2 results/kernel_test/no_gradh_hk \
			--output figures_v2/interactive_viewer.html; \
		echo ""; \
		echo "✓ HTML visualization generated!"; \
		echo "Open: $(FIG_DIR)/interactive_viewer.html"; \
	else \
		echo "ERROR: Results not found. Run 'kernel_run' or individual cases first."; \
		echo "  Expected: $(KERNEL_RESULTS)/gradh_hk"; \
		echo "           $(KERNEL_RESULTS)/no_gradh_hk"; \
		exit 1; \
	fi

viz: viz_html

viz_v2: viz_html

viz_long:
	@echo "================================================================================"
	@echo "Generating Long-Run Comparison Visualization"
	@echo "================================================================================"
	@mkdir -p $(FIG_DIR)/long_comparison
	@if [ -d "$(LONG_RESULTS)/no_gradh_hk" ] && [ -d "$(LONG_RESULTS)/no_gradh_wendland" ]; then \
		$(PYTHON) $(SCRIPTS_DIR)/gen_html_viewer.py \
			--case1 results/long_test/no_gradh_hk \
			--case2 results/long_test/no_gradh_wendland \
			--output figures_v2/long_comparison/interactive_viewer.html; \
		echo ""; \
		echo "✓ Long-run visualization complete!"; \
		echo "Open: $(FIG_DIR)/long_comparison/interactive_viewer.html"; \
	else \
		echo "ERROR: Long-run results not found. Run 'long_run' first."; \
		exit 1; \
	fi

# ================================================================================
# Combined Targets
# ================================================================================
gradh_all: gradh_run viz_html
	@echo ""
	@echo "================================================================================"
	@echo "✓ Complete Grad-H Study Done!"
	@echo "Results: $(RESULTS_DIR)/case1_gradh_hk, $(RESULTS_DIR)/case2_no_gradh_hk"
	@echo "Viewer:  open $(FIG_DIR)/interactive_viewer.html"
	@echo "================================================================================"

kernel_all: kernel_run viz
	@echo ""
	@echo "================================================================================"
	@echo "✓ Complete Kernel Study Done!"
	@echo "Results: $(KERNEL_RESULTS)"
	@echo "Viewer:  open $(FIG_DIR)/interactive_viewer.html"
	@echo "================================================================================"

long_all: long_run viz_long
	@echo ""
	@echo "================================================================================"
	@echo "✓ Complete Long-Run Study Done!"
	@echo "Results: $(LONG_RESULTS)"
	@echo "Viewer:  open $(FIG_DIR)/long_comparison/interactive_viewer.html"
	@echo "================================================================================"

# ================================================================================
# Cleanup
# ================================================================================
clean_gradh:
	@echo "Cleaning 2-case grad-h results..."
	rm -rf $(RESULTS_DIR)/case1_gradh_hk
	rm -rf $(RESULTS_DIR)/case2_no_gradh_hk
	@echo "✓ Grad-h results cleaned"

clean_kernel:
	@echo "Cleaning kernel test results..."
	rm -rf $(KERNEL_RESULTS)/gradh_hk
	rm -rf $(KERNEL_RESULTS)/no_gradh_hk
	rm -rf $(KERNEL_RESULTS)/gradh_wendland
	rm -rf $(KERNEL_RESULTS)/no_gradh_wendland
	@echo "✓ Kernel test results cleaned"

clean_long:
	@echo "Cleaning long test results..."
	rm -rf $(LONG_RESULTS)/no_gradh_hk
	rm -rf $(LONG_RESULTS)/no_gradh_wendland
	@echo "✓ Long test results cleaned"

clean: clean_gradh clean_kernel clean_long
	@echo "Cleaning figures..."
	rm -rf $(FIG_DIR)
	@echo "✓ All results cleaned"

# ================================================================================
# Legacy Targets (deprecated - will be removed)
# ================================================================================
.PHONY: run_all run_gradh_hk run_no_gradh_hk run_gradh_wendland run_no_gradh_wendland

run_all: kernel_run
run_gradh_hk: case1
run_no_gradh_hk: case2
run_gradh_wendland: case3
run_no_gradh_wendland: case4
