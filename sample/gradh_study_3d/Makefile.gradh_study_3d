	@echo ""
	@echo "QUICK START (2-case Ω comparison):"
	@echo "  make -f sample/gradh_study_3d/Makefile.gradh_study gradh_all"
	@echo ""
	@echo "4-CASE KERNEL STUDY:"
	@echo "  make -f sample/gradh_study_3d/Makefile.gradh_study kernel_all"
	@echo ""
	@echo "INDIVIDUAL SIMULATIONS (short runs, t=5):"
	@echo "  gradh_run   - Run case1 (Ω ON) and case2 (Ω OFF) with H-K"
	@echo "  case1       - Grad-H ON  + Hernquist-Katz"
	@echo "  case2       - Grad-H OFF + Hernquist-Katz"
	@echo "  case3       - Grad-H ON  + Wendland C4"
	@echo "  case4       - Grad-H OFF + Wendland C4 (KEY TEST)"
