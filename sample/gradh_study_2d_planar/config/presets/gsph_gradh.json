{
    "name": "2d_planar_gsph_gradh_wendland",
    "description": "GSPH with grad-h correction - 2D planar Lane-Emden slab (γ=5/3)",
    
    "sample": "polytropic_slab_2d",
    "N": 50,
    "rho_center": 1.0,
    "K": 1.0,
    "L_x": 2.0,
    
    "outputDirectory": "sample/gradh_study_2d_planar/results/gsph_gradh",
    "outputInterval": 0.5,
    "endTime": 50.0,
    
    "kernel": "wendland",
    "gamma": 1.6666666666666667,
    "neighborNumber": 32,
    
    "useGravity": true,
    "gravityConstant": 1.0,
    "useKernelGravityPlanar2D": true,
    
    "SPHType": "gsph",
    "use2ndOrderGSPH": true,
    "riemannSolver": "hll",
    "useGradH": true
}
