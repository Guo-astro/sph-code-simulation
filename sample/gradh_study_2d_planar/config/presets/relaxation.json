{
    "name": "2d_planar_relaxation_wendland",
    "description": "Relaxation for 2D planar Lane-Emden slab (γ=5/3, n=1.5) with Wendland kernel",
    
    "sample": "polytropic_slab_2d",
    "N": 50,
    "rho_center": 1.0,
    "K": 1.0,
    "L_x": 2.0,
    
    "outputDirectory": "sample/gradh_study_2d_planar/results/relaxation",
    "outputInterval": 0.1,
    "endTime": 10.0,
    
    "kernel": "wendland",
    "gamma": 1.6666666666666667,
    "neighborNumber": 32,
    
    "useGravity": true,
    "gravityConstant": 1.0,
    "useKernelGravityPlanar2D": true,
    
    "SPHType": "gsph",
    "use2ndOrderGSPH": true,
    "riemannSolver": "hll",
    "useGradH": true,
    
    "useRelaxation": true,
    "relaxationSteps": 5000,
    "relaxationOutputFreq": 500,
    "relaxationOnly": true
}
