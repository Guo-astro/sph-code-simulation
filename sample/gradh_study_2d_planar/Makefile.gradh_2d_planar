# 2D Planar Lane-Emden Grad-h Study Makefile Targets
#
# This test suite compares GSPH vs SSPH with/without grad-h correction
# for a 2D planar Lane-Emden slab (γ=5/3, n=1.5) with kernel-convolved
# 1D gravity in the y-direction only.
#
# Single Method Usage:
#   make gradh_2d_run PRESET=gsph_gradh    # Run specific preset
#   make gradh_2d_clean                     # Clean results
#
# Multi-Method Comparison:
#   make gradh_2d_compare_run              # Run all 4 methods (GSPH/SSPH × grad-h)
#   make gradh_2d_compare_viz              # Generate comparison plots
#   make gradh_2d_compare_animate          # Generate comparison animation
#   make gradh_2d_compare_all              # Run all + visualizations
#   make gradh_2d_compare_clean            # Clean comparison results

# Default preset
GRADH_2D_PRESET ?= gsph_gradh

# Paths
GRADH_2D_DIR = sample/gradh_study_2d_planar
GRADH_2D_PRESET_DIR = $(GRADH_2D_DIR)/config/presets
GRADH_2D_RESULTS_DIR = $(GRADH_2D_DIR)/results
GRADH_2D_SCRIPTS_DIR = $(GRADH_2D_DIR)/scripts

.PHONY: gradh_2d_run gradh_2d_clean gradh_2d_help \
        gradh_2d_compare_run gradh_2d_compare_viz gradh_2d_compare_animate \
        gradh_2d_compare_all gradh_2d_compare_clean \
        gradh_2d_relaxation

# ============================================================================
# Single Method Targets
# ============================================================================

# Run single method
gradh_2d_run: build/sph
	@echo "=========================================="
	@echo "2D Planar Lane-Emden: $(GRADH_2D_PRESET)"
	@echo "=========================================="
	@echo "Checking build configuration..."
	@if grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
		echo "✓ DIM=2 build detected"; \
	else \
		echo "❌ ERROR: 2D Planar test requires DIM=2 build"; \
		echo ""; \
		echo "Current build is configured for DIM=$$(grep 'SPH_DIM:STRING' build/CMakeCache.txt 2>/dev/null | cut -d= -f2 || echo 'unknown')."; \
		echo ""; \
		echo "To rebuild for 2D:"; \
		echo "  cd build && rm -f CMakeCache.txt && cmake -DSPH_DIM=2 .. && make -j4 && cd .."; \
		echo ""; \
		exit 1; \
	fi
	@echo "Output directory:"
	@grep -o '"outputDirectory"[[:space:]]*:[[:space:]]*"[^"]*"' $(GRADH_2D_PRESET_DIR)/$(GRADH_2D_PRESET).json | sed 's/.*: *"\(.*\)"/  📁 \1/'
	@echo "Creating results directory..."
	@mkdir -p $(GRADH_2D_RESULTS_DIR)/$(GRADH_2D_PRESET)
	@echo "Running simulation..."
	./build/sph $(GRADH_2D_PRESET_DIR)/$(GRADH_2D_PRESET).json
	@echo ""
	@echo "✓ Simulation complete!"
	@echo "📁 Results saved to: $(GRADH_2D_RESULTS_DIR)/$(GRADH_2D_PRESET)"

# Clean results
gradh_2d_clean:
	@echo "Cleaning 2D planar grad-h study results..."
	@rm -rf $(GRADH_2D_RESULTS_DIR)/*
	@echo "✓ Results cleaned"

# Help
gradh_2d_help:
	@echo "2D Planar Lane-Emden Grad-h Study"
	@echo "=================================="
	@echo ""
	@echo "Test: γ=5/3 polytropic slab with 1D gravity in y-direction"
	@echo "Purpose: Compare energy conservation between GSPH/SSPH × grad-h"
	@echo ""
	@echo "Single Method Targets:"
	@echo "  gradh_2d_run PRESET=<name>  - Run specific preset"
	@echo "  gradh_2d_clean              - Clean all results"
	@echo ""
	@echo "Available presets:"
	@echo "  relaxation    - Initial relaxation phase"
	@echo "  gsph_gradh    - GSPH with grad-h correction"
	@echo "  gsph_nogradh  - GSPH without grad-h correction"
	@echo "  ssph_gradh    - SSPH with grad-h correction"
	@echo "  ssph_nogradh  - SSPH without grad-h correction"
	@echo ""
	@echo "Multi-Method Comparison Targets:"
	@echo "  gradh_2d_compare_run     - Run all 4 methods"
	@echo "  gradh_2d_compare_viz     - Generate comparison plots"
	@echo "  gradh_2d_compare_animate - Generate comparison animation"
	@echo "  gradh_2d_compare_all     - Run all + visualizations"
	@echo "  gradh_2d_compare_clean   - Clean comparison results"
	@echo ""
	@echo "Example workflow:"
	@echo "  make gradh_2d_compare_all"

# ============================================================================
# Multi-Method Comparison Targets
# ============================================================================

# Run all four methods (GSPH/SSPH × grad-h/no-grad-h)
gradh_2d_compare_run: build/sph
	@echo "=========================================="
	@echo "2D Planar Lane-Emden: 4-Method Comparison"
	@echo "Running: GSPH/SSPH × grad-h/no-grad-h"
	@echo "=========================================="
	@echo "Checking build configuration..."
	@if grep -q "SPH_DIM:STRING=2" build/CMakeCache.txt 2>/dev/null; then \
		echo "✓ DIM=2 build detected"; \
	else \
		echo "❌ ERROR: 2D Planar test requires DIM=2 build"; \
		echo "To rebuild: cd build && rm -f CMakeCache.txt && cmake -DSPH_DIM=2 .. && make -j4"; \
		exit 1; \
	fi
	@echo ""
	@echo "[1/4] Running GSPH + grad-h simulation..."
	@echo "========================================"
	@mkdir -p $(GRADH_2D_RESULTS_DIR)/gsph_gradh
	@./build/sph $(GRADH_2D_PRESET_DIR)/gsph_gradh.json
	@echo "✓ GSPH + grad-h complete"
	@echo ""
	@echo "[2/4] Running GSPH - grad-h simulation..."
	@echo "========================================"
	@mkdir -p $(GRADH_2D_RESULTS_DIR)/gsph_nogradh
	@./build/sph $(GRADH_2D_PRESET_DIR)/gsph_nogradh.json
	@echo "✓ GSPH - grad-h complete"
	@echo ""
	@echo "[3/4] Running SSPH + grad-h simulation..."
	@echo "========================================"
	@mkdir -p $(GRADH_2D_RESULTS_DIR)/ssph_gradh
	@./build/sph $(GRADH_2D_PRESET_DIR)/ssph_gradh.json
	@echo "✓ SSPH + grad-h complete"
	@echo ""
	@echo "[4/4] Running SSPH - grad-h simulation..."
	@echo "========================================"
	@mkdir -p $(GRADH_2D_RESULTS_DIR)/ssph_nogradh
	@./build/sph $(GRADH_2D_PRESET_DIR)/ssph_nogradh.json
	@echo "✓ SSPH - grad-h complete"
	@echo ""
	@echo "=========================================="
	@echo "✓ All 4 simulations complete!"
	@echo "=========================================="

# Generate comparison plots
gradh_2d_compare_viz:
	@echo "=========================================="
	@echo "Generating 2D Planar Comparison Plots"
	@echo "=========================================="
	@if [ ! -d "$(GRADH_2D_RESULTS_DIR)/gsph_gradh" ]; then \
		echo "❌ ERROR: Missing results directories"; \
		echo "Run 'make gradh_2d_compare_run' first."; \
		exit 1; \
	fi
	@mkdir -p $(GRADH_2D_RESULTS_DIR)/comparison
	@chmod +x $(GRADH_2D_SCRIPTS_DIR)/compare_methods.py 2>/dev/null || true
	@python3 $(GRADH_2D_SCRIPTS_DIR)/compare_methods.py
	@echo ""
	@echo "✓ Comparison plots generated!"
	@echo "📊 Output: $(GRADH_2D_RESULTS_DIR)/comparison/"

# Generate comparison animation
gradh_2d_compare_animate:
	@echo "=========================================="
	@echo "Generating 2D Planar Comparison Animation"
	@echo "=========================================="
	@if [ ! -d "$(GRADH_2D_RESULTS_DIR)/gsph_gradh" ]; then \
		echo "❌ ERROR: Missing results directories"; \
		echo "Run 'make gradh_2d_compare_run' first."; \
		exit 1; \
	fi
	@mkdir -p $(GRADH_2D_RESULTS_DIR)/comparison
	@chmod +x $(GRADH_2D_SCRIPTS_DIR)/animate_comparison.py 2>/dev/null || true
	@python3 $(GRADH_2D_SCRIPTS_DIR)/animate_comparison.py
	@echo ""
	@echo "✓ Animation complete!"
	@echo "🎬 Output: $(GRADH_2D_RESULTS_DIR)/comparison/4method_comparison.gif"

# Run all comparisons and visualizations
gradh_2d_compare_all: gradh_2d_compare_run gradh_2d_compare_viz gradh_2d_compare_animate
	@echo ""
	@echo "=========================================="
	@echo "✓ Complete 2D Planar Comparison Done!"
	@echo "=========================================="
	@echo "Results: $(GRADH_2D_RESULTS_DIR)/"
	@echo "  - gsph_gradh/    : GSPH with grad-h"
	@echo "  - gsph_nogradh/  : GSPH without grad-h"
	@echo "  - ssph_gradh/    : SSPH with grad-h"
	@echo "  - ssph_nogradh/  : SSPH without grad-h"
	@echo "  - comparison/    : Plots and animation"

# Clean comparison results
gradh_2d_compare_clean:
	@echo "Cleaning 2D planar comparison results..."
	@rm -rf $(GRADH_2D_RESULTS_DIR)/gsph_gradh $(GRADH_2D_RESULTS_DIR)/gsph_nogradh
	@rm -rf $(GRADH_2D_RESULTS_DIR)/ssph_gradh $(GRADH_2D_RESULTS_DIR)/ssph_nogradh
	@rm -rf $(GRADH_2D_RESULTS_DIR)/comparison
	@echo "✓ Comparison results cleaned"
