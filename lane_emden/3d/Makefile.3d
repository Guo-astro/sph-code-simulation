# ============================================================================
# LANE-EMDEN 3D MAKEFILE
# ============================================================================
#
# PURPOSE:
#   Relaxation Benchmark System for Lane-Emden 3D polytrope simulations.
#   Tests 3D stellar equilibrium structures.
#
# USAGE:
#   make -f lane_emden/3d/Makefile.3d lane_emden_3d_relax
#   make -f lane_emden/3d/Makefile.3d lane_emden_3d_all
#   make -f lane_emden/3d/Makefile.3d lane_emden_3d_help
#
# SPH METHODS:
#   gsph    - Godunov SPH (Riemann solver based)
#   ssph    - Standard SPH (artificial viscosity)
#   disph   - Density-Independent SPH
#   gdisph  - Godunov DISPH (Riemann + density-independent)
#
# OUTPUT:
#   Results: lane_emden/3d/results/
#
# ============================================================================

# Paths
LANE_EMDEN_3D_DIR := lane_emden/3d
LANE_EMDEN_3D_PRESET_DIR := $(LANE_EMDEN_3D_DIR)/config/presets
LANE_EMDEN_3D_RESULTS_DIR := $(LANE_EMDEN_3D_DIR)/results
SAMPLE_DIR := lane_emden

# ============================================================================
# PHONY TARGETS
# ============================================================================

.PHONY: lane_emden_3d_help lane_emden_3d_relax lane_emden_3d_viz \
        lane_emden_3d_animate lane_emden_3d_all lane_emden_3d_clean

# ============================================================================
# HELP
# ============================================================================

lane_emden_3d_help:
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo "  LANE-EMDEN 3D POLYTROPE - Relaxation Benchmark"
	@echo "══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "  Relaxation Benchmark System for Lane-Emden 3D polytrope simulations."
	@echo "  Tests 3D stellar equilibrium structures."
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  QUICK START                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make lane_emden_3d_relax               Run 10,000 relaxation steps    │"
	@echo "│  make lane_emden_3d_all                 Run + plots + animation        │"
	@echo "│  make lane_emden_3d_clean               Remove all results             │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  VISUALIZATION                                                         │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  make lane_emden_3d_viz                 Generate plots                 │"
	@echo "│  make lane_emden_3d_animate             Generate animation             │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "┌─────────────────────────────────────────────────────────────────────────┐"
	@echo "│  SPH METHODS                                                           │"
	@echo "├─────────────────────────────────────────────────────────────────────────┤"
	@echo "│  ssph     Standard SPH with artificial viscosity                       │"
	@echo "│  gsph     Godunov SPH with Riemann solver                              │"
	@echo "│  disph    Density-Independent SPH                                      │"
	@echo "│  gdisph   Godunov DISPH (Riemann + density-independent)                │"
	@echo "└─────────────────────────────────────────────────────────────────────────┘"
	@echo ""
	@echo "  Results: $(LANE_EMDEN_3D_RESULTS_DIR)/"
	@echo ""
	@echo "  ⚠️  Note: Requires DIM=3 build"
	@echo ""

# ============================================================================
# VALIDATION CHECKS
# ============================================================================

lane_emden_3d_check_dim:
	@if ! grep -q "SPH_DIM:STRING=3" build/CMakeCache.txt 2>/dev/null; then \
	echo "❌ ERROR: This test requires DIM=3"; \
	echo ""; \
	echo "   To fix: cd build && cmake -DSPH_DIM=3 .. && make -j8"; \
	exit 1; \
	fi
	@echo "✓ DIM=3 confirmed"

# ============================================================================
# SINGLE METHOD TARGETS
# ============================================================================

lane_emden_3d_relax: build/sph lane_emden_3d_check_dim
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Lane-Emden 3D Relaxation (10,000 steps)"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Method: SSPH"
	@echo "  Particles: ~125,000 (50 shells in 3D)"
	@echo "  Relaxation: 10,000 steps (relaxation_only mode)"
	@echo ""
	@echo "  Applying preset configuration..."
	@python3 -c "import json; \
		preset = json.load(open('$(LANE_EMDEN_3D_PRESET_DIR)/benchmark_ssph.json')); \
		flat = { \
			'outputDirectory': preset['output']['directory'], \
			'startTime': preset['simulation']['start_time'], \
			'endTime': preset['simulation']['end_time'], \
			'outputTime': preset['simulation']['output_time'], \
			'energyTime': preset['simulation']['energy_time'], \
			'SPHType': preset['sph']['type'], \
			'kernel': preset['sph']['kernel'], \
			'gamma': preset['physics']['gamma'], \
			'neighborNumber': preset['physics']['neighbor_number'], \
			'useGravity': preset['physics']['use_gravity'], \
			'G': preset['physics']['G'], \
			'N': preset['simulation']['particle_count'], \
			'avAlpha': preset['artificial_viscosity']['alpha'], \
			'useBalsaraSwitch': preset['artificial_viscosity']['use_balsara_switch'], \
			'useTimeDependentAV': preset['artificial_viscosity']['use_time_dependent_av'], \
			'cflSound': preset['cfl']['sound'], \
			'cflForce': preset['cfl']['force'], \
			'maxTreeLevel': preset['tree']['max_level'], \
			'leafParticleNumber': preset['tree']['leaf_particle_number'], \
			'iterativeSmoothingLength': preset['sph']['iterative_smoothing_length'], \
			'useRelaxation': preset['relaxation']['use_relaxation'], \
			'relaxationSteps': preset['relaxation']['steps'], \
			'relaxationOutputFreq': preset['relaxation']['output_freq'], \
			'relaxationOnly': preset['relaxation']['relaxation_only'], \
			'output': {'formats': preset['output']['formats'], 'enableEnergyFile': preset['output']['enable_energy_file']}, \
			'units': preset['units'] \
		}; \
		json.dump(flat, open('$(SAMPLE_DIR)/lane_emden.json', 'w'), indent=2)"
	@echo "  Output directory:"
	@grep -o '"outputDirectory"[[:space:]]*:[[:space:]]*"[^"]*"' $(SAMPLE_DIR)/lane_emden.json | sed 's/.*: *"\(.*\)"/    📁 \1/'
	@echo "  Creating results directory..."
	@mkdir -p $(LANE_EMDEN_3D_RESULTS_DIR)
	@echo ""
	@echo "────────────────────────────────────────────────────────────────────────────"
	@echo "  Running relaxation..."
	@echo "────────────────────────────────────────────────────────────────────────────"
	./build/sph lane_emden
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✓ Relaxation complete!"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  📁 Results: $(LANE_EMDEN_3D_RESULTS_DIR)/"

lane_emden_3d_viz:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Generating Plots"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@mkdir -p $(LANE_EMDEN_3D_RESULTS_DIR)/plots
	@echo "  ✓ Plots generated!"
	@echo "  �� Output: $(LANE_EMDEN_3D_RESULTS_DIR)/plots/"

lane_emden_3d_animate:
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  Generating Animation"
	@echo "════════════════════════════════════════════════════════════════════════════"
	@mkdir -p $(LANE_EMDEN_3D_RESULTS_DIR)/animations
	@echo "  ✓ Animation complete!"

lane_emden_3d_all: lane_emden_3d_relax lane_emden_3d_viz lane_emden_3d_animate
	@echo ""
	@echo "════════════════════════════════════════════════════════════════════════════"
	@echo "  ✅ Complete Workflow Done!"
	@echo "════════════════════════════════════════════════════════════════════════════"

lane_emden_3d_clean:
	@echo "Cleaning Lane-Emden 3D results..."
	@rm -rf $(LANE_EMDEN_3D_RESULTS_DIR)
	@echo "✓ Cleaned!"
