{
  "comment": "Quick test for IMBH-cloud with relaxation (N=1000 particles)",
  "comment2": "Purpose: Verify Lane-Emden relaxation before full IMBH simulation",
  
  "sample": "lane_emden",
  
  "lane_emden": {
    "N_shells": 10,
    "R": 5.0,
    "M_total": 10000.0,
    "polytropic_index": 1.5,
    "use_equal_mass": true
  },
  
  "relaxationSteps": 100,
  "relaxationOutputFreq": 10,
  "relaxationOnly": true,
  "useRelaxation": true,
  
  "outputDirectory": "sample/imbh_cloud/results/quick_test_relaxation",
  "outputFormat": "csv",
  "enableEnergyFile": true,
  
  "neighborNumber": 50,
  "kernel": "wendland",
  "SPHType": "gdisph",
  "useGravity": false,
  "periodic": false,
  "use2ndOrderGSPH": true,
  "riemannSolver": "hll",
  
  "alpha": 1.0,
  "useBalsaraSwitch": true,
  "useTimeDependentAV": false,
  
  "cflSound": 0.3,
  "cflForce": 0.125,
  
  "startTime": 0.0,
  "endTime": 0.0,
  "outputTime": 0.01,
  
  "gamma": 1.666666667,
  
  "maxTreeLevel": 20,
  "leafParticleNumber": 1
}
